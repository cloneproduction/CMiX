<Window x:Class="CMiX.Core.Presentation.Views.Scheduling.TaskEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Views="clr-namespace:CMiX.Core.Presentation.Views.Scheduling"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        Style="{StaticResource MessengerSettingsWindowStyle}"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        SizeToContent="Height"
        Background="Transparent"
        Title="New Task" d:DesignHeight="168.167" >


    <StackPanel>
        <Grid 
            DockPanel.Dock="Top" 
            Height="20"
            Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Padding="4"
                    Grid.Column="0"
                    Foreground="{StaticResource TextBase}"
                    Text="Name"/>
                <TextBox
                    VerticalContentAlignment="Center"
                    Text="{Binding JobName}"
                    Foreground="{StaticResource TextBase}"
                    Grid.Column="1"
                    DockPanel.Dock="Top"
                    BorderThickness="0"
                    Background="{StaticResource HighDarkerColor}"/>
            </Grid>

            <Grid 
                Height="20"
                Margin="0, 4"
                DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Padding="4"
                    Grid.Column="0"
                    Foreground="{StaticResource TextBase}"
                    Text="Playlist"/>
                <ComboBox
                    Grid.Column="1"
                    ItemsSource="{Binding Path=DataContext.Playlists}"
                    SelectedItem="{Binding SelectedPlaylist}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Views:ToRunType 
                Margin="0, 4"
                DockPanel.Dock="Top"
                DataContext="{Binding ToRunType}"/>

        <Button 
            Height="25"
            DockPanel.Dock="Bottom"
            Margin="0, 8, 0, 0"
            Grid.Column="0"
            Content="OK"
            Style="{StaticResource ButtonRounded}"
            Click="Button_Click"
            Command="{Binding ApplyCommand}"
            CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
        </StackPanel>
</Window>
