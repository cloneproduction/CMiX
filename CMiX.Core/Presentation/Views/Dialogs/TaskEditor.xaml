<Window x:Class="CMiX.Core.Presentation.Views.TaskEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls" 


        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        Style="{StaticResource MessengerSettingsWindowStyle}"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        SizeToContent="Height"
        Background="Transparent"
        Title="New Task" d:DesignHeight="168.167" >


        <StackPanel>

            <Grid 
                    DockPanel.Dock="Top" 
                    Height="20"
                    Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Padding="4"
                        Grid.Column="0"
                        Foreground="{StaticResource TextBase}"
                        Text="Name"/>
                <TextBox
                        VerticalContentAlignment="Center"
                        Text="{Binding JobName}"
                        Foreground="{StaticResource TextBase}"
                        Grid.Column="1"
                        DockPanel.Dock="Top"
                        BorderThickness="0"
                        Background="{StaticResource HighDarkerColor}"/>
            </Grid>

            <Grid 
                    Height="20"
                    Margin="0, 4"
                    DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Padding="4"
                        Grid.Column="0"
                        Foreground="{StaticResource TextBase}"
                        Text="Playlist"/>
                <ComboBox
                        Grid.Column="1"

                        ItemsSource="{Binding Path=DataContext.Playlists}"
                        SelectedItem="{Binding SelectedPlaylist}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <!--<Views:ToRunType 
                    Margin="0, 4"
                    DockPanel.Dock="Top"
                    DataContext="{Binding ToRunType}"/>-->

        <!--<Controls:CMiXPopup IsOpen="{Binding PopupIsOpen}">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeave">
                            <i:InvokeCommandAction Command="{Binding ClosePopupCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>
                    <Border CornerRadius="{DynamicResource CornerRadiusDefault}" 
                                Height="100" 
                                Width="200">
                        <ListBox ItemsSource="{Binding Path=DataContext.CompositionSchedulers, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Views:SchedulerManager}}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="25" 
                                                Content="{Binding Name}"
                                                Command="{Binding DataContext.AddJobToSchedulerCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Views:JobEditor}}}"
                                                CommandParameter="{Binding DataContext, RelativeSource={RelativeSource Self}}"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Controls:CMiXPopup>-->
        <Button 
                Height="25"
                DockPanel.Dock="Bottom"
                Margin="0, 8, 0, 0"
                Grid.Column="0"
                Content="OK"
                Style="{StaticResource ButtonRounded}"
                Click="Button_Click"
                Command="{Binding ApplyCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
        </StackPanel>
</Window>
