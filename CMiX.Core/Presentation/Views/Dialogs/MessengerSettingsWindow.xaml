<Window x:Class="CMiX.Core.Presentation.Views.MessengerSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStyle="None"
        Style="{StaticResource MessengerSettingsWindowStyle}"
        ShowInTaskbar="False"
        Loaded="Window_Loaded"
        SizeToContent="Height"
        Background="Transparent"
        Title="Edit Messenger Settings" d:DesignHeight="168.167" >



    <StackPanel>
        <Grid Height="25" Margin="0, 0, 0, 1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.25*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock 
                    Text="IP" 
                    Foreground="{StaticResource TextBase}"
                    HorizontalAlignment="Right"
                    Margin="0, 0, 8, 0"
                    VerticalAlignment="Center"/>
            <Controls:IPBox 
                    x:Name="ipBox"
                    TabIndex="3"
                    Grid.Column="1" 
                    IPAddress="{Binding IP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </Grid>
        <Grid Height="25" Margin="0, 1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.25*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock 
                    Text="Port" 
                    Margin="0, 0, 8, 0"
                    Foreground="{StaticResource TextBase}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>
            <TextBox
                    Style="{DynamicResource TextBoxNumbersOnly}"
                    TabIndex="4"
                    Padding="4"
                    Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                    Grid.Column="1"
                    BorderThickness="0"
                    BorderBrush="{StaticResource DarkColor}"/>
        </Grid>

        <Button 
                Height="25"
                DockPanel.Dock="Bottom"
                Margin="0, 8, 0, 0"
                Grid.Column="0"
                Content="OK"
                Style="{StaticResource ButtonValidation}"
                Click="Button_Click"
                Command="{Binding ApplyCommand}"
                CommandParameter="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}"/>
    </StackPanel>
</Window>
