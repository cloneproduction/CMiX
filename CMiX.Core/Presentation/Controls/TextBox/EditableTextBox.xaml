<UserControl x:Class="CMiX.Core.Presentation.Controls.EditableTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMiX.Core.Presentation.Controls"
             mc:Ignorable="d" 
             x:Name="editableTextBox"
             d:DesignHeight="46.738" d:DesignWidth="124.807">

        <Grid Background="Transparent">
            <TextBlock 
                x:Name="TextDisplay" 
                Padding="4, 0"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Foreground="{Binding Foreground, ElementName=editableTextBox}" 
                Text="{Binding Path=Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EditableTextBox}}}" />

            <TextBox
                x:Name="InputValue" 
                SelectionBrush="{DynamicResource SuperHighLightColor}"
                CaretBrush="{DynamicResource AccentInactive}"
                BorderThickness="0"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Background="Transparent" 
                Foreground="{DynamicResource ActiveTextBase}" 
                Text="{Binding Path=Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EditableTextBox}}}">
                <TextBox.ContextMenu>
                    <ContextMenu Visibility="Hidden"/>
                </TextBox.ContextMenu>
            </TextBox>
        </Grid>

</UserControl>