<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="BorderContainer" TargetType="{x:Type Border}">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource DarkerColor}"/>
    </Style>

    <Style x:Key="BorderShadow" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderThickness" Value="1, 0, 1, 2"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Shadow}"/>
    </Style>


</ResourceDictionary>