<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls"
                    xmlns:local="clr-namespace:CMiX.Core.Presentation.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Core;component/Presentation/Themes/Basic/Converters.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Core;component/Presentation/Themes/Basic/Colors.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Core;component/Presentation/Themes/Styles/Sliders/Slider.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Core;component/Presentation/Themes/Styles/Sliders/ColorWheel.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Core;component/Presentation/Themes/Styles/RadioButton.xaml"/>
    </ResourceDictionary.MergedDictionaries>


    <Style TargetType="{x:Type local:ColorPicker}">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColorPicker}">
                    <StackPanel>
                        <DockPanel>
                            <Controls:ColorWheelValueSlider 
                                x:Name="PART_ColorWheelValue"
                                Orientation="Vertical"
                                DockPanel.Dock="Right" 
                                Margin="4, 0, 0, 0"
                                Width="12" 
                                Style="{StaticResource ValueSliderVertical}"/>

                            <Border x:Name="border" DockPanel.Dock="Left">
                                <Controls:ColorWheel 
                                    x:Name="PART_ColorWheel"
                                    Style="{StaticResource ColorWheelStyle}"
                                    Width="{Binding ActualWidth, ElementName=border}"
                                    Height="{Binding ActualWidth, ElementName=border}"/>
                            </Border>

                        </DockPanel>

                        <Border 
                            Margin="0, 8" 
                            BorderBrush="{DynamicResource Shadow}" 
                            BorderThickness="1, 0, 1, 2">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="HSVRadio" IsChecked="True" Content="HSV" Grid.Column="0" Style="{StaticResource InlineRadioButtonLeft}"/>
                                <RadioButton x:Name="RGBRadio" Content="RGB" Grid.Column="1" Style="{StaticResource InlineRadioButtonCenter}"/>
                                <RadioButton x:Name="HEXRadio" Content="HEX" Grid.Column="2" Style="{StaticResource InlineRadioButtonRight}"/>
                            </Grid>
                        </Border>

                        <Grid VerticalAlignment="Top">
                            <Border 
                                Visibility="{Binding ElementName=RGBRadio, Path=IsChecked, Converter={StaticResource BoolToVisibility}, ConverterParameter={x:Static Visibility.Hidden}}"
                                BorderBrush="{DynamicResource Shadow}" 
                                BorderThickness="1, 0, 1, 2">
                                <StackPanel>
                                    
                                    <local:RgbaColorSlider 
                                        x:Name="PART_RSlider"
                                        Channel="Red"
                                        Position="Top"
                                        Caption="R"
                                        Style="{StaticResource CMiXSliderStyle}"/>

                                    <local:RgbaColorSlider 
                                        x:Name="PART_GSlider"
                                        Channel="Green"
                                        Caption="G"
                                        Position="Middle"
                                        Margin="0, 1"
                                        Style="{StaticResource CMiXSliderStyle}"/>

                                    <local:RgbaColorSlider 
                                        x:Name="PART_BSlider"
                                        Channel="Blue"
                                        Caption="B"
                                        Position="Bottom"
                                        Style="{StaticResource CMiXSliderStyle}"/>
                                    
                                </StackPanel>
                            </Border>

                            <Border 
                                Visibility="{Binding ElementName=HSVRadio, Path=IsChecked, Converter={StaticResource BoolToVisibility}, ConverterParameter={x:Static Visibility.Hidden}}"
                                BorderBrush="{DynamicResource Shadow}" 
                                BorderThickness="1, 0, 1, 2">
                                <StackPanel>
                                    <local:HueColorSlider 
                                        x:Name="PART_HSlider"
                                        Position="Top"
                                        Caption="H"
                                        Style="{StaticResource CMiXSliderStyle}"/>

                                    <local:SaturationColorSlider 
                                        x:Name="PART_SSlider"
                                        Position="Middle"
                                        Margin="0, 1"
                                        Caption="S"
                                        Style="{StaticResource CMiXSliderStyle}"/>

                                    <local:ValueColorSlider
                                        x:Name="PART_VSlider"
                                        Position="Bottom"
                                        Caption="V"
                                        Style="{StaticResource CMiXSliderStyle}"/>

                                </StackPanel>
                            </Border>

                            <Border 
                                Height="20"
                                VerticalAlignment="Top"
                                Visibility="{Binding ElementName=HEXRadio, Path=IsChecked, Converter={StaticResource BoolToVisibility}, ConverterParameter={x:Static Visibility.Hidden}}"
                                BorderBrush="{DynamicResource Shadow}" 
                                BorderThickness="1, 0, 1, 2">
                                <TextBox 
                                    VerticalContentAlignment="Center"
                                    Background="{DynamicResource HighDarkerColor}"
                                    Foreground="{DynamicResource TextBase}"
                                    Text="{Binding SelectedColor,  RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorToHex}}"/>
                            </Border>
                        </Grid>

                        <Border 
                            VerticalAlignment="Top"
                            Margin="0, 4, 0, 0"
                            BorderBrush="{DynamicResource Shadow}" 
                            BorderThickness="1, 0, 1, 2">
                            <local:RgbaColorSlider 
                                x:Name="PART_AlphaSlider"
                                Caption="Alpha"
                                Channel="Alpha"
                                Style="{StaticResource CMiXSliderStyle}"/>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

</ResourceDictionary>