<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls"
                    xmlns:Behaviors="clr-namespace:CMiX.Core.Presentation.Behaviors">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Core;component/Presentation/Themes/Basic/Converters.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Core;component/Presentation/Themes/Styles/Button.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Core;component/Presentation/Themes/Styles/ToggleButton.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="ItemContainerStyle" Value="{DynamicResource ListBoxItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type ListBox}">
                    <Border
                        x:Name="Bd"
                        BorderBrush="{DynamicResource Shadow}"
                        BorderThickness="0, 2, 0, 0"
                        CornerRadius="4"
                        Background="{DynamicResource ListBoxBackground}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer 
                            Margin="4, 4, 4, 6" 
                            Focusable="False" 
                            VerticalScrollBarVisibility="Auto" 
                            HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListBoxWithSelector" TargetType="{x:Type ListBox}">
        <Setter Property="ItemContainerStyle" Value="{DynamicResource ListBoxWithSelectorItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <DockPanel>
                        <Button 
                            x:Name="deleteItemButton"
                            DockPanel.Dock="Right" 
                            Width="25" 
                            Command="{Binding DeleteItemCommand}"
                            Style="{StaticResource ButtonRoundedRight}"
                            Content="-">
                        </Button>
                        <Border 
                            DockPanel.Dock="Right" 
                            BorderBrush="{DynamicResource SuperHighDarkerColor}" 
                            BorderThickness="0, 0, 0, 1">
                            <Button 
                                Width="25" 
                                Margin="1, 0"
                                Command="{Binding AddItemCommand}"
                                Content="+">
                            </Button>
                        </Border>
                        <ToggleButton x:Name="PopUpToggle" 
                            Width="25"
                            Style="{StaticResource ToggleTransformModifierMenu}"
                            Background="{DynamicResource DarkerColor}" />
                        <Controls:CMiXPopup 
                            AllowsTransparency="True"
                            Behaviors:ClosePopupBehavior.PopupContainer="{Binding ElementName=PopUpToggle}"
                            Placement="Bottom"
                            Width="250"
                            PlacementTarget="{Binding ElementName=PopUpToggle}"
                            FlowDirection="RightToLeft"
                            IsOpen="{Binding IsChecked, ElementName=PopUpToggle}">
                            <Border Background="Transparent" 
                                    CornerRadius="{DynamicResource CornerRadiusBottom}" 
                                    Padding="2, 0, 2, 2">
                                <Border.Effect>
                                    <DropShadowEffect 
                                        BlurRadius="15" 
                                        Opacity="0.8"  
                                        ShadowDepth="2" 
                                        Direction="-90" 
                                        RenderingBias="Performance" />
                                </Border.Effect>
                                <Border CornerRadius="{DynamicResource CornerRadiusBottomLarge}" 
                                        Background="{DynamicResource HighDarkerColor}">
                                    <ScrollViewer Margin="4, 4, 4, 6" 
                                              Focusable="False" 
                                              VerticalScrollBarVisibility="Auto" 
                                              HorizontalScrollBarVisibility="Disabled" >
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Border>
                        </Controls:CMiXPopup>
                        <Border Background="{DynamicResource DarkerColor}" 
                                BorderBrush="{DynamicResource SuperHighDarkerColor}" 
                                BorderThickness="0, 0, 0, 1">
                            <Controls:EditableTextBox 
                                Padding="4, 0, 0, 0" 
                                Text="{Binding SelectedComposition.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Border>
                    </DockPanel>

                    <ControlTemplate.Triggers>
                        <DataTrigger
                            Binding="{Binding HasItems,RelativeSource={RelativeSource Self},UpdateSourceTrigger=PropertyChanged}"
                            Value="False">
                            <Setter TargetName="deleteItemButton" Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="ListBoxWithButton" TargetType="{x:Type ListBox}">
        <Setter Property="ItemContainerStyle" Value="{DynamicResource ListBoxItemStyle}"/>
        <Setter Property="Background" Value="{DynamicResource ListBoxBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ListBoxOutline}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate  TargetType="{x:Type ListBox}">
                    <DockPanel HorizontalAlignment="Stretch">
                        <StackPanel Margin="4, 0, 0, 0" DockPanel.Dock="Right">

                            <Button 
                                Style="{StaticResource ButtonRoundedTop}"
                                Height="20" 
                                Width="21"
                                Content="+" 
                                Command="{Binding AddItemCommand}"/>

                            <Button 
                                x:Name="deleteItemButton"
                                Style="{StaticResource ButtonRoundedBottom}"
                                Height="20"
                                Width="21"
                                Content="-"
                                Command="{Binding DeleteItemCommand}"/>
                            
                        </StackPanel>

                        <Border BorderBrush="{DynamicResource Shadow}"
                                BorderThickness="0, 2, 0, 0"
                                CornerRadius="4">

                            <Border
                                x:Name="Bd"
                                CornerRadius="4"
                                Background="{DynamicResource ListBoxBackground}"
                                SnapsToDevicePixels="True">
                                <ScrollViewer Margin="4, 4, 4, 6" 
                                              Focusable="False" 
                                              VerticalScrollBarVisibility="Auto" 
                                              HorizontalScrollBarVisibility="Disabled" >
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                </ScrollViewer>
                            </Border>
                            
                        </Border>
                    </DockPanel>

                    <ControlTemplate.Triggers>
                        <DataTrigger
                            Binding="{Binding HasItems,RelativeSource={RelativeSource Self},UpdateSourceTrigger=PropertyChanged}"
                            Value="False">
                            <Setter TargetName="deleteItemButton" Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                    
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListBoxWithSelectorItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Button 
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Command="{Binding DataContext.SelectItemCommand,  RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                        CommandParameter="{Binding}"
                        Height="25"
                        Content="{Binding Name}" 
                        Style="{StaticResource ButtonListBoxItem}"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border
                        x:Name="Bd"
                        Background="Transparent"
                        CornerRadius="2"
                        SnapsToDevicePixels="True"
                        Margin="2"
                        Padding="4, 0, 0, 0"
                        TextBlock.Foreground="{DynamicResource TextBase}">
                        <Controls:EditableTextBox 
                            Height="20" 
                            Text="{Binding Path=Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="TextBlock.Foreground" Value="{DynamicResource ActiveTextBase}" />
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HighLightColor}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>