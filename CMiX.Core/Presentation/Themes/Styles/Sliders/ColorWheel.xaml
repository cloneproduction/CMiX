<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Converters="clr-namespace:CMiX.Core.Presentation.ValueConverters"
                    xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Core;component/Presentation/Themes/Basic/Converters.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Core;component/Presentation/Themes/Basic/Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ColorWheelStyle" TargetType="{x:Type Controls:ColorWheel}">
        <Setter Property="Controls:MouseDownHelper.IsEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:ColorWheel}">
                    
                    <Grid Margin="5">

                        <Ellipse
                            x:Name="PART_BlackEllipse"
                            StrokeThickness="0"
                            Stretch="Uniform"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Fill="Black">
                        </Ellipse>

                        <Ellipse Name="PART_SpectrumEllipse"
                                Stretch="Uniform"
                                StrokeThickness="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{StaticResource ColorWheel}"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Canvas>
                            <Ellipse Name="PART_CursorEllipse"
                                     Width="6" Height="6"
                                     Stroke="Black"
                                     Fill="White"
                                     StrokeThickness="1">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="-5" Y="-4"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>
                        
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Controls:MouseDownHelper.IsMouseLeftButtonDown" Value="True">
                            <Setter Property="Cursor" Value="None"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>


    <Style x:Key="ValueSliderVertical" TargetType="{x:Type Controls:ColorWheelValueSlider}">
        <Setter Property="Maximum" Value="255" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Orientation" Value="Vertical"/>
        <Setter Property="Controls:MouseDownHelper.IsEnabled" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:ColorWheelValueSlider}">
                    <Border x:Name="sliderBorder" CornerRadius="2" BorderThickness="1" BorderBrush="Black">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="White"/>
                                <GradientStop Offset="1" Color="Black" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Track x:Name="PART_Track" Grid.Row="1" Margin="0">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{DynamicResource SliderRepeatButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{DynamicResource SliderRepeatButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Part_Thumb" Style="{DynamicResource ValueSliderVerticalThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Controls:MouseDownHelper.IsMouseLeftButtonDown" Value="True">
                            <Setter Property="Cursor" Value="None"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ValueSliderVerticalThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Ellipse Name="PART_CursorEllipse"
                                     Width="6" Height="6"
                                     Stroke="Black"
                                     Fill="White"
                                     StrokeThickness="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
