<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Converters="clr-namespace:CMiX.Core.Presentation.ValueConverters"
                    xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Core;component/Presentation/Themes/Basic/Converters.xaml"/>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Core;component/Presentation/Themes/Basic/Icons.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ColorWheelStyle" TargetType="{x:Type Controls:ColorWheel}">

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:ColorWheel}">
                    <Grid>
                        <Grid Margin="5">
                            <Ellipse Name="PART_SpectrumEllipse"
                                     StrokeThickness="0"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{StaticResource ColorWheel}"/>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>

                        <Canvas>
                            <Ellipse Name="PART_CursorEllipse"
                                     Width="6" Height="6"
                                     Stroke="Black"
                                     Fill="White"
                                     StrokeThickness="1"/>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

