                <Node Bounds="235,481,37,19" Id="TJ0b2XvomLyP3T4Pidmh5r">
                  <p:NodeReference LastCategoryFullName="Primitive.Boolean" LastDependency="VL.CoreLib.vl">
                    <Choice Kind="NodeFlag" Name="Node" Fixed="true" />
