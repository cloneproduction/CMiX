                <Pad Id="D7KfyBQj7fQMENaWzW8l84" Bounds="627,509,418,132" ShowValueBox="true" isIOBox="true" Value="Publishes the channel value every frame via Redis pub/sub, each value tagged with the shared PTP timestamp of the frame it belongs to.&#xD;&#xA;&#xD;&#xA;The channel is an untyped object. The payload must be serialized with MessagePack so the runtime type is transmitted and the receiver can rebuild the typed value.">
                  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                    <Choice Kind="TypeFlag" Name="String" />
                  </p:TypeAnnotation>
                  <p:ValueBoxSettings>
                    <p:fontsize p:Type="Int32">9</p:fontsize>
                    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                  </p:ValueBoxSettings>
                </Pad>
                <Pad Id="DxXMpOQLQHzP6nVhUvd2cl" Bounds="547,885,587,136" ShowValueBox="true" isIOBox="true" Value="Collects incoming samples and keeps a short history. Instead of applying a sample when it arrives, each frame applies the sample that belongs to a fixed number of frames in the past. &#xD;&#xA;&#xD;&#xA;The assumption:&#xD;&#xA;Since all clients are genlocked and share the same clock and delay, they all pick the same sample in the same frame, regardless of network arrival time.">
                  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                    <Choice Kind="TypeFlag" Name="String" />
                  </p:TypeAnnotation>
                  <p:ValueBoxSettings>
                    <p:fontsize p:Type="Int32">9</p:fontsize>
                    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                  </p:ValueBoxSettings>
                </Pad>
