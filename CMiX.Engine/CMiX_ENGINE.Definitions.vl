            <Pad Id="QiHDnLSb4JKLqcsDnxFPtK" Bounds="81,540,778,214" ShowValueBox="true" isIOBox="true" Value="MainloopQueue: the sync peer posts every apply, event and property change here from its background tasks. &#xD;&#xA;&#xD;&#xA;Drain runs them on the mainloop once per frame, in order, so the model changes only on the mainloop. (happens inside Manager)&#xD;&#xA;&#xD;&#xA;Close  runs the rest at once after Stop, so the peer does not wait for its timeout. ((here on Dispose)&#xD;&#xA;&#xD;&#xA;Read Batch is the number of entries one Drain action applies, 256 by default.&#xD;&#xA;&#xD;&#xA;Why:&#xD;&#xA;Without the queue the peer applies on a thread pool thread while the mainloop reads the controls. Two threads then change and read the same collections at the same time, and a read can throw an exception or sees a half applied change.">
              <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                <Choice Kind="TypeFlag" Name="String" />
              </p:TypeAnnotation>
              <p:ValueBoxSettings>
                <p:fontsize p:Type="Int32">9</p:fontsize>
                <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
              </p:ValueBoxSettings>
            </Pad>
