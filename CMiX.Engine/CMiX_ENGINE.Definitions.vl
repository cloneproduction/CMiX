              </p:NodeReference>
              <Pin Id="FXh4OLNG0G8PysO0S9xkeh" Name="Input" Kind="InputPin" />
              <Pin Id="R3OP9ZLJwGTONfAJU1ji3p" Name="Input 2" Kind="InputPin" />
              <Pin Id="JvmPI27RkPtPVoCqYJAZ9I" Name="Output" Kind="OutputPin" />
            </Node>
            <Pad Id="MtDksGEM2uvLWCCqIznemA" Comment="Delay in Frames" Bounds="658,100,35,15" ShowValueBox="true" isIOBox="true" Value="2" />
            <Pad Id="J00vaNHM7gmMyqkKJCfzaZ" Bounds="467,314,505,195" ShowValueBox="true" isIOBox="true" Value="Publishes the channel value every frame via Redis pub/sub, each value tagged with the shared PTP timestamp of the frame it belongs to.&#xD;&#xA;&#xD;&#xA;Collects incoming samples and keeps a short history. Instead of applying a sample when it arrives, each frame applies the sample that belongs to a fixed number of frames in the past. &#xD;&#xA;&#xD;&#xA;The assumption:&#xD;&#xA;Since all clients are genlocked and share the same clock and delay, they all pick the same sample in the same frame, regardless of network arrival time.">
              <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                <Choice Kind="TypeFlag" Name="String" />
              </p:TypeAnnotation>
              <p:ValueBoxSettings>
                <p:fontsize p:Type="Int32">9</p:fontsize>
                <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
              </p:ValueBoxSettings>
            </Pad>
            <Node Bounds="135,440,145,19" Id="OemMsJFltvtNZ1SXld0Q41">
