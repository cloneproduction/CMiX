            <Pad Id="TptwBAYdYlSP5kJX8gAPr6" Comment="FPS" Bounds="588,129,35,15" ShowValueBox="true" isIOBox="true" Value="60">
              <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
