                  </p:NodeReference>
                  <Pin Id="OjmkMyOr856P9c6SXbS2hJ" Name="Input" Kind="StateInputPin" />
                  <Pin Id="LTS59TNywkqQJRV6KKIVDK" Name="Output" Kind="StateOutputPin" />
                </Node>
                <ControlPoint Id="QiJEQsol4rmNJfO2OI0J58" Bounds="317,511" />
                <ControlPoint Id="ODmR7e3m0fyP3Jr4LvA3CV" Bounds="309,299" />
                <ControlPoint Id="U4UzTaBUh7RPc6F78repao" Bounds="416,491" />
                <Pad Id="ETZ9zd8OhszL2JsXGBx9bv" Bounds="486,536" ShowValueBox="true" isIOBox="true" Value="Receiver&#xD;&#xA;&#xD;&#xA;Writes each incoming value into the channel as soon as it has been moved to the main thread.&#xD;&#xA;&#xD;&#xA;Compared to BindToRedis&#xD;&#xA;&#xD;&#xA;BindToRedis stores the value in a Redis key; the receiver is only notified that the key changed and then fetches it with an extra round trip in a later frame. This adds one to two frames of latency and, because the fetch can land before or after a frame boundary, different clients can apply the same value in different frames. Pub/sub carries the value in the notification itself, so the extra round trip and its jitter are gone and every value is delivered, none are skipped.&#xD;&#xA;&#xD;&#xA;Why this is not enough&#xD;&#xA;&#xD;&#xA;The value is still applied at the moment it arrives. Whether that moment falls before or after a client’s frame boundary depends on network and thread timing, so clients can still be one frame apart, just less often. Making all clients apply the same value in the same frame requires the timestamped variant, where each client applies samples by their timestamp with a fixed, shared delay.">
                  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                    <Choice Kind="TypeFlag" Name="String" />
                  </p:TypeAnnotation>
                  <p:ValueBoxSettings>
                    <p:fontsize p:Type="Int32">9</p:fontsize>
                    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                  </p:ValueBoxSettings>
                </Pad>
                <Pad Id="RujPoNbtjruPdSvYEPoljD" Bounds="620,368" ShowValueBox="true" isIOBox="true" Value="Sender&#xD;&#xA;&#xD;&#xA;Publishes every change of the channel directly via Redis pub/sub. The channel is handled as an untyped object. The payload must be serialized with MessagePack so the runtime type is transmitted and the receiver can rebuild the typed value.">
                  <p:TypeAnnotation LastCategoryFullName="Primitive" LastDependency="VL.CoreLib.vl">
                    <Choice Kind="TypeFlag" Name="String" />
                  </p:TypeAnnotation>
                  <p:ValueBoxSettings>
                    <p:fontsize p:Type="Int32">9</p:fontsize>
                    <p:stringtype p:Assembly="VL.Core" p:Type="VL.Core.StringType">Comment</p:stringtype>
                  </p:ValueBoxSettings>
                </Pad>
              </Canvas>
