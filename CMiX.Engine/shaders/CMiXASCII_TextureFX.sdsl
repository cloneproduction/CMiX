[Category("")]
[Summary("")]

shader CMiXASCII_TextureFX : FilterBase
{
    bool Grayscale = false;

    float4 Filter(float4 tex0col)
    {
        float2 uv = streams.TexCoord;
        float2 R = ViewSize*0.5;

        float2 vp = uv*R-0.25;

        float2 sz = float2(8, 12);

        float4 c = Texture0.SampleLevel(Sampler0, floor(vp/sz)*sz/R+0.5/R, 0);

        float grey = mx(c.rgb);

        grey = pow(grey, 5.0);

        float letter = Texture1.SampleLevel(Sampler0, (frac(vp/sz)+float2(grey*176,0))/float2(176,1), 0);

        c.rgb=normalize(c.rgb)*sqrt(3)*letter;

        if(Grayscale)c.rgb=letter;

        return c;
    }

    float mx (float3 p)
    {
        return max(p.x, max(p.y, p.z));
    }
};


