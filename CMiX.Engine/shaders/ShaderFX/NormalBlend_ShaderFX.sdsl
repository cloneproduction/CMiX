shader NormalBlend_ShaderFX : ComputeColor
{
    compose ComputeColor LayerIn;    // backdrop (bottom)
    compose ComputeColor TextureIn;  // source (top)

    [Default(1.0)]
    compose ComputeFloat BlendAmountIn;

    override float4 Compute()
    {
        float4 backdrop = LayerIn.Compute();
        float4 source = TextureIn.Compute();

        float as = source.a * saturate(BlendAmountIn.Compute());
        float ab = backdrop.a;

        // Source over
        float ar = as + ab * (1.0 - as);
        float t = as / max(ar, 1e-6);

        float3 color = lerp(backdrop.rgb, source.rgb, t);
        return float4(color, ar);
    }
};