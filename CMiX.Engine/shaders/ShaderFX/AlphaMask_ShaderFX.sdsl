[Category("Filter")]
[Tags("")]

shader AlphaMask_ShaderFX : ComputeFloat4, Texturing, ShaderUtils, ShaderBaseStream 
{
    cbuffer PerMaterial
    {
        stage float4x4 TransformResult;
        stage float4x4 TransformTexture;
        stage float4x4 TransformMask;
        stage int AlphaChannel = 1;
        stage bool Invert = 0;
        stage bool MaskEnabled;
    }

    rgroup PerMaterial 
    {
        stage Texture2D Texture;
        stage Texture2D Mask;
        stage SamplerState TextureSampler;
        stage SamplerState MaskSampler;

        [Default(1.0f, 1.0f, 1.0f, 1.0f)]
        stage compose ComputeColor Color;
    }

    float2 TransformTexCoord(float2 TexCoord, float4x4 transform)
    {
        return mul(float4((TexCoord.xy*2-1)*float2(1,-1) * 0.5, 0, 1), transform).xy * float2(1, -1) + 0.5;
    }

    override float4 Compute()
    {
        float2 textureUV = TransformTexCoord(streams.TexCoord, mul(TransformTexture, TransformResult));
        float4 col = Texture.Sample(TextureSampler, textureUV);

        if (MaskEnabled)
        {
            float2 maskUV = TransformTexCoord(streams.TexCoord, mul(TransformMask, TransformResult));
            float4 alphaMask = Mask.Sample(MaskSampler, maskUV);

            float alpha = 0;

            switch(AlphaChannel)
            {
                case 0: alpha = (alphaMask.r + alphaMask.g + alphaMask.b + alphaMask.a) / 4; break;
                case 1: alpha = 1.0 - alphaMask.r; break;
                case 2: alpha = 1.0 - alphaMask.g; break;
                case 3: alpha = 1.0 - alphaMask.b; break;
                case 4: alpha = 1.0 - alphaMask.a; break;
                case 5: alpha = base.RGBtoHSV(alphaMask.rgb).x; break;
                case 6: alpha = 1.0 - base.RGBtoHSV(alphaMask.rgb).y; break;
                case 7: alpha = 1.0 - base.RGBtoHSV(alphaMask.rgb).z; break;
                case 8: alpha = 1.0 - base.RGBtoHSL(alphaMask.rgb).z; break;
            }

            if (!Invert) alpha = 1 - saturate(alpha);
            col *= alpha;
        }

        return col * Color.Compute();
    }
};