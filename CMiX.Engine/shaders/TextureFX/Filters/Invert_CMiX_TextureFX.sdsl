[Category("Filter")]
[Summary("Inverts the image colors")]


shader Invert_CMiX_TextureFX : FilterBase
{
    float Factor = 1;
    bool InvertAlpha = false;
    int Mode = 0;

    float4 Filter(float4 tex0col)
    {
        float4 o = tex0col;
        float4 c = o;

        switch(Mode)
        {
            //INVERT RGB
            case 0:
                c.rgb = 1 - ColorUtilityTemp.GammaToLinear(c, 2.2f).rgb; 
                break;

            //LINEAR INVERT RGB
            case 1:
                c.rgb = 1 - c.rgb;
                break;

            case 2:
                c.r = 1 - c.r;
                break;

            case 3:
                c.g = 1 - c.g;
                break;

            case 4:
                c.b = 1 - c.b;
                break;

            case 5:
                c.rgb = InvertValue(c);
                break;

            case 6:
                c.rgb = InvertLuma(c);
                break;

            case 7:
                c.rgb = InvertHue(c);
                break;
        }


        if (InvertAlpha) c.a = 1 - c.a;
        c.rgb = lerp(o, c, Factor);

        return c;
    }


    float3 InvertValue(float4 color)
    {
        float3 hsv = base.RGBtoHSV(color.rgb);
        hsv.z = 1 - hsv.z;
        return base.HSVtoRGB(hsv);
    }

    float3 InvertHue(float4 color)
    {
        color.rgb = color.rgb - 2 * (color.rgb - dot(color.rgb,1) / 3.);
        return color;
    }

    float3 InvertLuma(float4 color)
    {
        float3 hsv = base.RGBtoHSL(color.rgb);
        hsv.z = 1 - hsv.z;
        return base.HSLtoRGB(hsv);
    }
};