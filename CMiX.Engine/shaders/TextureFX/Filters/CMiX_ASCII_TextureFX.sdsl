[Category("Filter.Pattern")]
[Summary("")]
[Tags("")]

shader CMiX_ASCII_TextureFX : FilterBase, TileParams
{
    bool Grayscale = false;
    int CharacterCount = 176;
    

    [Default(0.0)]
    compose ComputeFloat GridSize;

    [Default(4.0, 6.0)]
    compose ComputeFloat2 CharacterSize;

    float4 Filter(float4 tex0col)
    {
        // Composition texel centre of this pixel. Integer math, the same on every machine.
        float2 ctex = float2(CompositionTexelIndex(streams.TexCoord, ViewSize)) + 0.5;
        float2 cuv = ctex / CompositionResolution;

        // Half resolution grid over the composition.
        float2 R = CompositionResolution * 0.5;

        float2 uv = cuv * R - 0.25;

        // At least one texel, so the division below is safe.
        int2 gridSize = max(CharacterSize.Compute() * (1 - GridSize.Compute()), 1);
        float2 cellUV = floor(uv / gridSize) * gridSize / R + 0.5 / R;
        float4 c = Texture0.SampleLevel(PointSampler, CompositionToTileUV(cellUV), 0);

        float grey = mx(c.rgb);

        grey = pow(grey, 5.0);

        float Quantized = round(grey * CharacterCount) / CharacterCount;

        float letter = Texture1.SampleLevel(PointSampler, (frac(uv / gridSize) + float2(Quantized * CharacterCount, 0)) / float2(CharacterCount, 1), 0);

        c.rgb = normalize(c.rgb) * sqrt(3) * letter;

        if(Grayscale)c.rgb=letter;

        return c;
    }

    float mx (float3 p)
    {
        return max(p.x, max(p.y, p.z));
    }
};


