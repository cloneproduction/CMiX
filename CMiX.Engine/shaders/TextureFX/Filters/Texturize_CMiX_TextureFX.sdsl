[Category("")]
[Summary("")]

shader Texturize_CMiX_TextureFX : FilterBase
{
    SamplerState sNOI;
    int2 G = 4;
    float Zoom;
    bool Aspect = 1;
    float Rotate;
    float2 Offset;

    float4 Filter(float4 tex0col)
    {
        float2 x = streams.TexCoord;

        float4 c = 0;

	    float2 tx=frac(x*G);
	    float2 fx=floor(x*G);

	    c+=slice(tx,fx,float2( 0, 0))*sstep(1,0,abs(tx.x-.5))*sstep(1,0,abs(tx.y-.5));
	    c+=slice(tx,fx,float2(-1, 0))*sstep(.5,1.5,tx.x)*sstep(1,0,abs(tx.y-.5));
	    c+=slice(tx,fx,float2(+1, 0))*sstep(.5,-.5,tx.x)*sstep(1,0,abs(tx.y-.5));
	    c+=slice(tx,fx,float2( 0,-1))*sstep(1,0,abs(tx.x-.5))*sstep(.5,1.5,tx.y);
	    c+=slice(tx,fx,float2(-1,-1))*sstep(.5,1.5,tx.x)*sstep(.5,1.5,tx.y);
	    c+=slice(tx,fx,float2(+1,-1))*sstep(.5,-.5,tx.x)*sstep(.5,1.5,tx.y);
	    c+=slice(tx,fx,float2( 0,+1))*sstep(1,0,abs(tx.x-.5))*sstep(.5,-.5,tx.y);
	    c+=slice(tx,fx,float2(-1,+1))*sstep(.5,1.5,tx.x)*sstep(.5,-.5,tx.y);
	    c+=slice(tx,fx,float2(+1,+1))*sstep(.5,-.5,tx.x)*sstep(.5,-.5,tx.y);

	    c.a = 1;

        return c;
    }


    float4 slice(float2 x, float2 n, float2 p)
    {
        n -= p;
        float4 noi = Texture1.Sample(LinearSampler, (n+0.5)/G);
        float zoom = pow(noi.x, pow(2, Zoom - 2.0)) * 0.5;
        float2 dx = (x - 0.5 + p)*zoom/G;
        float2 asp = ViewSize / ViewSize.x;

        if(!Aspect)
        {
            asp = 1;
        }

        dx = r2d(dx*asp, (noi.y - 0.5) * Rotate) / asp;
        dx += (noi.zw - 0.5) * (1.0 - zoom) * (G - 1.0) / G * Offset;

	    float4 c = Texture0.SampleLevel(LinearSampler, dx, 0);
	    return c;
    }

    float sstep(float a,float b,float x)
    {
	    return saturate((x-a)/(b-a));
    }
    //float2 r2d(float2 x,float a)
    //{
    //    a *= acos(-1)*2;
    //    return float2(cos(a)*x.x+sin(a)*x.y,cos(a)*x.y-sin(a)*x.x);
    //}
};


