[Category("Filter")]
[Summary("")]

shader CMiXPixelate_TextureFX : FilterBase
{
    float2 FactorXY = 1.0;

    float4 Filter(float4 tex0col)
    {
        float2 uv = streams.TexCoord;
        float2 R = ViewSize;
        
        float2 vp = uv * R;
        float2 sz = min(max(0.5/R, (FactorXY * 0.5 ) * R), R);

        return Texture0.Sample(Sampler0, floor(vp/sz) * sz/R + .5/R);	
    }
};



	