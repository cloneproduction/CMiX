<Window
    x:Class="CMiX.Studio.Avalonia.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:Modifiers="clr-namespace:CMiX.Core.Colors.Modifiers;assembly=CMiX.Core"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Texturing="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Avalonia.Behaviors"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Beat="clr-namespace:CMiX.Studio.Avalonia.Views.Beat"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Menus="clr-namespace:CMiX.Studio.Avalonia.Views.Menus"
    xmlns:Windows="clr-namespace:CMiX.Studio.Avalonia.Views.Windows"

    Title="CMiX"
    Width="400"
    Height="1000"
    Background="{DynamicResource Grey200Brush}"
    ExtendClientAreaChromeHints="NoChrome"
    ExtendClientAreaTitleBarHeightHint="-1"
    ExtendClientAreaToDecorationsHint="True"
    Focusable="True"
    WindowStartupLocation="CenterScreen">

    <DockPanel Background="{DynamicResource Grey200Brush}" LastChildFill="True">

        <!-- Custom title bar; dragging is handled in code behind via BeginMoveDrag. -->
        <Border
            x:Name="titleBar"
            Background="{DynamicResource Grey100Brush}"
            DockPanel.Dock="Top">

            <DockPanel LastChildFill="False">

                <Windows:MainWindowController DataContext="{Binding MainWindowController}" DockPanel.Dock="Right" />

                <Menus:MainMenu DataContext="{Binding MainMenu}" DockPanel.Dock="Left" />

            </DockPanel>
        </Border>

        <Border
            Height="{DynamicResource ControlHeightXL}"
            Background="{DynamicResource Grey100Brush}"
            BorderBrush="{DynamicResource Grey100Brush}"
            BorderThickness="2,0,2,2"
            DockPanel.Dock="Bottom">

            <DockPanel LastChildFill="False" Opacity="0.5">

                <TextBlock
                    Padding="8"
                    DockPanel.Dock="Left"
                    Text="CMiX Studio" />

                <TextBlock
                    Padding="8"
                    DockPanel.Dock="Right"
                    Text="CloneProduction" />

            </DockPanel>

        </Border>

        <Border
            Padding="8"
            Background="{DynamicResource Grey300Brush}"
            BorderBrush="{DynamicResource Grey100Brush}"
            BorderThickness="2,0"
            DockPanel.Dock="Bottom">

            <Beat:MasterBeatControl DataContext="{Binding Project.MasterBeat}" />

        </Border>

        <TabControl
            VerticalAlignment="Stretch"
            DockPanel.Dock="Top"
            Theme="{StaticResource TabControlLayerPanel}">

            <TabItem Theme="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{DynamicResource Composition}"
                        ToolTip.HorizontalOffset="-10"
                        ToolTip.Placement="Pointer"
                        ToolTip.Tip="Composition"
                        ToolTip.VerticalOffset="10" />
                </TabItem.Header>
                <ScrollViewer>
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>
                    <DockPanel>

                        <Views:PrefabSlotManager
                            Margin="8"
                            DataContext="{Binding CompositionManager}"
                            DockPanel.Dock="Top"
                            ItemsSource="{Binding $parent[Window].DataContext.ControlRepository.Compositions}">

                            <Views:PrefabSlotManager.SelectionPanel>
                                <Views:ButtonOpenSelectionPanel Caption="Add">
                                    <Views:ButtonOpenSelectionPanel.SelectionPanel>
                                        <Views:CompositionSelectionPanel />
                                    </Views:ButtonOpenSelectionPanel.SelectionPanel>
                                </Views:ButtonOpenSelectionPanel>
                            </Views:PrefabSlotManager.SelectionPanel>

                        </Views:PrefabSlotManager>

                        <!--<Views:PrefabSlotManager
                            Margin="8"
                            VerticalAlignment="Top"
                            DataContext="{Binding Project.CompositionManager}"
                            DockPanel.Dock="Top"
                            ItemsSource="{Binding ControlRepository.Compositions}">
--><!--
                            <Views:Outliner.SelectionPanel>
                                <Button
                                    Command="{Binding AddItemCommand}"
                                    CommandParameter="{x:Type Compositing:Composition}"
                                    Content="New Composition"
                                    Theme="{DynamicResource ButtonRoundedRight}" />
                            </Views:Outliner.SelectionPanel>--><!--

                        </Views:Outliner>-->

                        <!-- The IsVisible binding sits on a wrapper because an empty path binding against a null DataContext never delivers a value in Avalonia. -->
                        <Border IsVisible="{Binding Project.CompositionManager.SelectedItem, Converter={StaticResource NullToVisibility}}">
                            <Views:Composition DataContext="{Binding Project.CompositionManager.SelectedItem}" />
                        </Border>

                    </DockPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Theme="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{DynamicResource LayerScene}"
                        ToolTip.HorizontalOffset="-10"
                        ToolTip.Placement="Pointer"
                        ToolTip.Tip="Layers"
                        ToolTip.VerticalOffset="10" />
                </TabItem.Header>

                <Border IsVisible="{Binding Project.CompositionManager.SelectedItem, Converter={StaticResource NullToVisibility}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.4*" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="1"
                            Background="{DynamicResource Grey300Brush}"
                            BorderBrush="{DynamicResource Grey100Brush}"
                            BorderThickness="0,2"
                            IsVisible="{Binding Project.CompositionManager.SelectedItem.LayerManager.SelectedItem, Converter={StaticResource NullToVisibility}}">
                            <Views:Layer DataContext="{Binding Project.CompositionManager.SelectedItem.LayerManager.SelectedItem}" />
                        </Border>

                        <Views:LayerManager
                            Grid.Row="0"
                            DataContext="{Binding Project.CompositionManager.SelectedItem.LayerManager}" />

                        <GridSplitter
                            Grid.Row="0"
                            Height="8"
                            Margin="0,-4"
                            VerticalAlignment="Bottom"
                            Theme="{StaticResource GridSplitter}" />
                    </Grid>
                </Border>

            </TabItem>

            <TabItem Theme="{StaticResource TabItemHorizontal}">
                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{DynamicResource Geometry}"
                        ToolTip.HorizontalOffset="-10"
                        ToolTip.Placement="Pointer"
                        ToolTip.Tip="Entities"
                        ToolTip.VerticalOffset="10" />
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>

                    <Border Background="{DynamicResource Grey300Brush}">
                        <StackPanel>

                            <Views:RepositoryManager
                                x:Name="EntitiesRepository"
                                DataContext="{Binding EntityManager}"
                                DockPanel.Dock="Top"
                                ItemsSource="{Binding ControlRepository.Entities}">
                                <Views:RepositoryManager.SelectionPanel>
                                    <Button
                                        Command="{Binding AddItemCommand}"
                                        CommandParameter="{x:Type Compositing:Entity}"
                                        Content="New Entity" />
                                </Views:RepositoryManager.SelectionPanel>
                            </Views:RepositoryManager>

                            <Border IsVisible="{Binding EntityManager.SelectedItem, Converter={StaticResource NullToVisibility}}">
                                <ContentControl Content="{Binding}" DataContext="{Binding EntityManager.SelectedItem}">
                                    <ContentControl.DataTemplates>

                                        <DataTemplate DataType="{x:Type Compositing:Entity}">
                                            <Views:ModelEntity />
                                        </DataTemplate>

                                        <DataTemplate DataType="{x:Type Cameras:Camera}">
                                            <Views:Camera />
                                        </DataTemplate>

                                        <DataTemplate DataType="{x:Type Lights:LightEntity}">
                                            <Views:LightEntity />
                                        </DataTemplate>

                                    </ContentControl.DataTemplates>
                                </ContentControl>
                            </Border>

                        </StackPanel>
                    </Border>

                </ScrollViewer>

            </TabItem>

            <Managers:RepositoryTab
                DataContext="{Binding MaterialManager}"
                Icon="{DynamicResource World}"
                ItemsSource="{Binding ControlRepository.Materials}"
                ToolTipText="Material">
                <Managers:RepositoryTab.SelectionPanel>
                    <Button
                        Command="{Binding AddItemCommand}"
                        CommandParameter="{x:Type Materials:Material}"
                        Content="New Material" />
                </Managers:RepositoryTab.SelectionPanel>
                <Managers:RepositoryTab.EditingPanel>
                    <Views:Material />
                </Managers:RepositoryTab.EditingPanel>
            </Managers:RepositoryTab>

            <Managers:RepositoryTab
                DataContext="{Binding TextureManager}"
                Icon="{DynamicResource Texture}"
                ItemsSource="{Binding ControlRepository.Textures}"
                ToolTipText="Textures">
                <Managers:RepositoryTab.SelectionPanel>
                    <Views:ButtonOpenSelectionPanel Caption="New Texture">
                        <Views:ButtonOpenSelectionPanel.SelectionPanel>
                            <Views:AutoSelectionPanel Interface="{x:Type Texturing:ITextureSource}" />
                        </Views:ButtonOpenSelectionPanel.SelectionPanel>
                    </Views:ButtonOpenSelectionPanel>
                </Managers:RepositoryTab.SelectionPanel>
                <Managers:RepositoryTab.EditingPanel>
                    <Views:Texture />
                </Managers:RepositoryTab.EditingPanel>
            </Managers:RepositoryTab>

            <Managers:RepositoryTab
                DataContext="{Binding CameraManager}"
                Icon="{DynamicResource Camera}"
                ItemsSource="{Binding ControlRepository.Cameras}"
                ToolTipText="Cameras">
                <Managers:RepositoryTab.SelectionPanel>
                    <Button
                        Command="{Binding AddItemCommand}"
                        CommandParameter="{x:Type Cameras:Camera}"
                        Content="New Camera" />
                </Managers:RepositoryTab.SelectionPanel>
                <Managers:RepositoryTab.EditingPanel>
                    <Views:Camera />
                </Managers:RepositoryTab.EditingPanel>
            </Managers:RepositoryTab>

            <Managers:RepositoryTab
                DataContext="{Binding LightManager}"
                Icon="{DynamicResource MeshLight}"
                ItemsSource="{Binding ControlRepository.Lights}"
                ToolTipText="Lights">
                <Managers:RepositoryTab.SelectionPanel>
                    <Button
                        Command="{Binding AddItemCommand}"
                        CommandParameter="{x:Type Lights:LightEntity}"
                        Content="New Light" />
                </Managers:RepositoryTab.SelectionPanel>
                <Managers:RepositoryTab.EditingPanel>
                    <Views:LightEntity />
                </Managers:RepositoryTab.EditingPanel>
            </Managers:RepositoryTab>

            <Managers:RepositoryTab
                DataContext="{Binding BeatManager}"
                Icon="{DynamicResource Beat}"
                ItemsSource="{Binding ControlRepository.BeatModifiers}"
                ToolTipText="BeatModifiers">
                <Managers:RepositoryTab.SelectionPanel>
                    <Button
                        Command="{Binding AddItemCommand}"
                        CommandParameter="{x:Type Animations:BeatModifier}"
                        Content="New Beat" />
                </Managers:RepositoryTab.SelectionPanel>
                <Managers:RepositoryTab.EditingPanel>
                    <Views:BeatModifier />
                </Managers:RepositoryTab.EditingPanel>
            </Managers:RepositoryTab>

            <Managers:RepositoryTab
                DataContext="{Binding ColorPaletteManager}"
                Icon="{DynamicResource Coloration}"
                ItemsSource="{Binding ControlRepository.ColorPalettes}"
                ToolTipText="Color Palette">
                <Managers:RepositoryTab.SelectionPanel>
                    <Button
                        Command="{Binding AddItemCommand}"
                        CommandParameter="{x:Type Modifiers:ColorPalette}"
                        Content="New Palette" />
                </Managers:RepositoryTab.SelectionPanel>
            </Managers:RepositoryTab>

            <TabItem Theme="{StaticResource TabItemHorizontal}">
                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{DynamicResource Resources}"
                        ToolTip.HorizontalOffset="-10"
                        ToolTip.Placement="Pointer"
                        ToolTip.Tip="Assets"
                        ToolTip.VerticalOffset="10" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>
                    <Views:AssetManager DataContext="{Binding AssetManager}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Theme="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{DynamicResource Network}"
                        ToolTip.HorizontalOffset="-10"
                        ToolTip.Placement="Pointer"
                        ToolTip.Tip="Network"
                        ToolTip.VerticalOffset="10" />
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>
                    <Views:ServerManagementPanel DataContext="{Binding ServerManager}" />
                </ScrollViewer>

            </TabItem>

        </TabControl>
    </DockPanel>

</Window>
