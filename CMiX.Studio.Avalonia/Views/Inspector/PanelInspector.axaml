<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.PanelInspector"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Filters="clr-namespace:CMiX.Core.Texturing.Filters;assembly=CMiX.Core"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Tree="clr-namespace:CMiX.Studio.Avalonia.ViewModels.Tree"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    d:DesignHeight="600">

    <!-- The editor of the row that is selected in the project tree. The DataContext is the ProjectTree.
         The editors are the views of the other tabs, so an item looks the same here and there. -->

    <UserControl.Styles>
        <!-- A tab view in the inspector does not scroll. The inspector scrolls it. The view has no gutter: the inspector has one. -->
        <Style Selector=".hosted > ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector=".hosted > ScrollViewer /template/ ScrollContentPresenter#PART_ContentPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
    </UserControl.Styles>

    <DockPanel>

        <!-- The title bar: the icon of the inspected node and its name, on the inspected tint of its row in the tree. -->
        <Border
            Name="header"
            Height="{DynamicResource ControlHeightXL}"
            Padding="8,0"
            Background="{Binding InspectedNode, Converter={StaticResource KindMark}, ConverterParameter=Inspected}"
            DockPanel.Dock="Top"
            IsVisible="{Binding InspectedNode, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">
            <!-- The badge, the name, and at the right end the toggles of the item (see TogglesComposable).
                 The name of an item can be edited here, as in the tree. A group has a name that can not be changed, and no toggle. -->
            <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,*,Auto">
                <Views:BadgeCategory
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    DataContext="{Binding InspectedNode}" />

                <Panel Grid.Column="1" VerticalAlignment="Center">
                    <ui:TextBoxEditable
                        Name="nameEditor"
                        Text="{Binding InspectedNode.Item.PrefabService.Name.Value, Mode=TwoWay}"
                        IsVisible="{Binding InspectedNode.Item, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock
                        Name="title"
                        VerticalAlignment="Center"
                        Text="{Binding InspectedNode.Header}"
                        IsVisible="{Binding InspectedNode.Item, Converter={x:Static ObjectConverters.IsNull}}" />
                </Panel>

                <Views:TogglesComposable
                    Name="headerToggles"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    DataContext="{Binding InspectedNode.Item}"
                    IsVisible="{Binding $self.DataContext, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </Grid>
        </Border>

        <TextBlock
            Name="placeholder"
            Margin="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Opacity="0.5"
            Text="Select an item in the tree"
            IsVisible="{Binding InspectedNode.InspectorContent, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=True}" />

        <ScrollViewer
            Name="scroller"
            Theme="{StaticResource ScrollViewerOverlayKeepOffset}"
            IsVisible="{Binding InspectedNode.InspectorContent, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}">

            <ContentControl Name="editor" Content="{Binding InspectedNode.InspectorContent}">
                <ContentControl.DataTemplates>

                    <DataTemplate DataType="{x:Type Compositing:Composition}">
                        <StackPanel>
                            <Border Background="{DynamicResource Grey200Brush}">
                                <Views:SettingsComposable Margin="8" />
                            </Border>
                            <Views:Composition Classes="hosted" />
                        </StackPanel>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Compositing:Layer}">
                        <StackPanel>
                            <Border Background="{DynamicResource Grey200Brush}">
                                <Views:SettingsComposable Margin="8" />
                            </Border>
                            <Views:TabLayerPostFX Classes="hosted" />
                        </StackPanel>
                    </DataTemplate>

                    <!-- A group row of a layer shows the panel of the old tab for that kind: the list of the items and the editor of the
                         one that is chosen in it. The panels take the layer as their DataContext. -->
                    <DataTemplate DataType="{x:Type Tree:EntitiesGroup}">
                        <Views:TabLayerEntity Classes="hosted" DataContext="{Binding Layer}" />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Tree:CamerasGroup}">
                        <Views:TabLayerCamera Classes="hosted" DataContext="{Binding Layer}" />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Tree:LightsGroup}">
                        <Views:TabLayerLight Classes="hosted" DataContext="{Binding Layer}" />
                    </DataTemplate>

                    <!-- The groups of any item: the same panels as in the editors, for the list of the group. The panel that adds an item lists
                         what can be added to the owner, so it takes the type of the owner from the group. -->
                    <DataTemplate DataType="{x:Type Tree:ModifiersGroup}">
                        <Border Name="groupRoot">
                            <Views:ModifierManager Caption="Add Modifier" Margin="8" DataContext="{Binding Manager}">
                                <Views:ModifierManager.AddContent>
                                    <Managers:PanelAddTypes PanelOwner="{Binding DataContext.OwnerType, ElementName=groupRoot}" />
                                </Views:ModifierManager.AddContent>
                            </Views:ModifierManager>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Tree:FiltersGroup}">
                        <Views:ModifierManager Caption="Add Filter" Margin="8" DataContext="{Binding Manager}">
                            <Views:ModifierManager.AddContent>
                                <Managers:PanelAddTypes Interface="{x:Type Filters:ITextureFilter}" />
                            </Views:ModifierManager.AddContent>
                        </Views:ModifierManager>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Tree:TexturesGroup}">
                        <Views:DiffuseTexture DataContext="{Binding Owner.Texture.DiffuseTexture}" />
                    </DataTemplate>

                    <!-- The groups that make the structure (the compositions of the project, the layers of a composition) have no panel of their own yet:
                         the rows of the tree list their items. The hide button of the row is the one control of a group. -->
                    <DataTemplate DataType="{x:Type Tree:StructureGroup}">
                        <Border />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Compositing:Entity}">
                        <Views:ModelEntity />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Compositing:FullscreenQuad}">
                        <Views:FullscreenQuad />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Compositing:TextEntity}">
                        <Views:TextEntity />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Cameras:Camera}">
                        <Views:Camera />
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type Lights:LightEntity}">
                        <Views:LightEntity />
                    </DataTemplate>

                </ContentControl.DataTemplates>
            </ContentControl>
        </ScrollViewer>

    </DockPanel>

</UserControl>
