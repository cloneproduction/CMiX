<Controls:ModulatablePanel
    x:Class="CMiX.Studio.Avalonia.Views.ZoomModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="zoomModifier"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

        <BaseControls:DragValueModulatable
            Caption="Distance"
            DataContext="{Binding Distance}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=zoomModifier}" />

        <BaseControls:DragValueModulatable
            Caption="FOV"
            DataContext="{Binding FOV}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=zoomModifier}" />

    </ui:StackPanelPositioned>

</Controls:ModulatablePanel>
