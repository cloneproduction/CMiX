<Controls:ModulatablePanel
    x:Class="CMiX.Studio.Avalonia.Views.TargetModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    x:Name="targetModifier"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <BaseControls:ModulatableVectorXYZ
        Caption="Target"
        ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=targetModifier}" />

</Controls:ModulatablePanel>
