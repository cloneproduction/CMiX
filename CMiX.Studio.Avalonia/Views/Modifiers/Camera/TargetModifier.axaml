<Modulation:PanelModulatable
    x:Class="CMiX.Studio.Avalonia.Views.TargetModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    x:Name="targetModifier"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <Modulation:Vector3Modulatable
        Caption="Target"
        ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=targetModifier}" />

</Modulation:PanelModulatable>
