<Modulation:PanelModulatable
    x:Class="CMiX.Studio.Avalonia.Views.OrbitModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="orbitModifier"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

        <Modulation:DragValueModulatable
            Caption="Yaw"
            DataContext="{Binding Yaw}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=orbitModifier}" />

        <Modulation:DragValueModulatable
            Caption="Pitch"
            DataContext="{Binding Pitch}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=orbitModifier}" />

    </ui:StackPanelPositioned>

</Modulation:PanelModulatable>
