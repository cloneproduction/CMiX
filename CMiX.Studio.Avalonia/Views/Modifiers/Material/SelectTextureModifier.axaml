<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.SelectTextureModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:CaptionedComboBox
            Caption="From"
            ItemsSource="{x:Static Resources:EnumProviders.TextureFrom}"
            ResetCommand="{Binding TextureFrom.ResetCommand}"
            SelectedItem="{Binding TextureFrom.Value}" />

    </StackPanel>

</UserControl>
