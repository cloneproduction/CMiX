<HeaderedContentControl
    x:Class="CMiX.Studio.Avalonia.Views.Modifiers.ModifierPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Modifiers="clr-namespace:CMiX.Studio.Avalonia.Views.Modifiers"
    x:Name="modifierPanel"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <HeaderedContentControl.Styles>
        <Style Selector=":is(ContentControl)">
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
    </HeaderedContentControl.Styles>

    <HeaderedContentControl.Header>
        <DockPanel>

            <StackPanel 
                DockPanel.Dock="Right"
                Orientation="Horizontal">

                <ToggleButton
                    Width="{DynamicResource ControlHeightMD}"
                    DockPanel.Dock="Right"
                    IsChecked="{Binding DataContext.PrefabService.Visibility.Value, ElementName=modifierPanel, Mode=TwoWay}"
                    Theme="{DynamicResource ToggleButtonVisibility}" />

                <Button
                    Command="{Binding CloseModifierCommand, ElementName=modifierPanel}"
                    CommandParameter="{Binding CloseModifierCommandParameter, ElementName=modifierPanel}"
                    Theme="{DynamicResource ButtonIconClose}" />

              <Button
                    Margin="8, 0, 2, 0"
                    ui:DragHandle.IsEnabled="True"
                    ui:DragHandle.IsPressed="{Binding DragHandleIsPressed, ElementName=modifierPanel, Mode=TwoWay}"
                    DockPanel.Dock="Right"
                    Theme="{StaticResource ButtonDragHandle}">

                <Button.Content>

                  <ui:AppIcon
                      IconKey="DragHandle"
                      Size="{DynamicResource IconSizeXS}" />

                </Button.Content>

              </Button>
              
            </StackPanel>

            <TextBlock 

                Text="{Binding DataContext.PrefabService.Name.Value, ElementName=modifierPanel}" />

        </DockPanel>
    </HeaderedContentControl.Header>

    <HeaderedContentControl.Template>
        <ControlTemplate TargetType="Modifiers:ModifierPanel">
          
            <Expander
                Name="PART_Expander"
                IsExpanded="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                Theme="{StaticResource ExpanderItem}">

                <Expander.Header>
                    <ContentPresenter
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}" />
                </Expander.Header>

                    <ContentPresenter 
                        Padding="8" 
                        Content="{TemplateBinding Content}" 
                        ContentTemplate="{TemplateBinding ContentTemplate}" />

            </Expander>
        </ControlTemplate>
    </HeaderedContentControl.Template>

</HeaderedContentControl>
