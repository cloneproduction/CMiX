<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.RandomVisibility"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <StackPanel>
        <BaseControls:CMiXSlider
            Margin="0,0,0,8"
            Caption="Control"
            Maximum="1"
            Minimum="0"
            Value="{Binding Control.Value}" />
        <Views:BeatModifierManager DataContext="{Binding BeatModifierManager}" />
    </StackPanel>

</UserControl>
