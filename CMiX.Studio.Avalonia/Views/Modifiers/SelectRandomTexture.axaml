<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.SelectRandomTexture"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources">

    <StackPanel>

        <BaseControl:ComboBox
            Margin="0,0,0,8"
            Caption="From"
            ItemsSource="{x:Static Resources:EnumProviders.TextureFrom}"
            SelectedItem="{Binding TextureFrom.Value}" />

        <Views:BeatModifierManager DataContext="{Binding BeatModifierManager}" />

    </StackPanel>

</UserControl>
