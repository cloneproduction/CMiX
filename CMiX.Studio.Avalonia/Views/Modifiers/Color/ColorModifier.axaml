<Controls:ModulatablePanel
    x:Class="CMiX.Studio.Avalonia.Views.ColorModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:StudioControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    x:Name="colorModifier"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Views:ModifierModeSelector
            DataContext="{Binding ModifierModeSelector}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=colorModifier}" />

        <ui:ComboBoxCaptioned
            Caption="Color Mode"
            ItemsSource="{x:Static Resources:EnumProviders.ColorMode}"
            ResetCommand="{Binding ColorMode.ResetCommand}"
            SelectedItem="{Binding ColorMode.Value}">
          <ui:ComboBoxCaptioned.TrailingContent>
            <Border Width="{DynamicResource ControlHeightMD}" />
          </ui:ComboBoxCaptioned.TrailingContent>
        </ui:ComboBoxCaptioned>

        <ui:StackPanelPositioned
            Spacing="{DynamicResource SpacingXXS}">

            <StudioControls:DragValueModulatable
                Caption="{Binding DataContext.FirstCaption, ElementName=colorModifier}"
                DataContext="{Binding Hue}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=colorModifier}" />

            <StudioControls:DragValueModulatable
                Caption="{Binding DataContext.SecondCaption, ElementName=colorModifier}"
                DataContext="{Binding Saturation}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=colorModifier}" />

            <StudioControls:DragValueModulatable
                Caption="{Binding DataContext.ThirdCaption, ElementName=colorModifier}"
                DataContext="{Binding Value}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=colorModifier}" />

            <StudioControls:DragValueModulatable
                Caption="Alpha"
                DataContext="{Binding Alpha}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=colorModifier}" />

        </ui:StackPanelPositioned>

    </StackPanel>

</Controls:ModulatablePanel>
