<Modulation:PanelModulatable
    x:Class="CMiX.Studio.Avalonia.Views.AlphaModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    x:Name="alphaModifier"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <Modulation:SliderModulatable
            Caption="Alpha"
            DataContext="{Binding Value}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=alphaModifier}"
            Minimum="0"
            Maximum="1" />

    </StackPanel>

</Modulation:PanelModulatable>
