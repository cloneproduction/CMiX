<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ModifierManager"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Avalonia.Behaviors"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="modifierManager"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <!-- The list is from the library. This control tells it which properties of the manager to show. -->
    <ui:PanelItemList
        ui:ListBoxReorder.Service="{Binding ManagerReorderService}"
        AddCaption="{Binding Caption, ElementName=modifierManager}"
        AddContent="{Binding SelectionPanel, ElementName=modifierManager}"
        ItemsSource="{Binding ManagerData.Items}">

        <ui:PanelItemList.ItemTemplate>
            <DataTemplate>

                <ui:PanelItem
                    Margin="0, 4"
                    Title="{Binding PrefabService.Name.Value}"
                    IsChecked="{Binding PrefabService.Visibility.Value, Mode=TwoWay}"
                    DragHandleIsPressed="{Binding $parent[ItemsControl].DataContext.ManagerReorderService.DragHandleIsPressed}"
                    CloseCommand="{Binding $parent[ItemsControl].DataContext.DeleteItemCommand}"
                    CloseCommandParameter="{Binding}"
                    PanelBackground="{Binding $parent[Views:ModifierManager].PanelBackground}">

                    <i:Interaction.Behaviors>
                        <Behaviors:ModulatorHoverBehavior />
                    </i:Interaction.Behaviors>

                    <ui:PanelItem.Content>
                        <ContentControl Content="{Binding}" />
                    </ui:PanelItem.Content>

                </ui:PanelItem>

            </DataTemplate>
        </ui:PanelItemList.ItemTemplate>

    </ui:PanelItemList>

</UserControl>
