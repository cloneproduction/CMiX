<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Scale"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <StackPanel>

        <BaseControls:DragValue
            Margin="0,0,0,8"
            Caption="Uniform"
            Value="{Binding Uniform.Value}" />

        <BaseControls:VectorXYZ Caption="Scale" DataContext="{Binding XYZ}" />

    </StackPanel>
</UserControl>
