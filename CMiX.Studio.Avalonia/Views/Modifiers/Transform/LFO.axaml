<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LFO"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modifiers="clr-namespace:CMiX.Studio.Avalonia.Views.Modifiers"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources">

    <StackPanel>

        <Modifiers:ModifierModeSelector Margin="0,0,0,8" DataContext="{Binding ModifierModeSelector}" />

        <BaseControl:ComboBox
            Caption="Transform"
            ItemsSource="{x:Static Resources:EnumProviders.TransformType}"
            SelectedItem="{Binding TransformType.Value}" />

        <BaseControl:AxisSelector3D
            Margin="0,1,0,0"
            XIsChecked="{Binding DirectionXYZ.DirectionX.Value}"
            YIsChecked="{Binding DirectionXYZ.DirectionY.Value}"
            ZIsChecked="{Binding DirectionXYZ.DirectionZ.Value}" />

        <Panels:PositionedStackPanel Margin="0,8,0,0">
            <BaseControl:DragValue
                Caption="From"
                Value="{Binding From.Value}" />
            <BaseControl:DragValue
                Margin="0,1,0,0"
                Caption="To"
                Value="{Binding To.Value}" />
        </Panels:PositionedStackPanel>

        <BaseControl:ToggleButton
            Margin="0,8"
            Caption="PingPong"
            IsChecked="{Binding PingPong.Value}" />

        <BaseControl:DragValue
            Margin="0,0,0,8"
            Caption="Randomize Phase"
            Value="{Binding RandomizePhase.Value}" />

        <Views:BeatModifierManager DataContext="{Binding BeatModifierManager}" />

    </StackPanel>

</UserControl>
