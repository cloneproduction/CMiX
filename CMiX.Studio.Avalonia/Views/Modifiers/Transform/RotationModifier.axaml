<Modulation:PanelModulatable
    x:Class="CMiX.Studio.Avalonia.Views.RotationModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="rotationModifier"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Views:ModifierModeSelector
            DataContext="{Binding ModifierModeSelector}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=rotationModifier}" />

        <Modulation:Vector3Modulatable
            Caption="Rotation"
            ModulatorManager="{Binding ModulatorManager}" />

    </StackPanel>

</Modulation:PanelModulatable>
