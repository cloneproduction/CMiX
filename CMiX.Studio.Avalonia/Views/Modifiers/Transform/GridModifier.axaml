<Modulation:PanelModulatable
    x:Class="CMiX.Studio.Avalonia.Views.GridModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="gridModifier"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <Modulation:IntegerValueModulatable
                Caption="Count X"
                DataContext="{Binding Count.X}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=gridModifier}" />

            <Modulation:IntegerValueModulatable
                ui:ControlTitle.Text="Count Y"
                Caption="Y"
                DataContext="{Binding Count.Y}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=gridModifier}" />

            <Modulation:IntegerValueModulatable
                ui:ControlTitle.Text="Count Z"
                Caption="Z"
                DataContext="{Binding Count.Z}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=gridModifier}" />

        </ui:StackPanelPositioned>

        <Modulation:Vector3Modulatable
            Caption="Width"
            DataContext="{Binding Width}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=gridModifier}" />

        <Modulation:Vector3Modulatable
            Caption="Phase"
            DataContext="{Binding Phase}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=gridModifier}" />

    </StackPanel>

</Modulation:PanelModulatable>
