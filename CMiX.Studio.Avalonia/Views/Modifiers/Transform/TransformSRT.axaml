<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignWidth="400"
             x:Class="CMiX.Studio.Avalonia.Views.TransformSRT">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:DragValue
            Caption="Uniform"
            Value="{Binding Uniform.Value}"
            ResetCommand="{Binding Uniform.ResetCommand}" />

        <ui:VectorXYZ
            Caption="Scale"
            DataContext="{Binding Scale}" />

        <ui:VectorXYZ
            Caption="Rotation"
            DataContext="{Binding Rotation}" />

        <ui:VectorXYZ
            Caption="Translate"
            DataContext="{Binding Translate}" />

    </StackPanel>
</UserControl>
