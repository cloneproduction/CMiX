<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Grid"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <StackPanel>

        <BaseControls:Integer3Value Caption="Count" DataContext="{Binding Count}" />

        <BaseControls:VectorXYZ
            Margin="0,8"
            Caption="Width"
            DataContext="{Binding Width}" />

        <BaseControls:VectorXYZ Caption="Phase" DataContext="{Binding Phase}" />

    </StackPanel>

</UserControl>
