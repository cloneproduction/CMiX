<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.CircularSpread"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Modifiers="clr-namespace:CMiX.Studio.Avalonia.Views.Modifiers">

    <StackPanel>

        <Modifiers:ModifierModeSelector DataContext="{Binding ModifierModeSelector}" />

        <BaseControls:Vector2
            Margin="0,8"
            Caption="Width"
            DataContext="{Binding Width}" />

        <Panels:PositionedStackPanel>
            <BaseControls:DragValue
                Margin="0,0,0,1"
                Caption="Phase"
                Value="{Binding Phase.Value}" />

            <BaseControls:DragValue
                Margin="0,0"
                Caption="Factor"
                Value="{Binding Factor.Value}" />
        </Panels:PositionedStackPanel>

    </StackPanel>

</UserControl>
