<Controls:ModulatablePanel
    x:Class="CMiX.Studio.Avalonia.Views.RandomModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="randomModifier"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Views:ModifierModeSelector
            DataContext="{Binding ModifierModeSelector}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=randomModifier}" />

        <ui:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">
            <BaseControls:ModulatableFloatValue
                Caption="Center"
                DataContext="{Binding Center}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=randomModifier}" />

            <BaseControls:ModulatableFloatValue
                Caption="Width"
                DataContext="{Binding Width}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=randomModifier}" />
        </ui:PositionedStackPanel>

        <BaseControls:ModulatableFloatValue
            Caption="Seed"
            DataContext="{Binding Seed}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=randomModifier}" />

    </StackPanel>

</Controls:ModulatablePanel>
