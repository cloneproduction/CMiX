<Controls:ModulatablePanel
    x:Class="CMiX.Studio.Avalonia.Views.TransformSRTModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    x:Name="transformSRTModifier"    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Views:ModifierModeSelector
            DataContext="{Binding ModifierModeSelector}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
        
        <BaseControls:ModulatableFloatValue
            Caption="Uniform"
            DataContext="{Binding ScaleUniform}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />

        <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">
            <BaseControls:ModulatableFloatValue Caption="Scale X" DataContext="{Binding ScaleX}" ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
            <BaseControls:ModulatableFloatValue Caption="Y" DataContext="{Binding ScaleY}" ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
            <BaseControls:ModulatableFloatValue Caption="Z" DataContext="{Binding ScaleZ}" ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
        </Panels:PositionedStackPanel>

        <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">
            <BaseControls:ModulatableFloatValue 
                Caption="Translate X" 
                DataContext="{Binding TranslateX}" 
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
            <BaseControls:ModulatableFloatValue 
                Caption="Y" 
                DataContext="{Binding TranslateY}" 
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
            <BaseControls:ModulatableFloatValue 
                Caption="Z" 
                DataContext="{Binding TranslateZ}" 
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
        </Panels:PositionedStackPanel>

        <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">
            <BaseControls:ModulatableFloatValue Caption="Rotation X" DataContext="{Binding RotationX}" ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
            <BaseControls:ModulatableFloatValue Caption="Y" DataContext="{Binding RotationY}" ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
            <BaseControls:ModulatableFloatValue Caption="Z" DataContext="{Binding RotationZ}" ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
        </Panels:PositionedStackPanel>

        <BaseControls:AxisSelector3D
            Caption="Flip"
            XIsChecked="{Binding DirectionXYZ.DirectionX.Value}"
            YIsChecked="{Binding DirectionXYZ.DirectionY.Value}"
            ZIsChecked="{Binding DirectionXYZ.DirectionZ.Value}" />

    </StackPanel>

</Controls:ModulatablePanel>
