<Modulation:PanelModulatable
    x:Class="CMiX.Studio.Avalonia.Views.TransformSRTModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="transformSRTModifier"    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Views:ModifierModeSelector
            DataContext="{Binding ModifierModeSelector}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
        
        <Modulation:DragValueModulatable
            Caption="Uniform"
            DataContext="{Binding ScaleUniform}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">
            <Modulation:DragValueModulatable Caption="Scale X" DataContext="{Binding ScaleX}" ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
            <Modulation:DragValueModulatable ui:ControlTitle.Text="Scale Y" Caption="Y" DataContext="{Binding ScaleY}" ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
            <Modulation:DragValueModulatable ui:ControlTitle.Text="Scale Z" Caption="Z" DataContext="{Binding ScaleZ}" ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
        </ui:StackPanelPositioned>

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">
            <Modulation:DragValueModulatable 
                Caption="Translate X" 
                DataContext="{Binding TranslateX}" 
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
            <Modulation:DragValueModulatable 
                ui:ControlTitle.Text="Translate Y" 
                Caption="Y" 
                DataContext="{Binding TranslateY}" 
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
            <Modulation:DragValueModulatable 
                ui:ControlTitle.Text="Translate Z" 
                Caption="Z" 
                DataContext="{Binding TranslateZ}" 
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
        </ui:StackPanelPositioned>

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">
            <Modulation:DragValueModulatable Caption="Rotation X" DataContext="{Binding RotationX}" ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
            <Modulation:DragValueModulatable ui:ControlTitle.Text="Rotation Y" Caption="Y" DataContext="{Binding RotationY}" ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
            <Modulation:DragValueModulatable ui:ControlTitle.Text="Rotation Z" Caption="Z" DataContext="{Binding RotationZ}" ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformSRTModifier}" />
        </ui:StackPanelPositioned>

        <ui:AxisSelector3
            Caption="Flip"
            XIsChecked="{Binding DirectionXYZ.DirectionX.Value}"
            YIsChecked="{Binding DirectionXYZ.DirectionY.Value}"
            ZIsChecked="{Binding DirectionXYZ.DirectionZ.Value}" />

    </StackPanel>

</Modulation:PanelModulatable>
