<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TransformSRTModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <StackPanel>

        <BaseControls:DragValue
            Margin="0"
            Caption="Uniform Scale"
            Value="{Binding Uniform.Value}" />

        <BaseControls:VectorXYZ
            Margin="0, 8, 0, 0"
            Caption="Scale"
            DataContext="{Binding Scale.XYZ}" />

        <BaseControls:VectorXYZ
            Margin="0, 8"
            Caption="Rotation"
            DataContext="{Binding Rotation.XYZ}" />

        <BaseControls:VectorXYZ
            Caption="Translate"
            DataContext="{Binding Translate.XYZ}" />

        <BaseControls:AxisSelector3D
            Margin="0, 8, 0, 0"
            Caption="Flip"
            XIsChecked="{Binding DirectionXYZ.DirectionX.Value}"
            YIsChecked="{Binding DirectionXYZ.DirectionY.Value}"
            ZIsChecked="{Binding DirectionXYZ.DirectionZ.Value}" />
    </StackPanel>

</UserControl>
