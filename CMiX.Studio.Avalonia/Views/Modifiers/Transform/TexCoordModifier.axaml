<Modulation:PanelModulatable
    x:Class="CMiX.Studio.Avalonia.Views.TexCoordModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="texCoordModifier"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Views:ModifierModeSelector
            DataContext="{Binding ModifierModeSelector}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=texCoordModifier}" />

        <Modulation:DragValueModulatable
            Caption="Uniform"
            DataContext="{Binding Uniform}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=texCoordModifier}" />

        <Modulation:Vector2Modulatable
            Caption="Scale"
            DataContext="{Binding Scale}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=texCoordModifier}" />

        <Modulation:DragValueModulatable
            Caption="Rotation"
            DataContext="{Binding Rotation}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=texCoordModifier}" />

        <Modulation:Vector2Modulatable
            Caption="Translate"
            DataContext="{Binding Location}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=texCoordModifier}" />


    </StackPanel>

</Modulation:PanelModulatable>
