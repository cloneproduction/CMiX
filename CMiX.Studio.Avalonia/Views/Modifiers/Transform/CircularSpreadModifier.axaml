<Modulation:ModulatablePanel
    x:Class="CMiX.Studio.Avalonia.Views.CircularSpreadModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="circularSpreadModifier"    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Views:ModifierModeSelector
            DataContext="{Binding ModifierModeSelector}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=circularSpreadModifier}" />

        <Modulation:Vector2Modulatable
            Caption="Width"
            ModulatorManager="{Binding ModulatorManager}" />

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <Modulation:DragValueModulatable
                Caption="Phase"
                DataContext="{Binding Phase}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=circularSpreadModifier}" />

            <Modulation:DragValueModulatable
                Caption="Factor"
                DataContext="{Binding Factor}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=circularSpreadModifier}" />

        </ui:StackPanelPositioned>

    </StackPanel>

</Modulation:ModulatablePanel>
