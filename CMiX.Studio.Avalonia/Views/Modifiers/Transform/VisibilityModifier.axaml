<Modulation:PanelModulatable
    x:Class="CMiX.Studio.Avalonia.Views.VisibilityModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="visibilityModifier"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <Modulation:ToggleButtonModulatable
            Caption="Visible"
            DataContext="{Binding Visible}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=visibilityModifier}" />

    </StackPanel>

</Modulation:PanelModulatable>
