<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Modifiers.ModifierModeSelector"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Converters="clr-namespace:CMiX.Studio.Avalonia.Converters"
    xmlns:Modifiers="clr-namespace:CMiX.Core.Modifiers;assembly=CMiX.Core"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources">

    <Panels:PositionedStackPanel>

        <BaseControls:ComboBox
            Margin="0,0,0,1"
            Caption="Type"
            ItemsSource="{x:Static Resources:EnumProviders.ModifierMode}"
            SelectedItem="{Binding Mode.Value}" />

        <BaseControls:DragValue
            Caption="Count"
            IsEnabled="{Binding Mode.Value, Converter={x:Static Converters:EnumMatchConverter.Instance}, ConverterParameter={x:Static Modifiers:ModifierMode.ToSpread}}"
            IsInteger="True"
            LargeChange="1.0"
            Minimum="1"
            SmallChange="1.0"
            Value="{Binding Count.Value}" />

    </Panels:PositionedStackPanel>
</UserControl>