<StudioControls:ModulatorAssignableUserControl
    x:Class="CMiX.Studio.Avalonia.Views.ModifierModeSelector"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:StudioControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Modifiers="clr-namespace:CMiX.Core.Modifiers;assembly=CMiX.Core"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    x:Name="modifierModeSelector"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

        <ui:ComboBoxCaptioned
            Caption="Type"
            ItemsSource="{x:Static Resources:EnumProviders.ModifierMode}"
            ResetCommand="{Binding Mode.ResetCommand}"
            SelectedItem="{Binding Mode.Value}">
          <ui:ComboBoxCaptioned.TrailingContent>
            <Border Width="{DynamicResource ControlHeightMD}" />
          </ui:ComboBoxCaptioned.TrailingContent>
        </ui:ComboBoxCaptioned>
            
        <StudioControls:ModulatableIntegerValue
            Caption="Count"
            DataContext="{Binding Count}"
            IsEnabled="{Binding DataContext.Mode.Value, ElementName=modifierModeSelector, Converter={x:Static ui:EnumMatchConverter.Instance}, ConverterParameter={x:Static Modifiers:ModifierMode.ToSpread}}"
            ModulatorManager="{Binding ModulatorManager, ElementName=modifierModeSelector}" />

    </ui:StackPanelPositioned>

</StudioControls:ModulatorAssignableUserControl>