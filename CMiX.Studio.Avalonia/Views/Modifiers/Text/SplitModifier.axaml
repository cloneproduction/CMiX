<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.SplitModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Modifiers="clr-namespace:CMiX.Core.Text.Modifiers;assembly=CMiX.Core"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources">
    <StackPanel>

        <ui:ComboBoxCaptioned
            Margin="0,0,0,8"
            Caption="Type"
            ItemsSource="{x:Static Resources:EnumProviders.SplitType}"
            ResetCommand="{Binding Type.ResetCommand}"
            SelectedItem="{Binding Type.Value}" />

        <Grid IsEnabled="{Binding Type.Value, Converter={x:Static ui:EnumMatchConverter.Instance}, ConverterParameter={x:Static Modifiers:SplitType.Separator}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40*" />
                <ColumnDefinition Width="60*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Padding="0,0,8,0"
                HorizontalAlignment="Right"
                Text="Separator" />
            <TextBox
                Grid.Column="1"
                Theme="{StaticResource TextBoxTypeWriter}"
                Text="{Binding Separator.Value}" />
        </Grid>

    </StackPanel>
</UserControl>