<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.DiffuseTexture"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Texturing="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Avalonia.Behaviors"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity">

    <StackPanel>
        <Managers:PrefabSlotManager
            Margin="{DynamicResource SpacingMD}"
            DataContext="{Binding TextureManager}"
            ItemsSource="{Binding $parent[Window].DataContext.ControlRepository.Textures}">

            <i:Interaction.Behaviors>
                <Behaviors:TextureDropBehavior PrefabManager="{Binding}" />
            </i:Interaction.Behaviors>

            <Managers:PrefabSlotManager.SelectionPanel>
                <Managers:ButtonOpenSelectionPanel Caption="Add Texture">
                    <Managers:ButtonOpenSelectionPanel.SelectionPanel>
                        <Managers:AutoSelectionPanel Interface="{x:Type Texturing:ITextureSource}" />
                    </Managers:ButtonOpenSelectionPanel.SelectionPanel>
                </Managers:ButtonOpenSelectionPanel>
            </Managers:PrefabSlotManager.SelectionPanel>

        </Managers:PrefabSlotManager>

        <!-- The WPF style trigger that collapsed this border when no texture is selected becomes an IsVisible binding. -->
        <Border IsVisible="{Binding TextureManager.SelectedItem, Converter={StaticResource NullToVisibility}}">
            <Views:Texture DataContext="{Binding TextureManager.SelectedItem}" />
        </Border>

    </StackPanel>

</UserControl>
