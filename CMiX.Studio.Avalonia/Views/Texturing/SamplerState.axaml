<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.SamplerState"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <ui:ComboBoxCaptioned
                Caption="Address U"
                ItemsSource="{x:Static Resources:EnumProviders.TextureAddressMode}"
                ResetCommand="{Binding AddressU.ResetCommand}"
                SelectedItem="{Binding AddressU.Value}" />

            <ui:ComboBoxCaptioned
                Caption="V"
                ItemsSource="{x:Static Resources:EnumProviders.TextureAddressMode}"
                ResetCommand="{Binding AddressV.ResetCommand}"
                SelectedItem="{Binding AddressV.Value}" />

        </ui:StackPanelPositioned>

        <ui:ColorSelector
            Caption="Border Color"
            DataContext="{Binding BorderColor}" />

    </StackPanel>

</UserControl>
