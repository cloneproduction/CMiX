<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.SamplerState"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <BaseControls:CaptionedComboBox
                Caption="Address U"
                ItemsSource="{x:Static Resources:EnumProviders.TextureAddressMode}"
                SelectedItem="{Binding AddressU.Value}" />

            <BaseControls:CaptionedComboBox
                Caption="V"
                ItemsSource="{x:Static Resources:EnumProviders.TextureAddressMode}"
                SelectedItem="{Binding AddressV.Value}" />

        </Panels:PositionedStackPanel>

        <BaseControls:ColorSelector
            Caption="Border Color"
            DataContext="{Binding BorderColor}" />

    </StackPanel>

</UserControl>
