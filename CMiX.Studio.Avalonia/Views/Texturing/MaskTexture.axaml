<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.MaskTexture"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    d:DesignHeight="600">

    <StackPanel 
      Margin="8" 
      IsEnabled="{Binding Path=IsEnabled.Value, Mode=OneWay}">

        <Views:DiffuseTexture />

        <ui:ComboBoxCaptioned
            Margin="8,0"
            Caption="MaskChannel"
            ItemsSource="{x:Static Resources:EnumProviders.MaskChannel}"
            ResetCommand="{Binding MaskChannel.ResetCommand}"
            SelectedItem="{Binding MaskChannel.Value}" />

        <ui:ToggleButtonCaptioned
            Margin="8"
            Caption="Invert"
            IsChecked="{Binding Invert.Value}"
            ResetCommand="{Binding Invert.ResetCommand}" />
      
      <ui:ExpanderIndented 
        Indentation="4"
        Header="Transform" 
        IsExpanded="{Binding IsExpanded}">
        
        <StackPanel Spacing="{DynamicResource SpacingMD}">
          
          <Views:Transform2D
            DataContext="{Binding Transform2D}"  />

          <Views:SamplerState
            DataContext="{Binding SamplerState}"/>
          
        </StackPanel>

      </ui:ExpanderIndented>
      
    </StackPanel>

</UserControl>
