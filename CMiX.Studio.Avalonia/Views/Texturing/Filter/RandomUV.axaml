<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.RandomUV"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel>

        <Views:UVTransformEditor />

        <Views:BeatModifierManager
            DataContext="{Binding BeatModifierManager}" />

    </StackPanel>
</Views:FilterPanel>
