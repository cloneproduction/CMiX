<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Kaleidoscope"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:StudioControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    x:Name="kaleidoscope">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:IntegerValue
            Caption="Divisions"
            DataContext="{Binding Divisions}"
            Minimum="1"
            Value="{Binding Value}" />

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <ui:IntegerValue
                Caption="Iterations"
                DataContext="{Binding Iterations}"
                Minimum="1"
                Value="{Binding Value}" />

            <StudioControls:ModulatableFloatValue
                Caption="Iteration Zoom"
                DataContext="{Binding IterationZoom}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=kaleidoscope}" />

        </ui:StackPanelPositioned>

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <StudioControls:ModulatableFloatValue
                Caption="Rotation"
                DataContext="{Binding Rotation}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=kaleidoscope}" />

            <StudioControls:ModulatableFloatValue
                Caption="Zoom"
                DataContext="{Binding Zoom}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=kaleidoscope}" />

        </ui:StackPanelPositioned>

        <StudioControls:ModulatableVectorXY
            Caption="Center"
            DataContext="{Binding Center}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=kaleidoscope}" />

        <StudioControls:ModulatableFloatValue
            Caption="Cell Rotation"
            DataContext="{Binding CellRotation}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=kaleidoscope}" />

        <StudioControls:ModulatableVectorXY
            Caption="Cell Offset"
            DataContext="{Binding CellOffset}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=kaleidoscope}" />

        <StudioControls:ModulatableVectorXY
            Caption="Cell Scale"
            DataContext="{Binding CellScale}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=kaleidoscope}" />

    </StackPanel>

</Views:FilterPanel>
