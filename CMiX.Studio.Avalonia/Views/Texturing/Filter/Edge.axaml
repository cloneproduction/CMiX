<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Edge"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Views:FilterPanel>
        <Panels:PositionedStackPanel>

            <Controls:CMiXSlider
                Caption="Radius"
                Maximum="10"
                Minimum="0"
                Value="{Binding Radius.Value}" />

            <Controls:CMiXSlider
                Margin="0,1,0,0"
                Caption="Brightness"
                Maximum="10"
                Minimum="0"
                Value="{Binding Brightness.Value}" />

        </Panels:PositionedStackPanel>
    </Views:FilterPanel>

</UserControl>
