<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Edge"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="edge">

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

        <Controls:ModulatableFloatSlider
            Caption="Radius"
            DataContext="{Binding Radius}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=edge}" />

        <Controls:ModulatableFloatSlider
            Caption="Brightness"
            DataContext="{Binding Brightness}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=edge}" />

    </ui:StackPanelPositioned>

</Views:FilterPanel>
