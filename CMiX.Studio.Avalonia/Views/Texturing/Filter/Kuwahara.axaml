<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Kuwahara"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:StudioControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="kuwahara">

    <StackPanel>

        <ui:ComboBoxCaptioned
            Caption="Type"
            ItemsSource="{x:Static Resources:EnumProviders.KuwaharaType}"
            ResetCommand="{Binding Type.ResetCommand}"
            SelectedItem="{Binding Type.Value}" />

        <StudioControls:SliderModulatable
            Margin="0,8,0,0"
            Caption="Radius"
            DataContext="{Binding Radius}"
            Maximum="10"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=kuwahara}" />

    </StackPanel>

</Views:FilterPanel>
