<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Kuwahara"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel>

        <Controls:ComboBox
            Caption="Type"
            ItemsSource="{x:Static Resources:EnumProviders.KuwaharaType}"
            SelectedItem="{Binding Type.Value}" />

        <Controls:DragValue
            Margin="0,8,0,0"
            Caption="Radius"
            Maximum="10"
            Minimum="0"
            Value="{Binding Radius.Value}"
            ResetCommand="{Binding Radius.ResetCommand}" />

    </StackPanel>

</Views:FilterPanel>
