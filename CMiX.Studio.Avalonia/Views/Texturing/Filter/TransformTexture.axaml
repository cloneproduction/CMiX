<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.TransformTexture"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Modulators="clr-namespace:CMiX.Core.Modulation.Modulators;assembly=CMiX.Core"
    x:Name="transformTexture">

    <StackPanel>

        <Views:ModifierManager
            Margin="0,0,0,8"
            Caption="Add Modulator"
            PanelBackground="{DynamicResource Grey400Brush}"
            DataContext="{Binding ModulatorManager}">
            <Views:ModifierManager.SelectionPanel>
                <Managers:AutoSelectionPanel Interface="{x:Type Modulators:IModulator}" />
            </Views:ModifierManager.SelectionPanel>
        </Views:ModifierManager>

        <BaseControls:ModulatableFloatValue
            Caption="Uniform"
            DataContext="{Binding Uniform}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformTexture}" />

        <BaseControls:ModulatableVectorXY
            Caption="Scale"
            DataContext="{Binding Scale}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformTexture}" />

        <BaseControls:ModulatableFloatValue
            Caption="Rotation"
            DataContext="{Binding Rotation}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformTexture}" />

        <BaseControls:ModulatableVectorXY
            Caption="Translate"
            DataContext="{Binding Location}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=transformTexture}" />

        <Views:SamplerState
            Margin="0,8,0,0"
            DataContext="{Binding SamplerState}" />

    </StackPanel>

</Views:FilterPanel>
