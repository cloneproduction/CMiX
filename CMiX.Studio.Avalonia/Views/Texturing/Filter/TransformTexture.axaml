<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.TransformTexture"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel>
        <Views:Transform2D DataContext="{Binding Transform2D}" />
        <Views:SamplerState
            Margin="0,8,0,0"
            DataContext="{Binding SamplerState}" />
    </StackPanel>

</Views:FilterPanel>
