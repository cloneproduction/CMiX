<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.ShiftRGB"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="shiftRGB">

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

        <Modulation:SliderModulatable
            Caption="Direction"
            DataContext="{Binding Direction}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=shiftRGB}" />

        <Modulation:SliderModulatable
            Caption="Shift"
            DataContext="{Binding Shift}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=shiftRGB}" />

        <Modulation:SliderModulatable
            Caption="Hue"
            DataContext="{Binding Hue}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=shiftRGB}" />

    </ui:StackPanelPositioned>

</Views:FilterPanel>
