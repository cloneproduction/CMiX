<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.ShiftRGB"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

        <BaseControls:DragValue
            Caption="Direction"
            Value="{Binding Direction.Value}"
            ResetCommand="{Binding Direction.ResetCommand}" />

        <BaseControls:DragValue
            Caption="Shift"
            Value="{Binding Shift.Value}"
            ResetCommand="{Binding Shift.ResetCommand}" />

        <BaseControls:DragValue
            Caption="Hue"
            Value="{Binding Hue.Value}"
            ResetCommand="{Binding Hue.ResetCommand}" />

    </Panels:PositionedStackPanel>

</Views:FilterPanel>
