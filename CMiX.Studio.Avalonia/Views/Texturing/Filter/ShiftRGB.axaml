<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.ShiftRGB"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="shiftRGB">

    <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

        <BaseControls:ModulatableFloatSlider
            Caption="Direction"
            DataContext="{Binding Direction}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=shiftRGB}" />

        <BaseControls:ModulatableFloatSlider
            Caption="Shift"
            DataContext="{Binding Shift}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=shiftRGB}" />

        <BaseControls:ModulatableFloatSlider
            Caption="Hue"
            DataContext="{Binding Hue}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=shiftRGB}" />

    </Panels:PositionedStackPanel>

</Views:FilterPanel>
