<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ShiftRGB"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Views:FilterPanel>
        <Panels:PositionedStackPanel>

            <BaseControls:DragValue
                Caption="Direction"
                Value="{Binding Direction.Value}" />

            <BaseControls:DragValue
                Margin="0,1"
                Caption="Shift"
                Value="{Binding Shift.Value}" />

            <BaseControls:DragValue
                Caption="Hue"
                Value="{Binding Hue.Value}" />

        </Panels:PositionedStackPanel>
    </Views:FilterPanel>

</UserControl>
