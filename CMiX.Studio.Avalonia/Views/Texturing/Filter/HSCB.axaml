<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.HSCB"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="hscb">

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

        <Controls:ModulatableFloatSlider
            Caption="Hue"
            DataContext="{Binding Hue}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=hscb}" />

        <Controls:ModulatableFloatSlider
            Caption="Saturation"
            DataContext="{Binding Saturation}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=hscb}" />

        <Controls:ModulatableFloatSlider
            Caption="Contrast"
            DataContext="{Binding Contrast}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=hscb}" />

        <Controls:ModulatableFloatSlider
            Caption="Brightness"
            DataContext="{Binding Brightness}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=hscb}" />

    </ui:StackPanelPositioned>

</Views:FilterPanel>
