<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.HSCB"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Panels:PositionedStackPanel Margin="0,8,0,0" Spacing="{DynamicResource SpacingXXS}">

        <Controls:DragValue
            Caption="Hue"
            Value="{Binding Hue.Value}" />

        <Controls:DragValue
            Caption="Saturation"
            Value="{Binding Saturation.Value}" />

        <Controls:DragValue
            Caption="Contrast"
            Value="{Binding Contrast.Value}" />

        <Controls:DragValue
            Height="{DynamicResource ControlHeightMD}"
            Caption="Brightness"
            Value="{Binding Brightness.Value}" />

    </Panels:PositionedStackPanel>

</Views:FilterPanel>
