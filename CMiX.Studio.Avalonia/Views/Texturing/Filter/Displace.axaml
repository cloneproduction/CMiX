<Views:PanelFilter
    x:Class="CMiX.Studio.Avalonia.Views.Displace"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:TextureSources="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    x:Name="displace">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

      <Controls:SelectorPrefab
        DataContext="{Binding TextureSelector}"
        ItemsSource="{Binding ControlRepository.Textures}">

        <Controls:SelectorPrefab.AddContent>
          <ui:ButtonPopup Caption="New Control Texture">
            <ui:ButtonPopup.PopupContent>
              <Managers:PanelAddTypes Interface="{x:Type TextureSources:ITextureSource}" />
            </ui:ButtonPopup.PopupContent>
          </ui:ButtonPopup>
        </Controls:SelectorPrefab.AddContent>

      </Controls:SelectorPrefab>
      
        <Modulation:Vector2Modulatable
            Caption="Offset"
            DataContext="{Binding Offset}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=displace}" />

        <Modulation:Vector2Modulatable
            Caption="OffsetScale"
            DataContext="{Binding OffsetScale}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=displace}" />

    </StackPanel>

</Views:PanelFilter>
