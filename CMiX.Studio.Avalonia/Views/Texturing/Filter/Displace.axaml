<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Displace"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Texturing="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel>

        <Controls:Vector2
            Caption="Offset"
            DataContext="{Binding Offset}" />

        <Controls:Vector2
            Margin="0,8,0,0"
            Caption="OffsetScale"
            DataContext="{Binding OffsetScale}" />

        <Controls:Outliner
            Margin="0,8,0,0"
            DataContext="{Binding TextureSelector}"
            ItemsSource="{Binding ControlRepository.Textures}">

            <Controls:Outliner.SelectionPanel>
                <Managers:ButtonOpenSelectionPanel Caption="New Control Texture">
                    <Managers:ButtonOpenSelectionPanel.SelectionPanel>
                        <Managers:AutoSelectionPanel Interface="{x:Type Texturing:ITextureSource}" />
                    </Managers:ButtonOpenSelectionPanel.SelectionPanel>
                </Managers:ButtonOpenSelectionPanel>
            </Controls:Outliner.SelectionPanel>

        </Controls:Outliner>

    </StackPanel>

</Views:FilterPanel>
