<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Displace"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Texturing="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Views:FilterPanel>
        <StackPanel>

            <Controls:Vector2
                Caption="Offset"
                DataContext="{Binding Offset}" />

            <Controls:Vector2
                Margin="0,8,0,0"
                Caption="OffsetScale"
                DataContext="{Binding OffsetScale}" />

            <Views:Outliner
                Margin="0,8,0,0"
                DataContext="{Binding TextureSelector}"
                ItemsSource="{Binding ControlRepository.Textures}">

                <Views:Outliner.SelectionPanel>
                    <Views:ButtonOpenSelectionPanel Caption="New Control Texture">
                        <Views:ButtonOpenSelectionPanel.SelectionPanel>
                            <Views:AutoSelectionPanel Interface="{x:Type Texturing:ITextureSource}" />
                        </Views:ButtonOpenSelectionPanel.SelectionPanel>
                    </Views:ButtonOpenSelectionPanel>
                </Views:Outliner.SelectionPanel>

            </Views:Outliner>

        </StackPanel>
    </Views:FilterPanel>

</UserControl>
