<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Dither"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="dither">


        <Modulation:SliderModulatable
            Caption="Threshold"
            DataContext="{Binding Threshold}"
            Maximum="1"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=dither}" />


</Views:FilterPanel>
