<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Dither"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel>
        <Controls:DragValue
            Caption="Threshold"
            Value="{Binding Threshold.Value}" />
    </StackPanel>

</Views:FilterPanel>
