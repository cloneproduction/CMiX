<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Feedback"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="feedback">

    <Modulation:SliderModulatable
        Caption="Factor"
        DataContext="{Binding Factor}"
        Maximum="1"
        Minimum="0"
        ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=feedback}" />

</Views:FilterPanel>
