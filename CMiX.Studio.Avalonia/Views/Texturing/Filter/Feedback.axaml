<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Feedback"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <BaseControls:CMiXSlider
        Caption="Factor"
        Maximum="1"
        Minimum="0"
        Value="{Binding Factor.Value}"
        ResetCommand="{Binding Factor.ResetCommand}" />

</Views:FilterPanel>
