<HeaderedContentControl
    x:Class="CMiX.Studio.Avalonia.Views.FilterPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.Avalonia.AttachedProperties"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Modulators="clr-namespace:CMiX.Core.Modulation.Modulators;assembly=CMiX.Core"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignHeight="500"
    d:DesignWidth="400">

    <HeaderedContentControl.Header>
        <StackPanel Spacing="{DynamicResource SpacingMD}">

          <Views:ModifierManager 
            Caption="Add Modulator"
            PanelBackground="{DynamicResource Grey400Brush}"
            DataContext="{Binding ModulatorManager}">
            <Views:ModifierManager.SelectionPanel>
              
              <Managers:AutoSelectionPanel Interface="{x:Type Modulators:IModulator}" />
              
            </Views:ModifierManager.SelectionPanel>
          </Views:ModifierManager>
          
          <Panels:IndentedExpander 
            Background="{DynamicResource Grey300Brush}">

            <Panels:IndentedExpander.Header>

              <DockPanel>

                <Controls:CMiXToggleButton
                    Width="14"
                    Height="14"
                    IsChecked="{Binding Blend.IsEnabled.Value}"
                    ResetCommand="{Binding Blend.IsEnabled.ResetCommand}"
                    Theme="{DynamicResource ToggleButtonRounded}" />

                <TextBlock
                    Margin="8,0"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Text="Blend" />

              </DockPanel>

            </Panels:IndentedExpander.Header>

              <StackPanel
                  IsEnabled="{Binding Blend.IsEnabled.Value}"
                  Spacing="{DynamicResource SpacingMD}">

                <Controls:CMiXSlider
                    AttachedProperties:PositionedControl.Position="All"
                    Caption="Opacity"
                    Maximum="1"
                    Minimum="0"
                    Value="{Binding Blend.Opacity.Value}"
                    ResetCommand="{Binding Blend.Opacity.ResetCommand}" />

                <Controls:CaptionedComboBox
                    Caption="Blend Mode"
                    ItemsSource="{x:Static Resources:EnumProviders.BlendMode}"
                    SelectedItem="{Binding Blend.BlendMode.Value}" />

              </StackPanel>
            
            </Panels:IndentedExpander>

        </StackPanel>
      
    </HeaderedContentControl.Header>

    <HeaderedContentControl.Template>
        <ControlTemplate TargetType="Views:FilterPanel">

            <StackPanel Spacing="4">

                <ContentPresenter
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                <ContentPresenter
                    Content="{TemplateBinding Header}"
                    ContentTemplate="{TemplateBinding HeaderTemplate}" />

            </StackPanel>

        </ControlTemplate>
    </HeaderedContentControl.Template>

</HeaderedContentControl>
