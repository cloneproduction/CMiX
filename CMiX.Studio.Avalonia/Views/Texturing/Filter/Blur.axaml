<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Blur"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="blur">

    <Modulation:SliderModulatable
        Caption="Strength"
        DataContext="{Binding Strength}"
        Maximum="1"
        Minimum="0"
        ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=blur}" />

</Views:FilterPanel>
