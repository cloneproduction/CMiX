<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Invert"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="invert">

    <StackPanel>

        <Controls:SliderModulatable
            Caption="Factor"
            DataContext="{Binding Factor}"
            Maximum="1.0"
            Minimum="0.0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=invert}" />

        <ui:ComboBoxCaptioned
            Margin="0,8"
            Caption="Channel"
            ItemsSource="{x:Static Resources:EnumProviders.InvertChannel}"
            ResetCommand="{Binding InvertChannelSelector.ResetCommand}"
            SelectedItem="{Binding InvertChannelSelector.Value}" />

        <ui:ToggleButtonCaptioned
            Caption="Invert Alpha"
            IsChecked="{Binding InvertAlpha.Value}"
            ResetCommand="{Binding InvertAlpha.ResetCommand}" />

    </StackPanel>

</Views:FilterPanel>
