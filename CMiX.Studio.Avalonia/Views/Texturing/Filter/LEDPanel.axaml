<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.LEDPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

        <Controls:DragValue
            Caption="Pixel Size"
            Minimum="0"
            Value="{Binding PixelSize.Value}"
            ResetCommand="{Binding PixelSize.ResetCommand}" />

        <Controls:DragValue
            Caption="Mask Stagger"
            Minimum="0"
            Value="{Binding MaskStagger.Value}"
            ResetCommand="{Binding MaskStagger.ResetCommand}" />

        <Controls:DragValue
            Caption="Mask Border"
            Minimum="0"
            Value="{Binding MaskBorder.Value}"
            ResetCommand="{Binding MaskBorder.ResetCommand}" />

        <Controls:DragValue
            Caption="Mask Intensity"
            Minimum="0"
            Value="{Binding MaskIntensity.Value}"
            ResetCommand="{Binding MaskIntensity.ResetCommand}" />

    </Panels:PositionedStackPanel>

</Views:FilterPanel>
