<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.LEDPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Panels:PositionedStackPanel>

        <Controls:DragValue
            Caption="Pixel Size"
            Minimum="0"
            Value="{Binding PixelSize.Value}" />

        <Controls:DragValue
            Margin="0,1,0,0"
            Caption="Mask Stagger"
            Minimum="0"
            Value="{Binding MaskStagger.Value}" />

        <Controls:DragValue
            Margin="0,1,0,0"
            Caption="Mask Border"
            Minimum="0"
            Value="{Binding MaskBorder.Value}" />

        <Controls:DragValue
            Margin="0,1,0,0"
            Caption="Mask Intensity"
            Minimum="0"
            Value="{Binding MaskIntensity.Value}" />

    </Panels:PositionedStackPanel>

</Views:FilterPanel>
