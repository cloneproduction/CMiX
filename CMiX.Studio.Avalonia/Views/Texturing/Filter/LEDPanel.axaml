<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.LEDPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="ledPanel">

    <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

        <Controls:ModulatableDragValue
            Caption="Pixel Size"
            DataContext="{Binding PixelSize}"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=ledPanel}" />

        <Controls:ModulatableDragValue
            Caption="Mask Stagger"
            DataContext="{Binding MaskStagger}"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=ledPanel}" />

        <Controls:ModulatableDragValue
            Caption="Mask Border"
            DataContext="{Binding MaskBorder}"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=ledPanel}" />

        <Controls:ModulatableDragValue
            Caption="Mask Intensity"
            DataContext="{Binding MaskIntensity}"
            Minimum="0"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=ledPanel}" />

    </Panels:PositionedStackPanel>

</Views:FilterPanel>
