<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Ascii"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    x:Name="ascii">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Controls:ModulatableDragValue
            Caption="Grid Size"
            DataContext="{Binding GridSize}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=ascii}" />

        <Controls:ModulatableVectorXY
            Caption="Character Size"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=ascii}" />

        <Controls:ToggleButton
            Caption="Grayscale"
            IsChecked="{Binding Grayscale.Value}" />

    </StackPanel>

</Views:FilterPanel>
