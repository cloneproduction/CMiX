<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Ascii"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    x:Name="ascii">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Modulation:DragValueModulatable
            Caption="Grid Size"
            DataContext="{Binding GridSize}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=ascii}" />

        <Modulation:Vector2Modulatable
            Caption="Character Size"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=ascii}" />

        <ui:ToggleButtonCaptioned
            Caption="Grayscale"
            IsChecked="{Binding Grayscale.Value}"
            ResetCommand="{Binding Grayscale.ResetCommand}" />

    </StackPanel>

</Views:FilterPanel>
