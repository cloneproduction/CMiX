<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Threshold"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:StudioControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    x:Name="threshold"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

  <StackPanel>

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

      <StudioControls:ModulatableFloatValue
          Caption="Threshold"
          DataContext="{Binding ThresholdValue}"
          Minimum="0"
          ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=threshold}" />

      <StudioControls:ModulatableFloatValue
          Caption="Smooth"
          DataContext="{Binding Smooth}"
          Minimum="0"
          ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=threshold}" />

    </ui:StackPanelPositioned>

    <ui:StackPanelPositioned Margin="0,8" Spacing="{DynamicResource SpacingXXS}">

      <ui:ColorSelector
          Caption="Foreground"
          DataContext="{Binding Foreground}" />

      <ui:ColorSelector
          Caption="Background"
          DataContext="{Binding Background}" />

    </ui:StackPanelPositioned>

    <ui:ToggleButtonCaptioned
        Caption="Invert"
        IsChecked="{Binding Invert.Value}"
        ResetCommand="{Binding Invert.ResetCommand}" />

    <ui:ToggleButtonCaptioned
        Caption="Antialiasing"
        IsChecked="{Binding Antialiasing.Value}"
        ResetCommand="{Binding Antialiasing.ResetCommand}" />

  </StackPanel>

</Views:FilterPanel>
