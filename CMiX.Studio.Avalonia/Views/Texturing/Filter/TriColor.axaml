<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.TriColor"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:StudioControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    x:Name="triColor">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <ui:ColorSelector
                Caption="Color A"
                DataContext="{Binding ColorA}" />

            <ui:ColorSelector
                Caption="Color B"
                DataContext="{Binding ColorB}" />

            <ui:ColorSelector
                Caption="Color C"
                DataContext="{Binding ColorC}" />

        </ui:StackPanelPositioned>

        <ui:ToggleButtonCaptioned
            Caption="Single Channel"
            IsChecked="{Binding SingleChannel.Value}"
            ResetCommand="{Binding SingleChannel.ResetCommand}" />

        <ui:ToggleButtonCaptioned
            Caption="Clamp Color"
            IsChecked="{Binding ClampColor.Value}"
            ResetCommand="{Binding ClampColor.ResetCommand}" />

        <ui:StackPanelPositioned
            Spacing="{DynamicResource SpacingXXS}">

            <StudioControls:SliderModulatable
                Caption="Smooth"
                DataContext="{Binding Smooth}"
                Maximum="1.0"
                Minimum="0.0"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=triColor}" />

            <StudioControls:SliderModulatable
                Caption="Center"
                DataContext="{Binding Center}"
                Maximum="1.0"
                Minimum="0.0"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=triColor}" />

        </ui:StackPanelPositioned>

    </StackPanel>

</Views:FilterPanel>
