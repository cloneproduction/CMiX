<Views:FilterPanel
    x:Class="CMiX.Studio.Avalonia.Views.Pixelate"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

        <Controls:CMiXSlider
            Caption="Factor X"
            Maximum="1"
            Minimum="0"
            Value="{Binding Factor.X.Value}" />

        <Controls:CMiXSlider
            Caption="Factor Y"
            Maximum="1"
            Minimum="0"
            Value="{Binding Factor.Y.Value}" />

    </Panels:PositionedStackPanel>

</Views:FilterPanel>
