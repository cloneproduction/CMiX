<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Transform2D"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:DragValue
            Caption="Uniform Scale"
            Value="{Binding UniformScale.Value}"
            ResetCommand="{Binding UniformScale.ResetCommand}" />

        <ui:Vector2
            Caption="Scale"
            DataContext="{Binding Scale}" />

        <ui:DragValue
            Caption="Rotate"
            Value="{Binding Rotate.Value}"
            ResetCommand="{Binding Rotate.ResetCommand}" />

        <ui:Vector2
            Caption="Translate"
            DataContext="{Binding Translate}" />

    </StackPanel>

</UserControl>
