<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.CheckerBoard"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:Vector2
            Caption="Cell Count"
            DataContext="{Binding CellCount}" />

        <ui:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <ui:ColorSelector
                Caption="Color A"
                DataContext="{Binding ColorA}" />

            <ui:ColorSelector
                Caption="Color B"
                DataContext="{Binding ColorB}" />

        </ui:PositionedStackPanel>

        <Views:Transform2D
            DataContext="{Binding Transform2D}" />

        <ui:CaptionedToggleButton
            Caption="Use Composition Resolution"
            IsChecked="{Binding UseCompositionResolution.Value}"
            ResetCommand="{Binding UseCompositionResolution.ResetCommand}" />

        <Border IsEnabled="{Binding !UseCompositionResolution.Value}">
            <ui:Integer2Value
                Caption="Resolution"
                DataContext="{Binding Resolution}" />
        </Border>

    </StackPanel>

</UserControl>
