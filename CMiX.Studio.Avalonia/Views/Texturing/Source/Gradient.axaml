<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Gradient"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <StackPanel>

        <ui:DragValue
            Margin="0,0,0,8"
            Caption="Gamma"
            Value="{Binding Gamma.Value}"
            ResetCommand="{Binding Gamma.ResetCommand}" />

        <ui:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <ui:ColorSelector
                Caption="From"
                DataContext="{Binding From}" />

            <ui:ColorSelector
                Caption="To"
                DataContext="{Binding To}" />

        </ui:PositionedStackPanel>

        <ui:CaptionedToggleButton
            Margin="0,8"
            Caption="Horizontal"
            IsChecked="{Binding Horizontal.Value}"
            ResetCommand="{Binding Horizontal.ResetCommand}" />

        <ui:CaptionedToggleButton
            Margin="0,0,0,8"
            Caption="Use Composition Resolution"
            IsChecked="{Binding UseCompositionResolution.Value}"
            ResetCommand="{Binding UseCompositionResolution.ResetCommand}" />

        <Border IsEnabled="{Binding !UseCompositionResolution.Value}">
            <ui:Integer2Value
                Caption="Resolution"
                DataContext="{Binding Resolution}" />
        </Border>

    </StackPanel>

</UserControl>
