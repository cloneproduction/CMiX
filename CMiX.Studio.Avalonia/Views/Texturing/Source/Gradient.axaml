<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Gradient"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels">

    <StackPanel>

        <BaseControl:DragValue
            Margin="0,0,0,8"
            Caption="Gamma"
            Value="{Binding Gamma.Value}" />

        <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <BaseControl:ColorSelector
                Caption="From"
                DataContext="{Binding From}" />

            <BaseControl:ColorSelector
                Caption="To"
                DataContext="{Binding To}" />

        </Panels:PositionedStackPanel>

        <BaseControl:ToggleButton
            Margin="0,8"
            Caption="Horizontal"
            IsChecked="{Binding Horizontal.Value}" />

        <BaseControl:Integer2Value
            Caption="Resolution"
            DataContext="{Binding Resolution}" />

    </StackPanel>

</UserControl>
