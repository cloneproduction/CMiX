<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.VideoPlayer"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel>

        <Border Margin="0,0,0,8" Classes="BorderMask">
            <Grid ColumnDefinitions="*,*">
                <ui:ToggleButtonCMiX
                    Grid.Column="0"
                    Content="Play"
                    IsChecked="{Binding Play.Value, Mode=TwoWay}"
                    ResetCommand="{Binding Play.ResetCommand}"
                    Theme="{StaticResource ToggleButtonInlineLeft}" />
                <Button
                    Grid.Column="1"
                    Margin="1,0,0,0"
                    Content="Do Seek"
                    Command="{Binding DoSeek.ClickCommand}"
                    Theme="{StaticResource ButtonInlineRight}" />
            </Grid>
        </Border>

        <Views:AssetPathSelector
            Margin="0,0,0,8"
            DataContext="{Binding AssetSelector}"
            ItemsSource="{Binding AssetRepository.Videos}"
            SelectedItem="{Binding Asset}" />

        <ui:IntegerValue
            Caption="Seek Frame"
            Value="{Binding SeekFrame.Value}"
            ResetCommand="{Binding SeekFrame.ResetCommand}" />

        <ui:ToggleButtonCaptioned
            Margin="0,8"
            Caption="Use Composition Resolution"
            IsChecked="{Binding UseCompositionResolution.Value}"
            ResetCommand="{Binding UseCompositionResolution.ResetCommand}" />

        <Border IsEnabled="{Binding !UseCompositionResolution.Value}">
            <ui:Integer2
                Caption="Resolution"
                DataContext="{Binding Resolution}" />
        </Border>

    </StackPanel>

</UserControl>
