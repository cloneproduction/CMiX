<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.VideoPlayer"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel>

        <Border Margin="0,0,0,8" Classes="BorderMask">
            <Grid ColumnDefinitions="*,*">
                <BaseControls:CMiXToggleButton
                    Grid.Column="0"
                    Content="Play"
                    IsChecked="{Binding Play.Value, Mode=TwoWay}"
                    ResetCommand="{Binding Play.ResetCommand}"
                    Theme="{StaticResource InlineToggleButtonLeft}" />
                <Button
                    Grid.Column="1"
                    Margin="1,0,0,0"
                    Content="Do Seek"
                    Command="{Binding DoSeek.ClickCommand}"
                    Theme="{StaticResource InlineButtonRight}" />
            </Grid>
        </Border>

        <!-- PathSelector is ported in the Assets slice and resolves at integration time. -->
        <Views:PathSelector
            Margin="0,0,0,8"
            DataContext="{Binding AssetSelector}"
            ItemsSource="{Binding AssetRepository.Videos}"
            SelectedItem="{Binding Asset}" />

        <BaseControls:IntegerValue
            Caption="Seek Frame"
            DataContext="{Binding SeekFrame}" />

        <BaseControls:CaptionedToggleButton
            Margin="0,8"
            Caption="Use Composition Resolution"
            IsChecked="{Binding UseCompositionResolution.Value}"
            ResetCommand="{Binding UseCompositionResolution.ResetCommand}" />

        <Border IsEnabled="{Binding !UseCompositionResolution.Value}">
            <BaseControls:Integer2Value
                Caption="Resolution"
                DataContext="{Binding Resolution}" />
        </Border>

    </StackPanel>

</UserControl>
