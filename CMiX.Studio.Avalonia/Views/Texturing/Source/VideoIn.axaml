<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.VideoIn"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <BaseControl:CaptionedToggleButton
            Caption="Use Composition Resolution"
            IsChecked="{Binding UseCompositionResolution.Value}" />

        <Border IsEnabled="{Binding !UseCompositionResolution.Value}">
            <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

                <BaseControl:IntegerValue
                    Caption="Resolution X"
                    DataContext="{Binding SizeX}" />

                <BaseControl:IntegerValue
                    Caption="Y"
                    DataContext="{Binding SizeY}" />

            </Panels:PositionedStackPanel>
        </Border>

    </StackPanel>

</UserControl>
