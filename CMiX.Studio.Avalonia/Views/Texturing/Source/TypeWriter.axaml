<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TypeWriter"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources">

    <StackPanel>

        <Border
            Height="44"
            BorderBrush="{StaticResource Grey600Brush}"
            BorderThickness="0.5"
            CornerRadius="{DynamicResource CornerRadiusAll}">
            <!-- Avalonia updates the Text binding on every keystroke, so UpdateSourceTrigger is not needed. -->
            <TextBox
                Text="{Binding StringControl.Value}"
                Theme="{StaticResource TextBoxTypeWriter}" />
        </Border>

        <ui:StackPanelPositioned Margin="0,8,0,0" Spacing="{DynamicResource SpacingXXS}">

            <ui:ComboBoxCaptioned
                Caption="Font Family"
                ItemsSource="{x:Static Resources:EnumProviders.SortedFontsCollection}"
                ResetCommand="{Binding FontFamily.ResetCommand}"
                SelectedItem="{Binding FontFamily.Value, Converter={StaticResource FontFamilyToString}}" />

            <ui:ComboBoxCaptioned
                Caption="Style"
                ItemsSource="{x:Static Resources:EnumProviders.FontStyle}"
                ResetCommand="{Binding Style.ResetCommand}"
                SelectedItem="{Binding Style.Value}" />

        </ui:StackPanelPositioned>

        <ui:DragValue
            Margin="0,8"
            Caption="Size"
            Value="{Binding FontSize.Value}"
            ResetCommand="{Binding FontSize.ResetCommand}" />

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <ui:ColorSelector
                Caption="Font Color"
                DataContext="{Binding FontColor}" />

            <ui:ColorSelector
                Caption="Background Color"
                DataContext="{Binding BackgroundColor}" />

        </ui:StackPanelPositioned>

        <ui:Vector2
            Margin="0,8"
            Caption="Position"
            DataContext="{Binding Position}" />

        <ui:ToggleButtonCaptioned
            Margin="0,0,0,8"
            Caption="Use Composition Resolution"
            IsChecked="{Binding UseCompositionResolution.Value}"
            ResetCommand="{Binding UseCompositionResolution.ResetCommand}" />

        <Border IsEnabled="{Binding !UseCompositionResolution.Value}">
            <ui:Integer2
                Caption="Resolution"
                DataContext="{Binding Resolution}" />
        </Border>

    </StackPanel>

</UserControl>
