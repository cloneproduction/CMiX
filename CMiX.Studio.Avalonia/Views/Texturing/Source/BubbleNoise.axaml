<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.BubbleNoise"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels">

    <StackPanel>

        <Panels:PositionedStackPanel>

            <BaseControls:DragValue
                Caption="Speed"
                Value="{Binding Speed.Value}" />

            <BaseControls:DragValue
                Margin="0,1"
                Caption="Frequency"
                Value="{Binding Frequency.Value}" />

            <BaseControls:DragValue
                Caption="Contrast"
                Value="{Binding Contrast.Value}" />

        </Panels:PositionedStackPanel>

        <Panels:PositionedStackPanel>

            <BaseControls:ColorSelector
                Margin="0,8,0,1"
                Caption="Background"
                DataContext="{Binding BackgroundColor}" />

            <BaseControls:ColorSelector
                Caption="Bubble"
                DataContext="{Binding BubbleColor}" />

        </Panels:PositionedStackPanel>

        <BaseControls:Integer2Value
            Margin="0,8,0,0"
            Caption="Resolution"
            DataContext="{Binding Resolution}" />

    </StackPanel>

</UserControl>
