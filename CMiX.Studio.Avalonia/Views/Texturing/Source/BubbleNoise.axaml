<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.BubbleNoise"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <BaseControls:DragValue
                Caption="Speed"
                Value="{Binding Speed.Value}"
                ResetCommand="{Binding Speed.ResetCommand}" />

            <BaseControls:DragValue
                Caption="Frequency"
                Value="{Binding Frequency.Value}"
                ResetCommand="{Binding Frequency.ResetCommand}" />

            <BaseControls:DragValue
                Caption="Contrast"
                Value="{Binding Contrast.Value}"
                ResetCommand="{Binding Contrast.ResetCommand}" />

        </Panels:PositionedStackPanel>

        <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <BaseControls:ColorSelector
                Caption="Background"
                DataContext="{Binding BackgroundColor}" />

            <BaseControls:ColorSelector
                Caption="Bubble"
                DataContext="{Binding BubbleColor}" />

        </Panels:PositionedStackPanel>

        <BaseControls:Integer2Value
            Caption="Resolution"
            DataContext="{Binding Resolution}" />

    </StackPanel>

</UserControl>
