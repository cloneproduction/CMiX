<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.BubbleNoise"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <ui:DragValue
                Caption="Speed"
                Value="{Binding Speed.Value}"
                ResetCommand="{Binding Speed.ResetCommand}" />

            <ui:DragValue
                Caption="Frequency"
                Value="{Binding Frequency.Value}"
                ResetCommand="{Binding Frequency.ResetCommand}" />

            <ui:DragValue
                Caption="Contrast"
                Value="{Binding Contrast.Value}"
                ResetCommand="{Binding Contrast.ResetCommand}" />

        </ui:PositionedStackPanel>

        <ui:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <ui:ColorSelector
                Caption="Background"
                DataContext="{Binding BackgroundColor}" />

            <ui:ColorSelector
                Caption="Bubble"
                DataContext="{Binding BubbleColor}" />

        </ui:PositionedStackPanel>

        <ui:CaptionedToggleButton
            Caption="Use Composition Resolution"
            IsChecked="{Binding UseCompositionResolution.Value}"
            ResetCommand="{Binding UseCompositionResolution.ResetCommand}" />

        <Border IsEnabled="{Binding !UseCompositionResolution.Value}">
            <ui:Integer2Value
                Caption="Resolution"
                DataContext="{Binding Resolution}" />
        </Border>

    </StackPanel>

</UserControl>
