<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Image"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <!-- PathSelector is ported in the Assets slice and resolves at integration time. -->
        <Views:PathSelector
            VerticalAlignment="Top"
            DataContext="{Binding AssetSelector}"
            ItemsSource="{Binding AssetRepository.Images}"
            SelectedItem="{Binding Asset}" />

        <ui:CaptionedToggleButton
            Caption="Use Composition Resolution"
            IsChecked="{Binding UseCompositionResolution.Value}"
            ResetCommand="{Binding UseCompositionResolution.ResetCommand}" />

        <Border IsEnabled="{Binding !UseCompositionResolution.Value}">
            <ui:Integer2
                Caption="Resolution"
                DataContext="{Binding Resolution}" />
        </Border>

    </StackPanel>

</UserControl>
