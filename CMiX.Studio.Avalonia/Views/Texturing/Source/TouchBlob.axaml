<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TouchBlob"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels">

    <StackPanel>

        <BaseControls:DragValue
            Caption="Size"
            Value="{Binding Size.Value}"
            ResetCommand="{Binding Size.ResetCommand}" />

        <Panels:PositionedStackPanel Margin="0,8" Spacing="{DynamicResource SpacingXXS}">

            <BaseControls:ColorSelector
                Caption="Color"
                DataContext="{Binding Color}" />

            <BaseControls:ColorSelector
                Caption="Background"
                DataContext="{Binding Background}" />

        </Panels:PositionedStackPanel>

        <BaseControls:Integer2Value
            Caption="Resolution"
            DataContext="{Binding Resolution}" />

    </StackPanel>

</UserControl>
