<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TouchBlob"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <StackPanel>

        <ui:DragValue
            Caption="Size"
            Value="{Binding Size.Value}"
            ResetCommand="{Binding Size.ResetCommand}" />

        <ui:StackPanelPositioned Margin="0,8" Spacing="{DynamicResource SpacingXXS}">

            <ui:ColorSelector
                Caption="Color"
                DataContext="{Binding Color}" />

            <ui:ColorSelector
                Caption="Background"
                DataContext="{Binding Background}" />

        </ui:StackPanelPositioned>

        <ui:ToggleButtonCaptioned
            Margin="0,0,0,8"
            Caption="Use Composition Resolution"
            IsChecked="{Binding UseCompositionResolution.Value}"
            ResetCommand="{Binding UseCompositionResolution.ResetCommand}" />

        <Border IsEnabled="{Binding !UseCompositionResolution.Value}">
            <ui:Integer2
                Caption="Resolution"
                DataContext="{Binding Resolution}" />
        </Border>

    </StackPanel>

</UserControl>
