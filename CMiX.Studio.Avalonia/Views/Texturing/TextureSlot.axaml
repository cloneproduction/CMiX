<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TextureSlot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:TextureSources="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Avalonia.Behaviors"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity">

    <Managers:ListPrefabSlot
        Margin="8"
        MinItemCount="2"
        DataContext="{Binding TextureManager}"
        ItemsSource="{Binding ControlRepository.Textures}">

        <i:Interaction.Behaviors>
            <Behaviors:TextureDropBehavior PrefabManager="{Binding}" />
        </i:Interaction.Behaviors>

        <Managers:ListPrefabSlot.SelectionPanel>
            <ui:ButtonPopup Caption="Add Texture">
                <ui:ButtonPopup.PopupContent>
                    <Managers:PanelAddTypes Interface="{x:Type TextureSources:ITextureSource}" />
                </ui:ButtonPopup.PopupContent>
            </ui:ButtonPopup>
        </Managers:ListPrefabSlot.SelectionPanel>

    </Managers:ListPrefabSlot>

</UserControl>
