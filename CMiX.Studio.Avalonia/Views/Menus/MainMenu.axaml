<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Menus.MainMenu"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <Border
        Margin="0,0,0,2"
        Padding="2"
        Background="Transparent"
        BorderBrush="{DynamicResource Grey100Brush}"
        DockPanel.Dock="Top">
        <Menu
            Height="{DynamicResource ControlHeightMD}"
            Margin="0,0,0,0"
            HorizontalAlignment="Left"
            Theme="{StaticResource MenuDefault}">

            <MenuItem
                Padding="8,0"
                Header="File"
                Theme="{DynamicResource MenuItemTop}">

                <MenuItem
                    Padding="0,0,64,0"
                    Command="{Binding $parent[Window].DataContext.ProjectFile.NewProjectCommand}"
                    Header="New" />

                <!-- The gesture comes from the shortcut map of the window (File.Open), as the key binding of the window. -->
                <MenuItem
                    Command="{Binding $parent[Window].DataContext.ProjectFile.OpenProjectCommand}"
                    Header="Open"
                    InputGesture="{Binding $parent[Window].DataContext.Shortcuts[File.Open]}" />

                <MenuItem
                    Command="{Binding $parent[Window].DataContext.ProjectFile.SaveProjectCommand}"
                    Header="Save" />

                <MenuItem
                    Command="{Binding $parent[Window].DataContext.ProjectFile.SaveAsProjectCommand}"
                    Header="Save As" />

                <MenuItem
                    Command="{Binding $parent[Window].DataContext.MainWindowController.CloseWindowCommand}"
                    Header="Quit" />

            </MenuItem>

            <MenuItem
                Padding="8,0"
                Header="Edit"
                Theme="{DynamicResource MenuItemTop}">

                <!-- The gestures come from the shortcut map of the window (Edit.Undo, Edit.Redo), as the key bindings of the window. -->
                <MenuItem
                    Command="{Binding $parent[Window].DataContext.UndoCommand}"
                    Header="Undo"
                    InputGesture="{Binding $parent[Window].DataContext.Shortcuts[Edit.Undo]}" />

                <MenuItem
                    Command="{Binding $parent[Window].DataContext.RedoCommand}"
                    Header="Redo"
                    InputGesture="{Binding $parent[Window].DataContext.Shortcuts[Edit.Redo]}" />

            </MenuItem>

            <MenuItem
                Padding="8,0"
                Header="Compo"
                Theme="{DynamicResource MenuItemTop}">

                <MenuItem
                    Command="{Binding AddCompositionCommand}"
                    ui:RunCommandAfterClose.IsEnabled="True"
                    Header="New Composition" />

                <MenuItem
                    Command="{Binding RemoveCompositionCommand}"
                    ui:RunCommandAfterClose.IsEnabled="True"
                    Header="Delete" />
                <MenuItem
                    Command="{Binding DuplicateCompositionCommand}"
                    ui:RunCommandAfterClose.IsEnabled="True"
                    Header="Duplicate" />
                <MenuItem Header="-" />
                <MenuItem Header="Import" />
                <MenuItem Header="Export" />

            </MenuItem>

            <MenuItem
                Padding="8,0"
                Header="Layer"
                Theme="{DynamicResource MenuItemTop}">
                <MenuItem
                    Command="{Binding AddLayerCommand}"
                    ui:RunCommandAfterClose.IsEnabled="True"
                    Header="New Layer" />
                <MenuItem
                    Command="{Binding RemoveLayerCommand}"
                    ui:RunCommandAfterClose.IsEnabled="True"
                    Header="Delete" />
                <MenuItem
                    Command="{Binding DuplicateLayerCommand}"
                    ui:RunCommandAfterClose.IsEnabled="True"
                    Header="Duplicate" />
            </MenuItem>

        </Menu>
    </Border>
</UserControl>
