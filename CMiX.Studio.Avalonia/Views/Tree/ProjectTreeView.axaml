<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ProjectTreeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Tree="clr-namespace:CMiX.Studio.Avalonia.ViewModels.Tree"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <!-- The sizes of a row for a screen of 100%: ControlHeightMD and SpacingXXS. The code sets them again in whole pixels of the screen
         (ProjectTreeView.SnapToPixels), from those two tokens. The width of the toggle column comes from them too. -->
    <UserControl.Resources>
        <x:Double x:Key="TreeRowHeight">24</x:Double>
        <x:Double x:Key="TreeRowSpacing">1</x:Double>
        <x:Double x:Key="TreeDropLineThickness">1</x:Double>
        <Thickness x:Key="TreeDropLineGapMargin">0,25,0,0</Thickness>
        <Thickness x:Key="TreeDropLineTopMargin">0,-2,0,0</Thickness>
        <Thickness x:Key="TreeSelectionThickness">1</Thickness>
        <x:Double x:Key="TreeToggleWidth">50</x:Double>
    </UserControl.Resources>

    <!-- The gesture comes from the shortcut map. The binding pauses while a name box is edited (KeyBindingTextGuard). Tree.Open needs the
         focus in the tree, as the arrow keys that move the cursor (see OnKeyDownTunnel). The keys of the selected row (Tree.Rename,
         Tree.Remove, Tree.Duplicate, Tree.MoveUp, Tree.MoveDown) are in the main window. -->
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding OpenSelectedCommand}" Gesture="{Binding Shortcuts[Tree.Open]}" />
    </UserControl.KeyBindings>

    <UserControl.Styles>
        <!-- The class grabbing is on the view while a grab runs (see ProjectTreeView.OnGrabChanged). The frame is hidden by a style, not by
             a local value, so the style of the class can show it. -->
        <Style Selector="Border#GrabFrame">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Views|ProjectTreeView.grabbing Border#GrabFrame">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <!-- The toolbar is over the tree. Its Add button opens the Add panel under it. -->
    <DockPanel Background="{DynamicResource TreeBackgroundBrush}">

    <Views:ProjectTreeToolbar
        Background="{DynamicResource Grey300Brush}"
        DockPanel.Dock="Top"
        Padding="{DynamicResource TreeToolbarPadding}" />

    <!-- The keys of the mode of the tree, under the rows (see TreeKeyHints). The Settings tab hides it. It takes no click and no focus. -->
    <ui:KeyHintStrip
        x:Name="hintStrip"
        DockPanel.Dock="Bottom"
        IsVisible="{Binding Interface.ShowKeyHints}" />

    <!-- The stripes are behind the tree, in the same cell, and follow its rows. A row is one pitch (row height plus space) from the next, so
         the bands stay under the rows whatever is open. The rows have their own fill, so the stripes show between them and beside them. -->
    <Grid>

    <ui:RowStripes
        x:Name="stripes"
        Opacity="0.6"
        Brush="{DynamicResource PanelBackgroundLevel1Brush}"
        RowHeight="{DynamicResource TreeRowHeight}"
        RowSpacing="{DynamicResource TreeRowGap}" />


    <TreeView
        x:Name="treeView"
        AutoScrollToSelectedItem="False"
        Margin="{DynamicResource TreeMargin}"
        Padding="0"
        Background="Transparent"
        BorderThickness="0"
        FocusAdorner="{x:Null}"
        ItemsSource="{Binding Roots}"
        KeyboardNavigation.TabNavigation="Once"
        SelectedItem="{Binding SelectedNode, Mode=TwoWay}">

        <TreeView.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel />
            </ItemsPanelTemplate>
        </TreeView.ItemsPanel>

        <TreeView.Styles>
            <!-- The bar lies over the rows, so the rows do not move when it appears. -->
            <Style Selector="TreeView /template/ ScrollViewer">
                <Setter Property="Theme" Value="{DynamicResource ScrollViewerOverlay}" />
            </Style>
            <Style Selector="TreeViewItem">
                <Setter Property="Theme" Value="{StaticResource TreeViewItemCMiX}" />
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            </Style>
            <!-- The cursor row of the tree is framed in the colour of its kind; the selected row is lifted (TreeRowShadow) (TreeTone KindSelected), with the
                 focus and without it. The selected row is the coloured row (FillSelected), a greyed row is out of play (DimLayer).
                 The frame is one pixel of the screen (TreeSelectionThickness, see TreeRowMetrics). A list keeps the frame of CursorRow.axaml;
                 the focused style is named here too, so it comes after the one of CursorRow.axaml. -->
            <Style Selector="TreeViewItem.cursor /template/ Border#CursorFrame">
                <Setter Property="BorderThickness" Value="{DynamicResource TreeSelectionThickness}" />
                <Setter Property="BorderBrush" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=KindSelected}" />
            </Style>
            <Style Selector="TreeView:focus-within TreeViewItem.cursor /template/ Border#CursorFrame">
                <Setter Property="BorderThickness" Value="{DynamicResource TreeSelectionThickness}" />
                <Setter Property="BorderBrush" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=KindSelected}" />
            </Style>
            <!-- The cursor on the selected row: the frame is white, since the fill is the colour of the kind. -->
            <Style Selector="TreeViewItem:selected.cursor /template/ Border#CursorFrame">
                <Setter Property="BorderBrush" Value="{DynamicResource CursorFrameBrush}" />
            </Style>
        </TreeView.Styles>

        <TreeView.DataTemplates>
            <TreeDataTemplate DataType="{x:Type Tree:TreeNode}" ItemsSource="{Binding Children}">

                <!-- The row of a list: an icon (KindIconBrush: white on the selected row and on the cursor row, the colour of the kind otherwise) and the name.
                     The toggles are not here: they are at the right of the colored row (see RowToggles and the theme of the item). -->
                <DockPanel>

                    <ui:AppIcon
                        Name="KindIcon"
                        Margin="{DynamicResource TreeHeaderMargin}"
                        IconKey="{Binding IconKey}"
                        Size="{DynamicResource IconSizeXS}">
                        <ui:AppIcon.Foreground>
                            <MultiBinding Converter="{StaticResource KindIconBrush}">
                                <Binding />
                                <Binding Path="IsCursor" />
                                <Binding Path="$parent[TreeViewItem].IsSelected" />
                            <Binding Path="$parent[TreeViewItem].ItemCount" />
                            </MultiBinding>
                        </ui:AppIcon.Foreground>
                    </ui:AppIcon>

                    <!-- The last child of the dock panel: the name takes all the room after the icon. A group has a text, an item has
                         a name that can be edited. A collapsed row shows what it holds (KindCountBadges) right after its name. -->
                    <Panel>
                        <ui:TextBoxEditable
                            Text="{Binding Item.PrefabService.Name.Value, Mode=TwoWay}"
                            IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ui:TextBoxEditable.Foreground>
                                <MultiBinding Converter="{StaticResource KindIconBrush}" ConverterParameter="Text">
                                    <Binding />
                                    <Binding Path="IsCursor" />
                                    <Binding Path="$parent[TreeViewItem].IsSelected" />
                                <Binding Path="$parent[TreeViewItem].ItemCount" />
                                </MultiBinding>
                            </ui:TextBoxEditable.Foreground>
                            <ui:TextBoxEditable.Suffix>
                                <Views:KindCountBadges
                                    IsVisible="{Binding ShowsBadges}"
                                    IsHovered="{Binding $parent[TreeViewItem].IsPointerOver}"
                                    IsSelected="{Binding $parent[TreeViewItem].IsSelected}" />
                            </ui:TextBoxEditable.Suffix>
                        </ui:TextBoxEditable>

                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock
                                Margin="{DynamicResource TreeHeaderMargin}"
                                VerticalAlignment="Center"
                                Text="{Binding Header}">
                                <TextBlock.Foreground>
                                    <MultiBinding Converter="{StaticResource KindIconBrush}" ConverterParameter="Text">
                                        <Binding />
                                        <Binding Path="IsCursor" />
                                        <Binding Path="$parent[TreeViewItem].IsSelected" />
                                    <Binding Path="$parent[TreeViewItem].ItemCount" />
                                    </MultiBinding>
                                </TextBlock.Foreground>
                            </TextBlock>
                            <Views:KindCountBadges
                                IsVisible="{Binding ShowsBadges}"
                                IsHovered="{Binding $parent[TreeViewItem].IsPointerOver}"
                                IsSelected="{Binding $parent[TreeViewItem].IsSelected}" />
                        </StackPanel>
                    </Panel>

                </DockPanel>

            </TreeDataTemplate>
        </TreeView.DataTemplates>

    </TreeView>

    <!-- The shadow of the selected row (TreeRowShadow): a box shadow in a layer over the rows, so it falls on every row around it,
         not only on the rows inside its item. It takes no click. -->
    <Canvas
        x:Name="rowShadowLayer"
        ClipToBounds="True"
        IsHitTestVisible="False">
        <Border
            x:Name="rowShadowBox"
            Background="Transparent"
            BoxShadow="0 0 32 0 #E6000000"
            CornerRadius="{DynamicResource CornerRadiusAll}"
            Opacity="0" />
    </Canvas>

    <!-- The frame of a grab (Tree.Grab): an accent frame around the rows while the grab runs, so the mode shows at the edge of the eye.
         It takes no click. -->
    <Border
        x:Name="GrabFrame"
        BorderBrush="{DynamicResource AccentBrush}"
        BorderThickness="{DynamicResource CursorFrameThickness}"
        IsHitTestVisible="False" />

    </Grid>

    </DockPanel>

</UserControl>
