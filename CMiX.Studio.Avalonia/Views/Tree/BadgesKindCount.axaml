<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.BadgesKindCount"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Tree="clr-namespace:CMiX.Studio.Avalonia.ViewModels.Tree"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <!-- What a collapsed row holds: the icon of each kind, in the colour of the kind, with how many at its bottom right in white; the
         tooltip, in the colour of the kind, names the kind.
         At most TreeNode.MaxShownKindCounts kinds show. A grey square "+n" counts the other kinds.
         The DataContext is the tree node. The badges keep their colour under the pointer and when the row is selected. -->
    <UserControl.Styles>
        <Style Selector="Panel.kindcount">
            <Setter Property="ui:ToolTipCard.Fill" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=Kind}" />
        </Style>
        <Style Selector="Panel.kindcount > ui|TextOutlined.count">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="{DynamicResource TreeKindCountOffset}" />
            <Setter Property="FontSize" Value="{DynamicResource TreeKindCountFontSize}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ActiveForegroundBrush}" />
            <Setter Property="OutlineBrush" Value="{DynamicResource TreeBackgroundBrush}" />
            <Setter Property="OutlineThickness" Value="{DynamicResource TreeKindCountOutline}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXS}">
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingXS}" IsVisible="{Binding ShowsKindCounts}">
        <ItemsControl ItemsSource="{Binding ShownKindCounts}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingMD}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type Tree:KindCount}">
                    <Panel
                        Classes="kindcount"
                        Width="{DynamicResource IconSizeXS}"
                        Height="{DynamicResource IconSizeXS}"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        ToolTip.Tip="{Binding Description}">
                        <ui:AppIcon
                            IconKey="{Binding IconKey}"
                            Size="{DynamicResource IconSizeXS}"
                            Foreground="{Binding Converter={StaticResource TreeTone}, ConverterParameter=KindSelected}" />
                        <ui:TextOutlined Classes="count" Text="{Binding Count}" />
                    </Panel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border
            Name="MoreKinds"
            Height="{DynamicResource TreeKindSquareSize}"
            MinWidth="{DynamicResource TreeKindSquareSize}"
            VerticalAlignment="Center"
            Background="{DynamicResource Grey600Brush}"
            CornerRadius="{DynamicResource CornerRadiusAll}"
            IsVisible="{Binding HasMoreKinds}"
            ToolTip.Tip="{Binding MoreKindsDescription}">
            <TextBlock
                Margin="4,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource ActiveForegroundBrush}"
                Text="{Binding MoreKindsCount, StringFormat='+{0}'}" />
        </Border>
        </StackPanel>

        <!-- The sign of a missing asset on this row or under it (TreeNode.MissingCount), after the kinds: the orange Warning icon. Like the
             kind badges it shows on a collapsed row, for what is under it; an open row leaves it to the rows below. The missing row
             itself always shows it. -->
        <Border
            Name="MissingSign"
            ui:ToolTipCard.Fill="{DynamicResource PopupCardWarningBrush}"
            Width="{DynamicResource TreeKindSquareSize}"
            Height="{DynamicResource TreeKindSquareSize}"
            VerticalAlignment="Center"
            Background="Transparent"
            IsVisible="{Binding ShowsMissingSign}"
            ToolTip.Tip="{Binding MissingCount, StringFormat='{}{0} missing asset(s)'}">
            <ui:AppIcon
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IconKey="Warning"
                Size="{DynamicResource IconSizeXS}">
                <!-- A local value: AppIcon has a style of its own for its Foreground. -->
                <ui:AppIcon.Foreground>
                    <DynamicResourceExtension ResourceKey="PopupCardWarningBrush" />
                </ui:AppIcon.Foreground>
            </ui:AppIcon>
        </Border>

    </StackPanel>

</UserControl>
