<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LFOModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Modulation="clr-namespace:CMiX.Core.Modulation;assembly=CMiX.Core"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    x:Name="lfoModifier">

    <StackPanel Margin="4">

        <Views:ModifierModeSelector DataContext="{Binding ModifierModeSelector}" />

        <BaseControls:ComboBox
            Margin="0,4,0,0"
            Caption="Transform"
            ItemsSource="{x:Static Resources:EnumProviders.TransformType}"
            SelectedItem="{Binding TransformType.Value}" />

        <BaseControls:AxisSelector3D
            Margin="0,1,0,4"
            XIsChecked="{Binding DirectionXYZ.DirectionX.Value}"
            YIsChecked="{Binding DirectionXYZ.DirectionY.Value}"
            ZIsChecked="{Binding DirectionXYZ.DirectionZ.Value}" />

        <BaseControls:ModulatableValue
            Margin="0,0,0,1"
            Caption="From"
            DataContext="{Binding From}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=lfoModifier}" />

        <BaseControls:ModulatableValue
            Margin="0,0,0,4"
            Caption="To"
            DataContext="{Binding To}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=lfoModifier}" />

        <BaseControls:ToggleButton
            Margin="0,0,0,4"
            Caption="PingPong"
            IsChecked="{Binding PingPong.Value}" />

        <BaseControls:ModulatableValue
            Margin="0,0,0,4"
            Caption="Randomize Phase"
            DataContext="{Binding RandomizePhase}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=lfoModifier}" />

        <Views:ModifierManager DataContext="{Binding ModulatorManager}">
            <Views:ModifierManager.SelectionPanel>
                <Managers:AutoSelectionPanel Interface="{x:Type Modulation:IModulator}" />
            </Views:ModifierManager.SelectionPanel>
        </Views:ModifierManager>

    </StackPanel>

</UserControl>
