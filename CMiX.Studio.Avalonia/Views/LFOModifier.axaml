<Controls:ModulatablePanel
    x:Class="CMiX.Studio.Avalonia.Views.LFOModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    x:Name="lfoModifier"    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <Views:ModifierModeSelector
            DataContext="{Binding ModifierModeSelector}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=lfoModifier}" />

        <BaseControls:ComboBox
            Margin="0,8,0,1"
            Caption="Transform"
            ItemsSource="{x:Static Resources:EnumProviders.TransformType}"
            SelectedItem="{Binding TransformType.Value}" />

        <BaseControls:AxisSelector3D
            XIsChecked="{Binding DirectionXYZ.DirectionX.Value}"
            YIsChecked="{Binding DirectionXYZ.DirectionY.Value}"
            ZIsChecked="{Binding DirectionXYZ.DirectionZ.Value}" />

        <Panels:PositionedStackPanel Margin="0, 8">

            <BaseControls:ModulatableValue
                Margin="0,0,0,1"
                Caption="From"
                DataContext="{Binding From}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=lfoModifier}" />

            <BaseControls:ModulatableValue
                Caption="To"
                DataContext="{Binding To}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=lfoModifier}" />
        
        </Panels:PositionedStackPanel>
            <BaseControls:ModulatableValue
                Margin="0,0,0,8"
                Caption="Randomize Phase"
                DataContext="{Binding RandomizePhase}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=lfoModifier}" />

            <BaseControls:ToggleButton
                Margin="0,0,0,8"
                Caption="PingPong"
                IsChecked="{Binding PingPong.Value}" />

    </StackPanel>

</Controls:ModulatablePanel>
