<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TabSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <ScrollViewer Theme="{StaticResource ScrollViewerOverlayKeepOffset}">

        <StackPanel>

            <ui:ExpanderIndented Header="Output Mappings">
                <Managers:PanelOutputMappings DataContext="{Binding Project.OutputMappingManager}" />
            </ui:ExpanderIndented>

            <ui:ExpanderIndented Header="Redis Addresses">
                <Managers:PanelRedisAddresses DataContext="{Binding Project.RedisAddressRegistry}" />
            </ui:ExpanderIndented>

            <!-- Saved in studio-settings.json at once (see InterfaceOptions). -->
            <ui:ExpanderIndented Header="Interface">
                <ui:ToggleButtonCaptioned
                    x:Name="showKeyHintsToggle"
                    Caption="Show key hints under the tree"
                    IsChecked="{Binding Interface.ShowKeyHints, Mode=TwoWay}" />
            </ui:ExpanderIndented>

            <ui:ExpanderIndented Header="Shortcuts" IsExpanded="False">
                <Views:SettingsShortcut DataContext="{Binding ShortcutSettings}" />
            </ui:ExpanderIndented>

        </StackPanel>
    </ScrollViewer>

</UserControl>
