<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:BaseControls="using:CMiX.Studio.Avalonia.Views.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CMiX.Studio.Avalonia.Views.TransformSRT">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <BaseControls:DragValue
            Caption="Uniform"
            Value="{Binding Uniform.Value}" />

        <BaseControls:VectorXYZ
            Caption="Scale"
            DataContext="{Binding Scale}" />

        <BaseControls:VectorXYZ
            Caption="Rotation"
            DataContext="{Binding Rotation}" />

        <BaseControls:VectorXYZ
            Caption="Translate"
            DataContext="{Binding Translate}" />

    </StackPanel>
</UserControl>
