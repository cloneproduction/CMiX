<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ScaleModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Modulation="clr-namespace:CMiX.Core.Modulation;assembly=CMiX.Core"
    x:Name="scaleModifier"    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:panels="using:CMiX.Studio.Avalonia.Views.Controls.Panels"
    d:DesignWidth="400">

    <StackPanel>

        <Views:ModifierModeSelector DataContext="{Binding ModifierModeSelector}" />

        <BaseControls:ModulatableValue
            Margin="0,8"
            Caption="Uniform"
            DataContext="{Binding Uniform}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=scaleModifier}" />

        <BaseControls:ModulatableVectorXYZ
            Caption="Scale" 
            ModulatorManager="{Binding ModulatorManager}" />

        <Views:ModifierManager Caption="Add Modulator" DataContext="{Binding ModulatorManager}">
            <Views:ModifierManager.SelectionPanel>
                <Managers:AutoSelectionPanel Interface="{x:Type Modulation:IModulator}" />
            </Views:ModifierManager.SelectionPanel>
        </Views:ModifierManager>

    </StackPanel>

</UserControl>
