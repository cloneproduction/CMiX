<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TextEntity"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>
        <ui:ExpanderIndented Header="Transform" IsExpanded="{Binding TransformSRTIsExpanded}">
            <Views:TransformSRT Margin="8" DataContext="{Binding TransformSRT}" />
        </ui:ExpanderIndented>
        <Views:EntityModifiersSection PanelOwner="{x:Type Compositing:TextEntity}">
            <Managers:AutoSelectionPanel PanelOwner="{x:Type Compositing:Entity}" />
        </Views:EntityModifiersSection>

        <ui:ExpanderIndented Header="Settings" IsExpanded="{Binding SettingsIsExpanded}">
            <StackPanel Margin="8" Spacing="{DynamicResource SpacingMD}">

                <TextBox
                    Height="88"
                    Text="{Binding Text.Value}"
                    Theme="{StaticResource TextBoxTypeWriter}" />

                <ui:ColorSelector
                    Caption="Color"
                    DataContext="{Binding Color}" />

                <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">
                    <ui:DragValue
                        Caption="Size"
                        Value="{Binding Size.Value}"
                        ResetCommand="{Binding Size.ResetCommand}" />
                    <ui:DragValue
                        Caption="Line Height"
                        Value="{Binding LineHeight.Value}"
                        ResetCommand="{Binding LineHeight.ResetCommand}" />
                </ui:StackPanelPositioned>

                <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">
                    <ui:ComboBoxCaptioned
                        Caption="Font Family"
                        ItemsSource="{x:Static Resources:EnumProviders.SortedFontsCollection}"
                        ResetCommand="{Binding FontFamily.ResetCommand}"
                        SelectedItem="{Binding FontFamily.Value, Converter={StaticResource FontFamilyToString}}" />
                    <ui:ComboBoxCaptioned
                        Caption="Style"
                        ItemsSource="{x:Static Resources:EnumProviders.FontStyle}"
                        ResetCommand="{Binding Style.ResetCommand}"
                        SelectedItem="{Binding Style.Value}" />
                </ui:StackPanelPositioned>

                <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">
                    <ui:ComboBoxCaptioned
                        Caption="Horizontal Alignment"
                        ItemsSource="{x:Static Resources:EnumProviders.TextHorizontalAlignment}"
                        ResetCommand="{Binding HorizontalAlignment.ResetCommand}"
                        SelectedItem="{Binding HorizontalAlignment.Value}" />
                    <ui:ComboBoxCaptioned
                        Caption="Anchor"
                        ItemsSource="{x:Static Resources:EnumProviders.Anchor}"
                        ResetCommand="{Binding Anchor.ResetCommand}"
                        SelectedItem="{Binding Anchor.Value}" />
                </ui:StackPanelPositioned>

                <ui:DragValue
                    Margin="0,0,0,8"
                    Caption="Width"
                    Value="{Binding Width.Value}"
                    ResetCommand="{Binding Width.ResetCommand}" />

            </StackPanel>
        </ui:ExpanderIndented>

    </StackPanel>

</UserControl>
