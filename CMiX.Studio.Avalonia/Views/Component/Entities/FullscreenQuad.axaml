<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.FullscreenQuad"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="fullscreenQuad"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    d:DesignHeight="600">

    <StackPanel>

      <ui:ColorSelector
          Margin="8"
          Caption="Color"
          DataContext="{Binding Color}" />
      
      <ui:ExpanderIndented
          Header="Texture"
          IsExpanded="{Binding TextureIsExpanded}">
        
        <StackPanel>

          <Views:DiffuseTexture DataContext="{Binding Texture.DiffuseTexture}" />

          <!-- The mask has the color of the texture panel around it, not the darker color of a deeper level. -->
          <ui:ExpanderIndented
              Background="{DynamicResource PanelBackgroundLevel1Brush}"
              Indentation="4"
              IsExpanded="{Binding Texture.MaskTexture.IsExpanded}">
            
            <ui:ExpanderIndented.Header>
              <DockPanel>
                <ui:ToggleButtonCMiX
                    Width="{DynamicResource ControlHeightXS}"
                    Height="{DynamicResource ControlHeightXS}"
                    IsChecked="{Binding Texture.MaskTexture.IsEnabled.Value, Mode=TwoWay}"
                    ResetCommand="{Binding Texture.MaskTexture.IsEnabled.ResetCommand}"
                    Theme="{StaticResource ToggleButtonCheck}" />
                <TextBlock Margin="8,0" Text="Mask" />
              </DockPanel>
            </ui:ExpanderIndented.Header>
            
            <Views:MaskTexture DataContext="{Binding Texture.MaskTexture}" />
            
          </ui:ExpanderIndented>
          
        </StackPanel>

      </ui:ExpanderIndented>

      <ui:ExpanderIndented
        Header="Transform Texture"
        IsExpanded="{Binding TransformTextureIsExpanded}">
        
        <Views:Transform2D 
          DataContext="{Binding TransformTexture}" 
          Margin="8" />
        
      </ui:ExpanderIndented>
    </StackPanel>

</UserControl>
