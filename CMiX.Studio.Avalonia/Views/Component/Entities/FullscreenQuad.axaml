<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.FullscreenQuad"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="fullscreenQuad"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    d:DesignHeight="600">

    <StackPanel>

      <ui:SelectorColor
          Margin="8"
          Caption="Color"
          DataContext="{Binding Color}" />
      
      <Views:SectionEntityTexture />
    </StackPanel>

</UserControl>
