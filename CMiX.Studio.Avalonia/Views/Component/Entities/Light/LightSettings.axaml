<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LightSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Converters="clr-namespace:CMiX.Studio.Avalonia.Converters"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources">

    <StackPanel Margin="8">

        <BaseControls:ColorSelector Caption="Color" DataContext="{Binding LightColor}" />

        <BaseControls:DragValue
            Margin="0,8"
            Caption="Intensity"
            Value="{Binding Intensity.Value}"
            ResetCommand="{Binding Intensity.ResetCommand}" />

        <BaseControls:CaptionedComboBox
            Caption="Type"
            ItemsSource="{x:Static Resources:EnumProviders.LightType}"
            SelectedItem="{Binding LightTypeSelector.Value}" />

        <Panel>

            <Border IsVisible="{Binding LightTypeSelector.Value, Converter={x:Static Converters:EnumMatchConverter.Instance}, ConverterParameter={x:Static Lights:LightType.PointLight}}">
                <Views:LightPoint Margin="0,8,0,0" />
            </Border>

            <Border IsVisible="{Binding LightTypeSelector.Value, Converter={x:Static Converters:EnumMatchConverter.Instance}, ConverterParameter={x:Static Lights:LightType.SpotLight}}">
                <Views:LightSpot Margin="0,8,0,0" />
            </Border>

            <Border IsVisible="{Binding LightTypeSelector.Value, Converter={x:Static Converters:EnumMatchConverter.Instance}, ConverterParameter={x:Static Lights:LightType.AmbientLight}}">
                <Views:LightAmbient />
            </Border>

            <Border IsVisible="{Binding LightTypeSelector.Value, Converter={x:Static Converters:EnumMatchConverter.Instance}, ConverterParameter={x:Static Lights:LightType.DirectionalLight}}">
                <Views:LightDirectional Margin="0,8,0,0" />
            </Border>

        </Panel>

    </StackPanel>
</UserControl>