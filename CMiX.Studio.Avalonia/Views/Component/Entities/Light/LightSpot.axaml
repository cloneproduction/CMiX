<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LightSpot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <StackPanel>

        <ui:VectorXYZ Caption="Position" DataContext="{Binding Position}" />

        <ui:VectorXYZ
            Margin="0,8"
            Caption="Target"
            DataContext="{Binding Target}" />

        <ui:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <ui:DragValue
                Caption="Angle"
                Value="{Binding Angle.Value}"
                ResetCommand="{Binding Angle.ResetCommand}" />

            <ui:DragValue
                Caption="Softness"
                Value="{Binding Softness.Value}"
                ResetCommand="{Binding Softness.ResetCommand}" />

        </ui:PositionedStackPanel>

    </StackPanel>

</UserControl>
