<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LightSpot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels">

    <StackPanel>

        <BaseControl:VectorXYZ Caption="Position" DataContext="{Binding Position}" />

        <BaseControl:VectorXYZ
            Margin="0,8"
            Caption="Target"
            DataContext="{Binding Target}" />

        <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <BaseControl:DragValue
                Caption="Angle"
                Value="{Binding Angle.Value}"
                ResetCommand="{Binding Angle.ResetCommand}" />

            <BaseControl:DragValue
                Caption="Softness"
                Value="{Binding Softness.Value}"
                ResetCommand="{Binding Softness.ResetCommand}" />

        </Panels:PositionedStackPanel>

    </StackPanel>

</UserControl>
