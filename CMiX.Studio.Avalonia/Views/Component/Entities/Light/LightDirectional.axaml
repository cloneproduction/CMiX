<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LightDirectional"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <StackPanel>
        <ui:Vector3 
            Caption="Position" 
            DataContext="{Binding Position}" />
        <ui:Vector3
            Margin="0,8"
            Caption="Target"
            DataContext="{Binding Target}" />
    </StackPanel>

</UserControl>
