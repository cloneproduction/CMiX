<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LightDirectional"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <StackPanel>
        <BaseControl:VectorXYZ Caption="Position" DataContext="{Binding Position}" />
        <BaseControl:VectorXYZ
            Margin="0,8"
            Caption="Target"
            DataContext="{Binding Target}" />
    </StackPanel>

</UserControl>
