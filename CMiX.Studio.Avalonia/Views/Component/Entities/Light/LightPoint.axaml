<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LightPoint"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <StackPanel>

        <BaseControl:VectorXYZ
            Caption="Position"
            DataContext="{Binding Position}" />

        <BaseControl:DragValue
            Margin="0,8"
            Caption="Radius"
            Value="{Binding Radius.Value}" />

        <BaseControl:ToggleButton
            Caption="Show Helper"
            IsChecked="{Binding LightHelper.Value}" />
    </StackPanel>

</UserControl>
