<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LightPoint"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <StackPanel>

        <ui:VectorXYZ
            Caption="Position"
            DataContext="{Binding Position}" />

        <ui:DragValue
            Margin="0,8"
            Caption="Radius"
            Value="{Binding Radius.Value}"
            ResetCommand="{Binding Radius.ResetCommand}" />

        <ui:CaptionedToggleButton
            Caption="Show Helper"
            IsChecked="{Binding LightHelper.Value}"
            ResetCommand="{Binding LightHelper.ResetCommand}" />
    </StackPanel>

</UserControl>
