<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LightEntity"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels">

    <StackPanel>
        <Panels:IndentedExpander Header="Transform" IsExpanded="{Binding TransformSRTIsExpanded}">
            <Views:TransformSRT Margin="8" DataContext="{Binding TransformSRT}" />
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Modifiers" IsExpanded="{Binding ModifierManagerIsExpanded}">
            <Views:ModifierManager DataContext="{Binding ModifierManager}">
                <Views:ModifierManager.SelectionPanel>
                    <Views:AutoSelectionPanel PanelOwner="{x:Type Lights:LightEntity}" />
                </Views:ModifierManager.SelectionPanel>
            </Views:ModifierManager>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander
            Header="Settings"
            Indentation="0"
            IsExpanded="{Binding SettingsIsExpanded}">
            <Views:LightSettings DataContext="{Binding Settings}" />
        </Panels:IndentedExpander>

    </StackPanel>

</UserControl>
