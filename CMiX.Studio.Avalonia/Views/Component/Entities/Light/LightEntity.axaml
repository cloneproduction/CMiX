<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LightEntity"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    d:DesignHeight="600">

    <StackPanel>
      
        <ui:IndentedExpander 
          Header="Transform" 
          IsExpanded="{Binding TransformSRTIsExpanded}">
          
            <Views:TransformSRT Margin="8" DataContext="{Binding TransformSRT}" />
          
        </ui:IndentedExpander>

        <Views:EntityModifiersSection PanelOwner="{x:Type Lights:LightEntity}" />

        <ui:IndentedExpander
          Header="Settings"
          IsExpanded="{Binding SettingsIsExpanded}">
          
          <Views:LightSettings DataContext="{Binding Settings}" />
          
        </ui:IndentedExpander>

    </StackPanel>

</UserControl>
