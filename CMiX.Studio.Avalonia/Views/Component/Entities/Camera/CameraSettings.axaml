<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.CameraSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Margin="8">

        <ui:Vector3 
            Caption="Target" 
            DataContext="{Binding Target}" />

        <ui:StackPanelPositioned Margin="0,8" Spacing="{DynamicResource SpacingXXS}">

            <ui:DragValue
                Caption="Near"
                DataContext="{Binding NearClip}"
                Value="{Binding Value}"
                ResetCommand="{Binding ResetCommand}" />

            <ui:DragValue
                Caption="Far"
                DataContext="{Binding FarClip}"
                Value="{Binding Value}"
                ResetCommand="{Binding ResetCommand}" />

        </ui:StackPanelPositioned>

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <ui:DragValue
                Caption="Yaw"
                DataContext="{Binding Yaw}"
                Value="{Binding Value}"
                ResetCommand="{Binding ResetCommand}" />

            <ui:DragValue
                Caption="Pitch"
                DataContext="{Binding Pitch}"
                Value="{Binding Value}"
                ResetCommand="{Binding ResetCommand}" />

        </ui:StackPanelPositioned>

        <ui:ToggleButtonCaptioned
            Margin="0,8"
            Caption="Orthographic"
            IsChecked="{Binding IsOrthographic.Value}"
            ResetCommand="{Binding IsOrthographic.ResetCommand}" />

        <Border IsVisible="{Binding IsOrthographic.Value}">
            <ui:DragValue
                Caption="Orthographic Size"
                DataContext="{Binding OrthographicSize}"
                Value="{Binding Value}"
                ResetCommand="{Binding ResetCommand}" />
        </Border>

        <Border IsVisible="{Binding !IsOrthographic.Value}">

            <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

                <ui:DragValue
                    Caption="Distance"
                    DataContext="{Binding Distance}"
                    Value="{Binding Value}"
                    ResetCommand="{Binding ResetCommand}" />

                <ui:DragValue
                    Caption="FOV"
                    DataContext="{Binding FOV}"
                    Value="{Binding Value}"
                    ResetCommand="{Binding ResetCommand}" />

            </ui:StackPanelPositioned>

        </Border>
    </StackPanel>
</UserControl>
