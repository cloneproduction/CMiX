<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ModelEntity"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="modelEntity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    d:DesignHeight="600">

  <StackPanel Spacing="{DynamicResource SpacingMD}">
      
        <ui:ColorSelector
            Margin="8, 8, 8, 0"
            Caption="Color"
            DataContext="{Binding Color}" />
    
    <StackPanel Spacing="{DynamicResource SpacingXS}">
      
      <ui:ExpanderIndented
          Header="Transform" IsExpanded="{Binding TransformSRTIsExpanded}">
        <Views:TransformSRT Margin="8" DataContext="{Binding TransformSRT}" />
      </ui:ExpanderIndented>

      <Views:EntityModifiersSection
          PanelOwner="{x:Type Compositing:Entity}" />

      <ui:ExpanderIndented
          Header="Texture"
          IsExpanded="{Binding TextureIsExpanded}">

        <StackPanel>

          <Views:DiffuseTexture DataContext="{Binding Texture.DiffuseTexture}" />

          <ui:ExpanderIndented
              Indentation="4"
              IsExpanded="{Binding Texture.MaskTexture.IsExpanded}">

            <ui:ExpanderIndented.Header>
              <DockPanel>
                <ui:ToggleButtonCMiX
                    Width="{DynamicResource ControlHeightXS}"
                    Height="{DynamicResource ControlHeightXS}"
                    IsChecked="{Binding Texture.MaskTexture.IsEnabled.Value, Mode=TwoWay}"
                    ResetCommand="{Binding Texture.MaskTexture.IsEnabled.ResetCommand}"
                    Theme="{StaticResource ToggleButtonIcon}" />
                <TextBlock Margin="8,0" Text="Mask" />
              </DockPanel>
            </ui:ExpanderIndented.Header>

            <Views:MaskTexture DataContext="{Binding Texture.MaskTexture}" />

          </ui:ExpanderIndented>

        </StackPanel>

      </ui:ExpanderIndented>

      <ui:ExpanderIndented
        Header="Transform Texture"
        IsExpanded="{Binding TransformTextureIsExpanded}">

        <StackPanel Margin="8" Spacing="{DynamicResource SpacingMD}">

          <Views:Transform2D
            DataContext="{Binding Texture.DiffuseTexture.Transform2D}"  />

          <Views:SamplerState
            DataContext="{Binding Texture.DiffuseTexture.SamplerState}"/>

        </StackPanel>

      </ui:ExpanderIndented>

      <ui:ExpanderIndented
        Header="Material"
        IsExpanded="{Binding MaterialIsExpanded}">

        <Border IsVisible="{Binding Material, Converter={StaticResource NullToVisibility}}">
          <Views:Material DataContext="{Binding Material}" />
        </Border>

      </ui:ExpanderIndented>

      <ui:ExpanderIndented Header="Geometry" IsExpanded="{Binding MeshIsExpanded}">
        <Views:Mesh Margin="8" DataContext="{Binding Mesh}" />
      </ui:ExpanderIndented>

    </StackPanel>

    </StackPanel>

</UserControl>
