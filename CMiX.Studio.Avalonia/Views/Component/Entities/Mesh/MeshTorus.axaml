<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.MeshTorus"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Views:MeshShapeFrame>

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <ui:DragValue
                Caption="Radius"
                Value="{Binding Radius.Value}"
                ResetCommand="{Binding Radius.ResetCommand}" />

            <ui:DragValue
                Caption="Thickness"
                Value="{Binding Thickness.Value}"
                ResetCommand="{Binding Thickness.ResetCommand}" />

        </ui:StackPanelPositioned>

    </Views:MeshShapeFrame>

</UserControl>
