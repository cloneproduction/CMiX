<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.MeshPlane"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <StackPanel>

        <ui:Vector2
            Caption="Scale"
            DataContext="{Binding Scale}" />

        <ui:Vector3
            Margin="0,8"
            Caption="Offset"
            DataContext="{Binding Offset}" />

        <ui:Integer2
            Margin="0,0,0,8"
            Caption="Tessellation"
            DataContext="{Binding TessellationXY}" />

        <ui:CaptionedToggleButton
            Caption="Generate Backface"
            IsChecked="{Binding GenerateBackFace.Value}"
            ResetCommand="{Binding GenerateBackFace.ResetCommand}" />

    </StackPanel>

</UserControl>
