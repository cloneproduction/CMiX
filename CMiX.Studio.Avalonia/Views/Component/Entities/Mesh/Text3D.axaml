<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Text3D"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources">

    <StackPanel>

        <TextBox
            Height="44"
            Text="{Binding Text.Value}"
            Theme="{StaticResource TypeWriterStyle}" />

        <ui:StackPanelPositioned Margin="0,8,0,0" Spacing="{DynamicResource SpacingXXS}">
            
            <ui:ComboBoxCaptioned
                Caption="Font Family"
                ItemsSource="{x:Static Resources:EnumProviders.SortedFontsCollection}"
                ResetCommand="{Binding FontFamily.ResetCommand}"
                SelectedItem="{Binding FontFamily.Value, Converter={StaticResource FontFamilyToString}}" />

            <ui:IntegerValue
                Caption="Size"
                DataContext="{Binding FontSize}"
                Value="{Binding Value}" />
        </ui:StackPanelPositioned>

        <ui:DragValue
            Margin="0,8"
            Caption="Extrude Amount"
            Value="{Binding ExtrudeAmount.Value}"
            ResetCommand="{Binding ExtrudeAmount.ResetCommand}" />

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">
            <ui:ComboBoxCaptioned
                Caption="Text Alignment"
                ItemsSource="{x:Static Resources:EnumProviders.HorizontalAlignment}"
                ResetCommand="{Binding HorizontalAlignment.ResetCommand}"
                SelectedItem="{Binding HorizontalAlignment.Value}" />

            <ui:ComboBoxCaptioned
                Caption="Paragraph Alignment"
                ItemsSource="{x:Static Resources:EnumProviders.ParagraphAlignment}"
                ResetCommand="{Binding ParagraphAlignment.ResetCommand}"
                SelectedItem="{Binding ParagraphAlignment.Value}" />
        </ui:StackPanelPositioned>

    </StackPanel>

</UserControl>
