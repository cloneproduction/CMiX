<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.MeshFile"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Views:PathSelector
        VerticalAlignment="Top"
        DataContext="{Binding Geometry}"
        ItemsSource="{Binding AssetRepository.Geometries}"
        SelectedItem="{Binding Asset}" />

</UserControl>
