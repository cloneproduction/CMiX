<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ScaleOffsetEditor"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <StackPanel>

        <BaseControl:VectorXYZ
            Caption="Scale"
            DataContext="{Binding Scale}" />

        <BaseControl:VectorXYZ
            Margin="0,8"
            Caption="Offset"
            DataContext="{Binding Offset}" />

    </StackPanel>

</UserControl>
