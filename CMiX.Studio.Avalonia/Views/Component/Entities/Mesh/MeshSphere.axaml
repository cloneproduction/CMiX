<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.MeshSphere"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Views:FrameMeshShape>

        <ui:DragValue
            Caption="Radius"
            Value="{Binding Radius.Value}"
            ResetCommand="{Binding Radius.ResetCommand}" />

    </Views:FrameMeshShape>

</UserControl>
