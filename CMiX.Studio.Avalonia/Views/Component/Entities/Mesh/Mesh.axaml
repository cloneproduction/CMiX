<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Mesh"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Texturing="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:ViewModels="clr-namespace:CMiX.Core;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:StudioControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" 
    d:DesignWidth="400">

    <StackPanel>

        <ui:CaptionedComboBox
            Caption="Type"
            ItemsSource="{x:Static Resources:EnumProviders.MeshType}"
            ResetCommand="{Binding MeshTypeSelector.ResetCommand}"
            SelectedItem="{Binding MeshTypeSelector.Value}" />

        <Panel Margin="0, 8">

            <Border IsVisible="{Binding MeshTypeSelector.Value, 
                Converter={x:Static ui:EnumMatchConverter.Instance}, 
                ConverterParameter={x:Static ViewModels:MeshType.Text}}">
                <Views:Text3D DataContext="{Binding Text3DSettings}" />
            </Border>

            <Views:MeshBox 
                IsVisible="{Binding MeshTypeSelector.Value, 
                Converter={x:Static ui:EnumMatchConverter.Instance}, 
                ConverterParameter={x:Static ViewModels:MeshType.Box}}"/>

            <Views:MeshSphere 
                IsVisible="{Binding MeshTypeSelector.Value, 
                Converter={x:Static ui:EnumMatchConverter.Instance}, 
                ConverterParameter={x:Static ViewModels:MeshType.Sphere}}"/>

            <Views:MeshTorus 
                IsVisible="{Binding MeshTypeSelector.Value, 
                Converter={x:Static ui:EnumMatchConverter.Instance}, 
                ConverterParameter={x:Static ViewModels:MeshType.Torus}}"/>

            <Views:MeshCone 
                IsVisible="{Binding MeshTypeSelector.Value, 
                Converter={x:Static ui:EnumMatchConverter.Instance}, 
                ConverterParameter={x:Static ViewModels:MeshType.Cone}}"/>

             <Views:MeshCylinder 
                 IsVisible="{Binding MeshTypeSelector.Value, 
                 Converter={x:Static ui:EnumMatchConverter.Instance}, 
                 ConverterParameter={x:Static ViewModels:MeshType.Cylinder}}"/>

             <Views:MeshPlane 
                 IsVisible="{Binding MeshTypeSelector.Value, 
                 Converter={x:Static ui:EnumMatchConverter.Instance}, 
                 ConverterParameter={x:Static ViewModels:MeshType.Plane}}"/>

             <Views:MeshFile 
                 IsVisible="{Binding MeshTypeSelector.Value, 
                 Converter={x:Static ui:EnumMatchConverter.Instance}, 
                 ConverterParameter={x:Static ViewModels:MeshType.FromFile}}"/>

        </Panel>

        <ui:IndentedExpander
            Header="Geometry FX"
            Indentation="4"
            IsExpanded="False">

            <StackPanel 
              Margin="8" 
              Spacing="{DynamicResource SpacingMD}">

                <ui:DragValue
                    Caption="Explode Strength"
                    Value="{Binding ExplodeStrength.Value}"
                    ResetCommand="{Binding ExplodeStrength.ResetCommand}" />

                <ui:CMiXSlider
                    Caption="Flat Normals"
                    Maximum="1.0"
                    Minimum="0.0"
                    Value="{Binding FlatNormals.Value}"
                    ResetCommand="{Binding FlatNormals.ResetCommand}" />

                <StudioControls:Outliner
                    DataContext="{Binding ExplodeTriangleTextureManager}"
                    ItemsSource="{Binding ControlRepository.Textures}">
                    <StudioControls:Outliner.SelectionPanel>
                        <ui:PopupButton Caption="New Control Texture">
                            <ui:PopupButton.SelectionPanel>
                                <Managers:AutoSelectionPanel Interface="{x:Type Texturing:ITextureSource}" />
                            </ui:PopupButton.SelectionPanel>
                        </ui:PopupButton>
                    </StudioControls:Outliner.SelectionPanel>
                </StudioControls:Outliner>

                <Border IsVisible="{Binding ExplodeTriangleTextureManager.SelectedItem, Converter={StaticResource NullToVisibility}}">
                    <Views:Texture DataContext="{Binding ExplodeTriangleTextureManager.SelectedItem}" />
                </Border>
            </StackPanel>

        </ui:IndentedExpander>

        <ui:IndentedExpander

            Header="Displacement"
            Indentation="4"
            IsExpanded="False">

            <StackPanel 
              Margin="8" 
              Spacing="{DynamicResource SpacingMD}">

                <ui:DragValue
                  Caption="Strength"
                  Value="{Binding DisplacementStrength.Value}"
                  ResetCommand="{Binding DisplacementStrength.ResetCommand}" />

                <StudioControls:Outliner
                    Margin="0"
                    DataContext="{Binding DisplacementTextureManager}"
                    ItemsSource="{Binding ControlRepository.Textures}">
                  
                    <StudioControls:Outliner.SelectionPanel>
                        <ui:PopupButton Caption="New Control Texture">
                            <ui:PopupButton.SelectionPanel>
                                <Managers:AutoSelectionPanel Interface="{x:Type Texturing:ITextureSource}" />
                            </ui:PopupButton.SelectionPanel>
                        </ui:PopupButton>
                    </StudioControls:Outliner.SelectionPanel>
                </StudioControls:Outliner>

                <Border IsVisible="{Binding DisplacementTextureManager.SelectedItem, Converter={StaticResource NullToVisibility}}">
                    <Views:Texture DataContext="{Binding DisplacementTextureManager.SelectedItem}" />
                </Border>
            </StackPanel>

        </ui:IndentedExpander>
    </StackPanel>

</UserControl>