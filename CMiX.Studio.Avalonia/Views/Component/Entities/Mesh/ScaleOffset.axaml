<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ScaleOffset"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <StackPanel>

        <ui:Vector3
            Caption="Scale"
            DataContext="{Binding Scale}" />

        <ui:Vector3
            Margin="0,8"
            Caption="Offset"
            DataContext="{Binding Offset}" />

    </StackPanel>

</UserControl>
