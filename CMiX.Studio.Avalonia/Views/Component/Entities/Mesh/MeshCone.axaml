<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.MeshCone"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Mesh="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel>

        <Mesh:ScaleOffset />

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <ui:DragValue
                Caption="Radius"
                Value="{Binding Radius.Value}"
                ResetCommand="{Binding Radius.ResetCommand}" />

            <ui:DragValue
                Caption="Height"
                Value="{Binding Height.Value}"
                ResetCommand="{Binding Height.ResetCommand}" />

        </ui:StackPanelPositioned>

        <ui:IntegerValue
            Margin="0,8,0,0"
            Caption="Tessellation"
            Minimum="1"
            Value="{Binding Tessellation.Value}"
            ResetCommand="{Binding Tessellation.ResetCommand}" />

    </StackPanel>

</UserControl>
