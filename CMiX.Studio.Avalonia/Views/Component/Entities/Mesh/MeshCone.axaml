<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.MeshCone"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Mesh="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels">

    <StackPanel>

        <Mesh:ScaleOffsetEditor />

        <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <BaseControl:DragValue
                Caption="Radius"
                Value="{Binding Radius.Value}" />

            <BaseControl:DragValue
                Caption="Height"
                Value="{Binding Height.Value}" />

        </Panels:PositionedStackPanel>

        <BaseControl:IntegerValue
            Margin="0,8,0,0"
            Caption="Tessellation"
            Minimum="1"
            Value="{Binding Tessellation.Value}" />

    </StackPanel>

</UserControl>
