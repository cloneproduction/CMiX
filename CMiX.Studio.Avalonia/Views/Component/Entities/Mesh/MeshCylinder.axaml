<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.MeshCylinder"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <Views:FrameMeshShape>

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <ui:DragValue
                Caption="Radius"
                DataContext="{Binding Radius}"
                Value="{Binding Value}"
                ResetCommand="{Binding ResetCommand}" />

            <ui:DragValue
                Caption="Height"
                DataContext="{Binding Height}"
                Value="{Binding Value}"
                ResetCommand="{Binding ResetCommand}" />

        </ui:StackPanelPositioned>

    </Views:FrameMeshShape>

</UserControl>
