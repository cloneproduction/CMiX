<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.MeshCylinder"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Mesh="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel>

        <Mesh:ScaleOffsetEditor />

        <ui:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <ui:DragValue
                Caption="Radius"
                Value="{Binding Radius.Value}"
                ResetCommand="{Binding Radius.ResetCommand}" />

            <ui:DragValue
                Caption="Height"
                Value="{Binding Height.Value}"
                ResetCommand="{Binding Height.ResetCommand}" />

        </ui:PositionedStackPanel>

        <ui:IntegerValue
            Margin="0,8,0,0"
            Caption="Tessellation"
            DataContext="{Binding Tessellation}"
            Minimum="1"
            Value="{Binding Value}" />

    </StackPanel>

</UserControl>
