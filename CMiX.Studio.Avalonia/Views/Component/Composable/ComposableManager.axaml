<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ComposableManager"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    d:DesignHeight="450">

    <Border >
        <DockPanel >

            <views:ComposableManagerToolbar 
                Background="{DynamicResource Grey300Brush}"
                DockPanel.Dock="Bottom" 
                Padding="4"/>

            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource Grey200Brush}"
                    IsVisible="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
                <StackPanel Margin="8" DataContext="{Binding SelectedItem}">
                    <views:ComposableManagerMaskSettings IsVisible="{Binding Mask.IsMask.Value}" />
                    <views:ComposableManagerSettings />
                </StackPanel>
            </Border>

            <ListBox
                DockPanel.Dock="Top"
                ui:ListBoxReorder.Service="{Binding ManagerReorderService}"
                ItemsSource="{Binding ManagerData.Items}"
                SelectedIndex="{Binding ManagerData.SelectedIndex}"
                SelectedItem="{Binding SelectedItem}"
                Theme="{StaticResource ListBoxComposable}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <views:ComposableManagerItem DragHandleIsPressed="{Binding $parent[ListBox].DataContext.ManagerReorderService.DragHandleIsPressed, Mode=TwoWay}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
