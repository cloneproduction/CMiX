<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ComposableManagerToolbar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <DockPanel 

        LastChildFill="False">

        <Button
            Height="{DynamicResource ControlHeightMD}"
            Width="{DynamicResource ControlHeightMD}"
            Background="Transparent"
            Command="{Binding AddItemCommand}"
            CommandParameter="{Binding $parent[Views:ComposableManager].ItemType}"
            Theme="{StaticResource ButtonRounded}">
            <Button.Content>
                <ui:AppIcon Opacity="0.9" IconKey="Add" Size="{DynamicResource IconSizeXS}" />
            </Button.Content>
        </Button>

        <Button
            x:Name="DuplicateButton"
            Height="{DynamicResource ControlHeightMD}"
            Width="{DynamicResource ControlHeightMD}"
            Background="Transparent"
            Command="{Binding DuplicateItemCommand}"
            CommandParameter="{Binding SelectedItem}"
            IsEnabled="{Binding ManagerData.Items.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=0}"
            Theme="{StaticResource ButtonRounded}">
            <Button.Content>
                <ui:AppIcon Opacity="0.9" IconKey="Duplicate" Size="{DynamicResource IconSizeXS}" />
            </Button.Content>
        </Button>

        <Border IsEnabled="{Binding ManagerData.Items.Count, Converter={StaticResource CountToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <Button
                    Height="{DynamicResource ControlHeightMD}"
                    Width="{DynamicResource ControlHeightMD}"
                    Background="Transparent"
                    Command="{Binding ManagerReorderService.MoveItemUpCommand}"
                    CommandParameter="{Binding SelectedItem}"
                    Theme="{StaticResource ButtonRounded}">
                    <Button.Content>
                        <ui:AppIcon Opacity="0.9" IconKey="ArrowUp" Size="{DynamicResource IconSizeXS}" />
                    </Button.Content>
                </Button>

                <Button
                    Height="{DynamicResource ControlHeightMD}"
                    Width="{DynamicResource ControlHeightMD}"
                    Background="Transparent"
                    Command="{Binding ManagerReorderService.MoveItemDownCommand}"
                    CommandParameter="{Binding SelectedItem}"
                    Theme="{StaticResource ButtonRounded}">
                    <Button.Content>
                        <ui:AppIcon Opacity="0.9" IconKey="ArrowDown" Size="{DynamicResource IconSizeXS}" />
                    </Button.Content>
                </Button>
            </StackPanel>
        </Border>

        <Button
            x:Name="RemoveButton"
            Height="{DynamicResource ControlHeightMD}"
            Width="{DynamicResource ControlHeightMD}"
            Background="Transparent"
            Command="{Binding RemoveItemCommand}"
            CommandParameter="{Binding SelectedItem}"
            DockPanel.Dock="Right"
            IsEnabled="{Binding ManagerData.Items.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=0}"
            Theme="{StaticResource ButtonRounded}">
            <Button.Content>
                <ui:AppIcon Opacity="0.9" IconKey="Remove" Size="{DynamicResource IconSizeXS}" />
            </Button.Content>
        </Button>

    </DockPanel>
</UserControl>
