<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ComposableManagerItem"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <Border
        Background="Transparent"
        PointerPressed="Border_PointerPressed"
        PointerReleased="Border_PointerReleased">

        <DockPanel MinHeight="{DynamicResource ControlHeightMD}">

            <StackPanel
                Margin="4,0"
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Spacing="{DynamicResource SpacingSM}">

                <ToggleButton
                    IsChecked="{Binding PrefabService.Visibility.Value}"
                    Theme="{DynamicResource ToggleButtonVisibility}" />

                <ToggleButton
                    IsChecked="{Binding PrefabService.IsUpdating.Value}"
                    Theme="{DynamicResource ToggleButtonUpdate}"
                    ToolTip.Tip="Update" />

                <ToggleButton
                    IsChecked="{Binding Mask.IsMask.Value}"
                    Theme="{DynamicResource ToggleButtonMask}"
                    ToolTip.Tip="Mask" />

            </StackPanel>

            <!-- The name starts 8 from the left: 1 of the item padding, 3 of the margin and 4 of the text padding. -->
            <ui:TextBoxEditable
                x:Name="editableTextBox"
                Height="{DynamicResource ControlHeightSM}"
                Margin="3,0,0,0"
                Foreground="{DynamicResource ForegroundBrush}"
                Text="{Binding PrefabService.Name.Value, Mode=TwoWay}" />

        </DockPanel>

    </Border>
</UserControl>
