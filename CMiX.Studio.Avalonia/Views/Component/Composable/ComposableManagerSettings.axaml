<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ComposableManagerSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:ComboBoxCaptioned
            IsVisible="{Binding !Mask.IsMask.Value}"
            Caption="Blend Mode"
            ItemsSource="{x:Static Resources:EnumProviders.BlendMode}"
            ResetCommand="{Binding Compositing.BlendMode.ResetCommand}"
            SelectedItem="{Binding Compositing.BlendMode.Value, Mode=TwoWay}" />

        <ui:ColorSelector
            Caption="Background"
            DataContext="{Binding Compositing.BackgroundColor}" />

        <ui:SliderCMiX
            Height="{DynamicResource ControlHeightMD}"
            Caption="Alpha"
            Maximum="1"
            Minimum="0"
            Value="{Binding Compositing.Opacity.Value}"
            ResetCommand="{Binding Compositing.Opacity.ResetCommand}" />

    </StackPanel>

</UserControl>
