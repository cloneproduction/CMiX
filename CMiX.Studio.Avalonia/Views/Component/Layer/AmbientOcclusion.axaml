<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.AmbientOcclusion"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="ambientOcclusion">

    <ui:ExpanderIndented>

        <ui:ExpanderIndented.Header>

            <DockPanel>

                <ui:ToggleButtonCMiX
                    IsChecked="{Binding DataContext.IsEnabled.Value, ElementName=ambientOcclusion, Mode=TwoWay}"
                    ResetCommand="{Binding DataContext.IsEnabled.ResetCommand, ElementName=ambientOcclusion}"
                    Theme="{DynamicResource ToggleButtonBox}" />

                <TextBlock
                    Margin="8,0"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Text="Ambient Occlusion" />

            </DockPanel>

        </ui:ExpanderIndented.Header>

        <Border Margin="8" IsEnabled="{Binding IsEnabled.Value}">

            <StackPanel Spacing="{DynamicResource SpacingMD}">

                <ui:DragValueInteger Caption="Samples" DataContext="{Binding Samples}" Value="{Binding Value}" ResetCommand="{Binding ResetCommand}" />

                <ui:DragValue
                    Caption="Intensity"
                    DataContext="{Binding Intensity}"
                    Value="{Binding Value}"
                    ResetCommand="{Binding ResetCommand}" />

                <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">
                    <ui:DragValue
                        Caption="SampleBias"
                        DataContext="{Binding SampleBias}"
                        Value="{Binding Value}"
                        ResetCommand="{Binding ResetCommand}" />
                    <ui:DragValue
                        Caption="SampleRadius"
                        DataContext="{Binding SampleRadius}"
                        Value="{Binding Value}"
                        ResetCommand="{Binding ResetCommand}" />
                </ui:StackPanelPositioned>

                <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">
                    <ui:DragValueInteger
                        Caption="Blur Count"
                        DataContext="{Binding BlurCount}"
                        Value="{Binding Value}"
                        ResetCommand="{Binding ResetCommand}" />
                    <ui:DragValue
                        Caption="Blur Radius"
                        DataContext="{Binding BlurRadius}"
                        Value="{Binding Value}"
                        ResetCommand="{Binding ResetCommand}" />
                </ui:StackPanelPositioned>

                <ui:DragValue
                    Margin="0,0,0,8"
                    Caption="Edge Sharpness"
                    DataContext="{Binding EdgeSharpness}"
                    Value="{Binding Value}"
                    ResetCommand="{Binding ResetCommand}" />

            </StackPanel>

        </Border>

    </ui:ExpanderIndented>

</UserControl>
