<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.AmbientOcclusion"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="ambientOcclusion">

    <ui:ExpanderIndented>

        <ui:ExpanderIndented.Header>

            <DockPanel>

                <ui:ToggleButtonCMiX
                    Width="{DynamicResource ControlHeightXS}"
                    Height="{DynamicResource ControlHeightXS}"
                    IsChecked="{Binding DataContext.IsEnabled.Value, ElementName=ambientOcclusion, Mode=TwoWay}"
                    ResetCommand="{Binding DataContext.IsEnabled.ResetCommand, ElementName=ambientOcclusion}"
                    Theme="{DynamicResource ToggleButtonRounded}" />

                <TextBlock
                    Margin="8,0"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Text="Ambient Occlusion" />

            </DockPanel>

        </ui:ExpanderIndented.Header>

        <Border Margin="8" IsEnabled="{Binding IsEnabled.Value}">

            <StackPanel Spacing="{DynamicResource SpacingMD}">

                <ui:IntegerValue Caption="Samples" Value="{Binding Samples.Value}" ResetCommand="{Binding Samples.ResetCommand}" />

                <ui:DragValue
                    Caption="Intensity"
                    Value="{Binding Intensity.Value}"
                    ResetCommand="{Binding Intensity.ResetCommand}" />

                <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">
                    <ui:DragValue
                        Caption="SampleBias"
                        Value="{Binding SampleBias.Value}"
                        ResetCommand="{Binding SampleBias.ResetCommand}" />
                    <ui:DragValue
                        Caption="SampleRadius"
                        Value="{Binding SampleRadius.Value}"
                        ResetCommand="{Binding SampleRadius.ResetCommand}" />
                </ui:StackPanelPositioned>

                <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">
                    <ui:IntegerValue
                        Caption="Blur Count"
                        Value="{Binding BlurCount.Value}"
                        ResetCommand="{Binding BlurCount.ResetCommand}" />
                    <ui:DragValue
                        Caption="Blur Radius"
                        Value="{Binding BlurRadius.Value}"
                        ResetCommand="{Binding BlurRadius.ResetCommand}" />
                </ui:StackPanelPositioned>

                <ui:DragValue
                    Margin="0,0,0,8"
                    Caption="Edge Sharpness"
                    Value="{Binding EdgeSharpness.Value}"
                    ResetCommand="{Binding EdgeSharpness.ResetCommand}" />

            </StackPanel>

        </Border>

    </ui:ExpanderIndented>

</UserControl>
