<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LocalReflection"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="localReflection">

    <ui:ExpanderIndented>

        <ui:ExpanderIndented.Header>
            <DockPanel>
                <ui:ToggleButtonCMiX
                    IsChecked="{Binding DataContext.IsEnabled.Value, ElementName=localReflection, Mode=TwoWay}"
                    ResetCommand="{Binding DataContext.IsEnabled.ResetCommand, ElementName=localReflection}"
                    Theme="{DynamicResource ToggleButtonPower}" />
                <TextBlock
                    Margin="8,0"
                    Foreground="{DynamicResource ForegroundBrush}"
                    Text="Local Reflection" />
            </DockPanel>
        </ui:ExpanderIndented.Header>

        <Border Margin="8" IsEnabled="{Binding IsEnabled.Value}">

        </Border>

    </ui:ExpanderIndented>
</UserControl>
