<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LayerLightTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers">

    <ScrollViewer Theme="{StaticResource ScrollViewerOverlayKeepOffset}">
        <Managers:PrefabSlotEditor DataContext="{Binding LightManager}" ItemsSource="{Binding ControlRepository.Lights}">

            <Managers:PrefabSlotEditor.SelectionPanel>
                <Button
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{x:Type Lights:LightEntity}"
                    Content="New Light" />
            </Managers:PrefabSlotEditor.SelectionPanel>

            <Managers:PrefabSlotEditor.EditingPanel>
                <Views:LightEntity />
            </Managers:PrefabSlotEditor.EditingPanel>

        </Managers:PrefabSlotEditor>
    </ScrollViewer>

</UserControl>
