<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LayerCameraTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers">

    <ScrollViewer Theme="{StaticResource ScrollViewerOverlayKeepOffset}">
        <Managers:PrefabSlotEditor DataContext="{Binding CameraManager}" ItemsSource="{Binding ControlRepository.Cameras}">

            <Managers:PrefabSlotEditor.SelectionPanel>
                <Button
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{x:Type Cameras:Camera}"
                    Content="New Camera" />
            </Managers:PrefabSlotEditor.SelectionPanel>

            <Managers:PrefabSlotEditor.EditingPanel>
                <Views:Camera />
            </Managers:PrefabSlotEditor.EditingPanel>

        </Managers:PrefabSlotEditor>
    </ScrollViewer>

</UserControl>
