<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LayerPostFXTab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Filters="clr-namespace:CMiX.Core.Texturing.Filters;assembly=CMiX.Core"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">

        <i:Interaction.Behaviors>
            <ui:ScrollViewerBehavior />
        </i:Interaction.Behaviors>

        <StackPanel>
            <ui:ExpanderIndented Header="Texture Filters">
                <Views:ModifierManager
                    Caption="Add Filter"
                    Margin="8"
                    DataContext="{Binding TextureModifierManager}">

                    <Views:ModifierManager.SelectionPanel>
                        <Managers:AutoSelectionPanel Interface="{x:Type Filters:ITextureFilter}" />
                    </Views:ModifierManager.SelectionPanel>

                </Views:ModifierManager>
            </ui:ExpanderIndented>

            <ui:ExpanderIndented Header="Modifiers">
                <Views:ModifierManager
                    Caption="Add Modifier"
                    Margin="8"
                    DataContext="{Binding ModifierManager}">

                    <Views:ModifierManager.SelectionPanel>
                        <Managers:AutoSelectionPanel PanelOwner="{x:Type Compositing:Layer}" />
                    </Views:ModifierManager.SelectionPanel>

                </Views:ModifierManager>
            </ui:ExpanderIndented>

            <Views:AmbientOcclusion DataContext="{Binding AmbientOcclusion}" />

            <Views:LocalReflection DataContext="{Binding LocalReflection}" IsVisible="False" />

        </StackPanel>
    </ScrollViewer>

</UserControl>
