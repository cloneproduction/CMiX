<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Composition"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Filters="clr-namespace:CMiX.Core.Texturing.Filters;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">

        <i:Interaction.Behaviors>
            <ui:ScrollViewerBehavior />
        </i:Interaction.Behaviors>

        <StackPanel>

            <ui:ExpanderIndented
                Header="Filters"
                IsExpanded="{Binding TextureModifierIsExpanded}">
                <Views:ModifierManager Caption="Add Filter" Margin="8, 0, 8, 8" DataContext="{Binding TextureModifierManager}">
                    <Views:ModifierManager.SelectionPanel>
                        <Managers:AutoSelectionPanel Interface="{x:Type Filters:ITextureFilter}" />
                    </Views:ModifierManager.SelectionPanel>
                </Views:ModifierManager>
            </ui:ExpanderIndented>

            <ui:ExpanderIndented
                Header="Modifiers"
                IsExpanded="{Binding ModifierIsExpanded}">
                <Views:ModifierManager Caption="Add Modifier" Margin="8, 0, 8, 8" DataContext="{Binding ModifierManager}">
                    <Views:ModifierManager.SelectionPanel>
                        <Managers:AutoSelectionPanel PanelOwner="{x:Type Compositing:Composition}" />
                    </Views:ModifierManager.SelectionPanel>
                </Views:ModifierManager>
            </ui:ExpanderIndented>

            <ui:ExpanderIndented
                Header="Settings"
                IsExpanded="{Binding OutputSettingsIsExpanded}">
                <Views:CompositionSettings Margin="8" DataContext="{Binding}" />
            </ui:ExpanderIndented>

        </StackPanel>

    </ScrollViewer>

</UserControl>
