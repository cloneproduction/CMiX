<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.CompositionSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <StackPanel>
        <ui:CaptionedComboBox
            Caption="Output Mapping"
            ItemsSource="{Binding Project.OutputMappingManager.VisibleItems}"
            SelectedItem="{Binding SelectedOutputMapping}">
            <ui:CaptionedComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name.Value}" />
                </DataTemplate>
            </ui:CaptionedComboBox.ItemTemplate>
        </ui:CaptionedComboBox>

    </StackPanel>

</UserControl>