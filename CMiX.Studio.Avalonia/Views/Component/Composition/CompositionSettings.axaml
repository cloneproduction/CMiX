<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.CompositionSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <StackPanel>
        <ui:ComboBoxCaptioned
            Caption="Output Mapping"
            ItemsSource="{Binding Project.OutputMappingManager.Items}"
            SelectedItem="{Binding SelectedOutputMapping}">
            <ui:ComboBoxCaptioned.ItemTemplate>
                <DataTemplate>
                    <ui:TextBlockTrimmed Text="{Binding Name.Value}" />
                </DataTemplate>
            </ui:ComboBoxCaptioned.ItemTemplate>
        </ui:ComboBoxCaptioned>

    </StackPanel>

</UserControl>