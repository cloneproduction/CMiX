<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.CompositionSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel>
        <BaseControl:ComboBox
            Caption="Output Mapping"
            ItemsSource="{Binding Project.OutputMappingManager.VisibleItems}"
            SelectedItem="{Binding SelectedOutputMapping}">
            <BaseControl:ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name.Value}" />
                </DataTemplate>
            </BaseControl:ComboBox.ItemTemplate>
        </BaseControl:ComboBox>

        <Views:PathSelector
            Margin="0,8,0,0"
            DataContext="{Binding Model}"
            ItemsSource="{Binding AssetRepository.Geometries}"
            SelectedItem="{Binding Asset}" />
    </StackPanel>

</UserControl>
