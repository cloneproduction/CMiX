<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.CompositionSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources">

    <StackPanel>
        <BaseControl:ColorSelector
            Caption="Background Color"
            DataContext="{Binding BackgroundColor}" />
        <BaseControl:Integer2Value
        Margin="0, 8"
            Caption="Resolution"
            DataContext="{Binding Resolution}" />
        <BaseControl:ComboBox
            Caption="Texcoord"
            ItemsSource="{x:Static Resources:EnumProviders.TexcoordSemantic}"
            SelectedItem="{Binding TexcoordSemantic.Value}" />
        <BaseControl:ComboBox
            Margin="0, 8"
            Caption="Blend Mode"
            ItemsSource="{x:Static Resources:EnumProviders.BlendMode}"
            SelectedItem="{Binding BlendMode.Value}" />
        <BaseControl:CMiXSlider
            Height="{DynamicResource ControlHeightMD}"
            Caption="Alpha"
            Maximum="1"
            Minimum="0"
            Value="{Binding Opacity.Value}" />
    </StackPanel>

</UserControl>
