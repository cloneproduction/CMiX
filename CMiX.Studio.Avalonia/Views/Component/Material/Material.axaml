<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Material"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="material"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

      <Views:MaterialSettings Margin="8" DataContext="{Binding MaterialSettings}" />

    </StackPanel>

</UserControl>
