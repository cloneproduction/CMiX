<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Material"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    x:Name="uc"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <Panels:IndentedExpander
            Header="Settings"
            Indentation="4"
            IsExpanded="{Binding MaterialSettings.IsExpanded}">
            <Views:MaterialSettings Margin="{StaticResource SpacingMD}" DataContext="{Binding MaterialSettings}" />
        </Panels:IndentedExpander>

        <Panels:IndentedExpander
            Header="Modifiers"
            Indentation="4"
            IsExpanded="{Binding ModifierManagerIsExpanded}">
            <Views:ModifierManager Margin="{StaticResource SpacingMD}" DataContext="{Binding ModifierManager}">
                <Views:ModifierManager.SelectionPanel>
                    <Managers:AutoSelectionPanel PanelOwner="{x:Type Materials:Material}" />
                </Views:ModifierManager.SelectionPanel>
            </Views:ModifierManager>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander
            Header="Texture"
            Indentation="4"
            IsExpanded="{Binding DiffuseTexture.IsExpanded}">
            <Views:DiffuseTexture DataContext="{Binding DiffuseTexture}" />
        </Panels:IndentedExpander>

        <Panels:IndentedExpander
            Indentation="4"
            IsExpanded="{Binding IsExpanded}">
            <Panels:IndentedExpander.Header>
                <DockPanel>
                    <!--
                        The WPF DataContext.IsEnabled path resolved against the mask view through
                        a ContentTemplate quirk; the real owner of IsEnabled is the MaskTexture
                        view model, so the path goes there explicitly.
                    -->
                    <ToggleButton
                        Width="14"
                        Height="14"
                        IsChecked="{Binding MaskTexture.IsEnabled.Value, Mode=TwoWay}"
                        Theme="{StaticResource ToggleButtonIcon}" />
                    <TextBlock Margin="8,0" Text="Mask" />
                </DockPanel>
            </Panels:IndentedExpander.Header>
            <Views:MaskTexture DataContext="{Binding MaskTexture}" />
        </Panels:IndentedExpander>

    </StackPanel>

</UserControl>
