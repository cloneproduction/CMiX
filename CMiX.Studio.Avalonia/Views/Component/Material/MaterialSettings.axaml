<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.MaterialSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Converters="clr-namespace:CMiX.Studio.Avalonia.Converters"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <BaseControls:CMiXSlider
            Caption="Alpha"
            Maximum="1"
            Minimum="0"
            Value="{Binding Alpha.Value}" />

        <Panels:PositionedStackPanel Margin="0,8" Spacing="{DynamicResource SpacingXXS}">

            <BaseControls:ComboBox
                Caption="Cull Mode"
                ItemsSource="{x:Static Resources:EnumProviders.CullModeType}"
                SelectedItem="{Binding CullMode.Value}" />

            <BaseControls:ComboBox
                Caption="Transparency"
                ItemsSource="{x:Static Resources:EnumProviders.TransparencyType}"
                SelectedItem="{Binding Transparency.Value}" />

        </Panels:PositionedStackPanel>

        <BaseControls:ToggleButton 
            Caption="Is Shadow Caster" 
            IsChecked="{Binding IsShadowCaster.Value}" />

        <BaseControls:ComboBox
            Margin="0, 8"
            Caption="Pipeline"
            ItemsSource="{x:Static Resources:EnumProviders.PipelineType}"
            SelectedItem="{Binding Pipeline.Value}" />

        <Panels:PositionedStackPanel
            Margin="0, 0, 0, 8"
            Spacing="{DynamicResource SpacingXXS}"
            IsVisible="{Binding Pipeline.Value, Converter={x:Static Converters:EnumMatchConverter.Instance}, ConverterParameter={x:Static Materials:PipelineType.Metallic}}">

                <BaseControls:DragValue
                    Caption="Metalness"
                    Value="{Binding Metalness.Value}" />

                <BaseControls:DragValue
                    Caption="Roughness"
                    Value="{Binding Roughness.Value}" />

        </Panels:PositionedStackPanel>

        <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}" IsVisible="{Binding Pipeline.Value, Converter={x:Static Converters:EnumMatchConverter.Instance}, ConverterParameter={x:Static Materials:PipelineType.Specular}}">

            <BaseControls:CMiXSlider
                Caption="Glossiness"
                Maximum="1"
                Minimum="0"
                Value="{Binding Glossiness.Value}" />

            <BaseControls:CMiXSlider
                Caption="Specularity"
                Maximum="1"
                Minimum="0"
                Value="{Binding Specularity.Value}" />

        </Panels:PositionedStackPanel>

    </StackPanel>
</UserControl>