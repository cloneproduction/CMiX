<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.MaterialSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="8">

        <!--<ui:SliderCMiX
            Caption="Alpha"
            Maximum="1"
            Minimum="0"
            Value="{Binding Alpha.Value}" />-->

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <ui:ComboBoxCaptioned
                Caption="Cull Mode"
                ItemsSource="{x:Static Resources:EnumProviders.CullModeType}"
                ResetCommand="{Binding CullMode.ResetCommand}"
                SelectedItem="{Binding CullMode.Value}" />

            <ui:ComboBoxCaptioned
                Caption="Transparency"
                ItemsSource="{x:Static Resources:EnumProviders.TransparencyType}"
                ResetCommand="{Binding Transparency.ResetCommand}"
                SelectedItem="{Binding Transparency.Value}" />

        </ui:StackPanelPositioned>

        <ui:ToggleButtonCaptioned 
            Caption="Is Shadow Caster" 
            IsChecked="{Binding IsShadowCaster.Value}"
            ResetCommand="{Binding IsShadowCaster.ResetCommand}" />

        <ui:ComboBoxCaptioned
            Caption="Pipeline"
            ItemsSource="{x:Static Resources:EnumProviders.PipelineType}"
            ResetCommand="{Binding Pipeline.ResetCommand}"
            SelectedItem="{Binding Pipeline.Value}" />

        <ui:StackPanelPositioned
            Spacing="{DynamicResource SpacingXXS}"
            IsVisible="{Binding Pipeline.Value, Converter={x:Static ui:EnumMatchConverter.Instance}, ConverterParameter={x:Static Materials:PipelineType.Metallic}}">

                <ui:DragValue
                    Caption="Metalness"
                    Value="{Binding Metalness.Value}"
                    ResetCommand="{Binding Metalness.ResetCommand}" />

                <ui:DragValue
                    Caption="Roughness"
                    Value="{Binding Roughness.Value}"
                    ResetCommand="{Binding Roughness.ResetCommand}" />

        </ui:StackPanelPositioned>

        <ui:StackPanelPositioned 
          Spacing="{DynamicResource SpacingXXS}" 
          IsVisible="{Binding Pipeline.Value, Converter={x:Static ui:EnumMatchConverter.Instance}, ConverterParameter={x:Static Materials:PipelineType.Specular}}">

            <ui:SliderCMiX
                Caption="Glossiness"
                Maximum="1"
                Minimum="0"
                Value="{Binding Glossiness.Value}"
                ResetCommand="{Binding Glossiness.ResetCommand}" />

            <ui:SliderCMiX
                Caption="Specularity"
                Maximum="1"
                Minimum="0"
                Value="{Binding Specularity.Value}"
                ResetCommand="{Binding Specularity.ResetCommand}" />

        </ui:StackPanelPositioned>

    </StackPanel>
</UserControl>