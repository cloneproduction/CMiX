<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.HSVModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Modulation="clr-namespace:CMiX.Core.Modulation;assembly=CMiX.Core"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    x:Name="hsvModifier">

    <StackPanel Margin="4">

        <Views:ModifierModeSelector DataContext="{Binding ModifierModeSelector}" />

        <BaseControls:ComboBox
            Margin="0,4,0,4"
            Caption="Color Mode"
            ItemsSource="{x:Static Resources:EnumProviders.ColorMode}"
            SelectedItem="{Binding ColorMode.Value}" />

        <BaseControls:ChannelValue
            Margin="0,0,0,1"
            Caption="Hue"
            DataContext="{Binding Hue}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=hsvModifier}" />

        <BaseControls:ChannelValue
            Margin="0,0,0,1"
            Caption="Saturation"
            DataContext="{Binding Saturation}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=hsvModifier}" />

        <BaseControls:ChannelValue
            Margin="0,0,0,1"
            Caption="Value"
            DataContext="{Binding Value}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=hsvModifier}" />

        <BaseControls:ChannelValue
            Margin="0,0,0,4"
            Caption="Alpha"
            DataContext="{Binding Alpha}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=hsvModifier}" />

        <Views:ModifierManager DataContext="{Binding ModulatorManager}">
            <Views:ModifierManager.SelectionPanel>
                <Managers:AutoSelectionPanel Interface="{x:Type Modulation:IModulator}" />
            </Views:ModifierManager.SelectionPanel>
        </Views:ModifierManager>

    </StackPanel>

</UserControl>
