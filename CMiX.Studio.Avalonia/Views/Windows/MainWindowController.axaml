<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Windows.MainWindowController"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The WPF WindowChrome.IsHitTestVisibleInChrome attributes are gone; the Avalonia
        window chrome handles hit testing through its own template. The FindAncestor
        Window command parameters become $parent[Window] bindings.
    -->
    <DockPanel>

        <Button
            Command="{Binding CloseWindowCommand}"
            CommandParameter="{Binding $parent[Window]}"
            Content="Close"
            DockPanel.Dock="Right"
            Theme="{StaticResource ButtonWindowIconStyle}" />

        <Button
            Command="{Binding MaximizeWindowCommand}"
            CommandParameter="{Binding $parent[Window]}"
            Content="Maximize"
            DockPanel.Dock="Right"
            Theme="{StaticResource ButtonWindowIconStyle}" />

        <Button
            Command="{Binding MinimizeWindowCommand}"
            CommandParameter="{Binding $parent[Window]}"
            Content="Minimize"
            DockPanel.Dock="Right"
            Theme="{StaticResource ButtonWindowIconStyle}"
            VerticalContentAlignment="Bottom" />

    </DockPanel>
</UserControl>
