<BaseControls:ModulatorAssignableUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.ChannelVectorXY"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    x:Name="channelVectorXY">

    <!-- Same panel and margin pattern as Vector2.axaml - see ChannelVectorXYZ.axaml's comment. -->
    <Panels:PositionedStackPanel>

        <BaseControls:ChannelValue
            Caption="{Binding Caption, ElementName=channelVectorXY, StringFormat=' {0} X', Mode=OneWay}"
            DataContext="{Binding X}"
            ModulatorManager="{Binding ModulatorManager, ElementName=channelVectorXY}" />

        <BaseControls:ChannelValue
            Margin="0,1"
            Caption="{Binding Caption, ElementName=channelVectorXY, StringFormat=' {0} Y', Mode=OneWay}"
            DataContext="{Binding Y}"
            ModulatorManager="{Binding ModulatorManager, ElementName=channelVectorXY}" />

    </Panels:PositionedStackPanel>

</BaseControls:ModulatorAssignableUserControl>
