<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.Panels.IndentedExpander"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.Avalonia.AttachedProperties"
    x:Name="uc">

    <UserControl.ContentTemplate>
        <DataTemplate>
            <Expander
                AttachedProperties:ExpanderIndentation.Indentation="{Binding Indentation, ElementName=uc}"
                Header="{Binding Header, ElementName=uc}"
                IsExpanded="{Binding IsExpanded, ElementName=uc, Mode=TwoWay}"
                Theme="{StaticResource IndentedExpanderStyle}">
                <ContentPresenter Content="{Binding Content, ElementName=uc}" />
            </Expander>
        </DataTemplate>
    </UserControl.ContentTemplate>

</UserControl>
