<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.Panels.ModifierPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AP="clr-namespace:CMiX.Studio.Avalonia.AttachedProperties"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels">

    <!--
        The wrapper is a ControlTemplate, not a ContentTemplate. Presenting the content
        through a DataTemplate breaks DataContext inheritance for the content in Avalonia,
        which left the hosted views without a view model.
    -->
    <UserControl.Template>
        <ControlTemplate TargetType="Panels:ModifierPanel">
            <Expander
                IsExpanded="{Binding DataContext.IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                Theme="{StaticResource ItemControlExpander}">

                <Expander.Header>
                    <DockPanel>
                        <Button
                            AP:DragHandler.IsEnabled="True"
                            AP:DragHandler.IsPressed="{Binding DragHandlerIsPressed, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            DockPanel.Dock="Right"
                            Theme="{StaticResource DragHandlerButton}">
                            <Button.Content>
                                <Image
                                    Opacity="0.50"
                                    Source="{DynamicResource DragHandler}" />
                            </Button.Content>
                        </Button>

                        <Button
                            Command="{TemplateBinding CloseModifierCommand}"
                            CommandParameter="{TemplateBinding CloseModifierCommandParameter}"
                            DockPanel.Dock="Right"
                            Theme="{DynamicResource ModifierCloseButtonStyle}" />

                        <ToggleButton
                            Margin="2,0"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding DataContext.PrefabService.Visibility.Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                            Theme="{DynamicResource ToggleVisibility}" />

                        <TextBlock Text="{Binding DataContext.PrefabService.Name.Value, RelativeSource={RelativeSource TemplatedParent}}" />

                    </DockPanel>
                </Expander.Header>

                <!--
                    Padding instead of the WPF Margin: the filter panel compensates this inset
                    with negative margins on its blend bar, and with Padding that overdraw stays
                    inside the border bounds so Avalonia cannot clip it away.
                -->
                <Border Padding="8">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>

            </Expander>
        </ControlTemplate>
    </UserControl.Template>

</UserControl>
