<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:Managers="using:CMiX.Studio.Avalonia.Views.Managers"
             xmlns:Modulation="using:CMiX.Core.Modulation"
             xmlns:Modulators="using:CMiX.Core.Modulation.Modulators"
             xmlns:Views="using:CMiX.Studio.Avalonia.Views"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:panels="using:CMiX.Studio.Avalonia.Views.Controls.Panels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="CMiX.Studio.Avalonia.ModulatableModifierPanel">

        <UserControl.Template>
            <ControlTemplate TargetType="Views:FilterPanel">
                    <StackPanel>

                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <panels:ModifierPanel>
                            <panels:ModifierPanel.Content>
                                <Views:ModifierManager Caption="Add Modulator" DataContext="{Binding ModulatorManager}">
                                    <Views:ModifierManager.SelectionPanel>

                                        <Managers:AutoSelectionPanel Interface="{x:Type Modulators:IModulator}" />

                                    </Views:ModifierManager.SelectionPanel>
                                </Views:ModifierManager>
                            </panels:ModifierPanel.Content>
                        </panels:ModifierPanel>

                    </StackPanel>
            </ControlTemplate>
        </UserControl.Template>
               


</UserControl>
