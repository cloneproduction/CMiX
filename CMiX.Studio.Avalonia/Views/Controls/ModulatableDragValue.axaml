<BaseControls:ModulatorAssignableUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.ModulatableDragValue"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.Avalonia.AttachedProperties"
    x:Name="channelDragValue">

    <BaseControls:ModulatorAssignableUserControl.ContextMenu>
        <ContextMenu Theme="{StaticResource ContextMenuDefault}">
            <MenuItem
                Command="{Binding ResetCommand}"
                Header="Reset" />
        </ContextMenu>
    </BaseControls:ModulatorAssignableUserControl.ContextMenu>

    <BaseControls:DragValue
        AttachedProperties:PositionedControl.Position="{Binding (AttachedProperties:PositionedControl.Position), ElementName=channelDragValue}"
        Caption="{Binding Caption, ElementName=channelDragValue, Mode=OneWay}"
        Minimum="{Binding Minimum, ElementName=channelDragValue}"
        Maximum="{Binding Maximum, ElementName=channelDragValue}"
        Value="{Binding Value}">
        <BaseControls:DragValue.TrailingContent>
            <BaseControls:ModulatorAssignButton ModulatorManager="{Binding ModulatorManager, ElementName=channelDragValue}" />
        </BaseControls:DragValue.TrailingContent>
    </BaseControls:DragValue>

</BaseControls:ModulatorAssignableUserControl>
