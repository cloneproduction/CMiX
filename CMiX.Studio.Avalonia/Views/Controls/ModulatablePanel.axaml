<HeaderedContentControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.ModulatablePanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Modulators="clr-namespace:CMiX.Core.Modulation.Modulators;assembly=CMiX.Core">

    <HeaderedContentControl.Header>
        <Views:ModifierManager Margin="0,8,0,0" 
                               Caption="Add Modulator" 
                               PanelBackground="{DynamicResource Grey400Brush}" 
                               DataContext="{Binding ModulatorManager}">
            <Views:ModifierManager.SelectionPanel>
                <Managers:AutoSelectionPanel Interface="{x:Type Modulators:IModulator}" />
            </Views:ModifierManager.SelectionPanel>
        </Views:ModifierManager>
    </HeaderedContentControl.Header>

    <HeaderedContentControl.Template>
        <ControlTemplate TargetType="Controls:ModulatablePanel">
            <StackPanel>

                <ContentPresenter
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                <ContentPresenter
                    Content="{TemplateBinding Header}"
                    ContentTemplate="{TemplateBinding HeaderTemplate}" />

            </StackPanel>
        </ControlTemplate>
    </HeaderedContentControl.Template>

</HeaderedContentControl>
