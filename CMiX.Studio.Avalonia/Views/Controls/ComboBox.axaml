<Controls:CaptionedUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.ComboBox"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.Avalonia.AttachedProperties"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    x:Name="comboBox">

    <Controls:LabeledContent Caption="{Binding Caption, ElementName=comboBox}">

        <Border
            x:Name="mainBorder"
            AttachedProperties:PositionedControl.Position="{Binding (AttachedProperties:PositionedControl.Position), ElementName=comboBox}"
            Background="{DynamicResource Grey500Brush}"
            BorderBrush="Transparent"
            Classes="BorderMask">

            <ComboBox
                x:Name="innerComboBox"
                AttachedProperties:PositionedControl.Position="None"
                ItemsSource="{Binding ItemsSource, ElementName=comboBox}"
                ItemTemplate="{Binding ItemTemplate, ElementName=comboBox}"
                SelectedItem="{Binding SelectedItem, ElementName=comboBox, Mode=OneWay}" />

        </Border>

    </Controls:LabeledContent>

</Controls:CaptionedUserControl>