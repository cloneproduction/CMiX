<BaseControl:CaptionedUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.Integer3Value"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    x:Name="integer3Value"
    Background="Transparent">

    <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

        <BaseControl:IntegerValue
            Caption="{Binding Caption, StringFormat=' {0} X', ElementName=integer3Value, Mode=OneWay}"
            Value="{Binding X.Value}" />

        <BaseControl:IntegerValue
            Caption="Y"
            Value="{Binding Y.Value}" />

        <BaseControl:IntegerValue
            Caption="Z"
            Value="{Binding Z.Value}" />

    </Panels:PositionedStackPanel>

</BaseControl:CaptionedUserControl>
