<Controls:CaptionedUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.CaptionedButton"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    x:Name="labeledButton">

    <Controls:LabeledContent Caption="{Binding Caption, ElementName=labeledButton}">
        <Border>
            <Button Command="{Binding Command, ElementName=labeledButton}" />
        </Border>
    </Controls:LabeledContent>
</Controls:CaptionedUserControl>
