<Controls:CaptionedUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.CaptionedButton"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    x:Name="captionedButton">

    <Button
        Command="{Binding Command, ElementName=captionedButton}"
        CommandParameter="{Binding CommandParameter, ElementName=captionedButton}"
        Content="{Binding Caption, ElementName=captionedButton}"
        Theme="{StaticResource ButtonInlineCaption}" />
</Controls:CaptionedUserControl>
