<BaseControls:ModulatorAssignableUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.ModulatorAssignButton"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    x:Name="modulatorAssignButton"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignHeight="400"
    d:DesignWidth="400">

    <BaseControls:ModulatorAssignableUserControl.Resources>
        <!-- A menu row bound to a ModulatorOutputChoice. -->
        <ControlTheme x:Key="ModulatorOutputRow" TargetType="MenuItem" BasedOn="{StaticResource ContextMenuSubItem}">
            <Setter Property="Header" Value="{Binding Label}" />
            <Setter Property="IsChecked" Value="{Binding IsAssigned}" />
            <Setter Property="Command" Value="{Binding Command}" />
        </ControlTheme>
    </BaseControls:ModulatorAssignableUserControl.Resources>

    <Button
        x:Name="assignButton"
        Background="Transparent"
        Width="{DynamicResource ControlHeightMD}"
        IsEnabled="{Binding ModulatorManager.ManagerData.Items.Count, ElementName=modulatorAssignButton, Converter={StaticResource CountToVisibility}, ConverterParameter=0}"
        Theme="{StaticResource ButtonRoundedRightNoHover}">

        <Ellipse
            Width="8"
            Height="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Ellipse.Fill>
                <MultiBinding Converter="{StaticResource ModulatorStateToBrush}">
                    <Binding Path="BoundModulator" />
                    <Binding Path="BoundModulator.IsHovered" />
                    <Binding Source="{StaticResource Grey700Brush}" />
                    <Binding Source="{StaticResource AccentBrush}" />
                    <Binding Source="{StaticResource AccentHighlightBrush}" />
                </MultiBinding>
            </Ellipse.Fill>
        </Ellipse>

        <Button.Flyout>
            <MenuFlyout
                FlyoutPresenterTheme="{StaticResource MenuFlyoutPresenterDefault}"
                ItemContainerTheme="{StaticResource ModulatorOutputRow}"
                Placement="Bottom" />
        </Button.Flyout>
    </Button>

</BaseControls:ModulatorAssignableUserControl>
