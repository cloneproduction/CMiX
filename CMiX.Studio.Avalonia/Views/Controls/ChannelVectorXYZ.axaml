<BaseControls:ModulatorAssignableUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.ChannelVectorXYZ"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    x:Name="channelVectorXYZ">

    <!-- Same panel and margin pattern as VectorXYZ.axaml - PositionedStackPanel handles the
         joined-row spacing/rounding itself, only the middle row needs an explicit gap margin. -->
    <Panels:PositionedStackPanel>

        <BaseControls:ChannelValue
            Caption="{Binding Caption, ElementName=channelVectorXYZ, StringFormat=' {0} X', Mode=OneWay}"
            DataContext="{Binding X}"
            ModulatorManager="{Binding ModulatorManager, ElementName=channelVectorXYZ}" />

        <BaseControls:ChannelValue
            Margin="0,1"
            Caption="Y"
            DataContext="{Binding Y}"
            ModulatorManager="{Binding ModulatorManager, ElementName=channelVectorXYZ}" />

        <BaseControls:ChannelValue
            Caption="Z"
            DataContext="{Binding Z}"
            ModulatorManager="{Binding ModulatorManager, ElementName=channelVectorXYZ}" />

    </Panels:PositionedStackPanel>

</BaseControls:ModulatorAssignableUserControl>
