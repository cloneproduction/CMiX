<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.AxisSelector2D"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="axisSelector2D">

    <Grid Height="{DynamicResource ControlHeightMD}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            Padding="0,0,8,0"
            HorizontalAlignment="Right"
            Text="Axis" />

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <ToggleButton
                Grid.Column="0"
                Content="X"
                IsChecked="{Binding XIsChecked, ElementName=axisSelector2D, Mode=TwoWay}"
                Theme="{StaticResource InlineToggleButtonLeft}" />
            <ToggleButton
                Grid.Column="1"
                Margin="1,0"
                Content="Y"
                IsChecked="{Binding YIsChecked, ElementName=axisSelector2D, Mode=TwoWay}"
                Theme="{StaticResource InlineToggleButtonCenter}" />

        </Grid>

    </Grid>
</UserControl>
