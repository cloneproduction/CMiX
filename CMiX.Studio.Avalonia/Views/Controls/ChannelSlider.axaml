<BaseControls:CaptionedUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.ChannelSlider"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    x:Name="channelSlider">

    <!-- Same shape/reasoning as ChannelValue.axaml, just CMiXSlider instead of DragValue. -->
    <DockPanel>

        <Button
            x:Name="assignButton"
            Width="{DynamicResource ControlHeightMD}"
            DockPanel.Dock="Right"
            IsEnabled="{Binding ModulatorManager.ManagerData.Items.Count, ElementName=channelSlider, Converter={StaticResource CountToVisibility}, ConverterParameter=0}"
            Theme="{StaticResource ButtonRoundedRight}">
            <BaseControls:AppIcon
                IconKey="{Binding Binding.BoundModulator, Converter={StaticResource ModulatorTypeToIcon}}"
                Size="{DynamicResource IconSizeXS}">
                <BaseControls:AppIcon.Foreground>
                    <MultiBinding Converter="{StaticResource BoolToAccentBrush}">
                        <Binding Path="Binding.BoundModulator" />
                        <Binding Source="{StaticResource AccentBrush}" />
                        <Binding Source="{StaticResource ForegroundBrush}" />
                    </MultiBinding>
                </BaseControls:AppIcon.Foreground>
            </BaseControls:AppIcon>
            <Button.Flyout>
                <Flyout Placement="Pointer" HorizontalOffset="-80" VerticalOffset="-20" FlyoutPresenterTheme="{StaticResource PopupFlyoutStyle}">
                    <StackPanel MinWidth="160" Margin="4">
                        <Button
                            Content="None"
                            Click="Assign"
                            Theme="{DynamicResource ButtonItemControl}" />
                        <ItemsControl ItemsSource="{Binding ModulatorManager.ManagerData.Items, ElementName=channelSlider}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Click="Assign"
                                        Theme="{DynamicResource ButtonItemControl}">
                                        <DockPanel>
                                            <BaseControls:AppIcon
                                                DockPanel.Dock="Left"
                                                IconKey="{Binding Converter={StaticResource ModulatorTypeToIcon}}"
                                                Size="{DynamicResource IconSizeXS}" />
                                            <TextBlock Margin="4,0,0,0" Text="{Binding PrefabService.Name.Value}" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

        <BaseControls:CMiXSlider
            Caption="{Binding Caption, ElementName=channelSlider, Mode=OneWay}"
            Minimum="{Binding Minimum, ElementName=channelSlider}"
            Maximum="{Binding Maximum, ElementName=channelSlider}"
            Value="{Binding Value.Value}" />

    </DockPanel>

</BaseControls:CaptionedUserControl>
