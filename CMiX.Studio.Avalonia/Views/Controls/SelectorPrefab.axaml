<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.SelectorPrefab"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="outliner">

    <DockPanel Height="{DynamicResource ControlHeightMD}">

        <ComboBox
            x:Name="comboBox"
            Focusable="False"
            HorizontalAlignment="Stretch"
            ItemsSource="{Binding ItemsSource, ElementName=outliner}"
            SelectedItem="{Binding SelectedItem, Mode=OneWay}"
            SelectionChanged="ComboBox_SelectionChanged"
            Theme="{StaticResource ComboBoxWithButton}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <ui:TextBlockTrimmed Text="{Binding PrefabService.Name.Value}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Panel>

            <ContentControl
                Margin="1,0,0,0"
                Content="{Binding AddContent, ElementName=outliner}" />

            <Border>
                <!-- NullToVisibility returns a bool in this project; the Collapsed converter parameter is gone. -->
                <ui:DockPanelPositioned IsVisible="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">

                    <ui:ButtonIcon
                        x:Name="deleteItemButton"
                        Command="{Binding ClearSelectionCommand}"
                        CommandParameter="{Binding SelectedItem}"
                        DockPanel.Dock="Right"
                        Classes="filled"
                        IconKey="Remove" />

                    <Border
                        BorderBrush="{DynamicResource Grey300Brush}"
                        BorderThickness="0.5">
                        <ui:TextBoxEditable
                            Background="{DynamicResource Grey200Brush}"
                            Focusable="False"
                            Foreground="{DynamicResource ForegroundBrush}"
                            Text="{Binding SelectedItem.PrefabService.Name.Value, Mode=TwoWay}" />
                    </Border>

                </ui:DockPanelPositioned>
            </Border>

        </Panel>

    </DockPanel>

</UserControl>
