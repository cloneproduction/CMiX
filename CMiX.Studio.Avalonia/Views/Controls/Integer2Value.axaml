<BaseControl:CaptionedUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.Integer2Value"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    x:Name="integer2Value"
    Background="Transparent">

    <Panels:PositionedStackPanel>

        <BaseControl:IntegerValue
            Caption="{Binding Caption, StringFormat=' {0} X', ElementName=integer2Value, Mode=OneWay}"
            Value="{Binding X.Value}" />

        <BaseControl:IntegerValue
            Margin="0,1,0,0"
            Caption="Y"
            Value="{Binding Y.Value}" />

    </Panels:PositionedStackPanel>

</BaseControl:CaptionedUserControl>
