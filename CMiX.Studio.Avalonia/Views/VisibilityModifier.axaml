<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.VisibilityModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Modulation="clr-namespace:CMiX.Core.Modulation;assembly=CMiX.Core"
    x:Name="visibilityModifier">

    <StackPanel Margin="4">

        <BaseControls:ChannelSlider
            DataContext="{Binding Value}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=visibilityModifier}"
            Minimum="0"
            Maximum="1" />

        <Views:ModifierManager DataContext="{Binding ModulatorManager}">
            <Views:ModifierManager.SelectionPanel>
                <Managers:AutoSelectionPanel Interface="{x:Type Modulation:IModulator}" />
            </Views:ModifierManager.SelectionPanel>
        </Views:ModifierManager>

    </StackPanel>

</UserControl>
