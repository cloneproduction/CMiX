<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Managers.RepositoryManager"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    x:Name="repositoryManager">

    <!-- The list is from the library. This control tells it which properties of the manager to use
         and which icon each type of prefab gets. -->
    <ui:ListBoxRepository
        x:Name="detailList"
        AddContent="{Binding SelectionPanel, ElementName=repositoryManager}"
        DeleteCommand="{Binding RemoveEverywhereCommand}"
        DetailContent="{Binding EditingPanel, ElementName=repositoryManager}"
        ItemsSource="{Binding ItemsSource, ElementName=repositoryManager}"
        SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

        <ui:ListBoxRepository.DataTemplates>
            <Managers:PrefabListItemTemplates />
        </ui:ListBoxRepository.DataTemplates>

    </ui:ListBoxRepository>

</UserControl>
