<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.RepositoryManager"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    x:Name="repositoryManager">

    <StackPanel>

        <BaseControls:CMiXListBox
            x:Name="prefabListBox"
            MinHeight="105"
            Margin="8"
            ItemsSource="{Binding ItemsSource, ElementName=repositoryManager}"
            SelectedItem="{Binding SelectedItem}">
            <!--
                No SelectedIndex binding here. ItemsSource is the shared repository collection
                (for example PrefabRepositories.Textures), which combines items from every
                manager that owns items of this type, while ManagerData.SelectedIndex indexes
                only this manager's own ManagerData.Items. A two way SelectedIndex binding wrote
                a row index from the wrong index space directly into ManagerData.SelectedIndex,
                which the manager then reconciled by mutating SelectedItem, which changed the
                row's real ItemsSource position, which pushed a new SelectedIndex back in, and
                so on without ever converging; a click could recurse Avalonia's binding engine
                until the stack overflowed (CMiX.Core PrefabManager.SelectedItem, CollectionManager
                SelectedItem). SelectedItem alone drives selection here; PrefabManager.SelectedItem
                keeps ManagerData.SelectedIndex correct itself via SelectedItemChanged, using this
                manager's own item index, not the shared collection's row index.
            -->
            <!--
                The prefab list item templates are shared with PrefabSlotManager.axaml
                through Views\Managers\PrefabListItemTemplates.cs, which loads the
                ordered template list from PrefabListItemTemplates.axaml.
            -->
            <BaseControls:CMiXListBox.DataTemplates>
                <Managers:PrefabListItemTemplates />
            </BaseControls:CMiXListBox.DataTemplates>
        </BaseControls:CMiXListBox>

        <DockPanel Margin="8,0,8,8">

            <!--  DELETE EVERYWHERE  -->
            <Button
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Command="{Binding DeleteEverywhereCommand}"
                CommandParameter="{Binding SelectedItem}"
                Content="-"
                DockPanel.Dock="Right"
                Theme="{StaticResource ButtonRoundedRight}" />

            <ContentControl Content="{Binding SelectionPanel, ElementName=repositoryManager}" />

        </DockPanel>

        <!-- NullToVisibility returns a bool in this project; the Collapsed converter parameter is gone. -->
        <Border IsVisible="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
            <ContentControl
                Content="{Binding EditingPanel, ElementName=repositoryManager}"
                DataContext="{Binding SelectedItem}" />
        </Border>
    </StackPanel>

</UserControl>
