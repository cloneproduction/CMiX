<DataTemplates
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulators="clr-namespace:CMiX.Core.Modulation.Modulators;assembly=CMiX.Core"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:ColorModifiers="clr-namespace:CMiX.Core.Colors.Modifiers;assembly=CMiX.Core"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:TextureSources="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core">

    <DataTemplate DataType="{x:Type Compositing:Color}">
        <ui:ColorSelector Caption="{Binding Value}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Compositing:TextEntity}">
        <ui:ListItemIcon Icon="TextIcon" Title="{Binding PrefabService.Name.Value, Mode=TwoWay}" IsChecked="{Binding PrefabService.Visibility.Value, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Compositing:Entity}">
        <ui:ListItemIcon Icon="Geometry" Title="{Binding PrefabService.Name.Value, Mode=TwoWay}" IsChecked="{Binding PrefabService.Visibility.Value, Mode=TwoWay}" />
    </DataTemplate>

  <DataTemplate DataType="{x:Type Compositing:FullscreenQuad}">
    <ui:ListItemIcon Icon="FullscreenQuad" Title="{Binding PrefabService.Name.Value, Mode=TwoWay}" IsChecked="{Binding PrefabService.Visibility.Value, Mode=TwoWay}" />
  </DataTemplate>
  
    <DataTemplate DataType="{x:Type Lights:LightEntity}">
        <ui:ListItemIcon Icon="MeshLight" Title="{Binding PrefabService.Name.Value, Mode=TwoWay}" IsChecked="{Binding PrefabService.Visibility.Value, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Cameras:Camera}">
        <ui:ListItemIcon Icon="Camera" Title="{Binding PrefabService.Name.Value, Mode=TwoWay}" IsChecked="{Binding PrefabService.Visibility.Value, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type TextureSources:TextureSourceBase}">
        <ui:ListItemIcon Icon="Texture" Title="{Binding PrefabService.Name.Value, Mode=TwoWay}" IsChecked="{Binding PrefabService.Visibility.Value, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Materials:Material}">
        <ui:ListItemIcon Icon="World" Title="{Binding PrefabService.Name.Value, Mode=TwoWay}" IsChecked="{Binding PrefabService.Visibility.Value, Mode=TwoWay}" />
    </DataTemplate>
<!--
    <DataTemplate DataType="{x:Type Modulators:BeatModulator}">
        <ui:ListItemIcon Icon="Beat" Title="{Binding PrefabService.Name.Value, Mode=TwoWay}" IsChecked="{Binding PrefabService.Visibility.Value, Mode=TwoWay}" />
    </DataTemplate>-->

    <DataTemplate DataType="{x:Type Modulators:TrackingModulator}">
        <ui:ListItemIcon Icon="Camera" Title="{Binding PrefabService.Name.Value, Mode=TwoWay}" IsChecked="{Binding PrefabService.Visibility.Value, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ColorModifiers:ColorPaletteModifier}">
        <ui:ListItemIcon Icon="Coloration" Title="{Binding PrefabService.Name.Value, Mode=TwoWay}" IsChecked="{Binding PrefabService.Visibility.Value, Mode=TwoWay}" />
    </DataTemplate>

</DataTemplates>
