<DataTemplates
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:ColorModifiers="clr-namespace:CMiX.Core.Colors.Modifiers;assembly=CMiX.Core"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:Servers="clr-namespace:CMiX.Core.Networking.Servers;assembly=CMiX.Core"
    xmlns:TextureSource="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core">

    <DataTemplate DataType="{x:Type Compositing:Color}">
        <BaseControls:ColorSelector Caption="{Binding Value}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Servers:Server}">

        <Border
            Margin="1"
            Padding="2,0,0,0"
            Background="Transparent"
            CornerRadius="{DynamicResource CornerRadiusAll}"
            TextElement.Foreground="{DynamicResource ForegroundBrush}">

            <DockPanel>

                <Ellipse
                    Width="7"
                    Height="7"
                    Margin="0,0,4,0"
                    Classes.connected="{Binding ClientIsConnected}"
                    Classes.connecting="{Binding IsReconnecting}"
                    Classes.listening="{Binding ServerIsRunning}"
                    Theme="{StaticResource ServerConnectionIndicatorStyle}" />

                <ToggleButton
                    Height="{DynamicResource ControlHeightXS}"
                    Margin="0"
                    Padding="0"
                    Background="Crimson"
                    DockPanel.Dock="Right"
                    IsChecked="{Binding ServerIsRunning}"
                    Theme="{DynamicResource TogglePlayPause}" />

                <BaseControls:EditableTextBox Text="{Binding PrefabService.Name.Value}" />

            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type Compositing:TextEntity}">
        <BaseControls:PrefabListItem Icon="TextIcon" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Compositing:Entity}">
        <BaseControls:PrefabListItem Icon="Geometry" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Lights:LightEntity}">
        <BaseControls:PrefabListItem Icon="MeshLight" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Cameras:Camera}">
        <BaseControls:PrefabListItem Icon="Camera" />
    </DataTemplate>

    <!--
        TEXTURESOURCE. Matches TextureSourceBase itself, not each concrete type: every
        texture source without a template here falls through to the reflection view
        locator and renders its full editing view instead of a list row (this is how
        CheckerBoard and TouchBlob behaved before templates were added for them), and
        matching the shared base means a future texture source type is covered for free.
    -->
    <DataTemplate DataType="{x:Type TextureSource:TextureSourceBase}">
        <BaseControls:PrefabListItem Icon="Texture" />
    </DataTemplate>

    <!--  MATERIAL  -->
    <DataTemplate DataType="{x:Type Materials:Material}">
        <BaseControls:PrefabListItem Icon="World" />
    </DataTemplate>

    <!--  BEATMODIFIERS  -->
    <DataTemplate DataType="{x:Type Animations:BeatModifier}">
        <BaseControls:PrefabListItem Icon="Beat" />
    </DataTemplate>

    <!--
        ColorPalette has no list item template in WPF, which fell back to
        ToString there but to the reflection view locator here, so the
        template is added to render it like the other prefab types.
    -->
    <DataTemplate DataType="{x:Type ColorModifiers:ColorPalette}">
        <BaseControls:PrefabListItem Icon="Coloration" />
    </DataTemplate>

</DataTemplates>
