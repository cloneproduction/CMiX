<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Managers.PrefabSlotManager"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    x:Name="prefabSlotManager"    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <ui:ListBoxCMiX
            x:Name="prefabListBox"
            MinItemCount="{Binding MinItemCount, ElementName=prefabSlotManager}"
            ItemsSource="{Binding ManagerData.Items}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

            <ui:ListBoxCMiX.DataTemplates>
                <Managers:PrefabListItemTemplates />
            </ui:ListBoxCMiX.DataTemplates>
        </ui:ListBoxCMiX>

        <DockPanel Margin="0,4,0,0">

            <Button
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Command="{Binding RemoveItemCommand}"
                CommandParameter="{Binding SelectedItem}"
                Content="-"
                DockPanel.Dock="Right"
                Theme="{StaticResource ButtonRoundedRight}" />

            <Button
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Margin="1,0"
                Command="{Binding ManagerReorderService.MoveItemUpCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding SelectedItem}"
                DockPanel.Dock="Right"
                Theme="{StaticResource ButtonStraight}">
                <ui:AppIcon Opacity="0.7" IconKey="ArrowUp" Size="{DynamicResource IconSizeXS}" />
            </Button>

            <Button
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Command="{Binding ManagerReorderService.MoveItemDownCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding SelectedItem}"
                DockPanel.Dock="Right"
                Theme="{StaticResource ButtonStraight}">
                <ui:AppIcon Opacity="0.7" IconKey="ArrowDown" Size="{DynamicResource IconSizeXS}" />
            </Button>

            <ToggleButton
                x:Name="SwapToggle"
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Content="⇄"
                DockPanel.Dock="Left"
                Theme="{StaticResource ToggleButtonRoundedLeft}" />

            <Popup
                ui:TogglePopup.Toggle="{Binding ElementName=SwapToggle}"
                Placement="BottomEdgeAlignedLeft"
                VerticalOffset="-1">
                <Border
                    Padding="2"
                    Background="{DynamicResource Grey100Brush}"
                    CornerRadius="{DynamicResource CornerRadiusLargeAll}">
                    <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=prefabSlotManager}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Margin="2"
                                    Command="{Binding DataContext.AddExistingItemCommand, ElementName=prefabSlotManager}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding PrefabService.Name.Value}"
                                    Theme="{DynamicResource ButtonItem}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>

            <!--  SELECTION PANEL (type picker)  -->
            <ContentControl
                Height="{DynamicResource ControlHeightMD}"
                Margin="1,0"
                Content="{Binding SelectionPanel, ElementName=prefabSlotManager}"
                DockPanel.Dock="Left" />

        </DockPanel>

    </StackPanel>

</UserControl>
