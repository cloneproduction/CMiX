<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Managers.PrefabSlotManager"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Avalonia.Behaviors"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    x:Name="prefabSlotManager"    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <BaseControls:CMiXListBox
            x:Name="prefabListBox"
            MinHeight="105"
            ItemsSource="{Binding ManagerData.Items}"
            SelectedIndex="{Binding ManagerData.SelectedIndex, Mode=TwoWay}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <!--
                The prefab list item templates are shared with RepositoryManager.axaml
                through Views\Managers\PrefabListItemTemplates.cs, which loads the
                ordered template list from PrefabListItemTemplates.axaml.
            -->
            <BaseControls:CMiXListBox.DataTemplates>
                <Managers:PrefabListItemTemplates />
            </BaseControls:CMiXListBox.DataTemplates>
        </BaseControls:CMiXListBox>

        <DockPanel Margin="0,4,0,0">

            <Button
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Command="{Binding DeleteItemCommand}"
                CommandParameter="{Binding SelectedItem}"
                Content="-"
                DockPanel.Dock="Right"
                Theme="{StaticResource ButtonRoundedRight}" />

            <Button
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Margin="1,0"
                Command="{Binding ManagerReorderService.ItemUpCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding SelectedItem}"
                DockPanel.Dock="Right"
                Theme="{StaticResource ButtonStraight}">
                <BaseControls:AppIcon Opacity="0.7" IconKey="ArrowUp" Size="{DynamicResource IconSizeXS}" />
            </Button>

            <Button
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Command="{Binding ManagerReorderService.ItemDownCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding SelectedItem}"
                DockPanel.Dock="Right"
                Theme="{StaticResource ButtonStraight}">
                <BaseControls:AppIcon Opacity="0.7" IconKey="ArrowDown" Size="{DynamicResource IconSizeXS}" />
            </Button>

            <ToggleButton
                x:Name="SwapToggle"
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Content="⇄"
                DockPanel.Dock="Left"
                Theme="{StaticResource ToggleButtonRoundedLeft}" />

            <Popup
                IsOpen="{Binding IsChecked, ElementName=SwapToggle}"
                Placement="BottomEdgeAlignedLeft"
                PlacementTarget="{Binding ElementName=SwapToggle}"
                VerticalOffset="-1">
                <i:Interaction.Behaviors>
                    <Behaviors:ClosePopupBehavior />
                </i:Interaction.Behaviors>
                <Border
                    Width="250"
                    Padding="2"
                    Background="{DynamicResource Grey100Brush}"
                    CornerRadius="{DynamicResource CornerRadiusLargeAll}">
                    <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=prefabSlotManager}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="{Binding $parent[Border].Bounds.Width}"
                                    Margin="2"
                                    Command="{Binding DataContext.AddExistingItemCommand, ElementName=prefabSlotManager}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding PrefabService.Name.Value}"
                                    Theme="{DynamicResource ButtonItemControl}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>

            <!--  SELECTION PANEL (type picker)  -->
            <ContentControl
                Height="{DynamicResource ControlHeightMD}"
                Margin="1,0"
                Content="{Binding SelectionPanel, ElementName=prefabSlotManager}"
                DockPanel.Dock="Left" />

        </DockPanel>

    </StackPanel>

</UserControl>
