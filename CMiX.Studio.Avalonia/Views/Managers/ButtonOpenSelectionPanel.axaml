<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ButtonOpenSelectionPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Avalonia.Behaviors"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    x:Name="buttonOpenSelectionPanel">

    <Grid>

        <ToggleButton
            x:Name="PopUpToggle"
            Content="{Binding Caption, ElementName=buttonOpenSelectionPanel}" />

        <!--
            WPF AllowsTransparency and the FlowDirection right to left inheritance
            workaround are not needed in Avalonia. The ClosePopupBehavior keeps the
            WPF StaysOpen True closing logic, so light dismiss stays off.
        -->
        <Popup
            Width="{Binding Bounds.Width, ElementName=PopUpToggle}"
            IsOpen="{Binding IsChecked, ElementName=PopUpToggle}"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=PopUpToggle}">
            <i:Interaction.Behaviors>
                <Behaviors:ClosePopupBehavior />
            </i:Interaction.Behaviors>
            <Border
                Padding="2,4,2,2"
                Background="{DynamicResource Grey200Brush}"
                BorderBrush="{DynamicResource Shadow}"
                BorderThickness="1,0,1,2"
                CornerRadius="{DynamicResource CornerRadiusBottom}">

                <ContentControl Content="{Binding SelectionPanel, ElementName=buttonOpenSelectionPanel}" />

            </Border>

        </Popup>
    </Grid>

</UserControl>
