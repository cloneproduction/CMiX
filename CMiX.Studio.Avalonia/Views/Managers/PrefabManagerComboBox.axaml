<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Managers.PrefabManagerComboBox"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="prefabManagerComboBox">

    <Grid
        Height="{DynamicResource ControlHeightMD}"
        Margin="8"
        DockPanel.Dock="Left">

        <Border
            x:Name="mainBorder"
            ui:PositionedControl.Position="{Binding (ui:PositionedControl.Position), ElementName=prefabManagerComboBox}"
            Background="{DynamicResource Grey200Brush}"
            Classes="BorderMask">
            <DockPanel>

                <Button
                    Margin="1,0,0,0"
                    Command="{Binding RemoveSelectedItemCommand}"
                    CommandParameter="{Binding SelectedItem}"
                    DockPanel.Dock="Right"
                    Theme="{StaticResource ButtonStraight}">
                    <Button.Content>
                        <ui:AppIcon
                            Opacity="0.5"
                            IconKey="Add"
                            Size="{DynamicResource IconSizeXS}" />
                    </Button.Content>
                </Button>

                <ComboBox
                    DockPanel.Dock="Left"
                    ItemsSource="{Binding ItemsSource, ElementName=prefabManagerComboBox}"
                    SelectedItem="{Binding SelectedItem, ElementName=prefabManagerComboBox, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name.Value}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

            </DockPanel>
        </Border>
    </Grid>

</UserControl>
