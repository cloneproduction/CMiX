<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Managers.OutputMappingsPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <StackPanel Margin="8" Spacing="{DynamicResource SpacingMD}">

        <Views:PathSelector
            DataContext="{Binding $parent[Window].DataContext.Project.Model}"
            ItemsSource="{Binding AssetRepository.Geometries}"
            SelectedItem="{Binding Asset}" />

        <ui:CMiXListBox
            MinHeight="105"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

            <ui:CMiXListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>

                        <ToggleButton
                            Margin="0, 0, 8, 0"
                            DockPanel.Dock="Right"
                            IsChecked="{Binding !Visibility.Value}"
                            Theme="{DynamicResource ToggleVisibility}" />

                        <ui:EditableTextBox Text="{Binding Name.Value}" />

                    </DockPanel>
                </DataTemplate>
            </ui:CMiXListBox.ItemTemplate>
        </ui:CMiXListBox>

        <StackPanel
            DataContext="{Binding SelectedItem}">
            <ui:Integer2 
                Caption="Resolution" 
                DataContext="{Binding Resolution}" />
        </StackPanel>

    </StackPanel>

</UserControl>
