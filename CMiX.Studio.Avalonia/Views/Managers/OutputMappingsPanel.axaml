<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Managers.OutputMappingsPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <StackPanel>
        <BaseControl:ComboBox
            Caption="Slot"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem}">
            <BaseControl:ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name.Value}" />
                </DataTemplate>
            </BaseControl:ComboBox.ItemTemplate>
        </BaseControl:ComboBox>

        <StackPanel Margin="0,8,0,0" DataContext="{Binding SelectedItem}">
            <ToggleButton
                Width="14"
                Height="14"
                HorizontalAlignment="Left"
                IsChecked="{Binding IsEnabled.Value}"
                Theme="{StaticResource ToggleCheckBox}" />
            <TextBox
                Margin="0,8,0,0"
                Text="{Binding Name.Value}" />
            <BaseControl:Integer2Value
                Margin="0,8,0,0"
                Caption="Resolution"
                DataContext="{Binding Resolution}" />
        </StackPanel>
    </StackPanel>

</UserControl>
