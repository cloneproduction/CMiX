<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.CameraRandomModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Modulation="clr-namespace:CMiX.Core.Modulation;assembly=CMiX.Core"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    x:Name="cameraRandomModifier">

    <StackPanel Margin="4">

        <BaseControls:ComboBox
            Margin="0,0,0,4"
            Caption="Axis"
            ItemsSource="{x:Static Resources:EnumProviders.CameraAxis}"
            SelectedItem="{Binding Axis.Value}" />

        <BaseControls:ModulatableValue
            Margin="0,0,0,4"
            Caption="Width"
            DataContext="{Binding Width}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=cameraRandomModifier}" />

        <BaseControls:ToggleButton
            Margin="0,0,0,4"
            Caption="Ping Pong"
            IsChecked="{Binding PingPong.Value}" />

        <Views:ModifierManager DataContext="{Binding ModulatorManager}">
            <Views:ModifierManager.SelectionPanel>
                <Managers:AutoSelectionPanel Interface="{x:Type Modulation:IModulator}" />
            </Views:ModifierManager.SelectionPanel>
        </Views:ModifierManager>

    </StackPanel>

</UserControl>
