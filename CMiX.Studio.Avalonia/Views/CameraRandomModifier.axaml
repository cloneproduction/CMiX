<Controls:ModulatablePanel
    x:Class="CMiX.Studio.Avalonia.Views.CameraRandomModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    x:Name="cameraRandomModifier"    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <BaseControls:ComboBox
            Caption="Axis"
            ItemsSource="{x:Static Resources:EnumProviders.CameraAxis}"
            SelectedItem="{Binding Axis.Value}" />

        <BaseControls:ModulatableFloatValue
            Margin="0,8"
            Caption="Width"
            DataContext="{Binding Width}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=cameraRandomModifier}" />

        <BaseControls:ToggleButton
            Margin="0,0,0,8"
            Caption="Ping Pong"
            IsChecked="{Binding PingPong.Value}" />

    </StackPanel>

</Controls:ModulatablePanel>
