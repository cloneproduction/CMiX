<Controls:ModulatablePanel
    x:Class="CMiX.Studio.Avalonia.Views.RenderSequenceEntityModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    x:Name="renderSequenceEntityModifier">

    <StackPanel Margin="{DynamicResource SpacingSM}" Spacing="{DynamicResource SpacingSM}">

        <BaseControls:ModulatableFloatSlider
            Caption="Control"
            Minimum="0"
            Maximum="1"
            DataContext="{Binding Control}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=renderSequenceEntityModifier}" />

        <BaseControls:ComboBox
            Margin="0,0,0,4"
            Caption="Entity Type"
            ItemsSource="{x:Static Resources:EnumProviders.EntityType}"
            SelectedItem="{Binding EntityType.Value}" />

    </StackPanel>

</Controls:ModulatablePanel>
