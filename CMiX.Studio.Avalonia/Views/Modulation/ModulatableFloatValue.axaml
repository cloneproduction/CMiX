<StudioControls:ModulatorAssignableUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.ModulatableFloatValue"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:StudioControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    x:Name="channelValue"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <ui:DragValue
        ui:PositionedControl.Position="{Binding (ui:PositionedControl.Position), ElementName=channelValue}"
        Caption="{Binding Caption, ElementName=channelValue, Mode=OneWay}"
        IsReadOnly="{Binding IsModulated}"
        Maximum="{Binding Maximum, ElementName=channelValue}"
        Minimum="{Binding Minimum, ElementName=channelValue}"
        ResetCommand="{Binding ResetCommand}"
        Value="{Binding Value}">

        <ui:DragValue.TrailingContent>
            <StudioControls:ModulatorAssignButton
                ModulatorManager="{Binding ModulatorManager, ElementName=channelValue}" />
        </ui:DragValue.TrailingContent>
    </ui:DragValue>

</StudioControls:ModulatorAssignableUserControl>
