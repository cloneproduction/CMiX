<Modulation:UserControlModulatable
    x:Class="CMiX.Studio.Avalonia.Views.Modulation.ToggleButtonModulatable"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    x:Name="toggleButtonModulatable">

    <!-- The caption space of a value row, empty: the button takes the value column. -->
    <ui:ContentCaptioned>
        <DockPanel>

            <Modulation:ButtonModulatorAssign
                DockPanel.Dock="Right"
                ModulatorManager="{Binding ModulatorManager, ElementName=toggleButtonModulatable}" />

            <ui:ToggleButtonCMiX
                Content="{Binding Caption, ElementName=toggleButtonModulatable, Mode=OneWay}"
                IsChecked="{Binding Value, Mode=TwoWay}"
                IsHitTestVisible="{Binding !IsModulated}"
                ResetCommand="{Binding ResetCommand}"
                ui:PositionedControl.Position="{Binding (ui:PositionedControl.Position), ElementName=toggleButtonModulatable}" />

        </DockPanel>
    </ui:ContentCaptioned>

</Modulation:UserControlModulatable>
