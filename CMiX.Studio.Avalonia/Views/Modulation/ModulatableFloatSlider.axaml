<StudioControls:ModulatorAssignableUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.ModulatableFloatSlider"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:StudioControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    x:Name="channelSlider">

    <ui:CMiXSlider
        ui:PositionedControl.Position="{Binding (ui:PositionedControl.Position), ElementName=channelSlider}"
        Caption="{Binding Caption, ElementName=channelSlider, Mode=OneWay}"
        IsReadOnly="{Binding IsModulated}"
        Minimum="{Binding Minimum, ElementName=channelSlider}"
        Maximum="{Binding Maximum, ElementName=channelSlider}"
        ResetCommand="{Binding ResetCommand}"
        Value="{Binding Value}">
        <ui:CMiXSlider.TrailingContent>
            <StudioControls:ModulatorAssignButton ModulatorManager="{Binding ModulatorManager, ElementName=channelSlider}" />
        </ui:CMiXSlider.TrailingContent>
    </ui:CMiXSlider>

</StudioControls:ModulatorAssignableUserControl>
