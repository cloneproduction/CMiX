<Modulation:UserControlModulatable
    x:Class="CMiX.Studio.Avalonia.Views.Modulation.Vector2Modulatable"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="vector2Modulatable">

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

        <Modulation:DragValueModulatable
            Caption="{Binding Caption, ElementName=vector2Modulatable, StringFormat=' {0} X', Mode=OneWay}"
            DataContext="{Binding X}"
            ModulatorManager="{Binding ModulatorManager, ElementName=vector2Modulatable}" />

        <Modulation:DragValueModulatable
            ui:ControlTitle.Text="{Binding Caption, StringFormat=' {0} Y', ElementName=vector2Modulatable, Mode=OneWay}"
            Caption="Y"
            DataContext="{Binding Y}"
            ModulatorManager="{Binding ModulatorManager, ElementName=vector2Modulatable}" />

    </ui:StackPanelPositioned>

</Modulation:UserControlModulatable>
