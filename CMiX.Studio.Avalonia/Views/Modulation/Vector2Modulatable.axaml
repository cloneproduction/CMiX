<BaseControls:UserControlModulatable
    x:Class="CMiX.Studio.Avalonia.Views.Controls.Vector2Modulatable"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="channelVectorXY">

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

        <BaseControls:DragValueModulatable
            Caption="{Binding Caption, ElementName=channelVectorXY, StringFormat=' {0} X', Mode=OneWay}"
            DataContext="{Binding X}"
            ModulatorManager="{Binding ModulatorManager, ElementName=channelVectorXY}" />

        <BaseControls:DragValueModulatable
            Caption="Y"
            DataContext="{Binding Y}"
            ModulatorManager="{Binding ModulatorManager, ElementName=channelVectorXY}" />

    </ui:StackPanelPositioned>

</BaseControls:UserControlModulatable>
