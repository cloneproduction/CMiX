<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.BeatStepModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <Views:BeatControls />

        <ui:ListBoxEditable
            DataContext="{Binding StepManager}"
            AddCommand="{Binding AddItemCommand}"
            AddCommandParameter="{x:Type Animations:BeatStep}"
            ItemsSource="{Binding ManagerData.Items}"
            MoveDownCommand="{Binding ManagerReorderService.ItemDownCommand, FallbackValue={x:Null}}"
            MoveUpCommand="{Binding ManagerReorderService.ItemUpCommand, FallbackValue={x:Null}}"
            RemoveCommand="{Binding DeleteItemCommand}"
            ReorderService="{Binding ManagerReorderService}"
            SelectedIndex="{Binding ManagerData.SelectedIndex, Mode=TwoWay}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">

            <ui:ListBoxEditable.ItemTemplate>
                <DataTemplate DataType="{x:Type Animations:BeatStep}">
                    <ui:DragValue
                        Caption="{Binding $parent[ListBoxItem].(ui:ListBoxEditable.RowNumber), StringFormat='Step {0}'}"
                        ResetCommand="{Binding ResetCommand}"
                        Value="{Binding Value}" />
                </DataTemplate>
            </ui:ListBoxEditable.ItemTemplate>

        </ui:ListBoxEditable>

        <Views:Easing DataContext="{Binding Easing}" />

    </StackPanel>
</UserControl>
