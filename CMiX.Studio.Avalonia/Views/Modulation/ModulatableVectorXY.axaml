<BaseControls:ModulatorAssignableUserControl
    x:Class="CMiX.Studio.Avalonia.Views.Controls.ModulatableVectorXY"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    x:Name="channelVectorXY">

    <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

        <BaseControls:ModulatableFloatValue
            Caption="{Binding Caption, ElementName=channelVectorXY, StringFormat=' {0} X', Mode=OneWay}"
            DataContext="{Binding X}"
            ModulatorManager="{Binding ModulatorManager, ElementName=channelVectorXY}" />

        <BaseControls:ModulatableFloatValue
            Caption="Y"
            DataContext="{Binding Y}"
            ModulatorManager="{Binding ModulatorManager, ElementName=channelVectorXY}" />

    </Panels:PositionedStackPanel>

</BaseControls:ModulatorAssignableUserControl>
