<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.LFOModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:DragValue
            Caption="Period"
            Minimum="0.0"
            ResetCommand="{Binding Period.ResetCommand}"
            Value="{Binding Period.Value}" />

        <ui:RangeValue
            DataContext="{Binding Range}"
            LeftValue="{Binding Minimum.Value}"
            LeftCaption="Min"
            LeftResetCommand="{Binding Minimum.ResetCommand}"
            RightCaption="Max"
            RightResetCommand="{Binding Maximum.ResetCommand}"
            RightValue="{Binding Maximum.Value}"/>

        <ui:ComboBoxCaptioned
            Caption="Wave Type"
            ItemsSource="{x:Static Resources:EnumProviders.WaveType}"
            ResetCommand="{Binding WaveType.ResetCommand}"
            SelectedItem="{Binding WaveType.Value, Mode=TwoWay}" />

        <Views:Quantize DataContext="{Binding Quantize}" />

    </StackPanel>

</UserControl>
