<Modulation:UserControlModulatable
    x:Class="CMiX.Studio.Avalonia.Views.Modulation.IntegerValueModulatable"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    x:Name="countValue"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <ui:DragValue
        ui:PositionedControl.Position="{Binding (ui:PositionedControl.Position), ElementName=countValue}"
        Caption="{Binding Caption, ElementName=countValue, Mode=OneWay}"
        IsInteger="True"
        IsReadOnly="{Binding IsModulated}"
        LargeChange="1.0"
        Minimum="1"
        ResetCommand="{Binding ResetCommand}"
        SmallChange="1.0"
        Value="{Binding Value}">
        <ui:DragValue.TrailingContent>
            <Modulation:ButtonModulatorAssign
                ModulatorManager="{Binding ModulatorManager, ElementName=countValue}" />
        </ui:DragValue.TrailingContent>
    </ui:DragValue>

</Modulation:UserControlModulatable>
