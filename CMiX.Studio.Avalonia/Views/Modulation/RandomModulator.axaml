<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.RandomModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

            <ui:DragValue
                Caption="Center"
                Value="{Binding Center.Value}"
                ResetCommand="{Binding Center.ResetCommand}" />

            <ui:DragValue
                Caption="Width"
                Minimum="0.0"
                Value="{Binding Width.Value}"
                ResetCommand="{Binding Width.ResetCommand}" />

        </ui:PositionedStackPanel>

        <ui:DragValue
            Caption="Seed"
            IsInteger="True"
            LargeChange="1.0"
            SmallChange="1.0"
            Value="{Binding Seed.Value}"
            ResetCommand="{Binding Seed.ResetCommand}" />

    </StackPanel>

</UserControl>
