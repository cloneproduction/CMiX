<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.RandomModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">

        <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

            <ui:DragValue
                Caption="Center"
                DataContext="{Binding Center}"
                Value="{Binding Value}"
                ResetCommand="{Binding ResetCommand}" />

            <ui:DragValue
                Caption="Width"
                Minimum="0.0"
                DataContext="{Binding Width}"
                Value="{Binding Value}"
                ResetCommand="{Binding ResetCommand}" />

        </ui:StackPanelPositioned>

        <ui:DragValue
            Caption="Seed"
            IsInteger="True"
            LargeChange="1.0"
            SmallChange="1.0"
            DataContext="{Binding Seed}"
            Value="{Binding Value}"
            ResetCommand="{Binding ResetCommand}" />

    </StackPanel>

</UserControl>
