<BaseControls:UserControlModulatable
    x:Class="CMiX.Studio.Avalonia.Views.Controls.Vector3Modulatable"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="channelVectorXYZ"    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

        <BaseControls:DragValueModulatable
            Caption="{Binding Caption, ElementName=channelVectorXYZ, StringFormat=' {0} X', Mode=OneWay}"
            DataContext="{Binding X}"
            ModulatorManager="{Binding ModulatorManager, ElementName=channelVectorXYZ}" />

        <BaseControls:DragValueModulatable
            Caption="Y"
            DataContext="{Binding Y}"
            ModulatorManager="{Binding ModulatorManager, ElementName=channelVectorXYZ}" />

        <BaseControls:DragValueModulatable
            Caption="Z"
            DataContext="{Binding Z}"
            ModulatorManager="{Binding ModulatorManager, ElementName=channelVectorXYZ}" />

    </ui:StackPanelPositioned>

</BaseControls:UserControlModulatable>
