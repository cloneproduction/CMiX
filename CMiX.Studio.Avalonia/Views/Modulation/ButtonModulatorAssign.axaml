<Modulation:UserControlModulatable
    x:Class="CMiX.Studio.Avalonia.Views.Modulation.ButtonModulatorAssign"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Modulation="clr-namespace:CMiX.Studio.Avalonia.Views.Modulation"
    x:Name="modulatorAssignButton"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignHeight="400"
    d:DesignWidth="400">

    <Modulation:UserControlModulatable.Resources>
        <!-- A menu row bound to a ModulatorOutputChoice. -->
        <ControlTheme x:Key="MenuItemModulatorOutput" TargetType="MenuItem" BasedOn="{StaticResource MenuItemContext}">
            <Setter Property="Header" Value="{Binding Label}" />
            <Setter Property="IsChecked" Value="{Binding IsAssigned}" />
            <Setter Property="Command" Value="{Binding Command}" />
        </ControlTheme>
    </Modulation:UserControlModulatable.Resources>

    <Button
        x:Name="assignButton"
        Background="Transparent"
        Width="{DynamicResource ControlHeightMD}"
        IsEnabled="{Binding ModulatorManager.ManagerData.Items.Count, ElementName=modulatorAssignButton, Converter={StaticResource CountToVisibility}, ConverterParameter=0}"
        Theme="{StaticResource ButtonRoundedRightNoHover}">

        <Ellipse
            Width="8"
            Height="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
            <Ellipse.Fill>
                <MultiBinding Converter="{StaticResource ModulatorStateToBrush}">
                    <Binding Path="BoundModulator" />
                    <Binding Path="BoundModulator.IsHovered" />
                    <Binding Source="{StaticResource Grey700Brush}" />
                    <Binding Source="{StaticResource AccentBrush}" />
                    <Binding Source="{StaticResource AccentHighlightBrush}" />
                </MultiBinding>
            </Ellipse.Fill>
        </Ellipse>

        <Button.Flyout>
            <MenuFlyout
                FlyoutPresenterTheme="{StaticResource MenuFlyoutPresenterDefault}"
                ItemContainerTheme="{StaticResource MenuItemModulatorOutput}"
                Placement="Bottom">
                <i:Interaction.Behaviors>
                    <ui:CloseFlyoutOnPointerAwayBehavior />
                </i:Interaction.Behaviors>
            </MenuFlyout>
        </Button.Flyout>
    </Button>

</Modulation:UserControlModulatable>
