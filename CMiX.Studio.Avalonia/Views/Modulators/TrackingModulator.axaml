<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TrackingModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">
        <TextBlock HorizontalAlignment="Right" Padding="8, 0" Text="X ->"/>
        <TextBlock HorizontalAlignment="Right" Padding="8, 0"  Text="Y ->"/>
        <TextBlock HorizontalAlignment="Right" Padding="8, 0"  Text="Count ->"/>
    </StackPanel>

</UserControl>
