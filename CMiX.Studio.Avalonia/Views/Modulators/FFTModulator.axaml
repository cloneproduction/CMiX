<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.FFTModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Avalonia.Views.Controls.Panels"
    d:DesignWidth="400">

    <StackPanel Spacing="{DynamicResource SpacingMD}">
      
      <BaseControls:DragValue
        Caption="FFT"
        Minimum="0.0"
        Value="{Binding FFT.Value}"
        ResetCommand="{Binding FFT.ResetCommand}" />

      <Panels:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

        <BaseControls:DragValue
          Caption="Bass"
          Minimum="0.0"
          Value="{Binding Bass.Value}"
          ResetCommand="{Binding Bass.ResetCommand}"/>

        <BaseControls:DragValue
          Caption="Lower Mid"
          Minimum="0.0"
          Value="{Binding LowerMid.Value}"
          ResetCommand="{Binding LowerMid.ResetCommand}"/>

        <BaseControls:DragValue
          Caption="Higher Mid"
          Minimum="0.0"
          Value="{Binding HigherMid.Value}"
          ResetCommand="{Binding HigherMid.ResetCommand}"/>

        <BaseControls:DragValue
          Caption="High"
          Minimum="0.0"
          Value="{Binding High.Value}"
          ResetCommand="{Binding High.ResetCommand}"/>
        
    </Panels:PositionedStackPanel>
      
  </StackPanel>
  
</UserControl>
