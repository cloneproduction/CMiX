<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.BeatRandomModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <Views:BeatControls/>

        <BaseControls:RangeValue
            Margin="0, 8"
            LeftValue="{Binding Center.Value}"
            LeftCaption="Center"
            RightCaption="Width"
            RightValue="{Binding Width.Value}"/>

        <Views:Easing  DataContext="{Binding Easing}" />

    </StackPanel>
</UserControl>
