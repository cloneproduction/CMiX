<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ServerManager"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        HorizontalAlignment="Stretch"
        Background="{DynamicResource Grey400Brush}">
        <StackPanel>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <ListBox
                    Grid.Row="0"
                    Height="125"
                    Margin="8"
                    ItemsSource="{Binding Servers}"
                    SelectedItem="{Binding SelectedServer}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Height="{DynamicResource ControlHeightSM}">
                                <TextBlock Text="{Binding Name}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Grid>

        </StackPanel>
    </Border>

</UserControl>
