<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ServerCreation"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Button
        Height="{DynamicResource ControlHeightMD}"
        Click="Button_Click"
        Content="New"
        Theme="{StaticResource ButtonRounded}" />
</UserControl>
