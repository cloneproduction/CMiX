<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ServerSettings"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Margin="8">

        <DockPanel Margin="0,0,0,4">
            <Ellipse
                Width="7"
                Height="7"
                Margin="0,0,4,0"
                Classes.connected="{Binding ClientIsConnected}"
                Theme="{StaticResource ServerConnectionIndicatorStyle}" />
            <TextBlock
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource ForegroundBrush}"
                Text="{Binding Status}" />
            <ToggleButton
                Height="{DynamicResource ControlHeightXS}"
                DockPanel.Dock="Right"
                Background="Crimson"
                IsChecked="{Binding ServerIsRunning, Mode=TwoWay}"
                Theme="{DynamicResource TogglePlayPause}" />
        </DockPanel>

        <DockPanel Margin="0,0,0,8">
            <Ellipse
                Width="7"
                Height="7"
                Margin="0,0,4,0"
                Classes.insync="{Binding IsInSync}"
                Theme="{StaticResource ServerSyncIndicatorStyle}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource ForegroundBrush}"
                IsVisible="{Binding IsInSync}"
                Text="In sync" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource ForegroundBrush}"
                IsVisible="{Binding !IsInSync}"
                Text="Not in sync" />
        </DockPanel>

        <StackPanel
            Margin="0,0,0,8"
            IsVisible="{Binding !IsInSync}"
            Orientation="Horizontal">
            <Button
                Height="{DynamicResource ControlHeightMD}"
                Margin="0,0,4,0"
                Command="{Binding PushCommand}"
                Content="Push"
                Theme="{StaticResource ButtonRounded}"
                ToolTip.Tip="Send this side's project to the other side" />
            <Button
                Height="{DynamicResource ControlHeightMD}"
                Command="{Binding PullCommand}"
                Content="Pull"
                Theme="{StaticResource ButtonRounded}"
                ToolTip.Tip="Replace this side's project with the other side's" />
        </StackPanel>

        <Grid Height="{DynamicResource ControlHeightMD}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="0,0,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{DynamicResource ForegroundBrush}"
                Text="IP" />
            <TextBlock
                Grid.Column="1"
                Padding="4"
                Text="{Binding IP.Value}" />
        </Grid>
        <Grid Height="{DynamicResource ControlHeightMD}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBlock
                Margin="0,0,8,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource ForegroundBrush}"
                Text="Port" />
            <TextBlock
                Grid.Column="1"
                Padding="4"
                Foreground="{StaticResource ForegroundBrush}"
                Text="{Binding Port.Value}" />
        </Grid>

        <Button
            Height="{DynamicResource ControlHeightMD}"
            Margin="0,8,0,0"
            Click="Button_Click"
            Content="Edit Connection"
            Theme="{StaticResource ButtonRounded}" />
    </StackPanel>
</UserControl>
