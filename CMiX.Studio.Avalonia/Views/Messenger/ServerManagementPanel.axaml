<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ServerManagementPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views">

    <!-- Studio only ever talks to one engine, so just its settings, no server list. -->
    <Border Background="{DynamicResource Grey300Brush}">
        <Views:Server Margin="8" />
    </Border>
</UserControl>
