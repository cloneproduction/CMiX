<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.SyncStatusIndicator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="200">

    <!-- The status of a SyncPeer, as in the Network tab, without the caption. The status text says Connected, or Not in sync
         while the peer is connected and has not joined. -->
    <StackPanel
        VerticalAlignment="Center"
        Orientation="Horizontal"
        Spacing="{DynamicResource SpacingSM}">
        <Ellipse
            Name="connectionDot"
            Width="{DynamicResource IndicatorSize}"
            Height="{DynamicResource IndicatorSize}"
            VerticalAlignment="Center"
            Classes.connected="{Binding IsConnected}"
            Classes.connecting="{Binding Status, Converter={StaticResource SyncStatusIsConnecting}}"
            Theme="{StaticResource EllipseSyncConnection}" />
        <TextBlock
            Name="connectionText"
            VerticalAlignment="Center"
            Foreground="{DynamicResource ForegroundBrush}"
            Text="{Binding Status}" />
    </StackPanel>

</UserControl>
