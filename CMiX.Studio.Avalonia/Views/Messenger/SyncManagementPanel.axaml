<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.SyncManagementPanel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    d:DesignHeight="600">

    <!-- The Studio talks to Redis; all engines are peers on the same store. -->
    <Border Background="{DynamicResource Grey300Brush}">
        <Views:SyncPanel />
    </Border>
</UserControl>
