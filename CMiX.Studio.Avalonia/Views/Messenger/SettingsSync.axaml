<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.SettingsSync"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    d:DesignHeight="600">

    <StackPanel Spacing="{DynamicResource SpacingMD}" Margin="8">

        <ui:ContentCaptioned Caption="Status">
            <Border>
                <StackPanel Orientation="Horizontal">
                    <Ellipse
                        Width="{DynamicResource IndicatorSize}"
                        VerticalAlignment="Center"
                        Height="{DynamicResource IndicatorSize}"
                        Classes.connected="{Binding Peer.IsConnected}"
                        Classes.unsynced="{Binding !Peer.IsInSync}"
                        Classes.connecting="{Binding Peer.Status, Converter={StaticResource SyncStatusIsConnecting}}"
                        Theme="{StaticResource EllipseSyncConnection}" />
                    <TextBlock
                        Margin="4, 0, 0, 0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="{Binding Peer.Status}" />
                </StackPanel>
            </Border>
        </ui:ContentCaptioned>

        <!-- Shows the reason of a failed connection. Stays outside the flyouts so the text is
             visible right away, and stays visible until the peer clears ErrorMessage. -->
        <TextBlock

            Foreground="{DynamicResource PopupCardDangerBrush}"
            TextWrapping="Wrap"
            Text="{Binding Peer.ErrorMessage}"
            IsVisible="{Binding Peer.ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

        <!-- The single entry point for resolving an out-of-sync state: plain and inert while in
             sync, becomes clickable once not - clicking opens the Push/Pull/Cancel Flyout below. -->
        <Grid
            ColumnDefinitions="40*,60*"
            Height="{DynamicResource ControlHeightMD}">
            <TextBlock
                Grid.Column="0"
                Padding="0, 0, 8, 0"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                Text="Sync" />
            <Button
                Grid.Column="1"
                x:Name="syncButton"
                IsEnabled="{Binding !Peer.IsInSync}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse
                        Width="{DynamicResource IndicatorSize}"
                        Height="{DynamicResource IndicatorSize}"
                        Margin="0,0,4,0"
                        Classes.insync="{Binding Peer.IsInSync}"
                        Theme="{StaticResource EllipseSyncState}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ForegroundBrush}"
                        IsVisible="{Binding Peer.IsInSync}"
                        Text="In sync" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ForegroundBrush}"
                        IsVisible="{Binding !Peer.IsInSync}"
                        Text="Not in sync" />
                </StackPanel>

                <Button.Flyout>
                    <Flyout
                        Placement="Pointer"
                        FlyoutPresenterTheme="{StaticResource FlyoutPresenterPanel}">
                        <i:Interaction.Behaviors>
                            <ui:CloseFlyoutOnPointerAwayBehavior />
                        </i:Interaction.Behaviors>
                        <StackPanel Margin="4">
                            <TextBlock
                                Margin="0,0,0,16"
                                Text="The loaded project and the Redis state are different. Choose how to resolve it."
                                TextWrapping="Wrap" />
                            <Grid Height="{DynamicResource ControlHeightMD}" ui:MenuAnchor.IsAnchor="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button
                                    Grid.Column="0"
                                    Margin="0,0,4,0"
                                    Click="HideSyncFlyout_Click"
                                    Command="{Binding Peer.PushCommand}"
                                    Content="Push"
                                    IsEnabled="{Binding Peer.IsConnected}"
                                    ToolTip.Tip="Push: send the loaded project to Redis and all engines" />
                                <Button
                                    Grid.Column="1"
                                    Margin="4,0"
                                    Click="HideSyncFlyout_Click"
                                    Command="{Binding Peer.PullCommand}"
                                    Content="Pull"
                                    IsEnabled="{Binding !Peer.IsJoined}"
                                    ToolTip.Tip="Pull: replace the loaded project with the Redis state. Available while not in sync." />
                                <Button
                                    Grid.Column="2"
                                    Margin="4,0,0,0"
                                    Click="CancelSync_Click"
                                    Content="Cancel" />
                            </Grid>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- The endpoint line shows the options of the running peer. -->
        <ui:ContentCaptioned Caption="Redis">
            <TextBlock
                x:Name="endpointText"
                Text="{Binding EndpointText}"
                VerticalAlignment="Center"
                Foreground="{DynamicResource ForegroundBrush}" />
        </ui:ContentCaptioned>

        <Button
            x:Name="editConnectionButton"
            Height="{DynamicResource ControlHeightMD}"
            Content="Connection">
            <Button.Flyout>
                <Flyout
                    Opened="EditConnectionFlyout_Opened"
                    Placement="Pointer"
                    FlyoutPresenterTheme="{StaticResource FlyoutPresenterPanel}">
                    <i:Interaction.Behaviors>
                        <ui:CloseFlyoutOnPointerAwayBehavior />
                    </i:Interaction.Behaviors>

                    <StackPanel Spacing="{DynamicResource SpacingMD}">

                        <TextBlock Text="Connection Settings"
                                   Margin="0, 0, 0, 8"/>

                        <ui:TextBoxIP x:Name="ipBox" IPAddress="{Binding Ip, Mode=TwoWay}"/>

                        <ui:ContentCaptioned Caption="Port">
                            <TextBox x:Name="portBox" Text="{Binding Port}" />
                        </ui:ContentCaptioned>

                        <ui:ContentCaptioned Caption="Database">
                            <TextBox x:Name="databaseBox" Text="{Binding Database}" />
                        </ui:ContentCaptioned>

                        <ui:ToggleButtonCaptioned x:Name="useCredentialManagerBox" Caption="Use Credential Manager" IsChecked="{Binding UseCredentialManager}" />

                        <ui:ContentCaptioned Caption="Credential Name">
                            <TextBox x:Name="credentialNameBox" Text="{Binding CredentialName}" />
                        </ui:ContentCaptioned>

                        <ui:ContentCaptioned Caption="User">
                            <TextBox Grid.Column="1" x:Name="userBox" Text="{Binding User}" IsEnabled="{Binding IsUserEditable}" />
                        </ui:ContentCaptioned>

                        <ui:ContentCaptioned Caption="Password">
                            <TextBox Grid.Column="1" x:Name="passwordBox" PasswordChar="*" Text="{Binding Password}" IsEnabled="{Binding IsUserEditable}" />
                        </ui:ContentCaptioned>

                        <ui:ContentCaptioned Caption="Key Prefix">
                            <TextBox Grid.Column="1" x:Name="keyPrefixBox" Text="{Binding KeyPrefix}" />
                        </ui:ContentCaptioned>

                        <ui:ContentCaptioned Caption="Peer Name">
                            <TextBox Grid.Column="1" x:Name="peerNameBox" Text="{Binding PeerName}" />
                        </ui:ContentCaptioned>

                        <!-- Reserves space so the popup does not resize when a message appears. -->
                        <StackPanel MinHeight="40">
                            <TextBlock
                                x:Name="errorText"
                                Text="{Binding ErrorText}"
                                Margin="0,4"
                                Foreground="{DynamicResource PopupCardDangerBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <UniformGrid Margin="0, 8, 0, 0" Columns="2">
                            <Button
                                x:Name="connectButton"
                                Margin="0,0,4,0"
                                Command="{Binding ConnectCommand}"
                                Content="{Binding Peer.Status, Converter={StaticResource SyncStatusConnectText}}" />
                            <Button
                                Margin="4,0,0,0"
                                Click="CancelEditConnection_Click"
                                Content="Cancel" />
                        </UniformGrid>
                    </StackPanel>
                </Flyout>
            </Button.Flyout>
        </Button>

    </StackPanel>
</UserControl>
