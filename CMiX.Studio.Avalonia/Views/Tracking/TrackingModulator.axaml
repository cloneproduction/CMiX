<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TrackingModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <!--
        Typed in by hand, standing in for what a live tracker would report on its own - this
        modulator exists purely to exercise Kind = Set (lock-and-override) live in the app before
        any real tracking integration exists.
    -->
    <BaseControls:DragValue
        Caption="Count"
        IsInteger="True"
        Minimum="0"
        Value="{Binding Count.Value}" />

</UserControl>
