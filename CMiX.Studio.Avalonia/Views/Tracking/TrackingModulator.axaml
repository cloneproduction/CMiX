<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.TrackingModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>
        <BaseControls:DragValue
            Caption="Count"
            IsInteger="True"
            Minimum="0"
            Value="{Binding Count.Value}" />
        <BaseControls:DragValue
            Margin="0,1,0,0"
            Caption="X"
            Value="{Binding X.Value}" />
    </StackPanel>

</UserControl>
