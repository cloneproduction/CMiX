<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ListTreeProject"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:tree="clr-namespace:CMiX.Studio.Avalonia.Behaviors.ListTree">

    <!-- The behaviors watch the tree in this order. -->
    <i:Interaction.Behaviors>
        <tree:ListTreeViewStateInput />
        <tree:ListTreeScreenRequests />
        <tree:ListTreeFocusKeeper />
        <tree:ListTreePressFocus />
        <tree:ListTreeRowClick />
        <tree:ListTreeDragSession />
        <tree:ListTreeDragRest />
        <tree:ListTreeDrop />
        <tree:ListTreeRowDrag />
        <tree:ListTreeGrab />
        <tree:ListTreeGrabInput />
        <tree:ListTreeAutoScroll />
        <tree:ListTreeKeyInput />
        <tree:ListTreeAddBeside />
        <tree:ListTreeLastPointer />
        <tree:ListTreeMenus />
        <tree:ListTreeHints />
        <tree:ListTreeFileDropInput />
        <tree:ListTreeRowReveal />
        <tree:ListTreeScrollAnchor />
        <tree:ListTreeEndRoom />
        <tree:ListTreeTooltips />
    </i:Interaction.Behaviors>

    <UserControl.Styles>
        <!-- The frame of a grab shows while the view has the class grabbing (ListTreeGrab). -->
        <Style Selector="Border#grabFrame">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Views|ListTreeProject.grabbing Border#grabFrame">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </UserControl.Styles>

    <!-- Tree.Open. The keys of the selected row are in the main window.
         F2 is a fixed key: it renames in place in the tree only. Tree.Rename keeps its own gesture in the main window. -->
    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding OpenSelectedCommand}" Gesture="{Binding Shortcuts[Tree.Open]}" />
        <KeyBinding Command="{Binding RenameSelectedByKeyCommand}" Gesture="F2" />
    </UserControl.KeyBindings>

    <!-- The project tree. The DataContext is the ProjectTree. -->
    <DockPanel Background="{DynamicResource ListTreeBackgroundBrush}">

        <Views:ToolbarProjectTree
            Background="{DynamicResource ListTreeToolbarBackgroundBrush}"
            DockPanel.Dock="Top"
            Padding="{DynamicResource ListTreeToolbarPadding}" />

        <!-- The keys of the mode of the tree, under the rows. -->
        <ui:KeyHintStrip
            x:Name="hintStrip"
            DockPanel.Dock="Bottom"
            IsVisible="{Binding Interface.ShowKeyHints}" />

        <!-- One line during a drag: where the row goes (ListTreeDragSession). -->
        <TextBlock
            x:Name="dragNote"
            DockPanel.Dock="Bottom"
            FontSize="{DynamicResource FontSizeMD}"
            Foreground="{DynamicResource ListTreeTextRestBrush}"
            IsVisible="False"
            Padding="{DynamicResource ListTreeToolbarPadding}"
            TextTrimming="CharacterEllipsis" />

        <Panel>
        <!-- The clicks, the keys and the menus of the rows. A press under the rows hits the scroller too. -->
        <ScrollViewer
            x:Name="scroller"
            Background="Transparent"
            HorizontalScrollBarVisibility="Disabled"
            Theme="{DynamicResource ScrollViewerOverlay}">
            <StackPanel>
            <Views:PanelListTreeRows
                x:Name="rows"
                Margin="{DynamicResource ListTreeMargin}"
                Background="Transparent"
                Indent="{DynamicResource ListTreeIndent}"
                IsSearchActive="{Binding IsSearchActive}"
                KeyboardNavigation.TabNavigation="Once"
                Roots="{Binding Roots}"
                RowGap="{DynamicResource ListTreeRowGap}"
                RowHeight="{DynamicResource ListTreeRowHeight}"
                SelectedNode="{Binding SelectedNode}"
                SelectedNodes="{Binding SelectedNodes}" />

            <!-- The room under the rows (ListTreeEndRoom). -->
            <Border x:Name="endRoomSpace" Height="0" />
            </StackPanel>
        </ScrollViewer>

        <!-- The accent frame around the rows during a grab. -->
        <Border
            x:Name="grabFrame"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="{DynamicResource CursorFrameThickness}"
            IsHitTestVisible="False" />
        </Panel>

    </DockPanel>

</UserControl>
