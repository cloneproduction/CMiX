<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.ListTreeProject"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ListTree="clr-namespace:CMiX.Studio.Avalonia.ViewModels.ListTree">

    <!-- The new project tree. The DataContext is the ProjectTree, the same as the one of TreeViewProject. -->
    <DockPanel Background="{DynamicResource TreeBackgroundBrush}">

        <ItemsControl x:Name="rows" Margin="{DynamicResource TreeMargin}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type ListTree:ListTreeRow}">
                    <TextBlock Foreground="{DynamicResource ListTreeTextRestBrush}" Text="{Binding Node.Header}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </DockPanel>

</UserControl>
