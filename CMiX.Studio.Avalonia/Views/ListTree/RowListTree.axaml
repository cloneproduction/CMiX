<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.RowListTree"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:StudioConverters="clr-namespace:CMiX.Studio.Avalonia.Converters"
    FocusAdorner="{x:Null}"
    Classes.cursor="{Binding IsCursor}"
    Classes.inspected="{Binding IsInspected}"
    Classes.searchparent="{Binding IsSearchParent}"
    Focusable="True">

    <!-- One row of the tree, on the tree node. The band starts at the indent, the toggles stay at the right edge.
         The Background is the surface of the row, full width, for an item and for a card header. -->
    <UserControl.Resources>
        <StudioConverters:TreeToneConverter x:Key="RowTone" />
        <StudioConverters:ListTreeKindBrushConverter x:Key="KindMark" />
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="ui|TextBoxEditable#nameBox, TextBlock#groupName">
            <Setter Property="TextElement.FontSize" Value="{DynamicResource FontSizeMD}" />
            <Setter Property="TextElement.FontWeight" Value="Normal" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ListTreeTextRestBrush}" />
        </Style>
        <Style Selector="Views|RowListTree:card ui|TextBoxEditable#nameBox, Views|RowListTree:card TextBlock#groupName">
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Views|RowListTree:pointerover ui|TextBoxEditable#nameBox, Views|RowListTree:pointerover TextBlock#groupName">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ListTreeTextActiveBrush}" />
        </Style>
        <Style Selector="Views|RowListTree:selected ui|TextBoxEditable#nameBox, Views|RowListTree:selected TextBlock#groupName">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ListTreeTextSelectedBrush}" />
        </Style>
        <Style Selector="Views|RowListTree.inspected ui|TextBoxEditable#nameBox, Views|RowListTree.inspected TextBlock#groupName,
                         Views|RowListTree.inspected Views|TogglesRow ToggleButton">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ListTreeTextSelectedBrush}" />
        </Style>

        <Style Selector="Views|RowListTree:pointerover:not(:selected):not(:dimmed):not(.searchparent)">
            <Setter Property="Background" Value="{DynamicResource ListTreeRowHoverBrush}" />
        </Style>
        <Style Selector="Views|RowListTree:selected">
            <Setter Property="Background" Value="{DynamicResource ListTreeRowSelectedBrush}" />
        </Style>
        <Style Selector="Views|RowListTree:selected:pointerover:not(:dimmed)">
            <Setter Property="Background" Value="{DynamicResource ListTreeRowSelectedHoverBrush}" />
        </Style>
        <!-- The cursor row with no other state has the rest band at full width. -->
        <Style Selector="Views|RowListTree.cursor:not(:pointerover):not(:selected):not(.inspected):not(:dimmed):not(.searchparent)">
            <Setter Property="Background" Value="{DynamicResource ListTreeRowRestBandBrush}" />
        </Style>
        <!-- The inspected row has the tint of its kind, also when it is selected. -->
        <Style Selector="Views|RowListTree.inspected">
            <Setter Property="Background" Value="{Binding Converter={StaticResource KindMark}, ConverterParameter=Inspected}" />
        </Style>
        <Style Selector="Views|RowListTree.inspected:pointerover:not(:dimmed)">
            <Setter Property="Background" Value="{Binding Converter={StaticResource KindMark}, ConverterParameter=InspectedHover}" />
        </Style>

        <!-- A row that is the drop target and not a card: the surface of a hover and no left border. -->
        <Style Selector="Views|RowListTree:droptarget:not(:card)">
            <Setter Property="Background" Value="{DynamicResource ListTreeCardDropTargetBrush}" />
        </Style>

        <Style Selector="Border#band">
            <Setter Property="Background" Value="{DynamicResource ListTreeRowRestBandBrush}" />
        </Style>
        <Style Selector="Views|RowListTree:pointerover Border#band, Views|RowListTree:selected Border#band,
                         Views|RowListTree.cursor Border#band, Views|RowListTree.inspected Border#band">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border#mark">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Views|RowListTree:pointerover:not(:dimmed) Border#mark">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Background" Value="{Binding Converter={StaticResource KindMark}, ConverterParameter=HoverBorder}" />
        </Style>
        <Style Selector="Views|RowListTree:selected Border#mark">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Background" Value="{Binding Converter={StaticResource KindMark}, ConverterParameter=SelectionBorder}" />
        </Style>
        <Style Selector="Views|RowListTree:droptarget Border#mark">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- The cursor frame: one neutral pixel at full width, also on a selected row. It hides during a drag. -->
        <Style Selector="Border#cursorFrame">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Views|RowListTree.cursor Border#cursorFrame">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource ListTreeRowCursorFrameBrush}" />
        </Style>
        <Style Selector="Views|ListTreeProject.dragging Views|RowListTree Border#cursorFrame">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- AppIcon sets its own Foreground in its styles, so the state of the row reaches the icon through IconForeground. -->
        <Style Selector="Views|RowListTree">
            <Setter Property="IconForeground" Value="{Binding Converter={StaticResource RowTone}, ConverterParameter=KindSelected}" />
            <!-- The tooltips of a row have the hover fill of the row. -->
            <Setter Property="ui:ToolTipCard.Fill" Value="{Binding Converter={StaticResource RowTone}, ConverterParameter=FillHover}" />
        </Style>

        <!-- During a drag, a row that can not take the drop is a readable grey, never an opacity.
             During a search, a parent shown only for a match has the same look, unless it is selected or inspected. -->
        <Style Selector="Views|RowListTree:dimmed Border#band">
            <Setter Property="Background" Value="{DynamicResource ListTreeRowDimmedBandBrush}" />
        </Style>
        <Style Selector="Views|RowListTree:dimmed ui|TextBoxEditable#nameBox, Views|RowListTree:dimmed TextBlock#groupName">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ListTreeTextDimmedBrush}" />
        </Style>
        <Style Selector="Views|RowListTree:dimmed">
            <Setter Property="IconForeground" Value="{DynamicResource ListTreeIconDimmedBrush}" />
        </Style>
        <Style Selector="Views|RowListTree:dimmed Views|TogglesRow ToggleButton">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ListTreeTextDimmedBrush}" />
        </Style>
        <Style Selector="Views|RowListTree.searchparent:not(:selected):not(.inspected)">
            <Setter Property="IconForeground" Value="{DynamicResource ListTreeIconDimmedBrush}" />
            <Style Selector="^ Border#band">
                <Setter Property="Background" Value="{DynamicResource ListTreeRowDimmedBandBrush}" />
            </Style>
            <Style Selector="^ ui|TextBoxEditable#nameBox, ^ TextBlock#groupName, ^ Views|TogglesRow ToggleButton">
                <Setter Property="TextElement.Foreground" Value="{DynamicResource ListTreeTextDimmedBrush}" />
            </Style>
            <Style Selector="^:pointerover Border#mark">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <!-- A hidden row and every row under a hidden row have a fixed grey, never an opacity. -->
        <Style Selector="Views|RowListTree:hiddenrow ui|TextBoxEditable#nameBox, Views|RowListTree:hiddenrow TextBlock#groupName">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ListTreeTextHiddenBrush}" />
        </Style>
        <Style Selector="Views|RowListTree:hiddenrow">
            <Setter Property="IconForeground" Value="{DynamicResource ListTreeIconHiddenBrush}" />
        </Style>

        <!-- The dragged row sits at its landing place: a full width surface, white text, the icon in its kind colour. -->
        <Style Selector="Views|RowListTree:dragged">
            <Setter Property="Background" Value="{DynamicResource ListTreeRowDraggedBrush}" />
        </Style>
        <Style Selector="Views|RowListTree:dragged Border#band">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Views|RowListTree:dragged ui|TextBoxEditable#nameBox, Views|RowListTree:dragged TextBlock#groupName">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ListTreeTextSelectedBrush}" />
        </Style>
        <Style Selector="Views|RowListTree:dragged Border#mark">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- After a drop: the accent colour over the surface of the row fades out once. -->
        <Style Selector="Views|RowListTree:flash Border#flash">
            <Style.Animations>
                <Animation Duration="{x:Static ui:Motion.FlashDuration}" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="{StaticResource OpacityFlash}" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Border
            x:Name="flash"
            Background="{DynamicResource AccentBrush}"
            CornerRadius="{DynamicResource CornerRadiusAll}"
            IsHitTestVisible="False"
            Opacity="0" />

        <Border
            x:Name="band"
            Margin="{Binding IndentMargin, RelativeSource={RelativeSource AncestorType=Views:RowListTree}}"
            CornerRadius="{DynamicResource CornerRadiusAll}"
            ToolTip.Tip="{Binding DropBlockReason}">
            <DockPanel Margin="{DynamicResource ListTreeRowContentMargin}">

                <Views:TogglesRow
                    x:Name="toggles"
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right" />

                <!-- Each click on the icon of a card opens or closes the card, also the second click of a double click.
                     A double click on the rest of the row, outside the name text and the toggles, opens or closes it too. -->
                <Border
                    x:Name="iconHit"
                    Padding="{DynamicResource ListTreeIconMargin}"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    DockPanel.Dock="Left"
                    DoubleTapped="OnIconTapped"
                    Tapped="OnIconTapped">
                    <ui:AppIcon
                        x:Name="kindIcon"
                        IconKey="{Binding IconKey, RelativeSource={RelativeSource AncestorType=Views:RowListTree}}"
                        Foreground="{Binding IconForeground, RelativeSource={RelativeSource AncestorType=Views:RowListTree}}"
                        Size="{DynamicResource IconSizeXS}" />
                </Border>

                <!-- The name: a box for an item, a text for a group, each with the badges of a closed card.
                     During a search, the matched letters of the name have the highlight colour. -->
                <Panel VerticalAlignment="Center">
                    <ui:TextBoxEditable
                        x:Name="nameBox"
                        Padding="{DynamicResource ListTreeNamePadding}"
                        HighlightText="{Binding SearchHighlight}"
                        IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Text="{Binding Item.PrefabService.Name.Value, Mode=TwoWay}">
                        <ui:TextBoxEditable.Suffix>
                            <Views:BadgesKindCount
                                IsVisible="{Binding ShowsBadges}"
                                IsHovered="{Binding $parent[Views:RowListTree].IsPointerOver}"
                                IsSelected="{Binding $parent[Views:RowListTree].IsSelected}" />
                        </ui:TextBoxEditable.Suffix>
                    </ui:TextBoxEditable>

                    <StackPanel
                        VerticalAlignment="Center"
                        IsVisible="{Binding Item, Converter={x:Static ObjectConverters.IsNull}}"
                        Orientation="Horizontal">
                        <ui:TextBlockHighlighted
                            x:Name="groupName"
                            Padding="{DynamicResource ListTreeNamePadding}"
                            VerticalAlignment="Center"
                            HighlightText="{Binding SearchHighlight}"
                            Text="{Binding Header}" />
                        <Views:BadgesKindCount
                            IsVisible="{Binding ShowsBadges}"
                            IsHovered="{Binding $parent[Views:RowListTree].IsPointerOver}"
                            IsSelected="{Binding $parent[Views:RowListTree].IsSelected}" />
                    </StackPanel>
                </Panel>

            </DockPanel>
        </Border>

        <Border
            x:Name="cursorFrame"
            BorderThickness="{DynamicResource TreeSelectionThickness}"
            CornerRadius="{DynamicResource CornerRadiusAll}"
            IsHitTestVisible="False" />

        <Border
            x:Name="mark"
            Width="{DynamicResource ListTreeLeftBorderWidth}"
            HorizontalAlignment="Left"
            IsHitTestVisible="False" />
    </Panel>

</UserControl>
