<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.FrameListTreeCard"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    IsHitTestVisible="False">

    <!-- The area of a card, on the tree node. The panel sets the drop target state. -->
    <UserControl.Styles>
        <!-- The drop target: the surface of a hover and no left border. FrameListTreeOutline draws its outline. -->
        <Style Selector="Views|FrameListTreeCard:droptarget Border#surface">
            <Setter Property="Background" Value="{DynamicResource ListTreeCardDropTargetBrush}" />
        </Style>
    </UserControl.Styles>

    <Border x:Name="surface" CornerRadius="{DynamicResource CornerRadiusAll}" />

</UserControl>
