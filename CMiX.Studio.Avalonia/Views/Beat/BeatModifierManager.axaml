<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.BeatModifierManager"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">
    <StackPanel>
        <Controls:Outliner ItemsSource="{Binding ControlRepository.BeatModifiers}">
            <Controls:Outliner.SelectionPanel>
                <Button
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{x:Type Animations:BeatModifier}"
                    Content="New"
                    Theme="{DynamicResource ButtonRoundedRight}" />
            </Controls:Outliner.SelectionPanel>
        </Controls:Outliner>

        <!-- NullToVisibility returns a bool in this project; the Collapsed converter parameter is gone. -->
        <Border IsVisible="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
            <Views:BeatModifier Margin="-8,0,-8,-8" DataContext="{Binding SelectedItem}" />
        </Border>
    </StackPanel>
</UserControl>
