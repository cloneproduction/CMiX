<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.BeatModulator"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <Views:BeatControls/>

        <BaseControls:CMiXSlider
            Caption="Chance To Hit"
            Maximum="100"
            Value="{Binding ChanceToHit.Value}" />

        <Views:Easing Margin="0, 8, 0, 0" DataContext="{Binding Easing}" />

    </StackPanel>
</UserControl>
