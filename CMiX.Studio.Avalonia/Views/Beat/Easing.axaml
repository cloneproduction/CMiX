<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.Easing"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Resources="clr-namespace:CMiX.Studio.Avalonia.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <ui:CaptionedToggleButton 
            Margin="0, 0, 0, 8"
            IsChecked="{Binding IsEnabled.Value}"
            ResetCommand="{Binding IsEnabled.ResetCommand}"
            Caption="Easing"/>

        <ui:PositionedStackPanel
            Spacing="{DynamicResource SpacingXXS}"
            IsEnabled="{Binding IsEnabled.Value}">

            <ui:CaptionedComboBox
                Caption="Function"
                ItemsSource="{x:Static Resources:EnumProviders.TweenerTransition}"
                ResetCommand="{Binding Transition.ResetCommand}"
                SelectedItem="{Binding Transition.Value}" />

            <ui:CaptionedComboBox
                Caption="Mode"
                ItemsSource="{x:Static Resources:EnumProviders.TweenerMode}"
                ResetCommand="{Binding Mode.ResetCommand}"
                SelectedItem="{Binding Mode.Value}" />

        </ui:PositionedStackPanel>

    </StackPanel>
</UserControl>
