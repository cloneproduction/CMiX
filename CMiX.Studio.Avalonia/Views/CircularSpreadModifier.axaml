<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.CircularSpreadModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Modulators="clr-namespace:CMiX.Core.Modulation.Modulators;assembly=CMiX.Core"
    xmlns:Panels="using:CMiX.Studio.Avalonia.Views.Controls.Panels"
    x:Name="circularSpreadModifier"    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <Views:ModifierModeSelector DataContext="{Binding ModifierModeSelector}" />

        <!-- No DataContext override here - CircularSpread itself has X/Y properties, so this
             reads them directly off the whole modifier, same as
             ScaleModifier/TranslateModifier/RotationModifier already do with ModulatableVectorXYZ. -->
        <BaseControls:ModulatableVectorXY
            Margin="0,8"
            Caption="Width"
            ModulatorManager="{Binding ModulatorManager}" />

        <Panels:PositionedStackPanel Margin="0, 0, 0, 8">
            <BaseControls:ModulatableValue
                Margin="0, 0, 0, 1"
                Caption="Phase"
                DataContext="{Binding Phase}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=circularSpreadModifier}" />

            <BaseControls:ModulatableValue
                Caption="Factor"
                DataContext="{Binding Factor}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=circularSpreadModifier}" />

        </Panels:PositionedStackPanel>


        <Views:ModifierManager DataContext="{Binding ModulatorManager}">
            <Views:ModifierManager.SelectionPanel>
                <Managers:AutoSelectionPanel Interface="{x:Type Modulators:IModulator}" />
            </Views:ModifierManager.SelectionPanel>
        </Views:ModifierManager>

    </StackPanel>

</UserControl>
