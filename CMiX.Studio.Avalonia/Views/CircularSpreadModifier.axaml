<Controls:ModulatablePanel
    x:Class="CMiX.Studio.Avalonia.Views.CircularSpreadModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Panels="using:CMiX.Studio.Avalonia.Views.Controls.Panels"
    x:Name="circularSpreadModifier"    
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <StackPanel>

        <Views:ModifierModeSelector
            DataContext="{Binding ModifierModeSelector}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=circularSpreadModifier}" />

        <BaseControls:ModulatableVectorXY
            Margin="0,8"
            Caption="Width"
            ModulatorManager="{Binding ModulatorManager}" />

        <Panels:PositionedStackPanel Margin="0, 0, 0, 8">
            <BaseControls:ModulatableFloatValue
                Margin="0, 0, 0, 1"
                Caption="Phase"
                DataContext="{Binding Phase}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=circularSpreadModifier}" />

            <BaseControls:ModulatableFloatValue
                Caption="Factor"
                DataContext="{Binding Factor}"
                ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=circularSpreadModifier}" />

        </Panels:PositionedStackPanel>

    </StackPanel>

</Controls:ModulatablePanel>
