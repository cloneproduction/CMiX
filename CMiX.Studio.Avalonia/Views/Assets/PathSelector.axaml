<ui:CaptionedUserControl
    x:Class="CMiX.Studio.Avalonia.Views.PathSelector"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="pathSelector"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <ui:ContentCaptioned Caption="{Binding Caption, ElementName=pathSelector}">

        <DockPanel>

            <Button
                Margin="1,0,0,0"
                Width="{DynamicResource ControlHeightMD}"
                DockPanel.Dock="Right"
                Click="BrowseButton_Click"
                Theme="{StaticResource ButtonRoundedRight}">
                <ui:AppIcon IconKey="Folder" Size="{DynamicResource IconSizeXS}" />
            </Button>

            <Border
                x:Name="mainBorder"
                ui:PositionedControl.Position="Left"
                Background="{DynamicResource Grey500Brush}"
                BorderBrush="Transparent"
                Classes="BorderMask">

                <ComboBox
                    x:Name="pathComboBox"
                    ui:PositionedControl.Position="Left"
                    ItemsSource="{Binding ItemsSource, ElementName=pathSelector}"
                    SelectedItem="{Binding SelectedItem, ElementName=pathSelector}">

                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>

                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>

                </ComboBox>
            </Border>

        </DockPanel>

    </ui:ContentCaptioned>

</ui:CaptionedUserControl>
