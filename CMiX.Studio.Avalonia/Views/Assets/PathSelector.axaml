<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.PathSelector"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.Avalonia.AttachedProperties"
    x:Name="pathSelector">

    <Grid Height="{DynamicResource ControlHeightMD}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock
            Margin="0,0,8,0"
            HorizontalAlignment="Right"
            Text="Filename" />

        <Border
            x:Name="mainBorder"
            Grid.Column="1"
            AttachedProperties:PositionedControl.Position="{Binding (AttachedProperties:PositionedControl.Position), ElementName=pathSelector}"
            Background="{DynamicResource Grey500Brush}"
            BorderBrush="Transparent"
            Classes="BorderMask">

            <ComboBox
                x:Name="pathComboBox"
                AttachedProperties:PositionedControl.Position="All"
                ItemsSource="{Binding ItemsSource, ElementName=pathSelector}"
                SelectedItem="{Binding SelectedItem, ElementName=pathSelector}">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>

                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>

            </ComboBox>
        </Border>
    </Grid>
</UserControl>