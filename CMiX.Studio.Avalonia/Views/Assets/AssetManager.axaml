<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.AssetManager"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <Border
        x:Name="dropBorder"
        Background="{DynamicResource Grey300Brush}">
        <StackPanel>
            <Expander
                Header="Images"
                IsExpanded="True">
                <ListBox
                    x:Name="imagesListBox"
                    Background="Transparent"
                    ItemsSource="{Binding AssetRepository.Images}"
                    SelectionMode="Multiple">

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="{DynamicResource ControlHeightSM}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                                <ui:TextBlockTrimmed Text="{Binding Name}" ToolTipText="{Binding FilePath}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Expander>
            <Expander
                Header="Videos"
                IsExpanded="True">
                <ListBox
                    x:Name="videosListBox"
                    Background="Transparent"
                    ItemsSource="{Binding AssetRepository.Videos}"
                    SelectionMode="Multiple">

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="{DynamicResource ControlHeightSM}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                                <ui:TextBlockTrimmed Text="{Binding Name}" ToolTipText="{Binding FilePath}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Expander>
            <Expander
                Header="Geometries"
                IsExpanded="True">
                <ListBox
                    x:Name="geometriesListBox"
                    Background="Transparent"
                    ItemsSource="{Binding AssetRepository.Geometries}"
                    SelectionMode="Multiple">

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="{DynamicResource ControlHeightSM}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                                <ui:TextBlockTrimmed Text="{Binding Name}" ToolTipText="{Binding FilePath}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Expander>
            <Expander
                Header="Image Sequences"
                IsExpanded="True">
                <ListBox
                    x:Name="imageSequencesListBox"
                    Background="Transparent"
                    ItemsSource="{Binding AssetRepository.ImageSequences}"
                    SelectionMode="Multiple">

                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </ListBox.Styles>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="{DynamicResource ControlHeightSM}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                                <ui:TextBlockTrimmed Text="{Binding Name}" ToolTipText="{Binding FilePath}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                </ListBox>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>
