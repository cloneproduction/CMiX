<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.PanelMainTabs"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Modulators="clr-namespace:CMiX.Core.Modulation.Modulators;assembly=CMiX.Core"
    xmlns:ColorModifiers="clr-namespace:CMiX.Core.Colors.Modifiers;assembly=CMiX.Core"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:TextureSources="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers">

    <!-- The tabs of the app and, under them, the master beat. The DataContext is the MainViewModel.
         A side panel can show this (see SidePanelHost). -->
    <Grid RowDefinitions="*,Auto">

        <TabControl
            x:Name="mainTabs"
            Grid.Row="0"
            VerticalAlignment="Stretch"
            Theme="{StaticResource TabControlMain}">

            <!-- The editor of the item that is selected in the tree. -->
            <TabItem x:Name="inspectorTab" Theme="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <ui:AppIcon
                        Margin="8"
                        IconKey="Inspector"
                        Size="{DynamicResource IconSizeXS}"
                        ToolTip.Tip="Inspector" />
                </TabItem.Header>

                <Views:PanelInspector DataContext="{Binding ProjectTree}" />

            </TabItem>

            <TabItem Theme="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <ui:AppIcon
                        Margin="8"
                        IconKey="Settings"
                        Size="{DynamicResource IconSizeXS}"
                        ToolTip.Tip="Settings" />
                </TabItem.Header>

                <Views:TabSettings />

            </TabItem>

            <TabItem Theme="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <ui:AppIcon
                        Margin="8"
                        IconKey="Composition"
                        Size="{DynamicResource IconSizeXS}"
                        ToolTip.Tip="Composition" />
                </TabItem.Header>

                <Views:TabComposition />

            </TabItem>

            <TabItem Theme="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <ui:AppIcon
                        Margin="8"
                        IconKey="LayerScene"
                        Size="{DynamicResource IconSizeXS}"
                        ToolTip.Tip="Layers" />
                </TabItem.Header>

                <Views:TabLayers />

            </TabItem>

            <TabItem Theme="{StaticResource TabItemHorizontal}">
                <TabItem.Header>
                    <ui:AppIcon
                        Margin="8"
                        IconKey="Geometry"
                        Size="{DynamicResource IconSizeXS}"
                        ToolTip.Tip="Entities" />
                </TabItem.Header>

                <Views:TabEntities />

            </TabItem>

            <Managers:TabRepository
                DataContext="{Binding TextureManager}"
                Icon="Texture"
                ItemsSource="{Binding ControlRepository.Textures}"
                ToolTipText="Textures">
                <Managers:TabRepository.SelectionPanel>
                    <ui:ButtonPopup Caption="New Texture">
                        <ui:ButtonPopup.PopupContent>
                            <Managers:PanelAddTypes Interface="{x:Type TextureSources:ITextureSource}" />
                        </ui:ButtonPopup.PopupContent>
                    </ui:ButtonPopup>
                </Managers:TabRepository.SelectionPanel>
                <Managers:TabRepository.EditingPanel>
                    <Views:Texture />
                </Managers:TabRepository.EditingPanel>
            </Managers:TabRepository>

            <Managers:TabRepository
                DataContext="{Binding CameraManager}"
                Icon="Camera"
                ItemsSource="{Binding ControlRepository.Cameras}"
                RowMenu="Repository"
                ToolTipText="Cameras">
                <Managers:TabRepository.SelectionPanel>
                    <Button
                        Command="{Binding AddItemCommand}"
                        CommandParameter="{x:Type Cameras:Camera}"
                        Content="New Camera" />
                </Managers:TabRepository.SelectionPanel>
                <Managers:TabRepository.EditingPanel>
                    <Views:Camera />
                </Managers:TabRepository.EditingPanel>
            </Managers:TabRepository>

            <Managers:TabRepository
                DataContext="{Binding LightManager}"
                Icon="MeshLight"
                ItemsSource="{Binding ControlRepository.Lights}"
                RowMenu="Repository"
                ToolTipText="Lights">
                <Managers:TabRepository.SelectionPanel>
                    <Button
                        Command="{Binding AddItemCommand}"
                        CommandParameter="{x:Type Lights:LightEntity}"
                        Content="New Light" />
                </Managers:TabRepository.SelectionPanel>
                <Managers:TabRepository.EditingPanel>
                    <Views:LightEntity />
                </Managers:TabRepository.EditingPanel>
            </Managers:TabRepository>

<!--            <Managers:TabRepository
                DataContext="{Binding BeatManager}"
                Icon="Beat"
                ItemsSource="{Binding ControlRepository.BeatModulators}"
                ToolTipText="BeatModulators">
                <Managers:TabRepository.SelectionPanel>
                    <Button
                        Command="{Binding AddItemCommand}"
                        CommandParameter="{x:Type Modulators:BeatModulator}"
                        Content="New Beat" />
                </Managers:TabRepository.SelectionPanel>
                <Managers:TabRepository.EditingPanel>
                    <Views:BeatModulator />
                </Managers:TabRepository.EditingPanel>
            </Managers:TabRepository>-->

<!--            <Managers:TabRepository
                DataContext="{Binding ColorPaletteManager}"
                Icon="Coloration"
                ItemsSource="{Binding ControlRepository.ColorPalettes}"
                ToolTipText="Color Palette">
                <Managers:TabRepository.SelectionPanel>
                    <Button
                        Command="{Binding AddItemCommand}"
                        CommandParameter="{x:Type ColorModifiers:ColorPaletteModifier}"
                        Content="New Palette" />
                </Managers:TabRepository.SelectionPanel>
            </Managers:TabRepository>-->

            <TabItem Theme="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <ui:AppIcon
                        Margin="8"
                        IconKey="Network"
                        Size="{DynamicResource IconSizeXS}"
                        ToolTip.Tip="Network" />
                </TabItem.Header>

                <ScrollViewer Theme="{StaticResource ScrollViewerOverlayKeepOffset}">
                    <Views:PanelSyncManagement DataContext="{Binding Sync}" />
                </ScrollViewer>

            </TabItem>

        </TabControl>

        <Border
            Grid.Row="1"
            Padding="8"
            Background="{DynamicResource Grey300Brush}"
            BorderBrush="{DynamicResource Grey100Brush}"
            BorderThickness="2,0">

            <Views:PanelMasterBeat DataContext="{Binding Project.MasterBeat}" />

        </Border>

    </Grid>

</UserControl>
