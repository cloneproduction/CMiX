<UserControl
    x:Class="CMiX.Studio.Avalonia.Views.XYZModifier"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:Managers="clr-namespace:CMiX.Studio.Avalonia.Views.Managers"
    xmlns:Modulation="clr-namespace:CMiX.Core.Modulation;assembly=CMiX.Core"
    x:Name="xyzModifier">

    <StackPanel Margin="4">

        <Views:ModifierModeSelector DataContext="{Binding ModifierModeSelector}" />

        <BaseControls:ToggleButton
            Margin="0,0,0,4"
            Caption="Gaussian"
            IsChecked="{Binding Gaussian.Value}" />

        <BaseControls:ToggleButton
            Margin="0,0,0,2"
            Caption="Randomize Location"
            IsChecked="{Binding RandomizeLocation.Value}" />

        <BaseControls:ChannelVectorXYZ
            Margin="0,0,0,4"
            Caption="Location"
            DataContext="{Binding Location}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=xyzModifier}" />

        <BaseControls:ToggleButton
            Margin="0,0,0,2"
            Caption="Randomize Scale"
            IsChecked="{Binding RandomizeScale.Value}" />

        <BaseControls:ChannelVectorXYZ
            Margin="0,0,0,4"
            Caption="Scale"
            DataContext="{Binding Scale}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=xyzModifier}" />

        <BaseControls:ToggleButton
            Margin="0,0,0,2"
            Caption="Randomize Rotation"
            IsChecked="{Binding RandomizeRotation.Value}" />

        <BaseControls:ChannelVectorXYZ
            Margin="0,0,0,4"
            Caption="Rotation"
            DataContext="{Binding Rotation}"
            ModulatorManager="{Binding DataContext.ModulatorManager, ElementName=xyzModifier}" />

        <Views:ModifierManager DataContext="{Binding ModulatorManager}">
            <Views:ModifierManager.SelectionPanel>
                <Managers:AutoSelectionPanel Interface="{x:Type Modulation:IModulator}" />
            </Views:ModifierManager.SelectionPanel>
        </Views:ModifierManager>

    </StackPanel>

</UserControl>
