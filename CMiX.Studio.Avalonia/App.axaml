<Application
    x:Class="CMiX.Studio.Avalonia.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Dark">

    <Application.Styles>
        <SimpleTheme />
        <StyleInclude Source="avares://CMiX.Studio.Avalonia/Themes/Generic.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Basic/Basic.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
