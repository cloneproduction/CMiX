<Application
    x:Class="CMiX.Studio.Avalonia.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    RequestedThemeVariant="Dark">

    <Application.Styles>
        <SimpleTheme />
        <materialIcons:MaterialIconStyles />
        <ui:CMiXTheme />
        <StyleInclude Source="avares://CMiX.Studio.Avalonia/Themes/Generic.axaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/StudioConverters.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

</Application>
