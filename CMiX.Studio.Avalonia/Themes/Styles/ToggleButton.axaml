<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.Avalonia.AttachedProperties"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Basic/Converters.axaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTheme x:Key="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type Button}}" TargetType="ToggleButton">
        <Style Selector="^:checked:not(:pointerover) /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>

        <Style Selector="^:checked:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="^:unchecked:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey700Brush}" />
        </Style>

        <Style Selector="^:unchecked:not(:pointerover) /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        </Style>
    </ControlTheme>

    <ControlTheme
        x:Key="ToggleButtonRounded"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="(AttachedProperties:PositionedControl.Position)" Value="All" />
    </ControlTheme>

    <ControlTheme
        x:Key="ToggleButtonRoundedLeft"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="(AttachedProperties:PositionedControl.Position)" Value="Left" />
    </ControlTheme>

    <ControlTheme x:Key="ToggleCheckBox" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="(AttachedProperties:PositionedControl.Position)" Value="All" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>

                <Border
                    Name="border"
                    Padding="4"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{DynamicResource CornerRadiusAll}">

                    <Controls:AppIcon 
                        Name="icon" 
                        IconKey="IsChecked" 
                        Size="{DynamicResource IconSizeXS}" />

                </Border>

            </ControlTemplate>
        </Setter>

        <Style Selector="^:pressed /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey700Brush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#border">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <Style Selector="^:checked:not(:pointerover) /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>
        <Style Selector="^:checked:not(:pointerover) /template/ Controls|AppIcon#icon">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:checked:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="^:checked:pointerover /template/ Controls|AppIcon#icon">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:unchecked:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        </Style>
        <Style Selector="^:unchecked:pointerover /template/ Controls|AppIcon#icon">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="^:unchecked:not(:pointerover) /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        </Style>
        <Style Selector="^:unchecked:not(:pointerover) /template/ Controls|AppIcon#icon">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </ControlTheme>

    <ControlTheme
        x:Key="ToggleButtonIcon"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusAll}" />
        <Setter Property="Content" Value="" />
        <Style Selector="^:checked">
            <Setter Property="Content">
                <Template>
                    <Controls:AppIcon
                        Margin="2"
                        Opacity="0.75"
                        IconKey="IsChecked"
                        Size="{DynamicResource IconSizeXS}" />
                </Template>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ToggleVisibility" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightXS}" />
        <Setter Property="Width" Value="{DynamicResource ControlHeightXS}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Margin="0"
                    Padding="1"
                    Background="Transparent"
                    Opacity="0.6">
                    <Controls:AppIcon Name="image" IconKey="Visible" Size="{DynamicResource IconSizeXS}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:checked /template/ Controls|AppIcon#image">
            <Setter Property="IconKey" Value="NotVisible" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="TogglePlayPause" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Margin="0"
                    Padding="1"
                    Background="Transparent"
                    Opacity="0.6">
                    <Controls:AppIcon Name="image" IconKey="Play" Size="{DynamicResource IconSizeXS}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:checked /template/ Controls|AppIcon#image">
            <Setter Property="IconKey" Value="Stop" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ToggleTransformModifierMenu" TargetType="ToggleButton">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Background="{DynamicResource Grey500Brush}"
                    CornerRadius="{DynamicResource CornerRadiusLeft}">
                    <Grid>
                        <TextBlock DockPanel.Dock="Left" Padding="8,4,4,4" Text="+" />
                        <TextBlock HorizontalAlignment="Center" Padding="8,4,4,4" Text="{TemplateBinding Content}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        </Style>

        <Style Selector="^:checked /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Path#arrow">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="InlineToggleButtonLeft"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="(AttachedProperties:PositionedControl.Position)" Value="Left" />
    </ControlTheme>

    <ControlTheme x:Key="InlineToggleButtonCenter"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="(AttachedProperties:PositionedControl.Position)" Value="None" />
    </ControlTheme>

    <ControlTheme x:Key="InlineToggleButtonRight"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="(AttachedProperties:PositionedControl.Position)" Value="Right" />
    </ControlTheme>

</ResourceDictionary>
