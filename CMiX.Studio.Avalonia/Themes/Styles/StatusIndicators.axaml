<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Three states: red (default) means the peer has no store connection. Green (.connected)
         means it is connected to Redis. Gray (.connecting) means a connect or reconnect attempt
         is in progress, so a momentary red does not read as a failure. Consumers bind
         Classes.connected to IsConnected and Classes.connecting to the Status text through
         SyncStatusIsConnecting; declared last, .connecting wins over .connected. -->
    <ControlTheme x:Key="SyncConnectionIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="Red" />
        <Style Selector="^.connected">
            <Setter Property="Fill" Value="Green" />
        </Style>
        <Style Selector="^.connecting">
            <Setter Property="Fill" Value="Gray" />
        </Style>
    </ControlTheme>

    <!-- Same shape as SyncConnectionIndicatorStyle, different color. -->
    <ControlTheme x:Key="SyncStateIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="Gray" />
        <Style Selector="^.insync">
            <Setter Property="Fill" Value="DodgerBlue" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
