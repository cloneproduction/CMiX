<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The colors of the sync dots. Change a color here, in one place. -->
    <SolidColorBrush x:Key="StatusDisconnectedBrush" Color="Red" />
    <SolidColorBrush x:Key="StatusConnectedBrush" Color="Green" />
    <SolidColorBrush x:Key="StatusPendingBrush" Color="Gray" />
    <SolidColorBrush x:Key="StatusSyncedBrush" Color="DodgerBlue" />

    <!-- Three states: disconnected (default) means the peer has no store connection. Connected
         (.connected) means it is connected to Redis. Pending (.connecting) means a connect or
         reconnect attempt is in progress, so a momentary red does not read as a failure.
         Consumers bind Classes.connected to IsConnected and Classes.connecting to the Status text
         through SyncStatusIsConnecting; declared last, .connecting wins over .connected. -->
    <ControlTheme x:Key="EllipseSyncConnection" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource StatusDisconnectedBrush}" />
        <Style Selector="^.connected">
            <Setter Property="Fill" Value="{DynamicResource StatusConnectedBrush}" />
        </Style>
        <Style Selector="^.connecting">
            <Setter Property="Fill" Value="{DynamicResource StatusPendingBrush}" />
        </Style>
    </ControlTheme>

    <!-- Same shape as EllipseSyncConnection, different color. -->
    <ControlTheme x:Key="EllipseSyncState" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource StatusPendingBrush}" />
        <Style Selector="^.insync">
            <Setter Property="Fill" Value="{DynamicResource StatusSyncedBrush}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
