<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Four states: red (default) means the listener isn't running at all - a real problem,
         not just "no Engine yet". Orange (.listening) is the normal idle state: up and waiting.
         Green (.connected) means an Engine is actually attached. Gray (.connecting) means a
         deliberate reconnect is in progress (ApplyAsync stops itself before rebinding), so that
         momentary "not listening" doesn't read as a failure. Consumers bind Classes.listening to
         ServerIsRunning, Classes.connected to ClientIsConnected, and Classes.connecting to
         IsReconnecting; declared last, .connecting wins over the other two while it applies. -->
    <ControlTheme x:Key="ServerConnectionIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="Red" />
        <Style Selector="^.listening">
            <Setter Property="Fill" Value="Orange" />
        </Style>
        <Style Selector="^.connected">
            <Setter Property="Fill" Value="Green" />
        </Style>
        <Style Selector="^.connecting">
            <Setter Property="Fill" Value="Gray" />
        </Style>
    </ControlTheme>

    <!-- Same shape as ServerConnectionIndicatorStyle, different color. -->
    <ControlTheme x:Key="ServerSyncIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="Gray" />
        <Style Selector="^.insync">
            <Setter Property="Fill" Value="DodgerBlue" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
