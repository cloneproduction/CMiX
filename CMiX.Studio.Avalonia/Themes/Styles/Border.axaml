<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.Avalonia.AttachedProperties">

    <!--
        BorderMask now clips the border it's applied to directly via ClipToBoundsBehavior,
        instead of providing a separate invisible border referenced by a VisualBrush
        OpacityMask elsewhere. Avalonia's compositor caches VisualBrush-based OpacityMask
        as a rasterized bitmap and does not reliably invalidate it on resize; Border.Clip
        is evaluated live against current Bounds each render pass, so it has no such
        staleness problem. Consumers apply Classes="BorderMask" to the border that should
        be clipped/rounded, not to a separate mask element.
    -->
    <Style Selector="Border.BorderMask">
        <Setter Property="AttachedProperties:ClipToBoundsBehavior.CornerRadius" Value="{DynamicResource CornerRadiusAll}" />
    </Style>

    <Style Selector="Border.BorderMask:position-top">
        <Setter Property="AttachedProperties:ClipToBoundsBehavior.CornerRadius" Value="{DynamicResource CornerRadiusTop}" />
    </Style>

    <Style Selector="Border.BorderMask:position-bottom">
        <Setter Property="AttachedProperties:ClipToBoundsBehavior.CornerRadius" Value="{DynamicResource CornerRadiusBottom}" />
    </Style>

    <Style Selector="Border.BorderMask:position-middle">
        <Setter Property="AttachedProperties:ClipToBoundsBehavior.CornerRadius" Value="{DynamicResource CornerRadiusNone}" />
    </Style>

    <Style Selector="Border.BorderMask:position-none">
        <Setter Property="AttachedProperties:ClipToBoundsBehavior.CornerRadius" Value="{DynamicResource CornerRadiusNone}" />
    </Style>

    <Style Selector="Border.BorderMask:position-left">
        <Setter Property="AttachedProperties:ClipToBoundsBehavior.CornerRadius" Value="{DynamicResource CornerRadiusLeft}" />
    </Style>

    <Style Selector="Border.BorderMask:position-right">
        <Setter Property="AttachedProperties:ClipToBoundsBehavior.CornerRadius" Value="{DynamicResource CornerRadiusRight}" />
    </Style>

</Styles>