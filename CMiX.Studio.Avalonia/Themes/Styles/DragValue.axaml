<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.Avalonia.AttachedProperties"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <ControlTheme x:Key="{x:Type Controls:DragValue}" TargetType="Controls:DragValue">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Controls:LabeledContent Caption="{TemplateBinding Caption}">

                    <DockPanel>

                        <ContentPresenter
                            Content="{TemplateBinding TrailingContent}"
                            DockPanel.Dock="Right" />

                        <Panel IsEnabled="{Binding !IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border
                                Name="mainBorder"
                                AttachedProperties:PositionedControl.Position="{Binding (AttachedProperties:PositionedControl.Position), RelativeSource={RelativeSource TemplatedParent}}"
                                Background="{DynamicResource Grey500Brush}"
                                BorderBrush="Transparent"
                                Classes="BorderMask">

                                <Panel>

                                    <Panel>
                                        <Controls:NumericInput
                                            Name="numericInput"
                                            Height="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}}"
                                            IsEditing="{Binding IsEditing, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                            IsInteger="{TemplateBinding IsInteger}"
                                            Maximum="{TemplateBinding Maximum}"
                                            Minimum="{TemplateBinding Minimum}"
                                            Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                                        <Border
                                            Name="borderValueDisplay"
                                            VerticalAlignment="Stretch"
                                            IsVisible="{Binding !IsEditing, RelativeSource={RelativeSource TemplatedParent}}">

                                            <TextBlock
                                                Name="valueDisplay"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Classes.integer="{TemplateBinding IsInteger}" />

                                        </Border>
                                    </Panel>

                                    <DockPanel
                                        IsVisible="{Binding !IsEditing, RelativeSource={RelativeSource TemplatedParent}}"
                                        LastChildFill="False">

                                        <Button
                                            Name="SubButton"
                                            Width="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}}"
                                            HorizontalAlignment="Left"
                                            DockPanel.Dock="Left"
                                            IsVisible="{Binding IsPointerOver, ElementName=mainBorder}"
                                            Theme="{StaticResource ButtonStraight}">

                                            <Button.Content>
                                                <Controls:AppIcon
                                                    Opacity="0.5"
                                                    IconKey="Sub"
                                                    Size="{DynamicResource IconSizeXS}" />
                                            </Button.Content>

                                        </Button>
                                        <Button
                                            Name="AddButton"
                                            Width="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}}"
                                            HorizontalAlignment="Right"
                                            DockPanel.Dock="Right"
                                            IsVisible="{Binding IsPointerOver, ElementName=mainBorder}"
                                            Theme="{StaticResource ButtonStraight}">

                                            <Button.Content>
                                                <Controls:AppIcon
                                                    Opacity="0.5"
                                                    IconKey="Add"
                                                    Size="{DynamicResource IconSizeXS}" />
                                            </Button.Content>

                                        </Button>
                                    </DockPanel>
                                </Panel>

                            </Border>
                        </Panel>

                    </DockPanel>

                </Controls:LabeledContent>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#borderValueDisplay">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        </Style>
        <Style Selector="^ /template/ Border#borderValueDisplay:pointerover">
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Background" Value="{DynamicResource Grey700Brush}" />
        </Style>

        <Style Selector="^ /template/ TextBlock#valueDisplay">
            <Setter Property="Text" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N3}}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#valueDisplay.integer">
            <Setter Property="Text" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="DragValueInlineCaption" TargetType="Controls:DragValue" BasedOn="{StaticResource {x:Type Controls:DragValue}}">
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>

                    <ContentPresenter
                        Content="{TemplateBinding TrailingContent}"
                        DockPanel.Dock="Right" />

                    <Panel IsEnabled="{Binding !IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}">
                        <Border
                            Name="mainBorder"
                            AttachedProperties:PositionedControl.Position="{Binding (AttachedProperties:PositionedControl.Position), RelativeSource={RelativeSource TemplatedParent}}"
                            Background="{DynamicResource Grey500Brush}"
                            BorderBrush="Transparent"
                            Classes="BorderMask">

                            <Panel>

                                <Panel>
                                    <Controls:NumericInput
                                        Name="numericInput"
                                        Height="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}}"
                                        IsEditing="{Binding IsEditing, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        IsInteger="{TemplateBinding IsInteger}"
                                        Maximum="{TemplateBinding Maximum}"
                                        Minimum="{TemplateBinding Minimum}"
                                        Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                                    <Border
                                        Name="borderValueDisplay"
                                        VerticalAlignment="Stretch"
                                        IsVisible="{Binding !IsEditing, RelativeSource={RelativeSource TemplatedParent}}">

                                        <DockPanel LastChildFill="False" Margin="6,0">
                                            <TextBlock
                                                Name="captionDisplay"
                                                DockPanel.Dock="Left"
                                                Padding="24, 0, 0, 0"
                                                HorizontalAlignment="Left"
                                                Text="{TemplateBinding Caption}" />

                                            <TextBlock
                                                Name="valueDisplay"
                                                DockPanel.Dock="Right"
                                                Padding="0, 0, 24, 0"
                                                HorizontalAlignment="Right"
                                                Classes.integer="{TemplateBinding IsInteger}" />
                                        </DockPanel>

                                    </Border>
                                </Panel>

                                <DockPanel
                                    IsVisible="{Binding !IsEditing, RelativeSource={RelativeSource TemplatedParent}}"
                                    LastChildFill="False">

                                    <Button
                                        Name="SubButton"
                                        Width="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}}"
                                        HorizontalAlignment="Left"
                                        DockPanel.Dock="Left"
                                        IsVisible="{Binding IsPointerOver, ElementName=mainBorder}"
                                        Theme="{StaticResource ButtonStraight}">

                                        <Button.Content>
                                            <Controls:AppIcon
                                                Opacity="0.5"
                                                IconKey="Sub"
                                                Size="{DynamicResource IconSizeXS}" />
                                        </Button.Content>

                                    </Button>
                                    <Button
                                        Name="AddButton"
                                        Width="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}}"
                                        HorizontalAlignment="Right"
                                        DockPanel.Dock="Right"
                                        IsVisible="{Binding IsPointerOver, ElementName=mainBorder}"
                                        Theme="{StaticResource ButtonStraight}">

                                        <Button.Content>
                                            <Controls:AppIcon
                                                Opacity="0.5"
                                                IconKey="Add"
                                                Size="{DynamicResource IconSizeXS}" />
                                        </Button.Content>

                                    </Button>
                                </DockPanel>
                            </Panel>

                        </Border>
                    </Panel>

                </DockPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#borderValueDisplay">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        </Style>
        <Style Selector="^ /template/ Border#borderValueDisplay:pointerover">
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Background" Value="{DynamicResource Grey700Brush}" />
        </Style>

        <Style Selector="^ /template/ TextBlock#valueDisplay">
            <Setter Property="Text" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N3}}" />
        </Style>
        <Style Selector="^ /template/ TextBlock#valueDisplay.integer">
            <Setter Property="Text" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:N0}}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
