<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <!-- Two equal columns: caption right-aligned in column 0, the control's own Content in
         column 1. No Width setter - each consumer's content decides its own width. -->
    <ControlTheme x:Key="{x:Type Controls:LabeledContent}" TargetType="Controls:LabeledContent">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,*">
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="{TemplateBinding Caption}" />
                    <ContentPresenter
                        Grid.Column="1"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
