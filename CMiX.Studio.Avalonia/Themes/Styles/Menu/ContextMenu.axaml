<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System">

    <!--
        Ported from CMiX.Studio\Themes\Styles\Menu\ContextMenu.xaml.
        The WPF borderMask plus VisualBrush OpacityMask construct existed only to clip the
        item host to rounded corners. In Avalonia the background, border and corner radius
        sit directly on the template root Border, so the mask trick is no longer needed.
    -->

    <ControlTheme x:Key="ContextMenuSubItem" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="root"
                    Padding="8,4"
                    HorizontalAlignment="Stretch"
                    Background="{TemplateBinding Background}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            Name="PART_IconPresenter"
                            Grid.Column="0"
                            Width="10"
                            Height="10"
                            Margin="0,0,16,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Icon}"
                            IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter
                            Name="PART_HeaderPresenter"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}">
                            <ContentPresenter.DataTemplates>
                                <DataTemplate DataType="sys:String">
                                    <AccessText Text="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.DataTemplates>
                        </ContentPresenter>
                        <!--
                            The WPF SubmenuItem role template had no popup. This popup keeps the
                            Avalonia part structure intact for items that do carry a submenu.
                        -->
                        <Popup
                            Name="PART_Popup"
                            IsLightDismissEnabled="False"
                            IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                            Placement="RightEdgeAlignedTop">
                            <Border
                                Margin="8"
                                Background="{DynamicResource Grey400Brush}"
                                BorderBrush="{DynamicResource Grey600Brush}"
                                BorderThickness="1"
                                BoxShadow="0 0 8 0 #80000000"
                                CornerRadius="{DynamicResource CornerRadiusAll}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter
                                        Name="PART_ItemsPresenter"
                                        Grid.IsSharedSizeScope="True"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:separator">
            <Setter Property="Template">
                <ControlTemplate>
                    <Separator />
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:pointerover /template/ Border#root">
            <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#root">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ContextMenuDefault" TargetType="ContextMenu">
        <Setter Property="BorderBrush" Value="{DynamicResource Grey600Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="ItemContainerTheme" Value="{DynamicResource ContextMenuSubItem}" />
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The outer margin leaves room for the shadow, as in the WPF template -->
                <Border
                    Margin="8"
                    Background="{DynamicResource Grey400Brush}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    BoxShadow="0 0 8 0 #80000000"
                    CornerRadius="{DynamicResource CornerRadiusAll}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter
                            Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
