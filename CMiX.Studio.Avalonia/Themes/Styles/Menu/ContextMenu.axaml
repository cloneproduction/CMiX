<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="using:System"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <ControlTheme x:Key="ContextMenuSubItem" TargetType="MenuItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="root"
                    Padding="8,4"
                    HorizontalAlignment="Stretch"
                    Background="{TemplateBinding Background}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            Name="PART_IconPresenter"
                            Grid.Column="0"
                            Width="10"
                            Height="10"
                            Margin="0,0,16,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Icon}"
                            IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <ContentPresenter
                            Name="PART_HeaderPresenter"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Header}"
                            ContentTemplate="{TemplateBinding HeaderTemplate}">
                            <ContentPresenter.DataTemplates>
                                <DataTemplate DataType="sys:String">
                                    <AccessText Text="{Binding}" />
                                </DataTemplate>
                            </ContentPresenter.DataTemplates>
                        </ContentPresenter>

                        <Popup
                            Name="PART_Popup"
                            IsLightDismissEnabled="False"
                            IsOpen="{TemplateBinding IsSubMenuOpen, Mode=TwoWay}"
                            Placement="RightEdgeAlignedTop">
                            <Border
                                Margin="8"
                                Background="{DynamicResource Grey400Brush}"
                                BorderBrush="{DynamicResource Grey600Brush}"
                                BorderThickness="1"
                                BoxShadow="0 0 8 0 #80000000"
                                CornerRadius="{DynamicResource CornerRadiusAll}">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter
                                        Name="PART_ItemsPresenter"
                                        Grid.IsSharedSizeScope="True"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:separator">
            <!-- NaN clears the row height, so the row is as high as the thin line. -->
            <Setter Property="Height" Value="NaN" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Separator
                        Height="0.5"
                        Margin="0,4"
                        Background="{DynamicResource Grey600Brush}" />
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:pointerover /template/ Border#root">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        </Style>

        <Style Selector="^:checked /template/ Border#root">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#root">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <!-- The look of every menu popup. A context menu and a menu flyout derive from it. -->
    <ControlTheme x:Key="MenuPanel" TargetType="MenuBase">
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="ItemContainerTheme" Value="{DynamicResource ContextMenuSubItem}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Controls:PopupFrame CentersOnPointer="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter
                            Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}"
                            KeyboardNavigation.TabNavigation="Continue" />
                    </ScrollViewer>
                </Controls:PopupFrame>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ContextMenuDefault" TargetType="ContextMenu" BasedOn="{StaticResource MenuPanel}" />

    <ControlTheme x:Key="MenuFlyoutPresenterDefault" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource MenuPanel}" />

</ResourceDictionary>
