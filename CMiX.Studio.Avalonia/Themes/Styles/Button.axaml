<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.Avalonia.AttachedProperties"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Basic/Converters.axaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="(AttachedProperties:PositionedControl.Position)" Value="All" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Width="{TemplateBinding Width}"
                    Height="{TemplateBinding Height}"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{Binding (AttachedProperties:PositionedControl.Position), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PositionToCornerRadius}}">

                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey700Brush}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey700Brush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#border">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ButtonStraight"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Setter Property="(AttachedProperties:PositionedControl.Position)" Value="None" />
    </ControlTheme>

    <ControlTheme x:Key="ButtonRounded"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Setter Property="(AttachedProperties:PositionedControl.Position)" Value="All" />
    </ControlTheme>

    <ControlTheme x:Key="ButtonRoundedRight"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Setter Property="(AttachedProperties:PositionedControl.Position)" Value="Right" />
    </ControlTheme>

    <!--
        For a button whose own content already carries its own state indicator (e.g.
        ModulatorAssignButton's dot, which already changes color for bound/hovered) - the base
        Button theme's :pointerover/:pressed Grey700Brush tint would otherwise compete with that.
        Re-set to a literal Transparent rather than TemplateBinding Background: every consumer of
        this theme uses Background="Transparent" today anyway, and a literal value here avoids
        depending on TemplateBinding working correctly inside a Style block outside the
        ControlTemplate itself, which isn't proven elsewhere in this codebase - not worth the risk
        after two runtime-only binding failures already this session.
    -->
    <ControlTheme x:Key="ButtonRoundedRightNoHover"
        BasedOn="{StaticResource ButtonRoundedRight}"
        TargetType="Button">
        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="^:pressed /template/ Border#border">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </ControlTheme>

    <!--  This one is used for ColorSelector  -->
    <ControlTheme x:Key="ButtonColorStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">

                    <Border
                        Name="mask"
                        Classes="BorderMask"
                        AttachedProperties:PositionedControl.Position="{Binding (AttachedProperties:PositionedControl.Position), RelativeSource={RelativeSource TemplatedParent}}"
                        Background="{Binding Path=Background.Color, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorToNoAlpha}}"
                        IsHitTestVisible="False" />

                    <!--
                        The WPF VisualBrush opacity mask erased the content in Avalonia, so it
                        is dropped. The swatch borders carry their own corner radii instead.
                    -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="1"
                                CornerRadius="{DynamicResource CornerRadiusRight}"
                                Background="{DynamicResource CheckerboardBrush}" />

                        <Border
                            Name="borderAlpha"
                            Grid.Column="1"
                            CornerRadius="{DynamicResource CornerRadiusRight}">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding Path=Background.Color, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border.Background>
                        </Border>

                        <Border
                            Name="border"
                            Grid.Column="0"
                            Background="{Binding Path=Background.Color, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorToNoAlpha}}"
                            CornerRadius="{DynamicResource CornerRadiusLeft}" />

                    </Grid>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:disabled /template/ Border#border">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="^:disabled /template/ Border#borderAlpha">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ButtonItemControl" TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Margin="0"
                    Padding="8,0,0,0"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    CornerRadius="{DynamicResource CornerRadiusAll}">
                    <!--
                        HorizontalContentAlignment forwarded (matching ListBoxItemStyle's own
                        ContentPresenter) rather than hardcoded "Left" as before - every existing
                        consumer keeps today's look via the Setter above (still defaults to Left,
                        unchanged), while a specific instance (e.g. ModulatorAssignButton's assigned-
                        row highlight, which needs its Border background to actually fill the row)
                        can opt into Stretch without this theme needing to know about that case.
                    -->
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#border">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ButtonValidation" TargetType="Button">
        <Setter Property="IsEnabled" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Margin="0"
                    Background="{DynamicResource AccentInactiveBrush}"
                    BorderBrush="{DynamicResource Shadow}"
                    BorderThickness="0,0,0,2"
                    CornerRadius="{DynamicResource CornerRadiusAll}">

                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <TextBlock
                            Name="textBlock"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource ForegroundBrush}"
                            Text="{TemplateBinding Content}" />
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>

        <Style Selector="^:pressed /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#border">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ButtonWindowControlStyle"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="Button">
        <Setter Property="Height" Value="{DynamicResource ControlHeightXL}" />
        <Setter Property="Width" Value="{DynamicResource ControlHeightXL}" />
        <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </ControlTheme>

    <ControlTheme x:Key="ButtonWindowIconStyle"
        BasedOn="{StaticResource ButtonWindowControlStyle}"
        TargetType="Button">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="border" Padding="8" Background="Transparent">
                    <Controls:AppIcon Name="image" Opacity="0.75" IconKey="{TemplateBinding Content}" Size="{DynamicResource IconSizeXS}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Controls|AppIcon#image">
            <Setter Property="Opacity" Value="1.0" />
        </Style>

        <Style Selector="^:pressed /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey700Brush}" />
        </Style>
        <Style Selector="^:pressed /template/ Controls|AppIcon#image">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
