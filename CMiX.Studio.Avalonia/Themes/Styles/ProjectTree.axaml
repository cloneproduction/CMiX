<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:Views="clr-namespace:CMiX.Studio.Avalonia.Views"
    xmlns:converters="clr-namespace:Avalonia.Controls.Converters;assembly=Avalonia.Controls"
    xmlns:StudioConverters="clr-namespace:CMiX.Studio.Avalonia.Converters">

    <!-- The tree of the project. A row is as high as the rows of the other lists: one control height,
         with the space SpacingXXS between two rows. The two sizes are TreeRowHeight and TreeRowSpacing: the same values in
         whole pixels of the screen (see ProjectTreeView), so the rows are always one same pitch apart.
         It has a fill in the color of its kind (see CategoryPalette), one step brighter when the pointer is over the row itself
         (not over its children), and one more step when it is selected. A child is indented by its level.
         Each look has one meaning: the fill shows the selection, a frame shows the cursor, white marks show a drop.
         During a drag a row has one of three looks: lit (it can take the node), covered (it can not: the source and a row that refuses
         it by a rule too, with the reason in the tooltip), or half covered (a collapsed row with a row deeper that can take it, so the
         user goes in). TreeDropMark sets the classes droptarget, dropgap and droptop: the white frame of the row that takes the drop
         inside it, and the white line between rows. The marks are drawn over the row and take no room, so the rows never move. -->
    <converters:MarginMultiplierConverter x:Key="TreeLevelIndent" Indent="{StaticResource TreeIndent}" Left="True" />

    <!-- The tones of a row: the fill behind it and the colors of its count squares, by the kind of the row (see CategoryPalette). -->
    <StudioConverters:TreeToneConverter x:Key="TreeTone" />
    <!-- The brush of the icon of a row: white when selected, the colour of the kind on the cursor row, the text colour otherwise. -->
    <StudioConverters:KindIconBrushConverter x:Key="KindIconBrush" />

    <!-- The cover of a row: the dim of a drag, or the dim of the search while no drag runs (see TreeCoverConverter). -->
    <StudioConverters:TreeCoverConverter x:Key="TreeCover" />

    <!-- The cursor row and the rows above it are drawn over the other rows (see TreeLiftConverter). -->
    <StudioConverters:TreeLiftConverter x:Key="TreeLift" />

    <!-- How much of the cover stays over a row that can not take a dragged node. -->
    <x:Double x:Key="TreeDimOpacity">0.6</x:Double>
    <!-- The cover of a collapsed row with a possible target deeper: half, so the row reads as "not here, but look inside". -->
    <x:Double x:Key="TreeHintCoverOpacity">0.3</x:Double>

    <ControlTheme x:Key="TreeChevronToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{DynamicResource TreeIndent}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <Path
                        Name="Chevron"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Data="M 0 0 L 4 4 L 0 8"
                        RenderTransformOrigin="40%,50%"
                        Stroke="{TemplateBinding Foreground}"
                        StrokeThickness="1.5" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:checked /template/ Path#Chevron">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="TreeViewItemCMiX" TargetType="TreeViewItem">
        <!-- The cursor row shows the CursorFrame of the template and a shadow. The dotted frame of Avalonia is not wanted. -->
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <!-- The tooltips of a row (badges, toggles, the sign of a missing asset) take the colour of the row at the strength of a hover. -->
        <Setter Property="ui:ToolTipCard.Fill" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=FillHover}" />
        <!-- The cursor row of the model gets the class cursor, which shows CursorFrame and the shadow of the row. -->
        <Setter Property="ui:CursorRow.IsCursor" Value="{Binding IsCursor}" />
        <Setter Property="ZIndex">
            <MultiBinding Converter="{StaticResource TreeLift}">
                <Binding Path="IsCursor" />
                <Binding Path="IsOnCursorBranch" />
            </MultiBinding>
        </Setter>
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <!-- The marks of a drag are drawn over the whole item: the row and the rows under it. -->
                <Panel Name="ItemRoot" Classes.fresh="{Binding IsFresh}">
                <StackPanel>
                    <!-- The row and the space under it, with the indent guides over them. -->
                    <Panel Name="RowLift">
                    <StackPanel>
                    <!-- The chevron is at the left of the colored row, outside it, after the indent of the row. The toggles are inside the colored
                         row, at its right end, as icons with no fill (see RowToggles). Only the chevron expands a row. -->
                    <Grid Name="RowGrid" ColumnDefinitions="Auto,*">
                    <ToggleButton
                        Name="PART_ExpandCollapseChevron"
                        Grid.Column="0"
                        Margin="{TemplateBinding Level, Mode=OneWay, Converter={StaticResource TreeLevelIndent}}"
                        IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                        Theme="{StaticResource TreeChevronToggle}" />
                    <Border
                        Name="RowBorder"
                        Grid.Column="1"
                        Height="{DynamicResource TreeRowHeight}"
                        Classes.group="{Binding Item, Converter={x:Static ObjectConverters.IsNull}}"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        TextElement.Foreground="{DynamicResource TreeTextRestBrush}"
                        ToolTip.Tip="{Binding DropBlockReason}">
                        <Panel>
                            <!-- The header has no part names that TreeViewItem knows (PART_Header, PART_HeaderPresenter):
                                 it expands and collapses the row on a double tap of such a part, and a double tap on a row
                                 renames it. -->
                            <Grid
                                Name="RowContent"
                                ColumnDefinitions="*,Auto"
                                Margin="{DynamicResource TreeRowContentMargin}">
                                <ContentPresenter
                                    Name="RowHeaderPresenter"
                                    Grid.Column="0"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}" />
                                <Views:RowToggles Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                            <!-- The marks of a drag over the rows, drawn over the row: they take no room and no click. A row that can not take
                                 the node is covered with the background of the tree, so it recedes. A row that can take it has a
                                 fill with no cover, and no border. While no drag runs, a row that
                                 does not match the search is covered in the same way, so only the matches keep their color. -->
                            <Border
                                Name="DimLayer"
                                Classes.drophint="{Binding IsDropHint}"
                                Background="{DynamicResource TreeBackgroundBrush}"
                                CornerRadius="{DynamicResource CornerRadiusAll}"
                                IsHitTestVisible="False"
                                Opacity="0">
                                <Classes.dimmed>
                                    <MultiBinding Converter="{StaticResource TreeCover}">
                                        <Binding Path="IsDimmed" />
                                        <Binding Path="IsSearchDimmed" />
                                        <Binding Path="IsDragActive" />
                                    </MultiBinding>
                                </Classes.dimmed>
                                <!-- The cover fades in and out (Motion.FadeDuration), so a row does not jump when a drag starts or ends. -->
                                <Border.Transitions>
                                    <Transitions>
                                        <DoubleTransition Property="Opacity" Duration="{x:Static ui:Motion.FadeDuration}" Easing="CubicEaseOut" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                            <!-- The frame of the cursor row (the class cursor, see CursorRow), the same as in the lists. The arrow keys move it.
                                 Enter or a click selects the row. The selected row has no frame: its fill shows the selection. -->
                            <Border Name="CursorFrame" Theme="{DynamicResource CursorFrame}" />
                            <!-- The frame of the row that takes a drop inside it (:droptarget). It has the look of the white frame of the cursor on the selected row (CursorFrameBrush, one pixel of the screen). It is drawn over CursorFrame, so the cursor never hides it.
                                 The style sets the thickness, so the hidden frame has none. -->
                            <Border
                                Name="DropInsideFrame"
                                BorderBrush="{DynamicResource CursorFrameBrush}"
                                CornerRadius="{DynamicResource CornerRadiusAll}"
                                IsHitTestVisible="False"
                                IsVisible="False" />
                        </Panel>
                    </Border>
                    </Grid>
                    <!-- The space under the row (TreeRowGap) is a part of the item of the row, so it follows the row whatever is open: every
                         row is one row height plus one space from the next, and the pitch of the rows never changes. The drop line is a
                         part of the item too, and it fills this space. -->
                    <Border Name="GapUnderTheRow" Height="{DynamicResource TreeRowGap}" />
                    </StackPanel>
                    </Panel>
                    <!-- The same animation as the expanders. The panel owns the IsVisible of the presenter. -->
                    <ui:CollapsePanel Name="PART_Collapse" IsExpanded="{TemplateBinding IsExpanded}">
                        <Panel>
                            <ItemsPresenter
                                Name="PART_ItemsPresenter"
                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                        </Panel>
                    </ui:CollapsePanel>
                </StackPanel>
                <!-- The line starts where the colored row starts: after the indent of the row and its chevron (TreeIndent). It is inside the item:
                     at its top for a drop before the row, and at its bottom for a drop after it. An item cuts what is drawn outside it,
                     so a line in the space between two rows would not be seen. -->
                <Panel IsHitTestVisible="False">
                    <Border
                        Name="DropLine"
                        Height="{DynamicResource TreeDropLineThickness}"
                        Margin="{DynamicResource TreeDropLineTopMargin}"
                        VerticalAlignment="Top"
                        Background="{DynamicResource CursorFrameBrush}"
                        IsHitTestVisible="False"
                        IsVisible="False" />
                </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- The fill of a row is the tone of its kind. It is a style, not a value of the template, so the states below can replace it.
             A row with no fill would not take the pointer, so a row of an unknown kind has a clear fill. -->
        <Style Selector="^ /template/ Border#RowBorder">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=Fill}" />
        </Style>
        <!-- The pointer is tested on the row, not on the item: the item also contains its children. A row under the pointer has the hover
             fill. Its text does not change. A selected row keeps the selected fill under the pointer: its style comes after this one. -->
        <Style Selector="^ /template/ Border#RowBorder:pointerover">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=FillHover}" />
        </Style>
        <!-- The look of a focused tree is in CMiX.UI CursorRow.axaml. -->
        <Style Selector="^.cursor /template/ Border#CursorFrame">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="BorderBrush" Value="{DynamicResource CursorFrameInactiveBrush}" />
            <Setter Property="BorderThickness" Value="{DynamicResource CursorFrameInactiveThickness}" />
        </Style>
        <!-- A row that is new fades in (the class fresh, see TreeNode.IsFresh), with the time of the other fades of the tree. -->
        <Style Selector="^ /template/ Panel#ItemRoot.fresh">
            <Style.Animations>
                <Animation Duration="{x:Static ui:Motion.FadeDuration}" Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- The cursor row is drawn over the rows under it, so its shadow falls on them (see the styles of ProjectTreeView). -->
        <Style Selector="^.cursor /template/ Panel#RowLift">
            <Setter Property="ZIndex" Value="1" />
        </Style>
        <!-- The text of a row: a step dimmer at rest (TreeTextRest), full white on the cursor row and on the selected row. -->
        <Style Selector="^.cursor /template/ Border#RowBorder">
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ActiveForegroundBrush}" />
        </Style>
        <Style Selector="^:selected /template/ Border#RowBorder">
            <Setter Property="Background" Value="{Binding Converter={StaticResource TreeTone}, ConverterParameter=FillSelected}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource ActiveForegroundBrush}" />
        </Style>
        <!-- The row that takes the node or the files that are dragged over it, inside it: an accent frame inside the row. The fill does not change. -->
        <Style Selector="^:droptarget /template/ Border#DropInsideFrame">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="BorderThickness" Value="{DynamicResource TreeSelectionThickness}" />
        </Style>
        <!-- A group row (a row with no item, such as Entities) with no children has a grey fill, not the tone of its kind. An item row,
             such as a modulator, keeps the tone of its kind, also with no children. The styles come after the tone styles, so they
             replace them. The :empty class follows the number of children, so the fill changes when a group gets its first child or
             loses its last one. -->
        <Style Selector="^:empty /template/ Border#RowBorder.group">
            <Setter Property="Background" Value="{DynamicResource Grey300Brush}" />
        </Style>
        <Style Selector="^:empty /template/ Border#RowBorder.group:pointerover">
            <Setter Property="Background" Value="{DynamicResource Grey400Brush}" />
        </Style>
        <Style Selector="^:empty:selected /template/ Border#RowBorder.group">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        </Style>
        <Style Selector="^ /template/ Border#DimLayer.dimmed">
            <Setter Property="Opacity" Value="{DynamicResource TreeDimOpacity}" />
        </Style>
        <!-- The half cover of a collapsed row with a possible target deeper (the class drophint, see TreeNode.IsDropHint). -->
        <Style Selector="^ /template/ Border#DimLayer.drophint">
            <Setter Property="Opacity" Value="{DynamicResource TreeHintCoverOpacity}" />
        </Style>
        <!-- The chevron is grey (the Foreground of the toggle, see TreeChevronToggle). On the cursor row it takes the colour of the text,
             on a selected row the active text colour. -->
        <Style Selector="^ /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="Foreground" Value="{DynamicResource Grey800Brush}" />
        </Style>
        <Style Selector="^.cursor /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        </Style>
        <Style Selector="^:selected /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="Foreground" Value="{DynamicResource ActiveForegroundBrush}" />
        </Style>
        <Style Selector="^:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
            <!-- The chevron keeps its room: it holds the indent of the row, so an empty row stays aligned with the rows around it. -->
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <!-- An empty list of children takes no room, and adds no space below the row. -->
        <Style Selector="^:empty /template/ ui|CollapsePanel#PART_Collapse">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- The line of a drop between two rows is in the space under the row above the place: it fills that space, so it is
             exactly in the middle between the two rows. The first row of the tree has no row above it: the line is at its top. -->
        <Style Selector="^:dropgap /template/ Border#DropLine">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Margin" Value="{DynamicResource TreeDropLineGapMargin}" />
        </Style>
        <Style Selector="^:droptop /template/ Border#DropLine">
            <Setter Property="IsVisible" Value="True" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
