<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Ported from CMiX.Studio\Themes\Styles\ScrollViewer.xaml.
        The WPF file only styled ScrollBar (the ScrollViewer keeps its default template).
        The WPF keyed styles ScrollBarPageButton and ScrollBarThumb are absorbed into this
        ControlTheme as template children with nested selector styles.
        Note: the WPF file referenced a HorizontalScrollBar template that was never defined
        anywhere in the project; the horizontal orientation below mirrors the vertical design.
    -->
    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Margin" Value="4,0,2,0" />

        <Style Selector="^:vertical">
            <Setter Property="Width" Value="4" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border>
                        <Track
                            DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                            IsDirectionReversed="True"
                            Maximum="{TemplateBinding Maximum}"
                            Minimum="{TemplateBinding Minimum}"
                            Orientation="{TemplateBinding Orientation}"
                            ViewportSize="{TemplateBinding ViewportSize}"
                            Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton
                                    Name="PART_PageUpButton"
                                    Classes="repeattrack"
                                    Focusable="False"
                                    IsTabStop="False" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton
                                    Name="PART_PageDownButton"
                                    Classes="repeattrack"
                                    Focusable="False"
                                    IsTabStop="False" />
                            </Track.IncreaseButton>
                            <Thumb Name="thumb" />
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="8" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border>
                        <Track
                            DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}"
                            Maximum="{TemplateBinding Maximum}"
                            Minimum="{TemplateBinding Minimum}"
                            Orientation="{TemplateBinding Orientation}"
                            ViewportSize="{TemplateBinding ViewportSize}"
                            Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton>
                                <RepeatButton
                                    Name="PART_PageUpButton"
                                    Classes="repeattrack"
                                    Focusable="False"
                                    IsTabStop="False" />
                            </Track.DecreaseButton>
                            <Track.IncreaseButton>
                                <RepeatButton
                                    Name="PART_PageDownButton"
                                    Classes="repeattrack"
                                    Focusable="False"
                                    IsTabStop="False" />
                            </Track.IncreaseButton>
                            <Thumb Name="thumb" />
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!--  ScrollBar Thumb, the part that can be dragged up/down or left/right  -->
        <Style Selector="^ /template/ Thumb#thumb">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource CornerRadiusAll}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="^ /template/ Thumb#thumb:pointerover">
            <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        </Style>
        <Style Selector="^ /template/ Thumb#thumb:pressed">
            <Setter Property="Background" Value="{DynamicResource Grey700Brush}" />
        </Style>

        <!--  ScrollBar page repeat buttons, the long area between the buttons, not the thumb  -->
        <Style Selector="^ /template/ RepeatButton.repeattrack">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border
                        Background="Black"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        Opacity="0.2" />
                </ControlTemplate>
            </Setter>
        </Style>
    </ControlTheme>

</ResourceDictionary>
