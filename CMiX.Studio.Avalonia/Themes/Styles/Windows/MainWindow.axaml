<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Avalonia.Views.Controls">

    <!-- A FlyoutPresenter for popups. Its look comes from the PopupFrame control. -->
    <ControlTheme x:Key="PopupFlyoutStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="300" />
        <Setter Property="Template">
            <ControlTemplate>
                <Controls:PopupFrame>
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Controls:PopupFrame>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>