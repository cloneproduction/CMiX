<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The WPF file declared x:Class CMiX.Core.Themes.MainWindow on the ResourceDictionary, dropped in this port -->
    <!-- TODO Avalonia: all WPF WindowChrome settings are dropped here, the custom window chrome is rebuilt in a later phase -->

    <ControlTheme x:Key="PopupWindowNoTitleStyle" TargetType="Window">
        <!-- TODO Avalonia: WPF WindowChrome used CaptionHeight 0 and CornerRadius CornerRadiusLargeAll -->
        <!-- TODO Avalonia: WPF AllowsTransparency was dropped, set TransparencyLevelHint on the window instead -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="210" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="Transparent"
                    Effect="{DynamicResource WindowDropShadow}"
                    Padding="8">

                    <Grid>
                        <Border
                            Background="{DynamicResource Grey200Brush}"
                            CornerRadius="{DynamicResource CornerRadiusLargeAll}"
                            Opacity="0.9"
                            Padding="0" />

                        <Border Padding="8">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>

                    </Grid>

                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
