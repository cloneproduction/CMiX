<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Same rounded dark box + drop shadow look the old Window-based popups used, ported to
         FlyoutPresenter now that popups (Edit Connection, sync resolution) are Flyouts instead
         of separate windows. -->
    <ControlTheme x:Key="PopupFlyoutStyle" TargetType="FlyoutPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="300" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="Transparent"
                    Effect="{DynamicResource WindowDropShadow}"
                    Padding="8">

                    <Grid>
                        <Border
                            Background="{DynamicResource Grey200Brush}"
                            CornerRadius="{DynamicResource CornerRadiusLargeAll}"
                            Opacity="0.9"
                            Padding="0" />

                        <Border Padding="16">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>

                    </Grid>

                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>