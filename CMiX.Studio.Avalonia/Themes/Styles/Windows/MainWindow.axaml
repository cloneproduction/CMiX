<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The WPF file declared x:Class CMiX.Core.Themes.MainWindow on the ResourceDictionary, dropped in this port -->
    <!-- TODO Avalonia: all WPF WindowChrome settings are dropped here, the custom window chrome is rebuilt in a later phase -->

    <ControlTheme x:Key="MainWindowStyle" TargetType="Window">
        <!-- TODO Avalonia: WPF WindowChrome used CaptionHeight ControlHeightMD, CornerRadius 0 and ResizeBorderThickness 10 -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Grey100Brush}" />
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border>
                    <Grid>
                        <Border
                            Name="windowBorder"
                            Background="Transparent"
                            BorderThickness="0,0,0,0">
                            <VisualLayerManager>
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </VisualLayerManager>
                        </Border>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <!--  Margin added to avoid the border disappearing when the window is maximised  -->
        <Style Selector="^ /template/ Border#windowBorder">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^:maximized /template/ Border#windowBorder">
            <Setter Property="Margin" Value="7" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="QuitModalWindow" TargetType="Window">
        <!-- TODO Avalonia: WPF WindowChrome used CaptionHeight 0 and CornerRadius CornerRadiusLargeAll -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border>
                    <Grid>
                        <VisualLayerManager>
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </VisualLayerManager>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="MessengerSettingsWindowStyle" TargetType="Window">
        <!-- TODO Avalonia: WPF WindowChrome used CaptionHeight ControlHeightXL and CornerRadius CornerRadiusLargeAll -->
        <!-- TODO Avalonia: WPF AllowsTransparency was dropped, set TransparencyLevelHint on the window instead -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="210" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="Transparent"
                    Effect="{DynamicResource WindowDropShadow}"
                    Padding="8">

                    <Grid>
                        <Border
                            Background="{DynamicResource Grey200Brush}"
                            CornerRadius="{DynamicResource CornerRadiusLargeAll}"
                            Opacity="0.9"
                            Padding="0" />

                        <StackPanel>
                            <Border Height="{DynamicResource ControlHeightMD}" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="{DynamicResource DefaultFontSize}"
                                    Foreground="{DynamicResource ForegroundBrush}"
                                    Margin="8,0,0,0"
                                    Text="{TemplateBinding Title}"
                                    VerticalAlignment="Center" />
                            </Border>
                            <Border Padding="8">
                                <VisualLayerManager>
                                    <ContentPresenter
                                        Name="PART_ContentPresenter"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                                </VisualLayerManager>
                            </Border>
                        </StackPanel>

                    </Grid>

                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="PopupWindowNoTitleStyle" TargetType="Window">
        <!-- TODO Avalonia: WPF WindowChrome used CaptionHeight 0 and CornerRadius CornerRadiusLargeAll -->
        <!-- TODO Avalonia: WPF AllowsTransparency was dropped, set TransparencyLevelHint on the window instead -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="210" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="Transparent"
                    Effect="{DynamicResource WindowDropShadow}"
                    Padding="8">

                    <Grid>
                        <Border
                            Background="{DynamicResource Grey200Brush}"
                            CornerRadius="{DynamicResource CornerRadiusLargeAll}"
                            Opacity="0.9"
                            Padding="0" />

                        <Border Padding="8">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>

                    </Grid>

                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
