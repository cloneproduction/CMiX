<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The WPF file declared x:Class CMiX.Core.Themes.MainWindow on the ResourceDictionary, dropped in this port -->
    <!--
        WPF's WindowChrome (CaptionHeight 0, CornerRadius CornerRadiusLargeAll, AllowsTransparency)
        has no direct Avalonia equivalent. The rounded/transparent popup look is achieved instead
        by SystemDecorations="None" plus TransparencyLevelHint="Transparent" set on the consuming
        Window (see ServerCreationWindow.axaml), combined with the Background/CornerRadius/Effect
        already set in the template below.
    -->

    <ControlTheme x:Key="PopupWindowNoTitleStyle" TargetType="Window">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="210" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="Transparent"
                    Effect="{DynamicResource WindowDropShadow}"
                    Padding="8">

                    <Grid>
                        <Border
                            Background="{DynamicResource Grey200Brush}"
                            CornerRadius="{DynamicResource CornerRadiusLargeAll}"
                            Opacity="0.9"
                            Padding="0" />

                        <Border Padding="8">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>

                    </Grid>

                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>