<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Template structure follows the Avalonia Simple theme Window skeleton with CMiX visual properties applied -->

    <DropShadowEffect
        x:Key="WindowDropShadow"
        BlurRadius="8"
        Color="Black"
        OffsetX="0"
        OffsetY="0"
        Opacity="0.5" />

</ResourceDictionary>
