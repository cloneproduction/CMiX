<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Central icon sizes. WPF sized button icons implicitly through oversized margins,
        which Avalonia lays out differently, so icons that render too large get an
        explicit size through these classes instead of per instance widths.
    -->
    <Style Selector="Image.iconSmall">
        <Setter Property="Width" Value="8" />
    </Style>

    <Style Selector="Image.iconMedium">
        <Setter Property="Width" Value="12" />
    </Style>

</Styles>
