<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The Studio styles. They build on the CMiX.UI theme, which the application adds first. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/ComposableListBox.axaml" />
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/TypeWriter.axaml" />
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/StatusIndicators.axaml" />
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/EntityModifiersSection.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

</Styles>
