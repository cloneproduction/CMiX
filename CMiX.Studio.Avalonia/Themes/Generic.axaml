<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Selector based styles for non templated elements. -->
    <StyleInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/Border.axaml" />
    <StyleInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/TextBlock.axaml" />

    <!-- Control themes, merged in dependency order so StaticResource BasedOn references resolve. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/ScrollViewer.axaml" />
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/ToolTip.axaml" />
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/Label.axaml" />
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/Button.axaml" />
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/ToggleButton.axaml" />
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/RadioButton.axaml" />
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/TextBox.axaml" />
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/ListBox.axaml" />
                <ResourceInclude Source="avares://CMiX.Studio.Avalonia/Themes/Styles/ListView.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

</Styles>
