<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Grey ramp, neutral dark with subtle cool shift -->
    <!-- 100 = darkest, 900 = lightest -->
    <Color x:Key="Grey100">#FF111113</Color>
    <Color x:Key="Grey200">#FF19191b</Color>
    <Color x:Key="Grey300">#FF212124</Color>
    <Color x:Key="Grey400">#FF2b2b2f</Color>
    <Color x:Key="Grey500">#FF36363a</Color>
    <Color x:Key="Grey600">#FF46464b</Color>
    <Color x:Key="Grey700">#FF606065</Color>
    <Color x:Key="Grey800">#FF808087</Color>
    <Color x:Key="Grey900">#FFb0b0b8</Color>

    <!-- Accent -->
    <Color x:Key="AccentPrimary">#FF5680C2</Color>
    <Color x:Key="AccentSecondary">#FF4d6490</Color>
    <Color x:Key="Active">#FF5680C2</Color>

    <!-- Lightened AccentPrimary (blended ~35% toward white) - no existing brush already reads as
         "brighter than AccentPrimary" (AccentSecondary is darker/desaturated, the opposite
         direction), so this is new: the modulator assign-dot's hovered-and-bound emphasis state. -->
    <Color x:Key="AccentHighlight">#FF91ACD7</Color>

    <!-- Text -->
    <Color x:Key="Text">#FFcccccc</Color>
    <Color x:Key="ActiveText">#FFE6E6E6</Color>

</ResourceDictionary>
