<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="CornerRadiusNone">0</CornerRadius>

    <!-- Base radius: 2 -->
    <CornerRadius x:Key="CornerRadiusAll">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusTop">2,2,0,0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusBottom">0,0,2,2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLeft">2,0,0,2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusRight">0,2,2,0</CornerRadius>

    <!-- Large radius: 4 -->
    <CornerRadius x:Key="CornerRadiusLargeAll">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLargeBottom">0,0,4,4</CornerRadius>

    <!-- Control heights -->
    <x:Double x:Key="ControlHeightXS">16</x:Double>
    <x:Double x:Key="ControlHeightSM">20</x:Double>
    <x:Double x:Key="ControlHeightMD">24</x:Double>
    <x:Double x:Key="ControlHeightXL">32</x:Double>

    <!--
        Icon glyph sizes - deliberately separate from ControlHeight*, which sizes
        control bounding boxes, not glyph size. See Views/Controls/AppIcon.
    -->
    <x:Double x:Key="IconSizeXS">16</x:Double>
    <x:Double x:Key="IconSizeSM">12</x:Double>
    <x:Double x:Key="IconSizeMD">16</x:Double>
    <x:Double x:Key="IconSizeLG">24</x:Double>

</ResourceDictionary>
