<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Shadow" Opacity="0.2" Color="Black" />

    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentPrimary}" />
    <SolidColorBrush x:Key="AccentInactiveBrush" Color="{DynamicResource AccentSecondary}" />

    <SolidColorBrush x:Key="PanelBackground" Opacity="0.3" Color="Black" />
    <SolidColorBrush x:Key="PanelBorderBackground" Opacity="0.4" Color="Black" />
    <SolidColorBrush x:Key="ListBoxBackground" Opacity="0.4" Color="Black" />

    <SolidColorBrush x:Key="Grey100Brush" Color="{DynamicResource Grey100}" />
    <SolidColorBrush x:Key="Grey200Brush" Color="{DynamicResource Grey200}" />
    <SolidColorBrush x:Key="Grey300Brush" Color="{DynamicResource Grey300}" />
    <SolidColorBrush x:Key="Grey400Brush" Color="{DynamicResource Grey400}" />
    <SolidColorBrush x:Key="Grey500Brush" Color="{DynamicResource Grey500}" />
    <SolidColorBrush x:Key="Grey600Brush" Color="{DynamicResource Grey600}" />
    <SolidColorBrush x:Key="Grey700Brush" Color="{DynamicResource Grey700}" />

    <SolidColorBrush x:Key="ForegroundBrush" Color="{DynamicResource Text}" />
    <SolidColorBrush x:Key="ActiveForegroundBrush" Color="{DynamicResource ActiveText}" />

    <!--
        Alpha-transparency checkerboard, replacing the old Transparent_Bg.png ImageBrush.
        A tiled 2x2 pattern drawn from two rectangles rather than a raster asset.
    -->
    <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" DestinationRect="0,0,16,16">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="{DynamicResource Grey300Brush}">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,16,16" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="{DynamicResource Grey100Brush}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <RectangleGeometry Rect="0,0,8,8" />
                            <RectangleGeometry Rect="8,8,8,8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

</ResourceDictionary>
