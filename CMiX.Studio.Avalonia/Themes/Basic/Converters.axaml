<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converters="clr-namespace:CMiX.Studio.Avalonia.Converters">

    <Converters:ColorToBrushConverter x:Key="ColorToBrush" />
    <Converters:HexToBrushConverter x:Key="HexToBrush" />
    <Converters:ColorToHexConverter x:Key="ColorToHex" />
    <Converters:ColorToNoAlphaConverter x:Key="ColorToNoAlpha" />

    <Converters:DoubleToStringConverter x:Key="DoubleToString" />

    <Converters:NullToVisibilityConverter x:Key="NullToVisibility" />
    <Converters:CountToVisibilityConverter x:Key="CountToVisibility" />

    <Converters:MultiPeriodToBeatAnimationConverter x:Key="MultiPeriodToBeatAnimation" />

    <Converters:FontFamilyToStringConverter x:Key="FontFamilyToString" />

    <Converters:CurrentStepConverter x:Key="CurrentStepConverter" />

    <Converters:ControlPositionToCornerRadiusConverter x:Key="PositionToCornerRadius" />

    <Converters:ModulatorTypeToIconConverter x:Key="ModulatorTypeToIcon" />
    <Converters:BoolToAccentBrushConverter x:Key="BoolToAccentBrush" />

</ResourceDictionary>
