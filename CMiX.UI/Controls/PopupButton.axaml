<UserControl
    x:Class="CMiX.UI.Controls.PopupButton"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="popupButton">

    <Panel>

        <ToggleButton
            x:Name="PopUpToggle"
            Content="{Binding Caption, ElementName=popupButton}" />

        <Popup
            ui:TogglePopup.ClosesOnPointerAway="{Binding ClosesOnPointerAway, ElementName=popupButton}"
            ui:TogglePopup.MatchesToggleWidth="True"
            ui:TogglePopup.PointerAwayDistance="{Binding PointerAwayDistance, ElementName=popupButton}"
            ui:TogglePopup.Toggle="{Binding ElementName=PopUpToggle}"
            Placement="Bottom">
            <Border
                Padding="2,4,2,2"
                Background="{DynamicResource Grey200Brush}"
                BorderBrush="{DynamicResource Shadow}"
                BorderThickness="1,0,1,2"
                CornerRadius="{DynamicResource CornerRadiusBottom}">

                <ContentControl Content="{Binding PopupContent, ElementName=popupButton}" />

            </Border>

        </Popup>
    </Panel>

</UserControl>
