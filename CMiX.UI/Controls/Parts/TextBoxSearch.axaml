<UserControl
    x:Class="CMiX.UI.Controls.Parts.TextBoxSearch"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="textBoxSearch">

    <!-- The search field of every list and drop-down that filters its rows. The magnifier is inside the field, at its left. The text starts after it.
         With ShowsClear, a clear button with no background is inside the field, at its right, while the field holds text. The text always
         stops before the place of that button, so the text does not move when the button shows (see TextBoxSearch.axaml.cs). -->
    <Panel x:Name="PART_Panel">

        <TextBox
            x:Name="PART_Search"
            Height="{DynamicResource ControlHeightMD}"
            Padding="28,0,6,0"
            VerticalContentAlignment="Center"
            IsReadOnly="{Binding IsReadOnly, ElementName=textBoxSearch}"
            Text="{Binding Text, ElementName=textBoxSearch, Mode=TwoWay}"
            Watermark="{Binding Watermark, ElementName=textBoxSearch}" />

        <ui:AppIcon
            x:Name="PART_SearchIcon"
            Margin="8,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            IconKey="Search"
            IsHitTestVisible="False"
            Opacity="{DynamicResource OpacityIconIdle}"
            Size="{DynamicResource IconSizeXS}" />

    </Panel>

</UserControl>
