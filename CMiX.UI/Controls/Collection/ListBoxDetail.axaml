<UserControl
    x:Class="CMiX.UI.Controls.Collection.ListBoxDetail"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="listBoxDetail">

    <StackPanel>

        <ui:ListBoxCMiX
            MinHeight="105"
            Margin="8"
            ItemsSource="{Binding ItemsSource, ElementName=listBoxDetail}"
            SelectedItem="{Binding SelectedItem, ElementName=listBoxDetail, Mode=TwoWay}" />

        <DockPanel Margin="8,0,8,8">

            <Button
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Command="{Binding DeleteCommand, ElementName=listBoxDetail}"
                CommandParameter="{Binding SelectedItem, ElementName=listBoxDetail}"
                Content="-"
                DockPanel.Dock="Right"
                Theme="{StaticResource ButtonRoundedRight}" />

            <ContentControl Content="{Binding AddContent, ElementName=listBoxDetail}" />

        </DockPanel>

        <!-- The detail shows only while an item is selected. Its DataContext is that item. -->
        <Border IsVisible="{Binding SelectedItem, ElementName=listBoxDetail, Converter={StaticResource NullToVisibility}}">
            <ContentControl
                Content="{Binding DetailContent, ElementName=listBoxDetail}"
                DataContext="{Binding SelectedItem, ElementName=listBoxDetail}" />
        </Border>

    </StackPanel>

</UserControl>
