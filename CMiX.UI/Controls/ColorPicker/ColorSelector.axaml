<ui:UserControlCaptioned
    x:Class="CMiX.UI.Controls.ColorPicker.ColorSelector"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="colorSelector"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    ResetCommand="{Binding ResetCommand}"
    SelectedColor="{Binding Value, Converter={StaticResource ColorToHex}, Mode=TwoWay}">

    <ui:ContentCaptioned Caption="{Binding Caption, ElementName=colorSelector}">

        <Panel>

            <ToggleButton
                x:Name="PopupToggle"
                ui:PositionedControl.Position="{Binding (ui:PositionedControl.Position), ElementName=colorSelector}"
                Background="{Binding Value, Converter={StaticResource HexToBrush}}"
                Theme="{DynamicResource ToggleButtonColor}" />

            <Popup
                x:Name="colorPickerPopup"
                ui:TogglePopup.Toggle="{Binding ElementName=PopupToggle}"
                Placement="Top">
                <Border
                    x:Name="popupBorder"
                    Background="{DynamicResource Grey200Brush}"
                    CornerRadius="{DynamicResource CornerRadiusAll}">
                    <ui:ColorPickerFull
                        Margin="8"
                        SelectedColor="{Binding Value, Converter={StaticResource ColorToHex}, Mode=TwoWay}" />
                </Border>
            </Popup>

        </Panel>

    </ui:ContentCaptioned>

</ui:UserControlCaptioned>
