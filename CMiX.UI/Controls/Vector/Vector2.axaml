<ui:UserControlCaptioned
    x:Class="CMiX.UI.Controls.Vector.Vector2"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="vector2">

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

        <ui:DragValue
            Caption="{Binding Caption, StringFormat=' {0} X', ElementName=vector2, Mode=OneWay}"
            DataContext="{Binding X}"
            ResetAllCommand="{Binding DataContext.ResetAllCommand, ElementName=vector2}"
            ResetCommand="{Binding ResetCommand}"
            Value="{Binding Value}" />

        <ui:DragValue
            ui:ControlTitle.Text="{Binding Caption, StringFormat=' {0} Y', ElementName=vector2, Mode=OneWay}"
            Caption="Y"
            DataContext="{Binding Y}"
            ResetAllCommand="{Binding DataContext.ResetAllCommand, ElementName=vector2}"
            ResetCommand="{Binding ResetCommand}"
            Value="{Binding Value}" />

    </ui:StackPanelPositioned>

</ui:UserControlCaptioned>
