<ui:UserControlCaptioned
    x:Class="CMiX.UI.Controls.Vector.Integer2"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="integer2Value"
    Background="Transparent">

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

        <ui:IntegerValue
            Caption="{Binding Caption, StringFormat=' {0} X', ElementName=integer2Value, Mode=OneWay}"
            ResetAllCommand="{Binding ResetAllCommand}"
            Value="{Binding X.Value}"
            ResetCommand="{Binding X.ResetCommand}" />

        <ui:IntegerValue
            Caption="Y"
            ResetAllCommand="{Binding ResetAllCommand}"
            Value="{Binding Y.Value}"
            ResetCommand="{Binding Y.ResetCommand}" />

    </ui:StackPanelPositioned>

</ui:UserControlCaptioned>
