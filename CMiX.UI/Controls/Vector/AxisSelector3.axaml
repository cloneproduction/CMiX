<ui:UserControlCaptioned
    x:Class="CMiX.UI.Controls.Vector.AxisSelector3"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="axisSelector3D">

    <ui:ContentCaptioned Caption="{Binding Caption, ElementName=axisSelector3D}">

        <Border
            x:Name="outerBorder"
            ui:PositionedControl.Position="{Binding (ui:PositionedControl.Position), ElementName=axisSelector3D}"
            Classes="BorderMask">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <ToggleButton
                    Grid.Column="0"
                    Content="X"
                    IsChecked="{Binding XIsChecked, ElementName=axisSelector3D, Mode=TwoWay}"
                    Theme="{StaticResource ToggleButtonInlineLeft}" />

                <ToggleButton
                    Grid.Column="1"
                    Margin="1,0"
                    Content="Y"
                    IsChecked="{Binding YIsChecked, ElementName=axisSelector3D, Mode=TwoWay}"
                    Theme="{StaticResource ToggleButtonInlineCenter}" />

                <ToggleButton
                    Grid.Column="2"
                    Content="Z"
                    IsChecked="{Binding ZIsChecked, ElementName=axisSelector3D, Mode=TwoWay}"
                    Theme="{StaticResource ToggleButtonInlineRight}" />

            </Grid>

        </Border>

    </ui:ContentCaptioned>
</ui:UserControlCaptioned>
