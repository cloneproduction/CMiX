<ui:CaptionedUserControl
    x:Class="CMiX.UI.Controls.Vector.VectorXYZ"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    x:Name="vectorXYZ">

    <ui:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

        <!-- Mode OneWay stops the TwoWay default from writing the formatted string back. -->
        <ui:DragValue
            Caption="{Binding Caption, StringFormat=' {0} X', ElementName=vectorXYZ, Mode=OneWay}"
            DataContext="{Binding X}"
            Value="{Binding Value}">
            <ui:DragValue.ContextMenu>
                <ContextMenu Theme="{StaticResource ContextMenuDefault}">
                    <MenuItem Command="{Binding ResetCommand}" Header="Reset" />
                    <MenuItem Command="{Binding DataContext.ResetAllCommand, ElementName=vectorXYZ}" Header="Reset All" />
                </ContextMenu>
            </ui:DragValue.ContextMenu>
        </ui:DragValue>

        <ui:DragValue
            Caption="Y"
            DataContext="{Binding Y}"
            Value="{Binding Value}">
            <ui:DragValue.ContextMenu>
                <ContextMenu Theme="{StaticResource ContextMenuDefault}">
                    <MenuItem Command="{Binding ResetCommand}" Header="Reset" />
                    <MenuItem Command="{Binding DataContext.ResetAllCommand, ElementName=vectorXYZ}" Header="Reset All" />
                </ContextMenu>
            </ui:DragValue.ContextMenu>
        </ui:DragValue>

        <ui:DragValue
            Caption="Z"
            DataContext="{Binding Z}"
            Value="{Binding Value}">
            <ui:DragValue.ContextMenu>
                <ContextMenu Theme="{StaticResource ContextMenuDefault}">
                    <MenuItem Command="{Binding ResetCommand}" Header="Reset" />
                    <MenuItem Command="{Binding DataContext.ResetAllCommand, ElementName=vectorXYZ}" Header="Reset All" />
                </ContextMenu>
            </ui:DragValue.ContextMenu>
        </ui:DragValue>

    </ui:PositionedStackPanel>

</ui:CaptionedUserControl>
