<ui:UserControlCaptioned
    x:Class="CMiX.UI.Controls.Vector.Vector3"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400"
    x:Name="vectorXYZ">

    <ui:StackPanelPositioned Spacing="{DynamicResource SpacingXXS}">

        <!-- Mode OneWay stops the TwoWay default from writing the formatted string back. -->
        <ui:DragValue
            Caption="{Binding Caption, StringFormat=' {0} X', ElementName=vectorXYZ, Mode=OneWay}"
            DataContext="{Binding X}"
            ResetAllCommand="{Binding DataContext.ResetAllCommand, ElementName=vectorXYZ}"
            ResetCommand="{Binding ResetCommand}"
            Value="{Binding Value}" />

        <ui:DragValue
            Caption="Y"
            DataContext="{Binding Y}"
            ResetAllCommand="{Binding DataContext.ResetAllCommand, ElementName=vectorXYZ}"
            ResetCommand="{Binding ResetCommand}"
            Value="{Binding Value}" />

        <ui:DragValue
            Caption="Z"
            DataContext="{Binding Z}"
            ResetAllCommand="{Binding DataContext.ResetAllCommand, ElementName=vectorXYZ}"
            ResetCommand="{Binding ResetCommand}"
            Value="{Binding Value}" />

    </ui:StackPanelPositioned>

</ui:UserControlCaptioned>
