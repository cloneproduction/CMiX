<ui:UserControlCaptioned
    x:Class="CMiX.UI.Controls.Path.PathSelector"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="pathSelector"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">
    <ui:ContentCaptioned Caption="{Binding Caption, ElementName=pathSelector}">
        <ui:DockPanelPositioned>
            <Button
                Margin="1,0,0,0"
                Width="{DynamicResource ControlHeightMD}"
                DockPanel.Dock="Right"
                Click="BrowseButton_Click">
                <ui:AppIcon IconKey="Folder" Size="{DynamicResource IconSizeXS}" />
            </Button>
            <Border
                x:Name="mainBorder"
                Background="{DynamicResource Grey500Brush}"
                BorderBrush="Transparent"
                Classes="BorderMask">
                <ComboBox
                    x:Name="pathComboBox"
                    ui:PositionedControl.Position="Left"
                    ItemsSource="{Binding ItemsSource, ElementName=pathSelector}"
                    SelectedItem="{Binding SelectedItem, ElementName=pathSelector}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <ui:TextBlockTrimmed Text="{Binding Name}" ToolTipText="{Binding FilePath}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
            </Border>
        </ui:DockPanelPositioned>
    </ui:ContentCaptioned>
</ui:UserControlCaptioned>
