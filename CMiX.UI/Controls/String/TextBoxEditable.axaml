<UserControl
    x:Class="CMiX.UI.Controls.String.TextBoxEditable"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="textBoxEditable">

    <Grid
        Height="{DynamicResource ControlHeightMD}"
        Background="Transparent">

        <!-- The TextBox has a 1 border and the padding 3,1 (a ScrollViewer margin), so its text is 4,2 from its corner.
             The TextBlock has the padding 4,2 to have the same box: both boxes are centered with the same numbers,
             so the text does not move by a pixel when the edit mode starts. -->
        <!-- Only as wide as its text: a double tap on the text starts the edit mode, a double tap on the rest of the row does not.
             The least width keeps an empty name easy to hit. -->
        <!-- The suffix is something that follows the text, such as the counts of a row of a tree. It shows with the text. -->
        <StackPanel
            x:Name="displayRow"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <TextBlock
                x:Name="textDisplay"
                MinWidth="{DynamicResource ControlHeightMD}"
                Padding="4,2"
                Background="Transparent"
                VerticalAlignment="Center"
                Foreground="{Binding Foreground, ElementName=textBoxEditable}"
                Text="{Binding Text, ElementName=textBoxEditable}" />
            <ContentPresenter
                x:Name="suffixPresenter"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Content="{Binding Suffix, ElementName=textBoxEditable}" />
        </StackPanel>

        <!-- The input has no binding to Text: it gets the text when the edit starts, and gives it back when the edit ends.
             So the text of the owner never holds a half edited or an empty text. -->
        <TextBox
            x:Name="inputValue"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            VerticalContentAlignment="Center"
            CaretBrush="{DynamicResource AccentInactiveBrush}"
            ContextFlyout="{x:Null}"
            Padding="3,1"
            ScrollViewer.VerticalScrollBarVisibility="Disabled"
            Foreground="{DynamicResource ActiveForegroundBrush}"
            SelectionBrush="{DynamicResource AccentBrush}" />
    </Grid>

</UserControl>
