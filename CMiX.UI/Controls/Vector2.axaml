<ui:CaptionedUserControl
    x:Class="CMiX.UI.Controls.Vector2"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="vector2">

    <ui:PositionedStackPanel Spacing="{DynamicResource SpacingXXS}">

        <ui:DragValue
            Caption="{Binding Caption, StringFormat=' {0} X', ElementName=vector2, Mode=OneWay}"
            DataContext="{Binding X}"
            Value="{Binding Value}">
            <ui:DragValue.ContextMenu>
                <ContextMenu Theme="{StaticResource ContextMenuDefault}">
                    <MenuItem Command="{Binding ResetCommand}" Header="Reset" />
                    <MenuItem Command="{Binding DataContext.ResetAllCommand, ElementName=vector2}" Header="Reset All" />
                </ContextMenu>
            </ui:DragValue.ContextMenu>
        </ui:DragValue>

        <ui:DragValue
            Caption="Y"
            DataContext="{Binding Y}"
            Value="{Binding Value}">
            <ui:DragValue.ContextMenu>
                <ContextMenu Theme="{StaticResource ContextMenuDefault}">
                    <MenuItem Command="{Binding ResetCommand}" Header="Reset" />
                    <MenuItem Command="{Binding DataContext.ResetAllCommand, ElementName=vector2}" Header="Reset All" />
                </ContextMenu>
            </ui:DragValue.ContextMenu>
        </ui:DragValue>

    </ui:PositionedStackPanel>

</ui:CaptionedUserControl>
