<ui:UserControlCaptioned
    x:Class="CMiX.UI.Controls.Boolean.ToggleButtonCaptioned"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="toggleButtonControl">

    <ui:ContentCaptioned>
        <DockPanel>
            <ToggleButton
                x:Name="toggleButton"
                Width="{DynamicResource ControlHeightXS}"
                Height="{DynamicResource ControlHeightXS}"
                HorizontalAlignment="Left"
                IsChecked="{Binding IsChecked, ElementName=toggleButtonControl, Mode=TwoWay}"
                Theme="{StaticResource ToggleCheckBox}" />
            <Border
                x:Name="labelBorder"
                Background="Transparent">
                <TextBlock
                    Padding="4,0"
                    HorizontalAlignment="Left"
                    Foreground="{StaticResource ForegroundBrush}"
                    Text="{Binding Caption, ElementName=toggleButtonControl}" />
            </Border>
        </DockPanel>
    </ui:ContentCaptioned>

</ui:UserControlCaptioned>
