<UserControl
    x:Class="CMiX.UI.Controls.Number.RangeValue"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    x:Name="rangeValue"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    d:DesignWidth="400">

    <Grid ColumnDefinitions="*,*">

        <ui:DragValue
            Grid.Column="0"
            ui:PositionedControl.Position="Left"
            Caption="{Binding LeftCaption, ElementName=rangeValue}"
            IsInteger="{Binding IsInteger, ElementName=rangeValue}"
            LargeChange="{Binding LargeChange, ElementName=rangeValue}"
            Maximum="{Binding Maximum, ElementName=rangeValue}"
            Minimum="{Binding Minimum, ElementName=rangeValue}"
            SmallChange="{Binding SmallChange, ElementName=rangeValue}"
            Theme="{StaticResource DragValueInlineCaption}"
            ResetCommand="{Binding LeftResetCommand, ElementName=rangeValue}"
            Value="{Binding LeftValue, ElementName=rangeValue, Mode=TwoWay}" />

        <ui:DragValue
            Grid.Column="1"
            Margin="1,0,0,0"
            ui:PositionedControl.Position="Right"
            Caption="{Binding RightCaption, ElementName=rangeValue}"
            IsInteger="{Binding IsInteger, ElementName=rangeValue}"
            LargeChange="{Binding LargeChange, ElementName=rangeValue}"
            Maximum="{Binding Maximum, ElementName=rangeValue}"
            Minimum="{Binding Minimum, ElementName=rangeValue}"
            SmallChange="{Binding SmallChange, ElementName=rangeValue}"
            Theme="{StaticResource DragValueInlineCaption}"
            ResetCommand="{Binding RightResetCommand, ElementName=rangeValue}"
            Value="{Binding RightValue, ElementName=rangeValue, Mode=TwoWay}" />

    </Grid>

</UserControl>
