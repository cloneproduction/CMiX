<ui:CaptionedUserControl
    x:Class="CMiX.UI.Controls.Number.IntegerValue"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI"
    xmlns:conv="clr-namespace:Avalonia.Data.Converters;assembly=Avalonia.Base"
    x:Name="counter">

    <ui:DragValue
        ui:PositionedControl.Position="{Binding (ui:PositionedControl.Position), ElementName=counter}"
        Caption="{Binding Caption, ElementName=counter}"
        IsInteger="True"
        LargeChange="1.0"
        Maximum="{Binding Maximum, ElementName=counter}"
        Minimum="{Binding Minimum, ElementName=counter}"
        SmallChange="1.0"
        Value="{Binding Value, ElementName=counter, Mode=TwoWay}">
        <ui:DragValue.ContextMenu>
            <ContextMenu Theme="{StaticResource ContextMenuDefault}">
                <MenuItem Command="{Binding ResetCommand}" Header="Reset" />
                <MenuItem
                    Command="{Binding ResetAllCommand, ElementName=counter}"
                    Header="Reset All"
                    IsVisible="{Binding ResetAllCommand, ElementName=counter, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
            </ContextMenu>
        </ui:DragValue.ContextMenu>
    </ui:DragValue>

</ui:CaptionedUserControl>
