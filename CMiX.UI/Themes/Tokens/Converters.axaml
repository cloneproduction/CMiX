<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <ui:ColorToBrushConverter x:Key="ColorToBrush" />
    <ui:HexToBrushConverter x:Key="HexToBrush" />
    <ui:ColorToHexConverter x:Key="ColorToHex" />
    <ui:ColorToNoAlphaConverter x:Key="ColorToNoAlpha" />

    <ui:DoubleToStringConverter x:Key="DoubleToString" />

    <ui:NullToVisibilityConverter x:Key="NullToVisibility" />
    <ui:CountToVisibilityConverter x:Key="CountToVisibility" />

    <ui:FontFamilyToStringConverter x:Key="FontFamilyToString" />

    <ui:CurrentStepConverter x:Key="CurrentStepConverter" />

    <ui:ControlPositionToCornerRadiusConverter x:Key="PositionToCornerRadius" />

</ResourceDictionary>
