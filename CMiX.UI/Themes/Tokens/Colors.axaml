<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Grey100">#FF0F0F12</Color>
    <Color x:Key="Grey200">#FF212124</Color>
    <Color x:Key="Grey300">#FF2B2B2E</Color>
    <Color x:Key="Grey400">#FF363639</Color>
    <Color x:Key="Grey500">#FF414144</Color>
    <Color x:Key="Grey600">#FF4C4C4F</Color>
    <Color x:Key="Grey700">#FF606063</Color>
    <Color x:Key="Grey800">#FF808083</Color>
    <Color x:Key="Grey900">#FFB0B1B4</Color>

    <!-- The color under the rows of the project tree: the window surface (Grey100). The palette of the rows mixes against it. -->
    <Color x:Key="TreeBackground">#FF0F0F12</Color>

    <Color x:Key="AccentPrimary">#FF5680C2</Color>
    <Color x:Key="AccentSecondary">#FF4d6490</Color>
    <!-- The fill of a control that is on, or of a row that is selected, under the pointer. It is between AccentSecondary and
         AccentPrimary: white text has a contrast of 4.70:1 on it. AccentPrimary is for lines, such as the focus line and the drop line. -->
    <Color x:Key="AccentHover">#FF4B74B6</Color>
    <Color x:Key="Active">#FF5680C2</Color>

    <Color x:Key="AccentHighlight">#FF91ACD7</Color>

    <!-- The colors of the modulator assign button, one pair for each ModulatorCategory.
         The name is Modulator + category + (Highlight when the modulator is hovered).
         A new category needs two colors here and two brushes in Brushes.axaml.
         An internal modulator has the color of the modulator kind (CategoryModulator), not the accent: the accent
         means on or selected. -->
    <Color x:Key="ModulatorUnassigned">#FF606063</Color>
    <Color x:Key="ModulatorInternal">#FFAD8DFD</Color>
    <Color x:Key="ModulatorInternalHighlight">#FFCEC0FF</Color>
    <Color x:Key="ModulatorExternal">#FFDF8605</Color>
    <Color x:Key="ModulatorExternalHighlight">#FFF1B77E</Color>

    <!-- The colors of the kinds of row in the project tree, one for each TreeCategory.
         A composable takes a hue by its depth of nesting from a wheel of six (CategoryComposable0 to 5, 60 degrees apart), so a container
         and the containers in it never share a hue. The other kinds keep their own colour inside any container.
         CategoryComposable is the first hue of the wheel, for the places that ask for the kind by name.
         The tree reads them by the name Category + kind, and shows them as tones over the panel background. -->
    <Color x:Key="CategoryComposable">#FFDC89D5</Color>
    <Color x:Key="CategoryComposable0">#FFDC89D5</Color>
    <Color x:Key="CategoryComposable1">#FFF68675</Color>
    <Color x:Key="CategoryComposable2">#FFCDA629</Color>
    <Color x:Key="CategoryComposable3">#FF62C37A</Color>
    <Color x:Key="CategoryComposable4">#FF00C0D7</Color>
    <Color x:Key="CategoryComposable5">#FF8AA6FE</Color>
    <Color x:Key="CategoryEntity">#FFF275A0</Color>
    <Color x:Key="CategoryCamera">#FFF87B5C</Color>
    <Color x:Key="CategoryLight">#FFE3CC36</Color>
    <Color x:Key="CategoryTexture">#FF73BB43</Color>
    <Color x:Key="CategoryFilter">#FF2DC5A6</Color>
    <Color x:Key="CategoryModifier">#FF22B5E1</Color>
    <Color x:Key="CategoryModulator">#FFAD8DFD</Color>

    <!-- A muted warning tone, not a full red: the frame of a target that refuses a drop, the mark of a conflict.
         It is not PopupCardWarning, the line of a tooltip. -->
    <Color x:Key="WarningMuted">#FFB4685C</Color>

    <!-- The background of every popup: the card of a tooltip, the Add panel, a menu, a flyout and a drop down. It has no outline. -->
    <Color x:Key="PopupCardBackground">#FF18181B</Color>
    <!-- The line of a tooltip that says why a control is disabled. -->
    <Color x:Key="PopupCardWarning">#FFE2A355</Color>
    <!-- The text of a row of a menu that takes something away, such as Delete. -->
    <Color x:Key="PopupCardDanger">#FFE97871</Color>
    <!-- A good status, such as a connection that is up. With PopupCardDanger (a bad status) and PopupCardWarning (a status that needs
         attention), it is one of the three status colors. It has a contrast of 3:1 or more on every panel. -->
    <Color x:Key="StatusSuccess">#FF6FC082</Color>

    <!-- The text of a row of the tree at rest: a step under Text, so the white of the cursor row and of the selected row stands out. -->
    <Color x:Key="TreeTextRest">#FFC9C9CE</Color>
    <Color x:Key="Text">#FFE0E0E0</Color>
    <Color x:Key="ActiveText">#FFFFFFFF</Color>

    <!-- The new list tree. An opaque surface is white at a strength over TreeBackground. A band is white with alpha over what is under it. -->
    <Color x:Key="ListTreeRowRestBand">#0DFFFFFF</Color>
    <Color x:Key="ListTreeRowHover">#FF1B1B1E</Color>
    <Color x:Key="ListTreeRowSelected">#FF202023</Color>
    <Color x:Key="ListTreeRowSelectedHover">#FF27272A</Color>
    <Color x:Key="ListTreeRowDragged">#FF353538</Color>
    <Color x:Key="ListTreeRowDimmedBand">#05FFFFFF</Color>
    <Color x:Key="ListTreeRowCursorFrame">#73FFFFFF</Color>
    <Color x:Key="ListTreeCardDropTarget">#FF1B1B1E</Color>
    <Color x:Key="ListTreeTextRest">#FFB6B6BB</Color>
    <Color x:Key="ListTreeTextDimmed">#FF9A9A9F</Color>
    <Color x:Key="ListTreeTextHidden">#FF8A8A8F</Color>
    <Color x:Key="ListTreeIconHidden">#FF6C6C6F</Color>

    <!-- The text of a shortcut in a tooltip, a menu and a key cap. It has a contrast of 4.74:1 on PopupCardBackground (WCAG AA). -->
    <Color x:Key="ShortcutText">#FF85858C</Color>

</ResourceDictionary>
