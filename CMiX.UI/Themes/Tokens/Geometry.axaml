<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <CornerRadius x:Key="CornerRadiusNone">0</CornerRadius>

    <!-- Base radius: 2 -->
    <CornerRadius x:Key="CornerRadiusAll">2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusTop">2,2,0,0</CornerRadius>
    <CornerRadius x:Key="CornerRadiusBottom">0,0,2,2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLeft">2,0,0,2</CornerRadius>
    <CornerRadius x:Key="CornerRadiusRight">0,2,2,0</CornerRadius>

    <!-- Large radius: 4 -->
    <CornerRadius x:Key="CornerRadiusLargeAll">4</CornerRadius>
    <CornerRadius x:Key="CornerRadiusLargeBottom">0,0,4,4</CornerRadius>

    <!-- The space around a card, such as ExpanderIndented: SpacingXS at the sides, SpacingXXS above and below. -->
    <Thickness x:Key="MarginCard">2,1</Thickness>

    <!-- Control heights -->
    <x:Double x:Key="ControlHeightXS">17</x:Double>
    <x:Double x:Key="ControlHeightSM">21</x:Double>
    <x:Double x:Key="ControlHeightMD">25</x:Double>
    <x:Double x:Key="ControlHeightXL">31</x:Double>
    <x:Double x:Key="ControlHeightXXL">35</x:Double>
    <!-- Sizes of small parts. They are not control heights, but they sit in the same scale. -->
    <x:Double x:Key="IndicatorSize">8</x:Double>
    <x:Double x:Key="SplitterSize">8</x:Double>
    <x:Double x:Key="SplitterIndicatorSize">2</x:Double>
    <x:Double x:Key="ScrollBarSize">8</x:Double>
    <x:Double x:Key="SeparatorSize">0.5</x:Double>
    <x:Double x:Key="ContextMenuIconSize">10</x:Double>
    <!-- The least width of the visible panel of every menu and popup, without the margin of the shadow.
         More content makes it wider. A popup can follow the width of its toggle instead: TogglePopup.MatchesToggleWidth. -->
    <x:Double x:Key="PopupMinWidth">200</x:Double>
    <x:Double x:Key="ColorWheelSize">200</x:Double>

    <!-- Multi line text boxes: two lines and four lines. -->
    <x:Double x:Key="TextAreaHeight2">46</x:Double>
    <x:Double x:Key="TextAreaHeight4">92</x:Double>

    <!--
        Icon glyph sizes - deliberately separate from ControlHeight*, which sizes
        control bounding boxes, not glyph size. See Views/Controls/AppIcon.
    -->
    <x:Double x:Key="IconSizeXS">17</x:Double>
    <x:Double x:Key="IconSizeSM">13</x:Double>
    <x:Double x:Key="IconSizeMD">17</x:Double>
    <x:Double x:Key="IconSizeLG">25</x:Double>

    <!-- Lists and drop downs. The height of each is a number of rows of ControlHeightMD, plus the
         margins and the spaces around the rows. No other file holds one of these numbers.
         ListBoxCMiX: ListVisibleItems rows + the top and bottom of ListScrollMargin.
         ListBoxEditable: ListEditableVisibleItems rows + the spaces of ListEditableSpacing + ListEditablePadding.
         ComboBox: ComboBoxVisibleItems rows. -->
    <x:Int32 x:Key="ListVisibleItems">5</x:Int32>
    <Thickness x:Key="ListScrollMargin">2</Thickness>
    <x:Double x:Key="ListResizeHandleHeight">12</x:Double>
    <x:Int32 x:Key="ListEditableVisibleItems">4</x:Int32>
    <x:Double x:Key="ListEditableSpacing">2</x:Double>
    <Thickness x:Key="ListEditablePadding">4</Thickness>
    <x:Int32 x:Key="ComboBoxVisibleItems">7</x:Int32>

    <!-- The size of the text: about half a row of ControlHeightMD, rounded. -->
    <x:Double x:Key="FontSizeMD">12.5</x:Double>

    <!-- Spacing scale for Margin/Padding -->
    <x:Double x:Key="SpacingXXS">1</x:Double>
    <x:Double x:Key="SpacingXS">2</x:Double>
    <x:Double x:Key="SpacingSM">4</x:Double>
    <x:Double x:Key="SpacingMD">8</x:Double>

</ResourceDictionary>
