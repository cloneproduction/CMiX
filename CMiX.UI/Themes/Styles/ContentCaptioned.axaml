<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <!-- 40/60 columns: caption right-aligned in column 0, the control's own Content in
         column 1. -->
    <ControlTheme x:Key="{x:Type ui:ContentCaptioned}" TargetType="ui:ContentCaptioned">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="40*,60*">
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource ForegroundBrush}"
                        Text="{TemplateBinding Caption}" />
                    <ContentPresenter
                        Grid.Column="1"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
