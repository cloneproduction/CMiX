<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:i="clr-namespace:Avalonia.Xaml.Interactivity;assembly=Avalonia.Xaml.Interactivity"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <!-- The items, then the add button. The popup of the button shows AddContent. -->
    <ControlTheme x:Key="{x:Type ui:PanelItemList}" TargetType="ui:PanelItemList">
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>

                    <ItemsPresenter
                        Name="PART_ItemsPresenter"
                        ItemsPanel="{TemplateBinding ItemsPanel}" />

                    <ToggleButton
                        x:Name="PART_AddToggle"
                        Margin="0,8,0,0"
                        Background="{DynamicResource Grey600Brush}"
                        Content="{TemplateBinding AddCaption}"
                        Theme="{StaticResource ToggleButtonPopup}" />

                    <Popup
                        Width="{Binding Bounds.Width, ElementName=PART_AddToggle}"
                        IsLightDismissEnabled="False"
                        IsOpen="{Binding IsChecked, ElementName=PART_AddToggle}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=PART_AddToggle}">

                        <i:Interaction.Behaviors>
                            <ui:ClosePopupBehavior />
                        </i:Interaction.Behaviors>

                        <Border
                            Padding="2"
                            Background="{DynamicResource Grey100Brush}"
                            CornerRadius="{DynamicResource CornerRadiusLargeBottom}">

                            <ContentControl Content="{TemplateBinding AddContent}" />

                        </Border>

                    </Popup>

                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
