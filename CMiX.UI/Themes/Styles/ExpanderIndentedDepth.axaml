<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <!--
        The default background of an ExpanderIndented comes from the number of ExpanderIndented
        parents. Level 1 is the background set in Expander.axaml. The header and the content take
        it from the Background of the expander. A deeper expander keeps the level 3 color.
        A Background that a view sets on an expander is a local value, so it wins at every depth.
    -->
    <Style Selector="ui|ExpanderIndented ui|ExpanderIndented">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundLevel2Brush}" />
    </Style>
    <Style Selector="ui|ExpanderIndented ui|ExpanderIndented ui|ExpanderIndented">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundLevel3Brush}" />
    </Style>

</Styles>
