<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <ControlTheme x:Key="ListBoxResizeBorder" TargetType="Border">
        <Style Selector="^:pointerover">
            <Setter Property="Cursor" Value="SizeNorthSouth" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ui:ListBoxCMiX}" TargetType="ui:ListBoxCMiX">
        <Setter Property="ItemContainerTheme" Value="{DynamicResource ListBoxItemCMiX}" />
        <!-- A pick in the list must not scroll the list, or the panels around it. -->
        <Setter Property="AutoScrollToSelectedItem" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="outerBorder"
                    CornerRadius="{DynamicResource CornerRadiusAll}">
                    <DockPanel>

                        <!--<Border
                            Name="resizeBorder"
                            Background="{DynamicResource ListBoxBackground}"
                            DockPanel.Dock="Bottom"
                            Height="12"
                            Theme="{StaticResource ListBoxResizeBorder}">
                            <ui:AppIcon
                                IsHitTestVisible="False"
                                Margin="1"
                                Opacity="0.25"
                                IconKey="DragHandle"
                                Size="{DynamicResource IconSizeXS}" />
                        </Border>-->

                        <Border
                            Name="Bd"
                            Background="{DynamicResource ListBoxBackground}"
                            CornerRadius="{DynamicResource CornerRadiusAll}"
                            MinHeight="{TemplateBinding MinHeight}">
                            <ScrollViewer
                                Name="PART_ScrollViewer"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Disabled"
                                Margin="2"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter
                                    Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>

                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <!--<Style Selector="^:pointerover /template/ Border#outerBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource Grey600Brush}" />
        </Style>-->
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ListBox}" TargetType="ListBox">
        <Setter Property="ItemContainerTheme" Value="{DynamicResource ListBoxItemCMiX}" />
        <!-- A pick in the list must not scroll the list, or the panels around it. -->
        <Setter Property="AutoScrollToSelectedItem" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="Bd"
                    Background="{DynamicResource ListBoxBackground}"
                    CornerRadius="{DynamicResource CornerRadiusAll}">
                    <ScrollViewer
                        Name="PART_ScrollViewer"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        Margin="2"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter
                            Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="ListBoxItemCMiX" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="Bd"
                    Background="Transparent"
                    CornerRadius="{DynamicResource CornerRadiusAll}"
                    Margin="1"
                    Padding="2,0,0,0"
                    TextElement.Foreground="{DynamicResource ForegroundBrush}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:selected:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^:selected:not(:pointerover) /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>
        <Style Selector="^:pointerover:not(:selected) /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Grey400Brush}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
