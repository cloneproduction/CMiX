<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <ControlTheme x:Key="ListBoxResizeBorder" TargetType="Border">
        <Style Selector="^:pointerover">
            <Setter Property="Cursor" Value="SizeNorthSouth" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ui:ListBoxCMiX}" TargetType="ui:ListBoxCMiX">
        <Setter Property="ItemContainerTheme" Value="{DynamicResource ListBoxItemCMiX}" />
        <!-- A pick in the list must not scroll the list, or the panels around it. -->
        <Setter Property="AutoScrollToSelectedItem" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="outerBorder"
                    CornerRadius="{DynamicResource CornerRadiusAll}">
                    <DockPanel>

                        <Border
                            Name="resizeBorder"
                            Background="{DynamicResource ListBoxBackground}"
                            DockPanel.Dock="Bottom"
                            Height="{DynamicResource ListResizeHandleHeight}"
                            Theme="{StaticResource ListBoxResizeBorder}">
                            <ui:AppIcon
                                IsHitTestVisible="False"
                                Margin="1"
                                Opacity="0.25"
                                IconKey="DragHandle"
                                Size="{DynamicResource IconSizeXS}" />
                        </Border>

                        <Border
                            Name="Bd"
                            Background="{DynamicResource ListBoxBackground}"
                            CornerRadius="{DynamicResource CornerRadiusAll}"
                            MinHeight="{TemplateBinding MinHeight}">
                            <ScrollViewer
                                Name="PART_ScrollViewer"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Disabled"
                                Margin="{DynamicResource ListScrollMargin}"
                                ui:ScrollStep.ItemHeight="{DynamicResource ControlHeightMD}"
                                VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter
                                    Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                        </Border>

                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <!--<Style Selector="^:pointerover /template/ Border#outerBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource Grey600Brush}" />
        </Style>-->
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ListBox}" TargetType="ListBox">
        <Setter Property="ItemContainerTheme" Value="{DynamicResource ListBoxItemCMiX}" />
        <!-- A pick in the list must not scroll the list, or the panels around it. -->
        <Setter Property="AutoScrollToSelectedItem" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="Bd"
                    Background="{DynamicResource ListBoxBackground}"
                    CornerRadius="{DynamicResource CornerRadiusAll}">
                    <ScrollViewer
                        Name="PART_ScrollViewer"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Disabled"
                        Margin="{DynamicResource ListScrollMargin}"
                        ui:ScrollStep.ItemHeight="{DynamicResource ControlHeightMD}"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsPresenter
                            Name="PART_ItemsPresenter"
                            ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- The list of ListBoxEditable: dark, with no scroll viewer, as high as its items, and a space
         between the items. The dark is a black with some opacity, so the list is darker than the panel
         behind it, whatever the grey of that panel. The minimum height is computed in ListBoxEditable from the tokens ControlHeightMD, ListEditableVisibleItems,
         ListEditableSpacing and ListEditablePadding. The spacing and the padding below are the same tokens. -->
    <ControlTheme x:Key="ListBoxEditableList" TargetType="ListBox">
        <Setter Property="ItemContainerTheme" Value="{DynamicResource ListBoxItemEditable}" />
        <Setter Property="AutoScrollToSelectedItem" Value="False" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Spacing="{DynamicResource ListEditableSpacing}" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="Bd"
                    Padding="{DynamicResource ListEditablePadding}"
                    Background="{DynamicResource ListBoxBackground}"
                    CornerRadius="{DynamicResource CornerRadiusAll}">
                    <ItemsPresenter
                        Name="PART_ItemsPresenter"
                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- A row of ListBoxEditable. It is exactly as high as its content, so the highlight has the
         size of the content. The space between the rows comes from the items panel of the list.
         A row is transparent, grey when the pointer is over it, and blue when it is selected. -->
    <ControlTheme x:Key="ListBoxItemEditable" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="Bd"
                    Background="Transparent"
                    CornerRadius="{DynamicResource CornerRadiusAll}"
                    TextElement.Foreground="{DynamicResource ForegroundBrush}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:selected:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^:selected:not(:pointerover) /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>
        <Style Selector="^:pointerover:not(:selected) /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Grey400Brush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ListBoxItemCMiX" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="Bd"
                    Background="Transparent"
                    CornerRadius="{DynamicResource CornerRadiusAll}"
                    Margin="1"
                    Padding="2,0,0,0"
                    TextElement.Foreground="{DynamicResource ForegroundBrush}">
                    <ContentPresenter
                        Name="PART_ContentPresenter"
                        Content="{TemplateBinding Content}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:selected:pointerover /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^:selected:not(:pointerover) /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>
        <Style Selector="^:pointerover:not(:selected) /template/ Border#Bd">
            <Setter Property="Background" Value="{DynamicResource Grey400Brush}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
