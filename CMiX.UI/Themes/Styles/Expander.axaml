<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <ControlTheme x:Key="ExpanderDownHeader" TargetType="ToggleButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="mainBorder"
                    Background="{DynamicResource PanelBackground}"
                    Height="{DynamicResource ControlHeightMD}"
                    HorizontalAlignment="Stretch"
                    Margin="8,0"
                    VerticalAlignment="Center">
                    <DockPanel>
                        <ui:Chevron Name="image" IsOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Stretch"
                            Margin="8,0"
                            RecognizesAccessKey="True"
                            VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>

    </ControlTheme>

    <ControlTheme x:Key="{x:Type Expander}" TargetType="Expander">
        <!-- A panel is open when it appears. A binding or a value in the view can still close it. -->
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="Transparent"
                    BorderBrush="{DynamicResource PanelBorderBackground}"
                    BorderThickness="0,1,0,0">
                    <DockPanel>
                        <ToggleButton
                            Name="PART_toggle"
                            Content="{TemplateBinding Header}"
                            DockPanel.Dock="Top"
                            Focusable="False"
                            Foreground="{DynamicResource ForegroundBrush}"
                            HorizontalContentAlignment="Stretch"
                            IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                            Theme="{StaticResource ExpanderDownHeader}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <Border
                            Background="{DynamicResource PanelBackground}"
                            HorizontalAlignment="Stretch">
                            <ui:PanelCollapse IsExpanded="{TemplateBinding IsExpanded}">
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    Focusable="False"
                                    ui:EditCycle.IsLoop="True"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </ui:PanelCollapse>
                        </Border>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:disabled /template/ ToggleButton#PART_toggle">
            <Setter Property="Opacity" Value="{DynamicResource OpacityDisabled}" />
        </Style>    </ControlTheme>

    <ControlTheme x:Key="ExpanderItemHeader" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Grey300Brush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="mainBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource Grey100Brush}"
                    BorderThickness="0,0,0,0"
                    Height="{DynamicResource ControlHeightXL}">
                    <Grid
                        ColumnDefinitions="19,*"
                        Margin="4,0,0,0">
                        <ui:Chevron
                            Name="arrow"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter
                            Name="PART_ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            Margin="4,0,0,0"
                            RecognizesAccessKey="True"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:checked /template/ Border#mainBorder">
            <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusNone}" />
        </Style>
        <Style Selector="^:unchecked /template/ Border#mainBorder">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ExpanderItem" TargetType="Expander">
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Grey300Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="Transparent"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusAll}">
                    <DockPanel>
                        <ToggleButton
                            Name="PART_toggle"
                            Background="{TemplateBinding Background}"
                            Content="{TemplateBinding Header}"
                            DockPanel.Dock="Top"
                            Foreground="{DynamicResource ForegroundBrush}"
                            HorizontalContentAlignment="Left"
                            IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                            Theme="{StaticResource ExpanderItemHeader}"
                            VerticalContentAlignment="Center" />
                        <ui:PanelCollapse IsExpanded="{TemplateBinding IsExpanded}">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Focusable="False"
                                ui:EditCycle.IsLoop="True"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </ui:PanelCollapse>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>


        <Style Selector="^:disabled /template/ ToggleButton#PART_toggle">
            <Setter Property="Opacity" Value="{DynamicResource OpacityDisabled}" />
        </Style>    </ControlTheme>

      <ControlTheme x:Key="ExpanderIndentedHeader" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundLevel1Brush}" />
        <Setter Property="Template">
          <ControlTemplate>
            <Border
                Name="mainBorder"
                Background="{TemplateBinding Background}"
                Height="{DynamicResource ControlHeightXL}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center">
              <DockPanel >
                <ui:Chevron Name="image" Margin="4,0" IsOpen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" />
                <ContentPresenter
                    Name="PART_ContentPresenter"
                    Content="{TemplateBinding Content}"
                    ContentTemplate="{TemplateBinding ContentTemplate}"
                    HorizontalAlignment="Stretch"
                    Margin="0,0"
                    RecognizesAccessKey="True"
                    VerticalAlignment="Center" />
              </DockPanel>
            </Border>
          </ControlTemplate>
        </Setter>

      </ControlTheme>

  <ControlTheme x:Key="{x:Type ui:ExpanderIndented}" TargetType="ui:ExpanderIndented">
    <!-- Open by default, as Expander is. A section that starts closed sets IsExpanded to False itself. -->
    <Setter Property="IsExpanded" Value="True" />
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundLevel1Brush}" />
    <!-- CHANGED: was Transparent -->
    <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <!-- The expander is a card: rounded corners and a little space around it. -->
    <Setter Property="Margin" Value="{DynamicResource MarginCard}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border
            CornerRadius="{DynamicResource CornerRadiusAll}"
            ui:RoundedClip.CornerRadius="{DynamicResource CornerRadiusAll}">
          <Border Background="Transparent">
            <DockPanel>
              <ToggleButton
                  Name="PART_toggle"
                  Margin="{TemplateBinding IndentationMargin}"
                  Background="{TemplateBinding Background}"                       
                  Content="{TemplateBinding Header}"
                  DockPanel.Dock="Top"
                  Foreground="{DynamicResource ForegroundBrush}"
                  HorizontalContentAlignment="Stretch"
                  IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                  Theme="{StaticResource ExpanderIndentedHeader}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              <Border
                  Name="contentBackground"
                  Background="{TemplateBinding Background}"
                  HorizontalAlignment="Stretch">
                <ui:PanelCollapse IsExpanded="{TemplateBinding IsExpanded}">
                  <ContentPresenter
                      Name="PART_ContentPresenter"
                      Content="{TemplateBinding Content}"
                      ContentTemplate="{TemplateBinding ContentTemplate}"
                      Focusable="False"
                      ui:EditCycle.IsLoop="True"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                </ui:PanelCollapse>
              </Border>
            </DockPanel>
          </Border>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
