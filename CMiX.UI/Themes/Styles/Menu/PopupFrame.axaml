<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <ControlTheme x:Key="{x:Type ui:PopupFrame}" TargetType="ui:PopupFrame">
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Background="Transparent"
                    Effect="{DynamicResource DropShadowWindow}"
                    Padding="8">

                    <Panel MinWidth="{TemplateBinding PanelMinWidth}">
                        <Border
                            Background="{DynamicResource Grey200Brush}"
                            CornerRadius="{DynamicResource CornerRadiusLargeAll}"
                            Opacity="0.9"
                            Padding="0" />

                        <Border Padding="8">
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>

                    </Panel>

                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
