<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://CMiX.UI/Themes/Tokens/Converters.axaml" />
    </ResourceDictionary.MergedDictionaries>

    <ControlTheme x:Key="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type Button}}" TargetType="ToggleButton">
        <Style Selector="^:checked:not(:pointerover) /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>

        <Style Selector="^:checked:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="^:unchecked:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey700Brush}" />
        </Style>

        <Style Selector="^:unchecked:not(:pointerover) /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        </Style>
    </ControlTheme>

    <ControlTheme
        x:Key="ToggleButtonRounded"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="(ui:PositionedControl.Position)" Value="All" />
    </ControlTheme>

    <ControlTheme
        x:Key="ToggleButtonRoundedLeft"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="(ui:PositionedControl.Position)" Value="Left" />
    </ControlTheme>

    <ControlTheme x:Key="ToggleButtonCheckBox" TargetType="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="(ui:PositionedControl.Position)" Value="All" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>

                <Border
                    Name="border"
                    Padding="4"
                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{DynamicResource CornerRadiusAll}">

                    <ui:AppIcon 
                        Name="icon" 
                        IconKey="IsChecked" 
                        Size="{DynamicResource IconSizeXS}" />

                </Border>

            </ControlTemplate>
        </Setter>

        <Style Selector="^:pressed /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey700Brush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#border">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <Style Selector="^:checked:not(:pointerover) /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>
        <Style Selector="^:checked:not(:pointerover) /template/ ui|AppIcon#icon">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:checked:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="^:checked:pointerover /template/ ui|AppIcon#icon">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:unchecked:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        </Style>
        <Style Selector="^:unchecked:pointerover /template/ ui|AppIcon#icon">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="^:unchecked:not(:pointerover) /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        </Style>
        <Style Selector="^:unchecked:not(:pointerover) /template/ ui|AppIcon#icon">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </ControlTheme>

    <ControlTheme
        x:Key="ToggleButtonIcon"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusAll}" />
        <Setter Property="Content" Value="" />
        <Style Selector="^:checked">
            <Setter Property="Content">
                <Template>
                    <ui:AppIcon
                        Margin="2"
                        Opacity="0.75"
                        IconKey="IsChecked"
                        Size="{DynamicResource IconSizeXS}" />
                </Template>
            </Setter>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ToggleButtonVisibility" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightXS}" />
        <Setter Property="Width" Value="{DynamicResource ControlHeightXS}" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Margin="0"
                    Padding="1"
                    Background="Transparent"
                    Opacity="0.6">
                    <ui:AppIcon Name="image" IconKey="Visible" Size="{DynamicResource IconSizeXS}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:checked /template/ ui|AppIcon#image">
            <Setter Property="IconKey" Value="NotVisible" />
        </Style>

        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
    </ControlTheme>

    <!-- An on and off switch for a panel or a part. The icon is dim while off and lit while on. -->
    <ControlTheme x:Key="ToggleButtonPower" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightXS}" />
        <Setter Property="Width" Value="{DynamicResource ControlHeightXS}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Margin="0"
                    Padding="1"
                    Background="Transparent"
                    Opacity="0.4">
                    <ui:AppIcon Name="icon" IconKey="Power" Size="{DynamicResource IconSizeXS}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style Selector="^:checked /template/ Border#border">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="^:checked /template/ ui|AppIcon#icon">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ToggleButtonPlayPause" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Margin="0"
                    Padding="1"
                    Background="Transparent"
                    Opacity="0.6">
                    <ui:AppIcon Name="image" IconKey="Play" Size="{DynamicResource IconSizeXS}" />
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:checked /template/ ui|AppIcon#image">
            <Setter Property="IconKey" Value="Stop" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ToggleButtonPopup" TargetType="ToggleButton">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border
                    Name="border"
                    Background="{DynamicResource Grey500Brush}"
                    CornerRadius="{DynamicResource CornerRadiusLeft}">
                    <Grid>
                        <TextBlock DockPanel.Dock="Left" Padding="8,4,4,4" Text="+" />
                        <TextBlock HorizontalAlignment="Center" Padding="8,4,4,4" Text="{TemplateBinding Content}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        </Style>

        <Style Selector="^:checked /template/ Border#border">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Path#arrow">
            <Setter Property="Opacity" Value="1.0" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="ToggleButtonInlineLeft"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="(ui:PositionedControl.Position)" Value="Left" />
    </ControlTheme>

    <ControlTheme x:Key="ToggleButtonInlineCenter"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="(ui:PositionedControl.Position)" Value="None" />
    </ControlTheme>

    <ControlTheme x:Key="ToggleButtonInlineRight"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="ToggleButton">
        <Setter Property="(ui:PositionedControl.Position)" Value="Right" />
    </ControlTheme>

    <!-- The box in the value column and the Caption beside it. The box reacts to its own hover. -->
    <ControlTheme x:Key="{x:Type ui:ToggleButtonCaptioned}" TargetType="ui:ToggleButtonCaptioned">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="40*,60*">
                    <DockPanel
                        Grid.Column="1"
                        Background="Transparent">
                        <Border
                            Name="box"
                            Width="{DynamicResource ControlHeightXS}"
                            Height="{DynamicResource ControlHeightXS}"
                            Padding="4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource Grey500Brush}"
                            CornerRadius="{DynamicResource CornerRadiusAll}">
                            <ui:AppIcon
                                Name="icon"
                                IconKey="IsChecked"
                                Size="{DynamicResource IconSizeXS}" />
                        </Border>
                        <TextBlock
                            Padding="4,0"
                            HorizontalAlignment="Left"
                            Foreground="{TemplateBinding Foreground}"
                            Text="{TemplateBinding Caption}" />
                    </DockPanel>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:pressed /template/ Border#box">
            <Setter Property="Background" Value="{DynamicResource Grey700Brush}" />
        </Style>

        <Style Selector="^:disabled /template/ Border#box">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <Style Selector="^:checked /template/ Border#box:not(:pointerover)">
            <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        </Style>
        <Style Selector="^:checked /template/ Border#box:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^:checked /template/ ui|AppIcon#icon">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:unchecked /template/ Border#box:pointerover">
            <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        </Style>
        <Style Selector="^:unchecked /template/ Border#box:not(:pointerover)">
            <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        </Style>
        <Style Selector="^:unchecked /template/ ui|AppIcon#icon">
            <Setter Property="Opacity" Value="0" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
