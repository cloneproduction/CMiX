<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <ControlTheme x:Key="RepeatButtonDecrease" TargetType="RepeatButton">
        <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="RepeatButtonIncrease" TargetType="RepeatButton">
        <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ui:SliderCMiX}" TargetType="ui:SliderCMiX">
        <Setter Property="(ui:MouseDown.IsEnabled)" Value="True" />
        <Setter Property="(ui:PositionedControl.Position)" Value="All" />
        <Setter Property="Caption" Value="" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>

                    <ContentPresenter
                        Content="{TemplateBinding TrailingContent}"
                        DockPanel.Dock="Right" />

                    <Border
                        Name="mainBorder"
                        IsEnabled="{Binding !IsReadOnly, RelativeSource={RelativeSource TemplatedParent}}">
                        <Panel>

                            <Border
                                Name="sliderBorder"
                                ui:RoundedClip.CornerRadius="{Binding (ui:PositionedControl.Position), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource PositionToCornerRadius}}"
                                Background="Transparent"
                                IsVisible="{Binding !IsEditing, RelativeSource={RelativeSource TemplatedParent}}">
                                <Track
                                    Name="PART_Track"
                                    IsDirectionReversed="{TemplateBinding IsDirectionReversed}"
                                    Orientation="Horizontal">
                                    <Track.DecreaseButton>
                                        <RepeatButton
                                            Name="PART_DecreaseButton"
                                            Theme="{StaticResource RepeatButtonDecrease}" />
                                    </Track.DecreaseButton>
                                    <Track.IncreaseButton>
                                        <RepeatButton
                                            Name="PART_IncreaseButton"
                                            Theme="{StaticResource RepeatButtonIncrease}" />
                                    </Track.IncreaseButton>
                                    <Thumb Name="thumb" Width="0">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Border />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track>
                            </Border>

                            <TextBlock
                                Name="sliderName"
                                HorizontalAlignment="Left"
                                IsHitTestVisible="False"
                                IsVisible="{Binding !IsEditing, RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="8,0"
                                Text="{TemplateBinding Caption}"
                                VerticalAlignment="Center" />

                            <Label
                                Name="textDisplay"
                                Content="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource DoubleToString}, StringFormat='{}{0:0.000}'}"
                                HorizontalAlignment="Right"
                                IsHitTestVisible="False"
                                IsVisible="{Binding !IsEditing, RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="0,0,8,0"
                                VerticalAlignment="Center" />

                            <ui:NumericInput
                                Name="textInput"
                                Height="{Binding Bounds.Height, RelativeSource={RelativeSource TemplatedParent}}"
                                IsEditing="{Binding IsEditing, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Maximum="{TemplateBinding Maximum}"
                                Minimum="{TemplateBinding Minimum}"
                                Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                        </Panel>
                    </Border>

                </DockPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Track#PART_Track">
            <Setter Property="Minimum" Value="{TemplateBinding Minimum}" />
            <Setter Property="Maximum" Value="{TemplateBinding Maximum}" />
            <Setter Property="Value" Value="{TemplateBinding Value, Mode=TwoWay}" />
        </Style>

        <!-- The pointer must be over the slider body, mainBorder. The trailing content is outside it, so hovering the
             trailing content does not light the track. -->
        <Style Selector="^ /template/ Border#mainBorder:pointerover RepeatButton#PART_DecreaseButton">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="^ /template/ Border#mainBorder:pointerover RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
        </Style>

        <Style Selector="^ /template/ Border#mainBorder:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>

        <Style Selector="^:pressed /template/ RepeatButton#PART_IncreaseButton">
            <Setter Property="Background" Value="{DynamicResource Grey100Brush}" />
        </Style>

    </ControlTheme>

</ResourceDictionary>