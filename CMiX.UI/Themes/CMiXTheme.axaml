<Styles
    x:Class="CMiX.UI.CMiXTheme"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Selector based styles for non templated elements. -->
    <StyleInclude Source="avares://CMiX.UI/Themes/Styles/Border.axaml" />
    <StyleInclude Source="avares://CMiX.UI/Themes/Styles/TextBlock.axaml" />

    <!-- Selector based styles that read nesting depth from the control tree. -->
    <StyleInclude Source="avares://CMiX.UI/Themes/Styles/ExpanderIndentedDepth.axaml" />

    <!-- Control themes, merged in dependency order so StaticResource BasedOn references resolve. -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CMiX.UI/Themes/Tokens/Tokens.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/ScrollViewer.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/ToolTip.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/Label.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/ContentCaptioned.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/Button.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/ToggleButton.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/RadioButton.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/TextBox.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/ListBox.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/ComboBox.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/Menu/PopupFrame.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/Menu/Menu.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/Menu/ContextMenu.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/Tab.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/Expander.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/GridSplitter.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/NumericInput.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/DragValue.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/Sliders/Slider.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/Sliders/ColorPickerWheel.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/IconButton.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/Windows/Window.axaml" />
                <ResourceInclude Source="avares://CMiX.UI/Themes/Styles/Menu/PopupFlyout.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

</Styles>
