<UserControl x:Class="CMiX.Studio.Views.TextureFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
             xmlns:ViewModels="clr-namespace:CMiX.Core.Presentations.ViewModels;assembly=CMiX.Core"
             xmlns:Filters="clr-namespace:CMiX.Studio.Views"
             xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
             xmlns:dd="urn:gong-wpf-dragdrop"
             x:Name="textureFilterManager"
             mc:Ignorable="d" 
             d:DesignHeight="259.434" d:DesignWidth="313.836">

    <StackPanel Margin="8, 6">

        <ToggleButton 
            x:Name="PopUpToggle" 
            Content="Add Filter"
            Height="22" 
            Margin="0, 4"
            Background="{DynamicResource DarkerColor}" 
            Style="{StaticResource ToggleTransformModifierMenu}"/>

        <Popup
            AllowsTransparency="True"
            Behaviors:ClosePopupBehavior.PopupContainer="{Binding ElementName=textureFilterManager}"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=PopUpToggle}"
            FlowDirection="LeftToRight"
            IsOpen="{Binding IsChecked, ElementName=PopUpToggle}">

            <Border 
                BorderThickness="1, 0, 1, 2"
                BorderBrush="{DynamicResource Shadow}"
                CornerRadius="{DynamicResource CornerRadiusBottom}" 
                Padding="2, 0, 2, 2"
                Background="{DynamicResource HighHighDarkerColor}">

                <Grid Margin="4">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:HSCB}" 
                            Grid.Column="0"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="HSCB"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Invert}" 
                            Grid.Column="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Invert"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:TriColor}" 
                            Grid.Column="1"
                            Grid.Row="2"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="TriColor"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Edge}" 
                            Grid.Column="0"
                            Grid.Row="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Edge"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:TransformTexture}" 
                            Grid.Column="1"
                            Grid.Row="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Transform"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:RandomUV}" 
                            Grid.Column="1"
                            Grid.Row="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Random UV"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:LFOUV}" 
                            Grid.Column="1"
                            Grid.Row="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="LFO UV"/>
                        
                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Pixelate}" 
                            Grid.Column="2"
                            Grid.Row="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Pixelate"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Blur}" 
                            Grid.Column="2"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Blur"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Echo}" 
                            Grid.Column="2"
                            Grid.Row="2"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Echo"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Feedback}" 
                            Grid.Column="2"
                            Grid.Row="3"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Feedback"/>
                        
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <ItemsControl 
            AllowDrop="True"
            dd:DragDrop.IsDragSource="True"
            dd:DragDrop.IsDropTarget="True"
            dd:DragDrop.DragHandler="{Binding}"
            dd:DragDrop.DropHandler="{Binding}"
            ItemsSource="{Binding Modifiers}">
            
            <ItemsControl.Resources>
                
                <DataTemplate DataType="{x:Type ViewModels:HSCB}">
                    <Filters:HSCB DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:Invert}">
                    <Filters:Invert DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:Blur}">
                    <Filters:Blur DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:Edge}">
                    <Filters:Edge DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:TransformTexture}">
                    <Filters:TransformTexture DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:Pixelate}">
                    <Filters:Pixelate DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:Echo}">
                    <Filters:Echo DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:Feedback}">
                    <Filters:Feedback DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:TriColor}">
                    <Filters:TriColor DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:RandomUV}">
                    <Filters:RandomUV DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:LFOUV}">
                    <Filters:LFOUV DataContext="{Binding}"/>
                </DataTemplate>
                
            </ItemsControl.Resources>
            
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Panels:ModifierPanel 
                        Margin="0, 4"
                        DragHandlerIsPressed="{Binding DataContext.DragHandlerIsPressed, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CloseModifierCommand="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CloseModifierCommandParameter="{Binding}">
                        <ContentPresenter Content="{Binding}"/>
                    </Panels:ModifierPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            
        </ItemsControl>
    </StackPanel>
</UserControl>
