<UserControl
    x:Class="CMiX.Studio.Views.Texture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:TextureSource="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    d:DesignHeight="453.334"
    d:DesignWidth="340.667"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControls:ComboBox
            Margin="8, 8, 8, 0"
            Caption="Type"
            SelectedItem="{Binding ProceduralSelector.ProceduralName.Value, Converter={StaticResource EnumToString}}"
            ItemsSource="{Binding Source={StaticResource TextureSourceName}}"/>

        <Grid Margin="8">

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProceduralSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Image}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Views:PathSelector 
                    ItemsSource="{Binding Path=DataContext.AssetManager.ImageAssets, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                    SelectedItem="{Binding ImageSelector.SelectedAsset}"/>

            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProceduralSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Video}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <Views:PathSelector 
                            SelectedItem="{Binding SelectedAsset}"
                            ItemsSource="{Binding Path=DataContext.AssetManager.VideoAssets, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Grid.Column="1"
                            Height="22"/>

                    <Views:VideoPlayer Margin="0, 8, 0, 0" DataContext="{Binding VideoPlayer}"/>
                    
                </StackPanel>
            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProceduralSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Text}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Views:TypeWriter DataContext="{Binding TypeWriter}"/>

            </Border>


            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProceduralSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Input}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Views:VideoIn DataContext="{Binding VideoIn}"/>

            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProceduralSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Gradient}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Views:Gradient DataContext="{Binding ProceduralSelector.Gradient}"/>

            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProceduralSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.BubbleNoise}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Views:BubbleNoise DataContext="{Binding ProceduralSelector.BubbleNoise}"/>

            </Border>
        </Grid>

        <Panels:IndentedExpander Indentation="24" Header="Transform">
            <Views:TransformTexture DataContext="{Binding TransformTexture}"/>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Indentation="24" Header="Filter">
            <Views:TextureFilter DataContext="{Binding TextureModifierManager}"/>
        </Panels:IndentedExpander>

    </StackPanel>

</UserControl>