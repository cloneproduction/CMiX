<UserControl x:Class="CMiX.Studio.Views.EntityModifierSelectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ViewModels="clr-namespace:CMiX.Core.Presentations.ViewModels;assembly=CMiX.Core"
             xmlns:ColorModifiers="clr-namespace:CMiX.Core.Presentations.Modifiers.Color;assembly=CMiX.Core"
             xmlns:TransformModifiers="clr-namespace:CMiX.Core.Presentations.Modifiers.Transform;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid Margin="4, 8">

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">

            <TextBlock Margin="8, 8" Text="Coloration" Foreground="{DynamicResource LightColor}"/>
            <Border Margin="0" BorderBrush="{DynamicResource DarkerColor}" BorderThickness="0, 0, 0, 1"/>
            <Button 
                Style="{StaticResource ButtonItemControl}"
                Command="{Binding CreateCommand}" 
                CommandParameter="{x:Type ColorModifiers:RandomHSV}" 
                Grid.Row="2"
                Grid.Column="1"
                VerticalAlignment="Center" 
                Width="120" 
                Height="22" 
                Content="Random HSV"/>

        </StackPanel>

        <StackPanel Grid.Column="1">
            
            <TextBlock Margin="8, 8" Text="Transforms" Foreground="{DynamicResource LightColor}"/>
            <Border Margin="0" BorderBrush="{DynamicResource DarkerColor}" BorderThickness="0, 0, 0, 1"/>


            <Button 
                Style="{StaticResource ButtonItemControl}"
                Command="{Binding CreateCommand}" 
                CommandParameter="{x:Type ViewModels:TransformSRT}" 
                Grid.Row="2"
                Grid.Column="1"
                VerticalAlignment="Center" 
                Width="120" 
                Height="22" 
                Content="Transform XYZ"/>

            <Button 
                Style="{StaticResource ButtonItemControl}"
                Command="{Binding CreateCommand}" 
                CommandParameter="{x:Type ViewModels:Translate}" 
                Grid.Row="1"
                Grid.Column="1"
                VerticalAlignment="Center" 
                Width="120" 
                Height="22" 
                Content="Translate XYZ"/>

            <Button 
                Style="{StaticResource ButtonItemControl}"
                Command="{Binding CreateCommand}" 
                CommandParameter="{x:Type ViewModels:Scale}" 
                Grid.Row="1"
                Grid.Column="2"
                VerticalAlignment="Center" 
                Width="120" 
                Height="22" 
                Content="Scale XYZ"/>

            <Button 
                Style="{StaticResource ButtonItemControl}"
                Command="{Binding CreateCommand}" 
                CommandParameter="{x:Type ViewModels:Rotation}" 
                Grid.Row="2"
                Grid.Column="0"
                VerticalAlignment="Center" 
                Width="120" 
                Height="22" 
                Content="Rotate XYZ"/>

            <Button 
                Style="{StaticResource ButtonItemControl}"
                Command="{Binding CreateCommand}" 
                CommandParameter="{x:Type ViewModels:RandomXYZ}" 
                Grid.Column="1"
                VerticalAlignment="Center" 
                Width="120" 
                Height="22" 
                Content="RandomXYZ"/>

            <Button 
                Style="{StaticResource ButtonItemControl}"
                Command="{Binding CreateCommand}" 
                CommandParameter="{x:Type ViewModels:RandomScale}" 
                Grid.Row="1"
                Grid.Column="0"
                VerticalAlignment="Center" 
                Width="120" 
                Height="22" 
                Content="Random Scale"/>

        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock Margin="8, 8" Text="" Foreground="{DynamicResource LightColor}"/>
            <Border Margin="0" BorderBrush="{DynamicResource DarkerColor}" BorderThickness="0, 0, 0, 1"/>
            
            <Button 
                Style="{StaticResource ButtonItemControl}"
                Command="{Binding CreateCommand}" 
                CommandParameter="{x:Type ViewModels:LinearXYZ}" 
                Grid.Column="0"
                VerticalAlignment="Center" 
                Width="120" 
                Height="22" 
                Content="LinearXYZ"/>

            <Button 
                Style="{StaticResource ButtonItemControl}"
                Command="{Binding CreateCommand}" 
                CommandParameter="{x:Type ViewModels:LFO}" 
                Grid.Column="2"
                VerticalAlignment="Center" 
                Width="120" 
                Height="22" 
                Content="LFO"/>

            <Button 
                Style="{StaticResource ButtonItemControl}"
                Command="{Binding CreateCommand}" 
                CommandParameter="{x:Type ViewModels:Stepper}" 
                Grid.Column="2"
                VerticalAlignment="Center" 
                Width="120" 
                Height="22" 
                Content="Stepper"/>

        </StackPanel>
    </Grid>
</UserControl>
