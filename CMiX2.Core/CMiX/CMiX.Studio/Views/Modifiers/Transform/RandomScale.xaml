<UserControl x:Class="CMiX.Studio.Views.RandomScale"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="548" d:DesignWidth="461.333">

    <StackPanel>
        <StackPanel Margin="8">
            
            <BaseControls:ComboBox
                Caption="Type"
                SelectedItem="{Binding Mode.Value}"
                ItemsSource="{Binding Source={StaticResource ModifierMode}}"/>

            <BaseControls:IntegerValue 
                Caption="Count"
                Margin="0, 8"
                Value="{Binding Counter.Value}"/>

            <Views:BeatModifier 
                DataContext="{Binding BeatModifier}"/>

            <BaseControls:DragValue 
                Margin="0, 8"
                Caption="Uniform" 
                Value="{Binding UniformXYZ.Value}"/>

            <BaseControls:VectorXYZ 
                Caption="Scale"
                DataContext="{Binding Scale}"/>

        </StackPanel>

        <Views:Easing DataContext="{Binding Easing}"/>

    </StackPanel>

</UserControl>
