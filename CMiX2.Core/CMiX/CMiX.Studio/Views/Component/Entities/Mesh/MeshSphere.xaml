<UserControl x:Class="CMiX.Studio.Views.MeshSphere"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <StackPanel>
        
        <BaseControl:VectorXYZ Caption="Scale" DataContext="{Binding Scale}"/>
        <BaseControl:VectorXYZ Caption="Offset" Margin="0, 8" DataContext="{Binding Offset}"/>
        <BaseControl:DragValue Caption="Radius" Value="{Binding Radius.Value}"/>
        <BaseControl:IntegerValue Caption="Tessellation" Margin="0, 8, 0, 0" Value="{Binding Tessellation.Value}"/>
        
    </StackPanel>
    
</UserControl>
