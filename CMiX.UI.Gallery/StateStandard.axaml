<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="https://github.com/cloneproduction/CMiX.UI">

    <!-- The proposed standard. It applies only inside a section that has the class "standard", so the window can
         switch it on and off. The brushes are resources of the window and can be changed while it runs.
         Surface controls: StateIdleBrush, then StateHoverBrush, then StatePressedBrush. The on state is unchanged
         (accent-inactive, and accent under the pointer). Rows: transparent, then RowHoverBrush. -->

    <!-- Button -->
    <Style Selector=".surface.standard Button /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
    </Style>
    <Style Selector=".surface.standard Button:pointerover /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector=".surface.standard Button:pressed /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    </Style>

    <!-- ToggleButton, off -->
    <Style Selector=".surface.standard ToggleButton:unchecked:not(:pointerover) /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
    </Style>
    <Style Selector=".surface.standard ToggleButton:unchecked:pointerover /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector=".surface.standard ToggleButton:unchecked:pressed /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    </Style>

    <!-- Box toggle, off -->
    <Style Selector=".surface.standard ToggleButton:unchecked /template/ Border#box:not(:pointerover)">
        <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
    </Style>
    <Style Selector=".surface.standard ToggleButton:unchecked /template/ Border#box:pointerover">
        <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector=".surface.standard ToggleButton:unchecked:pressed /template/ Border#box">
        <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    </Style>

    <!-- ComboBox -->
    <Style Selector=".surface.standard ComboBox">
        <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
    </Style>
    <Style Selector=".surface.standard ComboBox /template/ ToggleButton#toggle:pointerover:not(:checked) /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>
    <Style Selector=".surface.standard ComboBox /template/ ToggleButton#toggle:pressed:not(:checked) /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource StatePressedBrush}" />
    </Style>

    <!-- DragValue -->
    <Style Selector=".surface.standard ui|DragValue /template/ Border#borderValueDisplay">
        <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
    </Style>
    <Style Selector=".surface.standard ui|DragValue /template/ Border#borderValueDisplay:pointerover">
        <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>

    <!-- Slider: the part after the thumb -->
    <Style Selector=".surface.standard ui|SliderCMiX /template/ RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource StateIdleBrush}" />
    </Style>
    <Style Selector=".surface.standard ui|SliderCMiX /template/ Border#mainBorder:pointerover RepeatButton#PART_IncreaseButton">
        <Setter Property="Background" Value="{DynamicResource StateHoverBrush}" />
    </Style>

    <!-- Rows -->
    <Style Selector=".row.standard ListBoxItem:pointerover:not(:selected) /template/ Border#Bd">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector=".row.standard ComboBoxItem:pointerover:not(:selected) /template/ Border#border">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>

    <!-- Tabs, first proposal: they are rows. -->
    <Style Selector=".tabrow.standard TabItem:selected /template/ Border#mainBorder">
        <Setter Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
    </Style>
    <Style Selector=".tabrow.standard TabItem:not(:selected):pointerover /template/ Border#mainBorder">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector=".tabrow.standard TabItem:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Tabs, second proposal: they are icon toggles. The icon is dim, lit under the pointer and when selected. -->
    <Style Selector=".tabicon.standard TabItem /template/ Border#mainBorder">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector=".tabicon.standard TabItem:selected /template/ Border#mainBorder">
        <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
    </Style>
    <Style Selector=".tabicon.standard TabItem:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector=".tabicon.standard TabItem:not(:selected):pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="1" />
    </Style>

</Styles>
