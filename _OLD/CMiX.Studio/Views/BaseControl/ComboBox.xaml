<UserControl x:Class="CMiX.Studio.Views.BaseControl.ComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
             mc:Ignorable="d" 
             x:Name="comboBox"
             d:DesignHeight="39.333" d:DesignWidth="294.667">


    <Grid Height="22">

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock 
            Text="{Binding Caption, ElementName=comboBox}" 
            HorizontalAlignment="Right" 
            VerticalAlignment="Center" 
            Margin="8, 0" 
            Foreground="{DynamicResource TextBase}"/>

        <Border
            x:Name="mask" 
            Grid.Column="1" 
            Background="{DynamicResource DarkColor}" 
            Style="{StaticResource BorderMask}"
            AttachedProperties:PositionedControl.Position="{Binding Path=Position, ElementName=comboBox}"/>

        <Border 
            x:Name="mainBorder" 
            Grid.Column="1" 
            BorderBrush="Transparent" 
            Background="{DynamicResource DarkColor}">

            <Border.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=mask}"/>
            </Border.OpacityMask>

            <ComboBox 
                Grid.Column="1" 
                SelectedItem="{Binding SelectedItem, ElementName=comboBox}"
                ItemsSource="{Binding ItemsSource, ElementName=comboBox}"/>

        </Border>

    </Grid>

</UserControl>
