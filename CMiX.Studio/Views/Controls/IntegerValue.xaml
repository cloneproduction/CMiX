<UserControl
    x:Class="CMiX.Studio.Views.Controls.IntegerValue"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
    x:Name="counter"
    d:DesignHeight="31.222"
    d:DesignWidth="665.444"
    Background="Transparent"
    ContextMenu="{DynamicResource connectionButtonContext}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ContextMenu x:Key="connectionButtonContext" StaysOpen="true">
            <MenuItem
                Command="{Binding ResetCommand}"
                CommandTarget="{Binding Path=PlacementTarget, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}"
                Header="Reset" />
        </ContextMenu>
    </UserControl.Resources>


    <BaseControl:DragValue
        AttachedProperties:PositionedControl.Position="{Binding Path=(AttachedProperties:PositionedControl.Position), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
        Caption="{Binding Caption, ElementName=counter}"
        IsInteger="True"
        Minimum="{Binding Minimum, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
        Maximum="{Binding Maximum, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
        LargeChange="1.0"
        SmallChange="1.0"
        Value="{Binding Value, ElementName=counter}" />

</UserControl>
