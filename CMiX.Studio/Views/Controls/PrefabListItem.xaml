<UserControl
    x:Class="CMiX.Studio.Views.Controls.PrefabListItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="uc"
    mc:Ignorable="d" d:DesignHeight="16.835" d:DesignWidth="109.608">

    <DockPanel>
        <Image
            Width="12"
            Height="12"
            Margin="4, 0"
            Opacity="0.7"
            Source="{Binding Icon, ElementName=uc}" />
        <ToggleButton
            Margin="4, 0"
            DockPanel.Dock="Right"
            IsChecked="{Binding PrefabService.Visibility.Value}"
            Style="{DynamicResource ToggleVisibility}" />
        <Controls:EditableTextBox
            Text="{Binding Path=PrefabService.Name.Value}" />
    </DockPanel>

</UserControl>