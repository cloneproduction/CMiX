<UserControl x:Class="CMiX.Studio.Views.Easing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:ViewModels="clr-namespace:CMiX.Core.Presentation.ViewModels;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    
    <UserControl.Resources>
        
        <ObjectDataProvider x:Key="EasingFunction" MethodName="GetValues" ObjectType="{x:Type ViewModels:EasingFunction}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ViewModels:EasingFunction"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="EasingMode" MethodName="GetValues" ObjectType="{x:Type ViewModels:EasingMode}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ViewModels:EasingMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        
    </UserControl.Resources>
    
    
    <Expander>
        <Expander.Header>
            <DockPanel>
                <Controls:CMiXToggleButton
                    Style="{DynamicResource CMiXToggleButtonStyle}"
                    Dock="Left"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsEnabled}"/>
                <TextBlock Text="Easing" Foreground="{DynamicResource TextBase}"/>
            </DockPanel>
        </Expander.Header>
        
        <StackPanel Margin="8" IsEnabled="{Binding IsEnabled}">
            
            <Grid Height="20" Margin="0, 0, 0, 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                    Text="Function" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center" 
                    Padding="4" 
                    Foreground="{DynamicResource TextBase}"/>
                <ComboBox 
                    Grid.Column="1" 
                    SelectedItem="{Binding EasingFunction}"
                    ItemsSource="{Binding Source={StaticResource EasingFunction}}"/>
            </Grid>
            
            <Grid Height="20" Margin="0, 0, 0, 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                    Text="Mode" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center" 
                    Padding="4" 
                    Foreground="{DynamicResource TextBase}"/>
                <ComboBox 
                    Grid.Column="1" 
                    SelectedItem="{Binding EasingMode}"
                    ItemsSource="{Binding Source={StaticResource EasingMode}}"/>
            </Grid>
            
        </StackPanel>
        
    </Expander>
</UserControl>
