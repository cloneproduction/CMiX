<UserControl
    x:Class="CMiX.Studio.Views.BeatModifierManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel>
        <Views:Outliner DataContext="{Binding}" ItemsSource="{Binding ControlRepository.BeatModifiers}">
            <Views:Outliner.SelectionPanel>
                <Button
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{x:Type Animations:BeatModifier}"
                    Content="New"
                    Style="{DynamicResource ButtonRoundedRight}" />
            </Views:Outliner.SelectionPanel>
        </Views:Outliner>

        <Border Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
            <Views:BeatModifier Margin="-8,0,-8,-8" DataContext="{Binding SelectedItem}" />
        </Border>
    </StackPanel>
</UserControl>
