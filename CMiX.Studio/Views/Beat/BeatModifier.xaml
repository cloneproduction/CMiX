<UserControl
    x:Class="CMiX.Studio.Views.BeatModifier"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="149.292"
    d:DesignWidth="358.48"
    mc:Ignorable="d">

    <StackPanel>

        <Views:BeatControls Margin="8,8,8,0" DataContext="{Binding}" />

        <Grid Margin="8,0,8,8">

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <BaseControls:CMiXSlider
                Grid.Column="1"
                Margin="0,1,0,0"
                Caption="Chance To Hit"
                Maximum="1"
                Position="Bottom"
                Value="{Binding ChanceToHit.Value}" />
        </Grid>

        <Views:Easing DataContext="{Binding Easing}" />
    </StackPanel>
</UserControl>
