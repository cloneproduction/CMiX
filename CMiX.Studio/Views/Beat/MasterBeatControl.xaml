<UserControl
    x:Class="CMiX.Studio.Views.Beat.MasterBeatControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="80.999"
    d:DesignWidth="934.667"
    mc:Ignorable="d">

    <DockPanel Grid.Column="1">

        <Button
            Margin="2, 0, 0, 0"
            Background="Transparent"
            Style="{StaticResource ButtonRounded}"
            Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}"
            Command="{Binding Resync.ClickCommand}"
            DockPanel.Dock="Right">
            <Button.Content>
                <Image Margin="16" Source="{StaticResource Reset}"/>
            </Button.Content>
        </Button>

        <ToggleButton
            Background="Transparent"
            Style="{StaticResource ToggleButtonRounded}"
            Margin="2, 0"
            Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}"
            IsChecked="{Binding Pause.IsChecked}"
            Content="P"
            DockPanel.Dock="Right"/>

        <Button
            Margin="2, 0"
            Background="Transparent"
            Style="{StaticResource ButtonRounded}"
            Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}"
            Command="{Binding MultiplyCommand}"
            Content="+"
            DockPanel.Dock="Right"/>

        <Button
            Background="Transparent"
            Margin="2, 0"
            Style="{StaticResource ButtonRounded}"
            Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}"
            Command="{Binding DivideCommand}"
            Content="-"
            DockPanel.Dock="Right"/>



        <Grid Margin="2, 0"                                 >
            <Border 
                CornerRadius="2"
                Background="{DynamicResource Color}"
                Opacity="{Binding AnimatedDouble.AnimationPosition}"/>
            <Button
                Margin="2, 0"
                HorizontalAlignment="Stretch"
                DockPanel.Dock="Right"
                Background="Transparent"
                Style="{StaticResource ButtonRounded}"
                Command="{Binding TapCommand}"
                Content="{Binding Period.Value, Converter={StaticResource PeriodToBPM}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}"/>
        </Grid>

    </DockPanel>

</UserControl>