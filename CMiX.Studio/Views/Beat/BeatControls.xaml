<UserControl
    x:Class="CMiX.Studio.Views.BeatControls"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="46.5"
    d:DesignWidth="226.667"
    mc:Ignorable="d">

    <Grid Height="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock
            Margin="8,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Text="Beat" />
        <Border
            x:Name="MainBorder"
            Grid.Column="1"
            Background="{DynamicResource DarkColor}"
            CornerRadius="2, 2, 0, 0">
            <Grid>
                <Border Background="{DynamicResource LightColor}" CornerRadius="2, 2, 0, 0">

                    <Border.Opacity>
                        <MultiBinding Converter="{StaticResource MultiPeriodToBeatAnimation}" UpdateSourceTrigger="PropertyChanged">
                            <Binding Path="BeatIndex.Value" />
                            <Binding Path="MasterBeat" />
                            <!--  The third binding is only to continuously update as the animation position keeps moving otherwise it would update only on BeatIndex Change or MasterBeat Change  -->
                            <Binding Path="MasterBeat.AnimatedDouble.AnimationPosition" />
                        </MultiBinding>
                    </Border.Opacity>

                </Border>

                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextBase}"
                    Text="{Binding BPM, StringFormat=F2}" />
                <!--<TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextBase}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource MultiPeriodToBPM}" UpdateSourceTrigger="PropertyChanged">
                            <Binding Path="BeatIndex.Value" />
                            <Binding Path="MasterBeat" />
                            --><!--  The third binding is only to continuously update as the animation position keeps moving otherwise it would update only on BeatIndex Change or MasterBeat Change  --><!--
                            <Binding Path="MasterBeat.AnimatedDouble.AnimationPosition" />
                            <Binding Path="MasterBeat.BeatIndex.Value" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>-->

                <Button
                    Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                    HorizontalAlignment="Left"
                    Command="{Binding DivideCommand}"
                    DockPanel.Dock="Left"
                    IsDefault="True">
                    <Button.Content>
                        <Image
                            Margin="64"
                            Opacity="0.7"
                            Source="{StaticResource Sub}" />
                    </Button.Content>
                    <Button.Style>
                        <Style BasedOn="{StaticResource ButtonRoundedLeft}" TargetType="{x:Type Button}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=MainBorder}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button
                    Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                    HorizontalAlignment="Right"
                    Command="{Binding MultiplyCommand}"
                    DockPanel.Dock="Right"
                    IsDefault="True">
                    <Button.Content>
                        <Image
                            Margin="64"
                            Opacity="0.7"
                            Source="{StaticResource Add}" />
                    </Button.Content>
                    <Button.Style>
                        <Style BasedOn="{StaticResource ButtonRoundedRight}" TargetType="{x:Type Button}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=MainBorder}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </Grid>
        </Border>
    </Grid>
</UserControl>