<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.AxisSelector2D"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="axisSelector2D"
    d:DesignHeight="25.833"
    d:DesignWidth="286.5"
    mc:Ignorable="d">

    <Grid Height="{DynamicResource ControlHeightMD}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            Padding="0,0,8,0"
            HorizontalAlignment="Right"
            Text="Axis" />

        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <ToggleButton
                Grid.Column="0"
                Content="X"
                IsChecked="{Binding XIsChecked, ElementName=axisSelector2D}"
                Style="{StaticResource InlineToggleButtonLeft}" />
            <ToggleButton
                Grid.Column="1"
                Margin="1,0"
                Content="Y"
                IsChecked="{Binding YIsChecked, ElementName=axisSelector2D}"
                Style="{StaticResource InlineToggleButtonCenter}" />

        </Grid>

    </Grid>
</UserControl>
