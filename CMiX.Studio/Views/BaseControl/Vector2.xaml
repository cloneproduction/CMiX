<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.Vector2"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Panels:PositionedStackPanel>

        <BaseControls:DragValue
            Caption="{Binding Caption, StringFormat=' {0} X', RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Value="{Binding X.Value}" />

        <BaseControls:DragValue
            Margin="0,1"
            Caption="Y"
            Value="{Binding Y.Value}" />

    </Panels:PositionedStackPanel>

</UserControl>
