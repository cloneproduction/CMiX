<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.ListBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:local="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="120.468"
    d:DesignWidth="307.323"
    mc:Ignorable="d">

    <DockPanel>

        <Border
            Height="12"
            Background="{DynamicResource ListBoxBackground}"
            DockPanel.Dock="Bottom"
            MouseMove="Border_MouseMove"
            PreviewMouseLeftButtonDown="Border_PreviewMouseLeftButtonDown"
            PreviewMouseLeftButtonUp="Border_PreviewMouseLeftButtonUp">

            <Image
                x:Name="dragHandler"
                Margin="1"
                IsHitTestVisible="False"
                Opacity="0.25"
                Source="{DynamicResource DragHandler}" />

            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Cursor" Value="SizeNS" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

        </Border>

        <ListBox
            x:Name="prefabListBox"
            Height="105"
            MinHeight="105"
            DataContext="{Binding}"
            DockPanel.Dock="top"
            IsEnabled="True"
            ItemsSource="{Binding ManagerData.Items}"
            SelectedIndex="{Binding ManagerData.SelectedIndex}"
            SelectedItem="{Binding SelectedItem}">
            <i:Interaction.Behaviors>
                <Behaviors:ScrollParentWhenAtMax />
            </i:Interaction.Behaviors>
            <ListBox.Resources>
                <ResourceDictionary Source="/Views/Managers/ListBoxItemDataTemplate.xaml" />
            </ListBox.Resources>
        </ListBox>

    </DockPanel>
</UserControl>
