<UserControl x:Class="CMiX.Studio.Views.BaseControl.Counter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             mc:Ignorable="d" 
             x:Name="counter"
             d:DesignHeight="65.333" d:DesignWidth="557.333">

    <Grid Height="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Caption, ElementName=counter}" HorizontalAlignment="Right" Padding="4"/>

        <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" CornerRadius="4" BorderThickness="1, 0, 1, 2">
            <Controls:Counter
                Style="{DynamicResource CMiXCounterStyle}"
                StepValue="1"
                HorizontalAlignment="Stretch"
                Value="{Binding Count, ElementName=counter}"/>
        </Border>

    </Grid>
</UserControl>
