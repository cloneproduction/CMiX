<UserControl
    x:Class="CMiX.Studio.Views.Outliner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="33.235"
    d:DesignWidth="294.326"
    mc:Ignorable="d">

    <DockPanel Height="22">

        <DockPanel>

            <Button
                x:Name="deleteItemButton"
                Width="20"
                Command="{Binding DeleteItemCommand}"
                CommandParameter="{Binding SelectedItem}"
                Content="-"
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonRoundedRight}" />

            <Button
                Width="20"
                Margin="1,0"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Compositing:Composition}"
                Content="+"
                DockPanel.Dock="Right"
                Style="{StaticResource ButtonStraight}" />

            <ComboBox
                ItemsSource="{Binding PrefabRepository.Prefabs}"
                SelectedItem="{Binding SelectedItem}"
                Style="{StaticResource ComboBoxWithButton}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name.Value}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Controls:EditableTextBox
                Background="{DynamicResource HighHighDarkerColor}"
                SnapsToDevicePixels="True"
                Text="{Binding SelectedItem.Name.Value}"
                TextElement.Foreground="{DynamicResource TextBase}" />

        </DockPanel>

    </DockPanel>

</UserControl>
