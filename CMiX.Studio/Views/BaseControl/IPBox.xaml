<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.IPBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="21.5"
    d:DesignWidth="160.167"
    mc:Ignorable="d">

    <Grid Height="25">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock
            Margin="0,0,4,0"
            HorizontalAlignment="Right"
            Text="IP Address" />
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <TextBox
                Name="txtboxFirstPart"
                Grid.Column="0"
                HorizontalContentAlignment="Center"
                LostFocus="TextBox_LostFocus"
                MaxLength="3"
                PreviewKeyDown="txtboxFirstPart_PreviewKeyDown"
                Style="{DynamicResource TextBoxNumbersOnly}"
                TabIndex="1"
                TextChanged="txtbox_TextChanged" />
            <Label
                Grid.Column="1"
                Background="{StaticResource SuperHighDarkerColor}"
                Content="."
                Foreground="{StaticResource TextBase}" />
            <TextBox
                Name="txtboxSecondPart"
                Grid.Column="2"
                HorizontalContentAlignment="Center"
                KeyDown="txtboxSecondPart_KeyDown"
                LostFocus="TextBox_LostFocus"
                MaxLength="3"
                Style="{DynamicResource TextBoxNumbersOnly}"
                TabIndex="2"
                TextChanged="txtbox_TextChanged" />
            <Label
                Grid.Column="3"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{StaticResource SuperHighDarkerColor}"
                BorderThickness="0"
                Content="."
                Foreground="{StaticResource TextBase}" />
            <TextBox
                Name="txtboxThridPart"
                Grid.Column="4"
                HorizontalContentAlignment="Center"
                KeyDown="txtboxThridPart_KeyDown"
                LostFocus="TextBox_LostFocus"
                MaxLength="3"
                Style="{DynamicResource TextBoxNumbersOnly}"
                TabIndex="3"
                TextChanged="txtbox_TextChanged" />
            <Label
                Grid.Column="5"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="{StaticResource SuperHighDarkerColor}"
                BorderThickness="0"
                Content="."
                Foreground="{StaticResource TextBase}" />
            <TextBox
                x:Name="txtboxFourthPart"
                Grid.Column="6"
                HorizontalContentAlignment="Center"
                LostFocus="TextBox_LostFocus"
                MaxLength="3"
                Style="{DynamicResource TextBoxNumbersOnly}"
                TabIndex="4"
                TextChanged="txtbox_TextChanged" />
        </Grid>
    </Grid>

</UserControl>