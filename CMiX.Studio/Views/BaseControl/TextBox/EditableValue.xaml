<UserControl x:Class="CMiX.Studio.Views.BaseControl.EditableValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <TextBlock 
            x:Name="TextDisplay" 
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Text="{Binding Path=Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type BaseControl:EditableValue}}}" />
        <TextBox
            x:Name="InputValue" 
            SelectionBrush="{DynamicResource Grey700Brush}"
            CaretBrush="{DynamicResource Grey700Brush}"
            Padding="5"
            BorderThickness="0"
            VerticalAlignment="Center"
            PreviewTextInput="TextInput_PreviewTextInput"
            Background="{DynamicResource Grey300Brush}" 
            Foreground="{DynamicResource ActiveForegroundBrush}" 
            Text="{Binding Path=Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type BaseControl:EditableValue}}}" />
    </Grid>

</UserControl>
