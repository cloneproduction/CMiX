<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.EditableTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="editableTextBox"
    d:DesignHeight="21.182"
    d:DesignWidth="141.696"
    mc:Ignorable="d">

    <Grid Height="20" Background="Transparent">
        <TextBlock
            x:Name="TextDisplay"
            Padding="4,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Foreground="{Binding Foreground, ElementName=editableTextBox}"
            Text="{Binding Path=Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EditableTextBox}}}" />

        <TextBox
            x:Name="InputValue"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            CaretBrush="{DynamicResource AccentInactive}"
            Foreground="{DynamicResource ActiveTextBase}"
            SelectionBrush="{DynamicResource SuperHighLightColor}"
            Text="{Binding Path=Text, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:EditableTextBox}}}">
            <TextBox.ContextMenu>
                <ContextMenu Visibility="Hidden" />
            </TextBox.ContextMenu>
        </TextBox>
    </Grid>

</UserControl>