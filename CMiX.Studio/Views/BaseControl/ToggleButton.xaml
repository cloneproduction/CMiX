<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.ToggleButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="47.333"
    d:DesignWidth="634.667"
    mc:Ignorable="d">

    <Grid Height="22">

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="1">
            <ToggleButton
                x:Name="toggleButton"
                Width="18"
                Margin="2"
                HorizontalAlignment="Left"
                IsChecked="{Binding IsChecked, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Style="{StaticResource ToggleCheckBox}" />
            <Border x:Name="labelBorder" Background="Transparent">
                <TextBlock
                    Padding="4,0"
                    HorizontalAlignment="Left"
                    Foreground="{StaticResource TextBase}"
                    Text="{Binding Caption, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
            </Border>
        </DockPanel>
    </Grid>
</UserControl>
