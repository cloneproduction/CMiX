<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.Integer2Value"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="integer2Value"
    d:DesignHeight="50.555"
    d:DesignWidth="608.778"
    Background="Transparent"
    mc:Ignorable="d">



    <StackPanel>

        <BaseControl:IntegerValue
            Caption="{Binding Caption, StringFormat=' {0} X', ElementName=integer2Value}"
            DataContext="{Binding X}"
            Position="Top" />

        <BaseControl:IntegerValue
            Margin="0,1,0,0"
            Caption="Y"
            DataContext="{Binding Y}"
            Position="Bottom" />

    </StackPanel>

</UserControl>
