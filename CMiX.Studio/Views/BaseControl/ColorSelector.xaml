<UserControl x:Class="CMiX.Studio.Views.BaseControl.ColorSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
             mc:Ignorable="d"
             x:Name="colorSelector"
             d:DesignHeight="42" d:DesignWidth="279.222">


    <Grid Height="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock HorizontalAlignment="Right" Margin="0, 0, 4, 0" Text="{Binding Caption, ElementName=colorSelector}"/>

        <Border
            x:Name="mask" 
            Grid.Column="1" 
            Background="{DynamicResource DarkColor}" 
            Style="{StaticResource BorderMask}"
            AttachedProperties:PositionedControl.Position="{Binding Path=Position, ElementName=colorSelector}"/>

        <Border 
            x:Name="mainBorder" 
            Grid.Column="1">
            <Border.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=mask}"/>
            </Border.OpacityMask>

            <Button 
                Grid.Column="1"
                Click="Button_Click"
                Background="{Binding SelectedColor, Converter={StaticResource ColorToBrush}, ConverterParameter=all, ElementName=colorSelector}"
                Style="{StaticResource ButtonColorStyle}"/>
        </Border>
    </Grid>


</UserControl>
