<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.ColorSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="colorSelector"
    Height="22"
    d:DesignHeight="42"
    d:DesignWidth="279.222"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock
            Margin="0,0,8,0"
            HorizontalAlignment="Right"
            Text="{Binding Caption, ElementName=colorSelector}" />

        <Border
            x:Name="mask"
            Grid.Column="1"
            AttachedProperties:PositionedControl.Position="{Binding Path=Position, ElementName=colorSelector}"
            Background="{DynamicResource DarkColor}"
            Style="{StaticResource BorderMask}" />

        <Border x:Name="mainBorder" Grid.Column="1">

            <Border.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=mask}" />
            </Border.OpacityMask>

            <Button
                Grid.Column="1"
                Background="{Binding SelectedColor, Converter={StaticResource ColorToBrush}, ConverterParameter=all, ElementName=colorSelector}"
                Click="Button_Click"
                Style="{StaticResource ButtonColorStyle}" />

        </Border>

    </Grid>

</UserControl>
