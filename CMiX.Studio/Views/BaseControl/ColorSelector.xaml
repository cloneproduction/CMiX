<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.ColorSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:Resources="clr-namespace:CMiX.Studio.Resources"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="colorSelector"
    Height="22"
    d:DesignHeight="42"
    d:DesignWidth="279.222"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock
            Margin="0,0,8,0"
            HorizontalAlignment="Right"
            Text="{Binding Caption, ElementName=colorSelector}" />

        <ToggleButton
            x:Name="PopupToggle"
            Grid.Column="1"
            Background="{Binding Value}"
            AttachedProperties:PositionedControl.Position="{Binding Path=(AttachedProperties:PositionedControl.Position), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Style="{DynamicResource ButtonColorStyle}" />

        <Popup
            x:Name="colorPickerPopup"
            AllowsTransparency="True"
            Placement="Top"
            StaysOpen="true">
            <i:Interaction.Behaviors>
                <Behaviors:ClosePopupBehavior />
            </i:Interaction.Behaviors>
            <Border
                x:Name="popupBorder"
                Background="{DynamicResource HighHighDarkerColor}"
                CornerRadius="{DynamicResource CornerRadiusAll}">
                <BaseControl:StandardColorPicker 
                    Margin="8" 
                    SelectedColor="{Binding Value, Converter={StaticResource ColorToHex}, Mode=TwoWay}" />
            </Border>
        </Popup>

    </Grid>

</UserControl>
