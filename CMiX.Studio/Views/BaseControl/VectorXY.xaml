<UserControl x:Class="CMiX.Studio.Views.BaseControl.VectorXY"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             x:Name="vectorXY"
             d:DesignHeight="450" d:DesignWidth="800">
    
    <StackPanel>
        
        <BaseControls:DragValue 
            Caption="{Binding Caption, StringFormat=' {0} X', ElementName=vectorXY}" 
            Position="Top" 
            Value="{Binding X, ElementName=vectorXY}"/>

        <BaseControls:DragValue 
            Margin="0, 1"
            Caption="Y" 
            Position="Bottom" 
            Value="{Binding Y, ElementName=vectorXY}"/>
        
    </StackPanel>
    
</UserControl>
