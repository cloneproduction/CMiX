<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.VectorXYZ"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="vectorXYZ"
    d:DesignHeight="118"
    d:DesignWidth="251.667"
    mc:Ignorable="d">


    <StackPanel>

        <BaseControls:DragValue
            Caption="{Binding Caption, StringFormat=' {0} X', RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Position="Top"
            Value="{Binding X.Value}" />

        <BaseControls:DragValue
            Margin="0,1"
            Caption="Y"
            Position="Middle"
            Value="{Binding Y.Value}" />

        <BaseControls:DragValue
            Caption="Z"
            Position="Bottom"
            Value="{Binding Z.Value}" />

    </StackPanel>
</UserControl>
