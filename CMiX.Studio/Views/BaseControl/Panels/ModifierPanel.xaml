<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.Panels.ModifierPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="268.208"
    d:DesignWidth="287.353"
    mc:Ignorable="d">

    <UserControl.ContentTemplate>

        <DataTemplate>
            <Expander IsExpanded="{Binding IsExpanded}" Style="{StaticResource ItemControlExpander}">
                <Expander.Header>
                    <DockPanel>

                        <Border
                            Width="22"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right">

                            <Button
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"
                                PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp"
                                Style="{StaticResource DragHandlerButton}">
                                <Button.Content>
                                    <Image Opacity="0.25" Source="{DynamicResource DragHandler}" />
                                </Button.Content>
                            </Button>
                        </Border>

                        <Button
                            Width="22"
                            Command="{Binding CloseModifierCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                            CommandParameter="{Binding CloseModifierCommandParameter, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                            DockPanel.Dock="Right"
                            Style="{DynamicResource ModifierCloseButtonStyle}" />

                        <Controls:ToggleVisibility
                            Margin="4,0"
                            DataContext="{Binding}"
                            DockPanel.Dock="Right" />

                        <TextBlock DockPanel.Dock="Left" Text="{Binding Converter={StaticResource TypeToName}}" />
                    </DockPanel>
                </Expander.Header>
                <Border Margin="8">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>

            </Expander>
        </DataTemplate>
    </UserControl.ContentTemplate>

</UserControl>
