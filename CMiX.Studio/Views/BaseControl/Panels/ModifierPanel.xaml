<UserControl x:Class="CMiX.Studio.Views.BaseControl.Panels.ModifierPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             x:Name="modifierPanel"
             d:DesignHeight="415" d:DesignWidth="350">

    <UserControl.ContentTemplate>
        <DataTemplate>
            <Expander IsExpanded="True" 
                      Style="{StaticResource ItemControlExpander}">
                
                <Expander.Header>
                    <Border>
                        <DockPanel>

                            <Border 
                                DockPanel.Dock="Right" 
                                Width="22"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">

                                <Button 
                                    Style="{StaticResource DragHandlerButton}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    PreviewMouseLeftButtonDown="Button_PreviewMouseLeftButtonDown"
                                    PreviewMouseLeftButtonUp="Button_PreviewMouseLeftButtonUp">
                                    <Button.Content>
                                        <Image Source="{DynamicResource DragHandler}" Opacity="0.25"/>
                                    </Button.Content>
                                </Button>
                            </Border>

                            <Button 
                                DockPanel.Dock="Right" 
                                Width="22"
                                Command="{Binding CloseModifierCommand, ElementName=modifierPanel}"
                                CommandParameter="{Binding CloseModifierCommandParameter, ElementName=modifierPanel}"
                                Style="{DynamicResource ModifierCloseButtonStyle}"/>

                            <ToggleButton 
                                DockPanel.Dock="Right" 
                                Style="{StaticResource ToggleModifierVisibility}" 
                                Width="22"
                                IsChecked="{Binding  Path=DataContext.Visible.Value}"/>

                            <TextBlock Text="{Binding Path=DataContext, Converter={StaticResource TypeToName}}" DockPanel.Dock="Left"/>
                        </DockPanel>

                    </Border>

                </Expander.Header>

                <ContentPresenter Content="{TemplateBinding Content}" />

            </Expander>
        </DataTemplate>
    </UserControl.ContentTemplate>


</UserControl>
