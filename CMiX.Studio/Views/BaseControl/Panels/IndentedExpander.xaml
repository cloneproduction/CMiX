<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.Panels.IndentedExpander"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="uc"
    d:DesignHeight="33.777"
    d:DesignWidth="302.222"
    mc:Ignorable="d">

    <UserControl.ContentTemplate>
        <DataTemplate>
            <Expander
                AttachedProperties:ExpanderIndentation.Indentation="{Binding Indentation, ElementName=uc, Converter={StaticResource Indentation}}"
                Header="{Binding Header, ElementName=uc}"
                IsExpanded="{Binding IsExpanded, ElementName=uc}"
                Style="{StaticResource IndentedExpanderStyle}">
                <ContentPresenter Content="{Binding Content, ElementName=uc}" />
            </Expander>
        </DataTemplate>
    </UserControl.ContentTemplate>

</UserControl>
