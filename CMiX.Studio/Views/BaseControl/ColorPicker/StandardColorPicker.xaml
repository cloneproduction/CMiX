<Controls:PickerControlBase
    x:Class="CMiX.Studio.Views.BaseControl.StandardColorPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:Converters="clr-namespace:CMiX.Studio.Converters"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
    x:Name="uc"
    d:DesignHeight="345.414"
    d:DesignWidth="230.397"
    mc:Ignorable="d">

    <StackPanel>

        <Border>
            <StackPanel Orientation="Horizontal">

                <BaseControl:ColorWheel
                    Width="200"
                    Height="200"
                    ColorState="{Binding ElementName=uc, Path=ColorState, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Style="{StaticResource ColorWheelStyle}" />

                <BaseControl:CMiXSlider
                    Width="16"
                    Margin="0,0,0,0"
                    DockPanel.Dock="Right"
                    IsEditable="False"
                    Maximum="1"
                    Minimum="0"
                    Style="{StaticResource ValueSliderVertical}"
                    Value="{Binding Path=Color.HSV_V, ElementName=uc, Mode=TwoWay, Converter={Converters:RemapDoubleConverter FromMin=0, FromMax=100, ToMin=0, ToMax=1}}">

                    <i:Interaction.Behaviors>
                        <Behaviors:ColorSliderBehavior ColorState="{Binding Path=ColorState, ElementName=uc}" />
                    </i:Interaction.Behaviors>
                </BaseControl:CMiXSlider>

            </StackPanel>
        </Border>

        <BaseControl:ColorSliders
            Margin="0, 8, 0, 0"
            ColorState="{Binding ElementName=uc, Path=ColorState, Mode=TwoWay}" />

    </StackPanel>

</Controls:PickerControlBase>
