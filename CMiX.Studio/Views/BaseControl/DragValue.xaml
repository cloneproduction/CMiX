<UserControl
    x:Class="CMiX.Studio.Views.BaseControl.DragValue"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
    Height="22"
    d:DesignHeight="31.15"
    d:DesignWidth="320.797"
    mc:Ignorable="d">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Column="0"
            Margin="0,0,8,0"
            HorizontalAlignment="Right"
            Text="{Binding Caption, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />

        <Border
            x:Name="mask"
            IsHitTestVisible="False"
            Grid.Column="1"
            AttachedProperties:PositionedControl.Position="{Binding Path=(AttachedProperties:PositionedControl.Position), RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Background="{Binding Background, ElementName=mainBorder}"
            Style="{StaticResource BorderMask}" />

        <Border
            x:Name="mainBorder"
            Grid.Column="1"
            Background="{DynamicResource DarkColor}"
            BorderBrush="Transparent">

            <Border.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=mask}" />
            </Border.OpacityMask>

            <Grid>

                <Grid>
                    <Controls:NumericInput
                        x:Name="numericInput"
                        Height="{Binding ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                        IsEditing="{Binding IsEditing, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Mode=TwoWay}"
                        Value="{Binding Value, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}, Mode=TwoWay}"
                        Minimum="{Binding Minimum, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                        Maximum="{Binding Maximum, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                        IsInteger="{Binding IsInteger, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />

                        <Border
                            x:Name="borderValueDisplay"
                            VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="Background" Value="{DynamicResource DarkColor}" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Cursor" Value="SizeWE" />
                                            <Setter Property="Background" Value="{DynamicResource LightColor}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Value="True">
                                            <Setter Property="Visibility" Value="Hidden" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Label
                                x:Name="valueDisplay"
                                Padding="0"
                                Background="Transparent"
                                Content="{Binding Value, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}">
                                <Label.Style>
                                    <Style BasedOn="{StaticResource {x:Type Label}}" TargetType="{x:Type Label}">
                                        <Setter Property="ContentStringFormat" Value="{}{0:N3}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInteger, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" Value="True">
                                                <Setter Property="ContentStringFormat" Value="{}{0:N0}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Label.Style>
                            </Label>

                        </Border>
                    </Grid>

                <DockPanel LastChildFill="False" 
                           Visibility="{Binding IsEditing, 
                                                RelativeSource={RelativeSource Mode=FindAncestor, 
                                                AncestorType=UserControl}, 
                                                Converter={StaticResource BoolToVisibility}, 
                                                ConverterParameter=Invert}">
                    <Button
                        x:Name="SubButton"
                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                        HorizontalAlignment="Left"
                        DockPanel.Dock="Left">

                        <Button.Content>
                            <Image
                                Margin="42"
                                Opacity="0.5"
                                Source="{DynamicResource Sub}" />
                        </Button.Content>

                        <Button.Style>
                            <Style BasedOn="{StaticResource ButtonStraight}" TargetType="{x:Type Button}">
                                <Setter Property="Border.Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=mainBorder}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                    </Button>
                    <Button
                        x:Name="AddButton"
                        Width="{Binding ActualHeight, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">

                        <Button.Content>
                            <Image
                                Margin="42"
                                Opacity="0.5"
                                Source="{DynamicResource Add}" />
                        </Button.Content>

                        <Button.Style>
                            <Style BasedOn="{StaticResource ButtonStraight}" TargetType="{x:Type Button}">
                                <Setter Property="Border.Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=mainBorder}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                    </Button>
                </DockPanel>
            </Grid>

        </Border>

    </Grid>

</UserControl>
