<UserControl x:Class="CMiX.Studio.Views.BaseControl.DragValue"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             mc:Ignorable="d" 
             x:Name="dragValue"
             d:DesignHeight="25.333" d:DesignWidth="325.556">

    <Grid>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <TextBlock 
            Grid.Column="0" 
            Margin="0, 0, 8, 0" 
            HorizontalAlignment="Right" 
            Text="{Binding Caption, ElementName=dragValue}" />
        
        <Controls:DistanceSlider 
            Grid.Column="1" 
            Position="{Binding Position, ElementName=dragValue}" 
            Style="{StaticResource DistanceSliderStyle}" 
            Value="{Binding Value, ElementName=dragValue}"/>
        
    </Grid>

</UserControl>
