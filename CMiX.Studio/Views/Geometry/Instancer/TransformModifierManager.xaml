<UserControl
    x:Class="CMiX.Studio.Views.TransformModifierManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Behaviors="clr-namespace:CMiX.Core.Presentation.Behaviors;assembly=CMiX.Core"
    xmlns:ViewModels="clr-namespace:CMiX.Core.Presentation.ViewModels;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:dd="urn:gong-wpf-dragdrop"
    d:DesignHeight="238.667"
    d:DesignWidth="277.667"
    mc:Ignorable="d"
    x:Name="transformModifierManager">

    <StackPanel Margin="8, 6">

        <ToggleButton 
            IsEnabled="{Binding IsChecked, ElementName=ModifierEnabled}"
            x:Name="PopUpToggle" 
            Content="Add Modifier"
            Height="22" 
            Margin="0, 4"
            Background="{DynamicResource DarkerColor}" 
            Style="{StaticResource ToggleTransformModifierMenu}"/>

        <Popup
            AllowsTransparency="True"
            Behaviors:ClosePopupBehavior.PopupContainer="{Binding ElementName=transformModifierManager}"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=PopUpToggle}"
            FlowDirection="LeftToRight"
            IsOpen="{Binding IsChecked, ElementName=PopUpToggle}">

            <Border 
                BorderThickness="1, 0, 1, 2"
                BorderBrush="{DynamicResource Shadow}"
                CornerRadius="{DynamicResource CornerRadiusBottom}" 
                Padding="2, 0, 2, 2"
                Background="{DynamicResource HighHighDarkerColor}">

                <Grid Margin="4, 8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:TransformSRT}" 
                            Grid.Row="2"
                            Grid.Column="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Transform XYZ"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Translate}" 
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Translate XYZ"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Scale}" 
                            Grid.Row="1"
                            Grid.Column="2"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Scale XYZ"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Rotation}" 
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Rotate XYZ"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        
                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:RandomXYZ}" 
                            Grid.Column="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="RandomXYZ"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:RandomScale}" 
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Random Scale"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        
                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:LinearXYZ}" 
                            Grid.Column="0"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="LinearXYZ"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:LFO}" 
                            Grid.Column="2"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="LFO"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Stepper}" 
                            Grid.Column="2"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Stepper"/>
                        
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <ItemsControl 
            IsEnabled="{Binding IsChecked, ElementName=ModifierEnabled}"
            AllowDrop="True"
            dd:DragDrop.IsDragSource="True"
            dd:DragDrop.IsDropTarget="True"
            dd:DragDrop.DragHandler="{Binding}"
            dd:DragDrop.DropHandler="{Binding}"
            ItemsSource="{Binding Modifiers}">
            
            <ItemsControl.Resources>
                <DataTemplate DataType="{x:Type ViewModels:LinearXYZ}">
                    <Views:LinearXYZ DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:TranslateModifier}">
                    <Views:RandomXYZ DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:LFO}">
                    <Views:LFO DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:Stepper}">
                    <Views:Stepper DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:RandomScale}">
                    <Views:RandomScale DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:TransformSRT}">
                    <Views:TransformSRT DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:Translate}">
                    <Views:Translate DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:Scale}">
                    <Views:Scale DataContext="{Binding}"/>
                </DataTemplate>

                <DataTemplate DataType="{x:Type ViewModels:Rotation}">
                    <Views:Rotation DataContext="{Binding}"/>
                </DataTemplate>
            </ItemsControl.Resources>
            
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Panels:ModifierPanel 
                        Margin="0, 4"
                        DragHandlerIsPressed="{Binding DataContext.DragHandlerIsPressed, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CloseModifierCommand="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CloseModifierCommandParameter="{Binding}">
                        <ContentPresenter Content="{Binding}"/>
                    </Panels:ModifierPanel>
                </DataTemplate>
                
            </ItemsControl.ItemTemplate>
            
        </ItemsControl>

    </StackPanel>

</UserControl>