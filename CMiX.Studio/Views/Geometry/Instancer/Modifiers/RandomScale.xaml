<UserControl x:Class="CMiX.Studio.Views.RandomScale"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ViewModels="clr-namespace:CMiX.Core.Presentation.ViewModels;assembly=CMiX.Core"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="548" d:DesignWidth="461.333">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="ModifierMode" MethodName="GetValues" ObjectType="{x:Type ViewModels:ModifierMode}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ViewModels:ModifierMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>
    
    <Expander
            IsExpanded="{Binding IsExpanded}"
            Header="Random Scale" 
            Template="{StaticResource ModifierPanelTemplate}">
        <StackPanel>
            <StackPanel Margin="8">
                <Grid Height="20" Margin="0, 0, 0, 4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Type" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4" Foreground="{DynamicResource TextBase}"/>
                    <!--<Controls:CMiXToggleButton HorizontalAlignment="Left" Caption="Spread" Style="{StaticResource CMiXToggleButtonStyle}" Grid.Column="1" IsChecked="{Binding Spread.IsChecked}"/>-->
                    <ComboBox 
                        Grid.Column="1" 
                        SelectedItem="{Binding Mode.Selection}"
                        ItemsSource="{Binding Source={StaticResource ModifierMode}}"/>
                </Grid>
                <Border Margin="0, 0, 0, 16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="IsEnabled" Value="False"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Mode.Selection}" Value="{x:Static ViewModels:ModifierMode.ToSpread}">
                                    <Setter Property="IsEnabled" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Count" HorizontalAlignment="Right" Padding="4"/>
                        <Controls:Counter
                            Style="{DynamicResource CMiXCounterStyle}"
                            StepValue="1"
                            Grid.Column="1"
                            Height="20"
                            HorizontalAlignment="Stretch"
                            Value="{Binding Counter.Count, Mode=TwoWay}"/>
                    </Grid>
                </Border>

                <Views:BeatModifier DataContext="{Binding BeatModifier}"/>
            </StackPanel>

            <Grid Height="22" Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Controls:DistanceSlider 
                    Grid.Column="2" 
                    Position="Top" 
                    Style="{StaticResource DistanceSliderStyle}" 
                    Value="{Binding UniformXYZ.Amount}"/>
                <TextBlock 
                    Grid.Column="0" 
                    Padding="4" 
                    HorizontalAlignment="Right" 
                    Text="Uniform XYZ" 
                    Foreground="{StaticResource TextBase}"/>
            </Grid>
            
            <StackPanel Margin="8, 0">
                <Grid Height="20" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Controls:DistanceSlider 
                                Grid.Column="2" 
                                Position="Top" 
                                Style="{StaticResource DistanceSliderStyle}" 
                                Value="{Binding ScaleX.Amount}"/>
                    <TextBlock 
                                Grid.Column="0" 
                                Padding="4" 
                                HorizontalAlignment="Right" 
                                Text="Scale X" 
                                Foreground="{StaticResource TextBase}"/>
                </Grid>
                <Grid Height="20" Margin="0, 1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Controls:DistanceSlider 
                            Grid.Column="2" 
                            Position="Middle" 
                            Style="{StaticResource DistanceSliderStyle}" 
                            Value="{Binding ScaleY.Amount}"/>
                    <TextBlock 
                            Grid.Column="0" 
                            Padding="4" 
                            HorizontalAlignment="Right" 
                            Text="Y" 
                            Foreground="{StaticResource TextBase}"/>
                </Grid>
                <Grid Height="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Controls:DistanceSlider 
                            Grid.Column="2" 
                            Position="Bottom" 
                            Style="{StaticResource DistanceSliderStyle}" 
                            Value="{Binding ScaleZ.Amount}"/>
                    <TextBlock 
                            Grid.Column="0" 
                            Padding="4" 
                            HorizontalAlignment="Right" 
                            Text="Z" 
                            Foreground="{StaticResource TextBase}"/>
                </Grid>
            </StackPanel>

            <Views:Easing DataContext="{Binding Easing}"/>


        </StackPanel>
    </Expander>

</UserControl>
