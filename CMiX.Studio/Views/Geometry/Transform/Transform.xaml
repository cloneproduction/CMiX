             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="412.435" d:DesignWidth="292.87">


    <StackPanel>

        <!--<Expander Header="Transform SRT" IsExpanded="True">
            <StackPanel Margin="8">

                <BaseControls:DragValue 
                                Caption="Uniform Scale" 
                                Value="{Binding SelectedItem.Prefab.Uniform.Amount}"/>

                <BaseControls:VectorXYZ 
                                Caption="Scale"  
                                Margin="0, 8" 
                                DataContext="{Binding SelectedItem.Prefab.Scale}"
                                X="{Binding X.Amount}"
                                Y="{Binding Y.Amount}"
                                Z="{Binding Z.Amount}"/>

                <BaseControls:VectorXYZ 
                                Caption="Rotation"  
                                DataContext="{Binding SelectedItem.Prefab.Rotate}"
                                X="{Binding X.Amount}"
