<UserControl x:Class="CMiX.Studio.Views.TransformSRT"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="291.592" d:DesignWidth="257.329">

    <StackPanel Margin="8">
        
        <BaseControls:ComboBox
            Caption="Type"
            SelectedItem="{Binding Mode.Selection}"
            ItemsSource="{Binding Source={StaticResource ModifierMode}}"/>

        <BaseControls:DragValue
            Margin="0, 8, 0, 0"
            Caption="Uniform Scale" 
            Value="{Binding Uniform.Amount}"/>
        
        <BaseControls:VectorXYZ
            Margin="0, 8, 0, 0"
            Caption="Scale"
            X="{Binding Scale.XYZ.X.Amount}"
            Y="{Binding Scale.XYZ.Y.Amount}"
            Z="{Binding Scale.XYZ.Z.Amount}"/>

        <BaseControls:VectorXYZ
            Margin="0, 8"
            Caption="Rotation"
            X="{Binding Rotation.XYZ.X.Amount}"
            Y="{Binding Rotation.XYZ.Y.Amount}"
            Z="{Binding Rotation.XYZ.Z.Amount}"/>
        
        <BaseControls:VectorXYZ
            Caption="Translate"
            X="{Binding Translate.XYZ.X.Amount}"
            Y="{Binding Translate.XYZ.Y.Amount}"
            Z="{Binding Translate.XYZ.Z.Amount}"/>

    </StackPanel>
    
</UserControl>
