<UserControl
    x:Class="CMiX.Studio.Views.Geometry"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    d:DesignHeight="1507.577"
    d:DesignWidth="415.712"
    mc:Ignorable="d">

    <Border Background="{DynamicResource DarkerColor}">
        <StackPanel>
            <Border
                Height="25"
                Margin="0, 0, 0, 2"
                Padding="4"
                DockPanel.Dock="Top">
                <DockPanel 
                    VerticalAlignment="Center" 
                    LastChildFill="False">
                    <TextBlock
                        Margin="4, 0, 0, 0"
                        Text="GEOMETRY"
                        Foreground="{StaticResource TextBase}"/>
                </DockPanel>
            </Border>

            <Views:GeometryPathSelector Margin="8, 0" DataContext="{Binding GeometrySelector}"/>

            <Expander Margin="0, 2" IsExpanded="True" Header="Transform" >
                <Views:Transform 
                    Margin="0, 2" 
                    DockPanel.Dock="Bottom" 
                    DataContext="{Binding Transform}"/>
            </Expander>
            
            <Views:Instancer 
                DockPanel.Dock="Bottom" 
                Margin="0, 2" 
                DataContext="{Binding Instancer}"/>
            
            <Views:GeometryFX  
                Margin="0, 2"
                DockPanel.Dock="Bottom" 
                DataContext="{Binding GeometryFX}"/>
            
        </StackPanel>
    </Border>
    
</UserControl>