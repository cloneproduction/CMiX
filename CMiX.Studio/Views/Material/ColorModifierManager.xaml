<UserControl
    x:Class="CMiX.Studio.Views.ColorModifierManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Behaviors="clr-namespace:CMiX.Core.Presentation.Behaviors;assembly=CMiX.Core"
    xmlns:ViewModels="clr-namespace:CMiX.Core.Presentation.ViewModels;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:dd="urn:gong-wpf-dragdrop"
    d:DesignHeight="238.667"
    d:DesignWidth="277.667"
    mc:Ignorable="d"
    x:Name="ColorModifier">

    <UserControl.Resources>
        
        <!--<ResourceDictionary>

            <DataTemplate x:Key="RandomHSVTemplate" DataType="{x:Type ViewModels:RandomHSV}">
                <Views:RandomHSV Margin="0, 2" DataContext="{Binding}"/>
            </DataTemplate>

            <Views:ColorModifierTemplateSelector 
                x:Key="TemplateSelector" 
                RandomHSVTemplate="{StaticResource RandomHSVTemplate}"/>

        </ResourceDictionary>-->

    </UserControl.Resources>

    <StackPanel>

        <ToggleButton 
                x:Name="PopUpToggle" 
                Content="Add Modifier"
                Height="22" 
                Margin="0, 4"
                Background="{DynamicResource DarkerColor}" 
                Style="{StaticResource ToggleTransformModifierMenu}"/>

        <Popup
                AllowsTransparency="True"
                Behaviors:ClosePopupBehavior.PopupContainer="{Binding ElementName=ColorModifier}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=PopUpToggle}"
                FlowDirection="RightToLeft"
                IsOpen="{Binding IsChecked, ElementName=PopUpToggle}">

            <Border 
                    Background="Transparent" 
                    CornerRadius="{DynamicResource CornerRadiusBottom}" 
                    Padding="2, 0, 2, 2">

                <Border.Effect>
                    <DropShadowEffect 
                            BlurRadius="15" 
                            Opacity="0.8"  
                            ShadowDepth="2" 
                            Direction="-90" 
                            RenderingBias="Performance"/>
                </Border.Effect>

                <Border 
                        CornerRadius="{DynamicResource CornerRadiusBottomLarge}" 
                        Opacity="0.75" 
                        Background="{DynamicResource HighDarkerColor}">

                    <Grid Margin="8" Background="{DynamicResource HighDarkerColor}">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <Button 
                                Command="{Binding CreateCommand}" 
                                CommandParameter="{x:Type ViewModels:RandomHSV}" 
                                Grid.Column="0"
                                VerticalAlignment="Center" 
                                Width="100" 
                                Height="20" 
                                Content="RandomHSV"/>

                    </Grid>

                </Border>

            </Border>
        </Popup>

        <ItemsControl 
                AllowDrop="True"
                dd:DragDrop.IsDragSource="True"
                dd:DragDrop.IsDropTarget="True"
                dd:DragDrop.DragHandler="{Binding}"
                dd:DragDrop.DropHandler="{Binding}"
                ItemsSource="{Binding Modifiers}">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type ViewModels:RandomHSV}">
                    <Views:RandomHSV Margin="0, 2" DataContext="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>

</UserControl>