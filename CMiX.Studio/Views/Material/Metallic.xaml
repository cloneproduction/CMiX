<UserControl x:Class="CMiX.Studio.Views.Metallic"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    <StackPanel>
        
        <StackPanel>
            
            <Grid Height="20" Margin="0, 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Controls:DistanceSlider 
                    Grid.Column="2" 
                    Position="Top" 
                    Style="{StaticResource DistanceSliderStyle}" 
                    Value="{Binding Roughness.Amount}"/>
                <TextBlock 
                    Grid.Column="0" 
                    Padding="4" 
                    HorizontalAlignment="Right" 
                    Text="Roughness" 
                    Foreground="{StaticResource TextBase}"/>
            </Grid>
            
            <Grid Height="20" Margin="0, 1, 0, 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Controls:DistanceSlider 
                    Grid.Column="2" 
                    Position="Bottom" 
                    Style="{StaticResource DistanceSliderStyle}" 
                    Value="{Binding Metalness.Amount}"/>
                <TextBlock 
                    Grid.Column="0" 
                    Padding="4" 
                    HorizontalAlignment="Right" 
                    Text="Metalness" 
                    Foreground="{StaticResource TextBase}"/>
            </Grid>
            
        </StackPanel>

        <Expander>
            <Expander.Header>
                <DockPanel>
                    <Controls:CMiXToggleButton
                        x:Name="Enabled"
                        Style="{DynamicResource CMiXToggleButtonStyle}"
                        Dock="Left"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsEnabled.IsChecked}"/>
                    <TextBlock Text="Emissive" Foreground="{DynamicResource TextBase}"/>
                </DockPanel>
            </Expander.Header>
        </Expander>
    </StackPanel>
    
</UserControl>
