<UserControl
    x:Class="CMiX.Studio.Views.Material"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    md:DialogServiceViews.IsRegistered="True"
    d:DesignHeight="202.514"
    d:DesignWidth="239.883"
    mc:Ignorable="d">

    <StackPanel>
        
        <BaseControls:ColorSelector 
            Margin="8"
            Caption="Base Color" 
            SelectedColor="{Binding BaseColor.SelectedColor}"
            ViewModel="{Binding BaseColor}"/>

        <Panels:IndentedExpander Header="Texture" Indentation="8" IsExpanded="{Binding DiffuseTexture.IsExpanded}">
            <Views:DiffuseTexture DataContext="{Binding DiffuseTexture}"/>
        </Panels:IndentedExpander>


            <Views:MaskTexture DataContext="{Binding MaskTexture}"/>

        
    </StackPanel>

</UserControl>