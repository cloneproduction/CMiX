<UserControl
    x:Class="CMiX.Studio.Views.Material"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Tools="clr-namespace:CMiX.Core.Presentation;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
    d:DesignHeight="1870.805"
    d:DesignWidth="349.875"
    mc:Ignorable="d"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    md:DialogServiceViews.IsRegistered="True">

    <UserControl.Resources>
        <ResourceDictionary>
            <Tools:BindingProxy x:Key="ProjectProxy" Data="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource DarkerColor}">
        <StackPanel>
            
            <Border Height="25" 
                    Margin="0, 0, 0, 2" 
                    Padding="4">
                <TextBlock
                    Margin="4, 0, 0, 0"
                    Text="MATERIAL"
                    Foreground="{StaticResource TextBase}"/>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                    Text="Base Color" 
                    HorizontalAlignment="Right" Padding="4, 0"
                    VerticalAlignment="Center"/>
                
                <Border Grid.Column="1">
                    <Button Height="25"
                        Margin="4"
                        Command="{Binding OpenColorSelectorCommand}"
                        Style="{StaticResource ButtonColorStyle}">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding BaseColor.SelectedColor}"/>
                        </Button.Background>
                    </Button>
                </Border>
            </Grid>



            <Border Background="{StaticResource DarkerColor}">
                <Expander IsExpanded="True" Header="Modifiers">
                    <Views:BeatModifier Margin="8" DataContext="{Binding BeatModifier}"/>
                </Expander>
            </Border>

        </StackPanel>
    </Border>
</UserControl>