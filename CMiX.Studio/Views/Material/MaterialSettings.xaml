<UserControl
    x:Class="CMiX.Studio.Views.MaterialSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="232"
    d:DesignWidth="350"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControls:ColorSelector
            Margin="8,8,8,0"
            Caption="Base Color"
            SelectedColor="{Binding BaseColor.Value, Converter={StaticResource ColorToHex}}"
            ViewModel="{Binding BaseColor}" />

        <BaseControls:CMiXSlider
            Margin="8"
            Caption="Alpha"
            Maximum="1"
            Minimum="0"
            Value="{Binding Alpha.Value}" />

        <BaseControls:ComboBox
            Margin="8,0,8,1"
            Caption="Cull Mode"
            ItemsSource="{Binding Source={StaticResource CullModeType}}"
            Position="top"
            SelectedItem="{Binding CullMode.Value}" />

        <BaseControls:ComboBox
            Margin="8,0,8,8"
            Caption="Transparency"
            ItemsSource="{Binding Source={StaticResource TransparencyType}}"
            Position="Bottom"
            SelectedItem="{Binding Transparency.Value}" />

        <BaseControls:ToggleButton Caption="Is Shadow Caster" IsChecked="{Binding IsShadowCaster.Value}" />

        <BaseControls:ComboBox
            Margin="8"
            Caption="Pipeline"
            ItemsSource="{Binding Source={StaticResource PipelineType}}"
            SelectedItem="{Binding Pipeline.Value}" />

        <Border>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Pipeline.Value}" Value="{x:Static Materials:PipelineType.Metallic}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel>
                <BaseControls:CMiXSlider
                    Margin="8,0,8,8"
                    Caption="Metalness"
                    Maximum="1"
                    Minimum="0"
                    Position="Top"
                    Value="{Binding Metalness.Value}" />
            </StackPanel>
        </Border>

        <Border Margin="8,0,8,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Pipeline.Value}" Value="{x:Static Materials:PipelineType.Specular}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

    </StackPanel>
</UserControl>
