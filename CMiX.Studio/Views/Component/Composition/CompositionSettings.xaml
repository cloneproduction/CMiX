<UserControl
    x:Class="CMiX.Studio.Views.CompositionSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="478.806"
    d:DesignWidth="344.701"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel>
        <BaseControl:ColorSelector
            Margin="0,0,0,8"
            Caption="Background Color"
            DataContext="{Binding BackgroundColor}" />
        <BaseControl:Integer2Value Caption="Resolution" DataContext="{Binding Resolution}" />
    </StackPanel>

</UserControl>
