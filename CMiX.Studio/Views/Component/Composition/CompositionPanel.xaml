<UserControl x:Class="CMiX.Studio.Views.CompositionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Beat="clr-namespace:CMiX.Studio.Views.Beat"
             xmlns:CMiX="clr-namespace:CMiX"
             mc:Ignorable="d" 
             d:DesignHeight="525" d:DesignWidth="293">

    <!--<Beat:MasterBeatControl DockPanel.Dock="Bottom" DataContext="{Binding SelectedComposition.MasterBeat}"/>-->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.9*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock 
                Grid.Column="0" 
                Padding="8, 0" 
                HorizontalAlignment="Right" 
                Text="Master Beat" 
                Foreground="{DynamicResource TextBase}"/>
        <ComboBox 
            Grid.Column="1"
            Height="25"
            SelectedItem="{Binding MasterBeat}"
            ItemsSource="{Binding Path=DataContext.BeatManager.MasterBeats, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type CMiX:MainWindow}}}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding BPM}"/>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
    </Grid>

</UserControl>
