<UserControl
    x:Class="CMiX.Studio.Views.Composition"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="292.667"
    d:DesignWidth="208"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <i:Interaction.Behaviors>
            <Behaviors:ScrollViewerBehavior />
        </i:Interaction.Behaviors>
        <StackPanel>

            <Panels:IndentedExpander DockPanel.Dock="Top" Header="Filters">
                <Views:ModifierManager DataContext="{Binding TextureModifierManager}">
                    <Views:ModifierManager.SelectionPanel>
                        <Views:TextureFilterSelectionPanel DataContext="{Binding}" />
                    </Views:ModifierManager.SelectionPanel>
                </Views:ModifierManager>
            </Panels:IndentedExpander>

            <Panels:IndentedExpander DockPanel.Dock="Top" Header="Settings">
                <Views:CompositionSettings Margin="8" DataContext="{Binding OutputSettings}" />
            </Panels:IndentedExpander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
