<UserControl x:Class="CMiX.Studio.Views.Component.AmbientOcclusion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
             mc:Ignorable="d" 
             d:DesignHeight="415.333" d:DesignWidth="381.333">

    <Panels:IndentedExpander>
        <Panels:IndentedExpander.Header>
            <DockPanel>
                <Controls:CMiXToggleButton

                    Style="{DynamicResource CMiXToggleButtonStyle}"
                    Dock="Left"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsEnabled.IsChecked}"/>
                <TextBlock Text="Ambient Occlusion" Margin="8, 0, 0, 0" Foreground="{DynamicResource TextBase}"/>

            </DockPanel>
        </Panels:IndentedExpander.Header>

        <StackPanel IsEnabled="{Binding IsChecked, ElementName=Enabled}" Margin="8">
            <Grid Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Controls:Counter
                    Style="{DynamicResource CMiXCounterStyle}"
                    StepValue="1"
                    Grid.Column="1"
                    Height="20"
                    HorizontalAlignment="Stretch"
                    Value="{Binding Samples.Count, Mode=TwoWay}"/>
                <TextBlock 
                    Grid.Column="0" 
                    Padding="4" 
                    HorizontalAlignment="Right" 
                    Text="Samples" 
                    Foreground="{StaticResource TextBase}"/>
            </Grid>

            <Grid Height="20" Margin="0, 4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Controls:DistanceSlider 
                    Grid.Column="2" 
                    Position="Default" 
                    Style="{StaticResource DistanceSliderStyle}" 
                    Value="{Binding ProjectionScale.Amount}"/>
                <TextBlock 
                    Grid.Column="0" 
                    Padding="4" 
                    HorizontalAlignment="Right" 
                    Text="Projection Scale" 
                    Foreground="{StaticResource TextBase}"/>
            </Grid>

            <Grid Height="20" Margin="0, 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Controls:DistanceSlider 
                    Grid.Column="2" 
                    Position="Default" 
                    Style="{StaticResource DistanceSliderStyle}" 
                    Value="{Binding Intensity.Amount}"/>
                <TextBlock 
                    Grid.Column="0" 
                    Padding="4" 
                    HorizontalAlignment="Right" 
                    Text="Intensity" 
                    Foreground="{StaticResource TextBase}"/>
            </Grid>

            <Grid Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Controls:DistanceSlider 
                    Grid.Column="2" 
                    Position="Top" 
                    Style="{StaticResource DistanceSliderStyle}" 
                    Value="{Binding SampleBias.Amount}"/>
                <TextBlock 
                    Grid.Column="0" 
                    Padding="4" 
                    HorizontalAlignment="Right" 
                    Text="Sample Bias" 
                    Foreground="{StaticResource TextBase}"/>
            </Grid>

            <Grid Height="22" Margin="0, 1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Controls:DistanceSlider 
                    Grid.Column="2" 
                    Position="Bottom" 
                    Style="{StaticResource DistanceSliderStyle}" 
                    Value="{Binding SampleRadius.Amount}"/>
                <TextBlock 
                    Grid.Column="0" 
                    Padding="4" 
                    HorizontalAlignment="Right" 
                    Text="Sample Radius" 
                    Foreground="{StaticResource TextBase}"/>
            </Grid>

            <Grid Height="22" Margin="0, 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Controls:Counter
                    Style="{DynamicResource CMiXCounterStyle}"
                    StepValue="1"
                    Grid.Column="1"
                    Height="20"
                    HorizontalAlignment="Stretch"
                    Value="{Binding BlurCount.Count, Mode=TwoWay}"/>
                <TextBlock 
                    Grid.Column="0" 
                    Padding="4" 
                    HorizontalAlignment="Right" 
                    Text="Blur Count" 
                    Foreground="{StaticResource TextBase}"/>
            </Grid>

            <Grid Height="22" Margin="0, 1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Controls:DistanceSlider 
                    Grid.Column="2" 
                    Position="Default" 
                    Style="{StaticResource DistanceSliderStyle}" 
                    Value="{Binding BlurRadius.Amount}"/>
                <TextBlock 
                    Grid.Column="0" 
                    Padding="4" 
                    HorizontalAlignment="Right" 
                    Text="Blur Radius" 
                    Foreground="{StaticResource TextBase}"/>
            </Grid>

            <Grid Height="22" Margin="0, 1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Controls:DistanceSlider 
                    Grid.Column="2" 
                    Position="Default" 
                    Style="{StaticResource DistanceSliderStyle}" 
                    Value="{Binding EdgeSharpness.Amount}"/>
                <TextBlock 
                    Grid.Column="0" 
                    Padding="4" 
                    HorizontalAlignment="Right" 
                    Text="Edge Sharpness" 
                    Foreground="{StaticResource TextBase}"/>
            </Grid>
        </StackPanel>

    </Panels:IndentedExpander>

</UserControl>
