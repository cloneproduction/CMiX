<UserControl
    x:Class="CMiX.Studio.Views.AmbientOcclusion"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="415.333"
    d:DesignWidth="381.333"
    mc:Ignorable="d">

    <Panels:IndentedExpander>

        <Panels:IndentedExpander.Header>
            
            <DockPanel>
                
                <ToggleButton
                    Width="14"
                    Height="14"
                    IsChecked="{Binding DataContext.IsEnabled.Value}"
                    Style="{DynamicResource ToggleButtonRounded}" />
                
                <TextBlock
                    Margin="8,0"
                    Foreground="{DynamicResource TextBase}"
                    Text="Ambient Occlusion" />
                
            </DockPanel>
            
        </Panels:IndentedExpander.Header>

        <Border Margin="8" IsEnabled="{Binding IsEnabled.Value}">

            <StackPanel>

                <BaseControls:IntegerValue Caption="Samples" DataContext="{Binding Samples}" />

                <BaseControls:DragValue
                    Margin="0,8"
                    Caption="Intensity"
                    Value="{Binding Intensity.Value}" />

                <BaseControls:DragValue
                    Margin="0"
                    Caption="SampleBias"
                    Position="Top"
                    Value="{Binding SampleBias.Value}" />

                <BaseControls:DragValue
                    Margin="0,1,0,8"
                    Caption="SampleRadius"
                    Position="Bottom"
                    Value="{Binding SampleRadius.Value}" />

                <BaseControls:IntegerValue
                    Caption="Blur Count"
                    DataContext="{Binding BlurCount}"
                    Position="Top" />

                <BaseControls:DragValue
                    Margin="0,1,0,0"
                    Caption="Blur Radius"
                    Position="Bottom"
                    Value="{Binding BlurRadius.Value}" />

                <BaseControls:DragValue
                    Margin="0,8"
                    Caption="Edge Sharpness"
                    Value="{Binding EdgeSharpness.Value}" />

            </StackPanel>

        </Border>

    </Panels:IndentedExpander>

</UserControl>
