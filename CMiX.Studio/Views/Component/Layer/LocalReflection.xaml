<UserControl
    x:Class="CMiX.Studio.Views.LocalReflection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="239.333"
    d:DesignWidth="228"
    mc:Ignorable="d">

    <Panels:IndentedExpander>

        <Panels:IndentedExpander.Header>
            <DockPanel>
                <ToggleButton
                    Width="14"
                    Height="14"
                    IsChecked="{Binding DataContext.IsEnabled.Value}"
                    Style="{DynamicResource ToggleButtonRounded}" />
                <TextBlock
                    Margin="8,0"
                    Foreground="{DynamicResource TextBase}"
                    Text="Local Reflection" />
            </DockPanel>
        </Panels:IndentedExpander.Header>

        <Border Margin="8" IsEnabled="{Binding IsEnabled.Value}">



        </Border>

    </Panels:IndentedExpander>
</UserControl>
