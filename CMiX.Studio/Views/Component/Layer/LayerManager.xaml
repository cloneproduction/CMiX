<UserControl x:Class="CMiX.Studio.Views.LayerManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Components="clr-namespace:CMiX.Core.Presentation.ViewModels.Components;assembly=CMiX.Core"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="d" d:DesignHeight="210.285" d:DesignWidth="298.727" >


    <Border Background="{DynamicResource SuperHighDarkerColor}">
        <DockPanel Grid.Row="0">

            <Border Margin="0, 0, 0, 2" DockPanel.Dock="Bottom" Background="{DynamicResource DarkerColor}" >
                <DockPanel LastChildFill="False">

                    <Button 
                        Command="{Binding AddItemCommand}"
                        CommandParameter="{x:Type Components:Layer}"
                        Margin="4"
                        Height="22"
                        Style="{StaticResource ButtonImage}">
                        
                        <Button.Content>
                            <Image Margin="16" Source="{DynamicResource Add}"/>
                        </Button.Content>
                        
                    </Button>

                    <Button Grid.Column="1" 
                        DockPanel.Dock="Right"
                        Margin="4"
                        Height="22"
                        Command="{Binding DeleteItemCommand}"
                        CommandParameter="{Binding SelectedItem}"
                        Style="{StaticResource ButtonImage}">
                        
                        <Button.Content>
                            <Image Margin="16" Source="{DynamicResource DeleteLayer}"/>
                        </Button.Content>
                        
                    </Button>

                </DockPanel>
            </Border>
            
            <Border DockPanel.Dock="Top" Background="{DynamicResource DarkerColor}">
                
                <ListBox 
                    DockPanel.Dock="Top"
                    AllowDrop="True"
                    dd:DragDrop.IsDragSource="True"
                    dd:DragDrop.IsDropTarget="True"
                    dd:DragDrop.DragHandler="{Binding}"
                    dd:DragDrop.DropHandler="{Binding}"
                    Grid.Row="3" 
                    Style="{StaticResource LayerListBoxStyle}"
                    SelectedItem="{Binding SelectedItem}"
                    VirtualizingStackPanel.IsVirtualizing="False"
                    ItemsSource="{Binding Prefabs}">

                </ListBox>
                
            </Border>
            
        </DockPanel>
    </Border>

</UserControl>


