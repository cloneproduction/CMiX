<UserControl
    x:Class="CMiX.Studio.Views.LayerManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:CMiX.Studio.Views"
    d:DesignHeight="210.285"
    d:DesignWidth="298.727"
    mc:Ignorable="d">


    <Border Background="{DynamicResource HighDarkerColor}">
        <DockPanel>

            <Border DockPanel.Dock="Bottom" Visibility="{Binding ManagerData.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Hidden}}">

                <StackPanel Margin="8" DataContext="{Binding ManagerData.SelectedItem}">

                    <Controls:CMiXSlider
                        Height="22"
                        Caption="Alpha"
                        DockPanel.Dock="Top"
                        Maximum="1"
                        Minimum="0"
                        Style="{StaticResource SliderRounded}"
                        Value="{Binding Opacity.Value}" />

                    <BaseControls:ColorSelector
                        Margin="0,8"
                        Caption="Background"
                        SelectedColor="{Binding BackgroundColor.Value, Converter={StaticResource ColorToHex}}"
                        ViewModel="{Binding BackgroundColor}" />

                    <Border>
                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMask.Value}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMask.Value}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <BaseControls:ComboBox
                            Caption="Blend Mode"
                            ItemsSource="{Binding Source={StaticResource BlendMode}}"
                            SelectedItem="{Binding BlendMode.Value, Mode=TwoWay}" />
                    </Border>

                    <Border>

                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMask.Value}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsMask.Value}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>

                            <BaseControls:ComboBox
                                Caption="Mask Mode"
                                ItemsSource="{Binding Source={StaticResource MaskMode}}"
                                SelectedItem="{Binding MaskMode.Value}" />

                            <BaseControls:ComboBox
                                Margin="0,4"
                                Caption="Channel"
                                ItemsSource="{Binding Source={StaticResource MaskChannel}}"
                                SelectedItem="{Binding MaskChannel.Value}" />

                            <BaseControls:ToggleButton Caption="Invert" IsChecked="{Binding Invert.Value}" />

                        </StackPanel>

                    </Border>

                </StackPanel>
            </Border>

            <DockPanel>
                <DockPanel
                    Background="{DynamicResource DarkerColor}"
                    DockPanel.Dock="Bottom"
                    LastChildFill="False">

                    <Button
                        Height="20"
                        Margin="2"
                        Background="Transparent"
                        Command="{Binding AddItemCommand}"
                        CommandParameter="{x:Type Compositing:Layer}"
                        Style="{StaticResource ButtonRounded}">
                        <Button.Content>
                            <Image
                                Margin="20"
                                Opacity="0.7"
                                Source="{DynamicResource Add}" />
                        </Button.Content>
                    </Button>

                    <Button
                        Height="20"
                        Margin="2"
                        Background="Transparent"
                        Command="{Binding ItemUpCommand}"
                        Style="{StaticResource ButtonRounded}">
                        <Button.Content>
                            <Image
                                Margin="16"
                                Opacity="0.7"
                                Source="{DynamicResource ArrowUp}" />
                        </Button.Content>
                    </Button>

                    <Button
                        Height="20"
                        Margin="2"
                        Background="Transparent"
                        Command="{Binding ItemDownCommand}"
                        Style="{StaticResource ButtonRounded}">
                        <Button.Content>
                            <Image
                                Margin="16"
                                Opacity="0.7"
                                Source="{DynamicResource ArrowDown}" />
                        </Button.Content>
                    </Button>

                    <Button
                        Height="20"
                        Margin="4"
                        Background="Transparent"
                        Command="{Binding DeleteItemCommand}"
                        CommandParameter="{Binding ManagerData.SelectedItem}"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ButtonRounded}">
                        <Button.Content>
                            <Image
                                Margin="20"
                                Opacity="0.7"
                                Source="{DynamicResource DeleteLayer}" />
                        </Button.Content>
                    </Button>

                </DockPanel>

                <Border Background="{DynamicResource DarkerColor}" DockPanel.Dock="Top">

                    <ListBox
                        Grid.Row="3"
                        dd:DragDrop.DragHandler="{Binding ManagerReorderService}"
                        dd:DragDrop.DropHandler="{Binding ManagerReorderService}"
                        dd:DragDrop.IsDragSource="True"
                        dd:DragDrop.IsDropTarget="True"
                        AllowDrop="True"
                        DockPanel.Dock="Top"
                        ItemsSource="{Binding ManagerData.Items}"
                        SelectedIndex="{Binding ManagerData.SelectedIndex}"
                        SelectedItem="{Binding ManagerData.SelectedItem}"
                        Style="{StaticResource LayerListBoxStyle}"
                        VirtualizingStackPanel.IsVirtualizing="False">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <views:LayerManagerItem DragHandlerIsPressed="{Binding DataContext.ManagerReorderService.DragHandlerIsPressed, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </DockPanel>
    </Border>
</UserControl>


