<UserControl x:Class="CMiX.Studio.Views.LayerMaskController"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="128.333" d:DesignWidth="340.111">

    <StackPanel>

        <Controls:CMiXSlider
            Margin="0, 0, 0, 8"
            Style="{StaticResource CMiXSliderStyle}"
            Minimum="0"
            Maximum="1"
            DockPanel.Dock="Top"
            Height="22"
            Value="{Binding Opacity.Amount}" 
            Caption="Alpha"/>

        <BaseControls:ComboBox 
            Caption="Channel"
            SelectedItem="{Binding MaskChannelSelector.Selection, Converter={StaticResource EnumToString}}"
            ItemsSource="{Binding Source={StaticResource MaskChannel}}"/>

        <BaseControls:ColorSelector 
            Margin="0, 8"
            Caption="Background" 
            Command="{Binding OpenColorSelectorCommand}"/>

        <BaseControls:ToggleButton 
            IsChecked="{Binding Invert.IsChecked}"
            Caption="Invert"/>
        
    </StackPanel>

</UserControl>
