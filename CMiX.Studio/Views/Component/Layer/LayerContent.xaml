<UserControl x:Class="CMiX.Studio.Views.Component.LayerContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:ViewComponents="clr-namespace:CMiX.Studio.Views.Component"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="752.666" d:DesignWidth="333.333">

    <Border
        Background="{DynamicResource DarkerColor}"
        IsEnabled="{Binding Converter={StaticResource NullToBool}}">
        <StackPanel>
            <Expander Header="Entities">
                <StackPanel>
                    <Views:PrefabSlotManager
                        ItemsSource="{Binding Path=DataContext.Project.CompositionService.EntityRepository.Prefabs, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Views:MainWindow}}}"
                        DataContext="{Binding ModelEntityManager}"/>
                    <Border>

                        <Border.Style>
                            <Style TargetType="{x:Type Border}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=ModelEntityManager.SelectedItem, Converter={StaticResource NullToBool}}" Value="False">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Path=ModelEntityManager.SelectedItem, Converter={StaticResource NullToBool}}" Value="False">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel>
                            <Border IsEnabled="{Binding ModelEntityManager.SelectedItem.Transform, Converter={StaticResource NullToBool}}">
                                <Expander>
                                    <Expander.Header>
                                        <DockPanel>
                                            <ToggleButton
                                                x:Name="ModifierEnabled"
                                                Height="16"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding ModelEntityManager.SelectedItem.Prefab.TransformModifier.Visibility.IsChecked}"/>
                                            <TextBlock Text="Modifiers" Margin="8, 0" Foreground="{DynamicResource TextBase}"/>
                                        </DockPanel>
                                    </Expander.Header>
                                    <Views:CameraTransformModifierManager DataContext="{Binding ModelEntityManager.SelectedItem.Prefab.Transform.TransformModifier}"/>
                                </Expander>

                            </Border>

                            <Border IsEnabled="{Binding ModelEntityManager.SelectedItem.Mesh, Converter={StaticResource NullToBool}}">
                                <Expander Header="Mesh">
                                    <StackPanel>
                                        <Grid Margin="8, 8, 8, 0" >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock 
                                                Grid.Column="0" 
                                                Padding="8, 0" 
                                                HorizontalAlignment="Right" 
                                                Text="Mesh" 
                                                Foreground="{StaticResource TextBase}"/>
                                            <ComboBox 
                                                Grid.Column="1"
                                                SelectedValue="{Binding ModelEntityManager.SelectedItem.Prefab.Mesh}"
                                                SelectedValuePath="Prefab"
                                                ItemsSource="{Binding CompositionService.MeshManager.Prefabs}">
                                                <ComboBox.ItemTemplate>
                                                    <ItemContainerTemplate>
                                                        <Border Height="20">
                                                            <TextBlock Padding="4" Text="{Binding Name}"/>
                                                        </Border>
                                                    </ItemContainerTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>
                                        <ViewComponents:Mesh DataContext="{Binding ModelEntityManager.SelectedItem.Prefab.Mesh}"/>
                                    </StackPanel>

                                </Expander>
                            </Border>

                            <Border IsEnabled="{Binding ModelEntityManager.SelectedItem.Material, Converter={StaticResource NullToBool}}">
                                <Expander Header="Material">
                                    <Views:Material DataContext="{Binding ModelEntityManager.SelectedItem.Prefab.Material}"/>
                                </Expander>
                            </Border>
                        </StackPanel>

                    </Border>

                </StackPanel>
            </Expander>

            <Expander Header="Filter">
                <Views:TextureFilter  DataContext="{Binding TextureModifierManager}"/>
            </Expander>
            
            <Expander Header="Background">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button 
                        Height="22"
                        Grid.Column="1"
                        Margin="4"
                        Command="{Binding OpenColorSelectorCommand}"
                        Style="{StaticResource ButtonColorStyle}">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding BackgroundColor.SelectedColor}"/>
                        </Button.Background>
                    </Button>
                    <TextBlock 
                        Grid.Column="0" 
                        Padding="8, 0" 
                        HorizontalAlignment="Right" 
                        Text="Color" 
                        Foreground="{StaticResource TextBase}"/>
                </Grid>
            </Expander>
            
            <Expander Header="Cameras">
                <Views:PrefabSlotManager 
                    ItemsSource="{Binding Path=DataContext.Project.CompositionService.CameraRepository.Prefabs, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Views:MainWindow}}}"
                    DataContext="{Binding CameraEntityManager}"/>
            </Expander>
            
            <ViewComponents:AmbientOcclusion DataContext="{Binding AmbientOcclusion}"/>

        </StackPanel>
    </Border>
</UserControl>
