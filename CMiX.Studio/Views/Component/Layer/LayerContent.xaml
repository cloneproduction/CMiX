<UserControl x:Class="CMiX.Studio.Views.Component.LayerContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Presentation="clr-namespace:CMiX.Core.Presentation;assembly=CMiX.Core"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:ViewComponents="clr-namespace:CMiX.Studio.Views.Component"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="587.333" d:DesignWidth="317.333">

    <UserControl.Resources>
        <Presentation:BindingProxy x:Key="ModelEntityProxy" Data="{Binding Path=DataContext.Project.CompositionManager.SelectedComposition.CompositionService.ModelEntityManager, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Views:MainWindow}}}"/>
        <Presentation:BindingProxy x:Key="LightEntityProxy" Data="{Binding Path=DataContext.Project.CompositionManager.SelectedComposition.CompositionService.LightEntityManager, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Views:MainWindow}}}"/>
        <Presentation:BindingProxy x:Key="CameraProxy" Data="{Binding Path=DataContext.Project.CompositionManager.SelectedComposition.CompositionService.CameraManager, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Views:MainWindow}}}"/>
    </UserControl.Resources>
    
    <Border
        Background="{DynamicResource DarkerColor}"
        IsEnabled="{Binding Converter={StaticResource NullToBool}}">
        <StackPanel>
            <Expander Header="Entities" IsExpanded="True">
                <Border Background="{DynamicResource HighDarkerColor}">
                    <StackPanel>
                        <Grid Height="100" Margin="8">

                            <ListBox 
                                x:Name="EntityListBox"
                                Style="{StaticResource ListBoxSlotWithButton}"
                                DataContext="{Binding EntityManager}"
                                AllowDrop="True"
                                dd:DragDrop.IsDragSource="True"
                                dd:DragDrop.IsDropTarget="True"
                                dd:DragDrop.DragHandler="{Binding}"
                                dd:DragDrop.DropHandler="{Binding}"
                                Grid.Row="3" 
                                SelectedItem="{Binding SelectedItem}"
                                ItemsSource="{Binding PrefabSlots}">

                                <ListBox.ItemTemplate>
                                    <ItemContainerTemplate>
                                        <Border Height="20">
                                            <TextBlock Padding="4" Text="{Binding Name}"/>
                                        </Border>
                                    </ItemContainerTemplate>
                                </ListBox.ItemTemplate>
                                
                            </ListBox>
                        </Grid>

                        <ComboBox 
                            Grid.Column="1"
                            x:Name="EntityCombobox"
                            Margin="8, 0, 8, 16" 
                            DockPanel.Dock="Bottom" 
                            SelectedItem="{Binding EntityManager.SelectedItem.Prefab}">
                            <ComboBox.Style>
                                <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=EntityCombobox, Path=HasItems}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="False" />
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>

                                                <Condition Binding="{Binding ElementName=EntityListBox, Path=HasItems}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="False" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            <ComboBox.ItemsSource>
                                <CompositeCollection>
                                    <CollectionContainer Collection="{Binding Path=Data.Prefabs, Source={StaticResource ModelEntityProxy}}" />
                                    <CollectionContainer Collection="{Binding Path=Data.Prefabs, Source={StaticResource LightEntityProxy}}" />
                                </CompositeCollection>
                            </ComboBox.ItemsSource>
                            
                            <ComboBox.ItemTemplate>
                                <ItemContainerTemplate>
                                    <Border Height="20">
                                        <TextBlock Padding="4" Text="{Binding Name}"/>
                                    </Border>
                                </ItemContainerTemplate>
                            </ComboBox.ItemTemplate>
                            
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Expander>
            
            <Expander Header="Cameras" IsExpanded="True">
                <Border Background="{DynamicResource HighDarkerColor}">
                    <StackPanel>
                        <Grid Height="100" Margin="8">

                            <ListBox 
                                x:Name="CameraListBox"
                                Style="{StaticResource ListBoxSlotWithButton}"
                                DataContext="{Binding CameraManager}"
                                AllowDrop="True"
                                dd:DragDrop.IsDragSource="True"
                                dd:DragDrop.IsDropTarget="True"
                                dd:DragDrop.DragHandler="{Binding}"
                                dd:DragDrop.DropHandler="{Binding}"
                                Grid.Row="3" 
                                SelectedItem="{Binding SelectedItem}"
                                ItemsSource="{Binding PrefabSlots}">

                                <ListBox.ItemTemplate>
                                    <ItemContainerTemplate>
                                        <Border Height="20">
                                            <TextBlock Padding="4" Text="{Binding Name}"/>
                                        </Border>
                                    </ItemContainerTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>
                        </Grid>

                        <ComboBox 
                            Grid.Column="1"
                            x:Name="CameraCombobox"
                            Margin="8, 0, 8, 16" 
                            DockPanel.Dock="Bottom" 
                            ItemsSource="{Binding Path=Data.Prefabs, Source={StaticResource CameraProxy}}"
                            SelectedItem="{Binding CameraManager.SelectedItem.Prefab}">
                            <ComboBox.Style>
                                <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                                    <Style.Triggers>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=CameraCombobox, Path=HasItems}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="False" />
                                        </MultiDataTrigger>

                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=CameraListBox, Path=HasItems}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsEnabled" Value="False" />
                                        </MultiDataTrigger>

                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                            
                            <ComboBox.ItemTemplate>
                                <ItemContainerTemplate>
                                    <Border Height="20">
                                        <TextBlock Padding="4" Text="{Binding Name}"/>
                                    </Border>
                                </ItemContainerTemplate>
                            </ComboBox.ItemTemplate>

                        </ComboBox>
                    </StackPanel>
                </Border>
            </Expander>
            
            <Expander Header="Background" IsExpanded="True">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button 
                        Height="22"
                        Grid.Column="1"
                        Margin="4"
                        Command="{Binding OpenColorSelectorCommand}"
                        Style="{StaticResource ButtonColorStyle}">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding BackgroundColor.SelectedColor}"/>
                        </Button.Background>
                    </Button>
                    <TextBlock 
                        Grid.Column="0" 
                        Padding="8, 0" 
                        HorizontalAlignment="Right" 
                        Text="Color" 
                        Foreground="{StaticResource TextBase}"/>
                </Grid>
            </Expander>

            <Views:TextureFilterManager DataContext="{Binding ModifierManager}"/>
            <ViewComponents:AmbientOcclusion DataContext="{Binding AmbientOcclusion}"/>

        </StackPanel>

    </Border>

</UserControl>
