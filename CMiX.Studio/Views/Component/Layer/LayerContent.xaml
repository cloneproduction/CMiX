<UserControl x:Class="CMiX.Studio.Views.Component.LayerContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Components="clr-namespace:CMiX.Core.Presentation.ViewModels.Components;assembly=CMiX.Core"
             xmlns:ViewComponents="clr-namespace:CMiX.Studio.Views.Component"
             xmlns:Presentation="clr-namespace:CMiX.Core.Presentation;assembly=CMiX.Core"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="d" 
             d:DesignHeight="587.333" d:DesignWidth="317.333">

    <UserControl.Resources>
        <Presentation:BindingProxy x:Key="ModelEntityProxy" Data="{Binding Path=DataContext.Project.CompositionManager.SelectedComposition.CompositionService.ModelEntityManager, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Views:MainWindow}}}"/>
        <Presentation:BindingProxy x:Key="LightEntityProxy" Data="{Binding Path=DataContext.Project.CompositionManager.SelectedComposition.CompositionService.LightEntityManager, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Views:MainWindow}}}"/>
    </UserControl.Resources>
    
    <Border
        Background="{DynamicResource DarkerColor}"
        IsEnabled="{Binding Converter={StaticResource NullToBool}}">
        <StackPanel>
            <Expander Header="Entities" IsExpanded="True">
                <Border Background="{DynamicResource DarkerColor}">
                    <StackPanel>
                        <Grid 
                            Height="100"                                         
                            Margin="8">
                            <ListBox 
                                Style="{StaticResource ListBoxWithButton}"
                                DataContext="{Binding}"
                                AllowDrop="True"
                                dd:DragDrop.IsDragSource="True"
                                dd:DragDrop.IsDropTarget="True"
                                dd:DragDrop.DragHandler="{Binding}"
                                dd:DragDrop.DropHandler="{Binding}"
                                Grid.Row="3" 
                                SelectedItem="{Binding SelectedItem}"
                                ItemsSource="{Binding Prefabs}">

                                <ListBox.ItemTemplate>
                                    <ItemContainerTemplate>
                                        <Border Height="20">
                                            <TextBlock Padding="4" Text="{Binding Name}"/>
                                        </Border>
                                    </ItemContainerTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                        <ComboBox Grid.Column="1" Margin="8, 0, 8, 16" DockPanel.Dock="Bottom" 
                                        SelectedItem="{Binding Coloration}">
                            <!--ItemsSource="{Binding Path=DataContext.ColorationManager.Prefabs, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Views:EntityPanel}}}">-->
                            <ComboBox.ItemsSource>
                                <CompositeCollection>
                                    <!--{Binding Data.CopyPostFXCommand, Source={StaticResource ProjectProxy}}-->
                                    <CollectionContainer Collection="{Binding Path=Data.Prefabs, Source={StaticResource ModelEntityProxy}}" />
                                    <CollectionContainer Collection="{Binding Path=Data.Prefabs, Source={StaticResource LightEntityProxy}}" />
                                </CompositeCollection>
                            </ComboBox.ItemsSource>
                            <ComboBox.ItemTemplate>
                                <ItemContainerTemplate>
                                    <Border Height="20">
                                        <TextBlock Padding="4" Text="{Binding Name}"/>
                                    </Border>
                                </ItemContainerTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Expander>
            <Expander Header="Background" IsExpanded="True">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button 
                                    Height="22"
                                    Grid.Column="1"
                                    Margin="4"
                                    Command="{Binding OpenColorSelectorCommand}"
                                    Style="{StaticResource ButtonColorStyle}">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding BackgroundColor.SelectedColor}"/>
                        </Button.Background>
                    </Button>
                    <TextBlock 
                                    Grid.Column="0" 
                                    Padding="8, 0" 
                                    HorizontalAlignment="Right" 
                                    Text="Color" 
                                    Foreground="{StaticResource TextBase}"/>
                </Grid>
            </Expander>
            <ViewComponents:AmbientOcclusion DataContext="{Binding AmbientOcclusion}"/>
        </StackPanel>

    </Border>


</UserControl>
