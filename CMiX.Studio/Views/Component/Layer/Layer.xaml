<UserControl
    x:Class="CMiX.Studio.Views.Layer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Light="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:Prefabs="clr-namespace:CMiX.Core.Prefabs;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="639.46"
    d:DesignWidth="351.206"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">



    <Border Background="{DynamicResource HighDarkerColor}" IsEnabled="{Binding Converter={StaticResource NullToBool}}">
        <DockPanel>

            <TabControl
                Background="{DynamicResource HighHighDarkerColor}"
                Style="{StaticResource TabControlVerticalPanel}"
                TabStripPlacement="Left">



                <TabItem IsSelected="True">
                    <TabItem.Header>
                        <Image Margin="8" Source="{StaticResource Entity}" />
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <i:Interaction.Behaviors>
                            <Behaviors:ScrollViewerBehavior />
                        </i:Interaction.Behaviors>
                        <StackPanel>

                            <Views:PrefabSlotManager Margin="8" DataContext="{Binding ModelEntityManager}">

                                <Views:PrefabSlotManager.Resources>
                                    <CollectionViewSource x:Key="CamerasCollection" Source="{Binding Path=DataContext.PrefabRepositories.Cameras, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
                                    <CollectionViewSource x:Key="EntitiesCollection" Source="{Binding Path=DataContext.PrefabRepositories.Entities, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
                                    <CollectionViewSource x:Key="LightsCollection" Source="{Binding Path=DataContext.PrefabRepositories.Lights, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
                                    <CollectionViewSource x:Key="TextsCollection" Source="{Binding Path=DataContext.PrefabRepositories.Texts, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
                                </Views:PrefabSlotManager.Resources>

                                <Views:PrefabSlotManager.ItemsSource>
                                    <CompositeCollection>
                                        <CollectionContainer Collection="{Binding Source={StaticResource CamerasCollection}}" />
                                        <CollectionContainer Collection="{Binding Source={StaticResource EntitiesCollection}}" />
                                        <CollectionContainer Collection="{Binding Source={StaticResource LightsCollection}}" />
                                        <CollectionContainer Collection="{Binding Source={StaticResource TextsCollection}}" />
                                    </CompositeCollection>
                                </Views:PrefabSlotManager.ItemsSource>

                                <Views:PrefabSlotManager.SelectionPanel>
                                    <Views:ButtonOpenSelectionPanel Caption="Add Entity">
                                        <Views:ButtonOpenSelectionPanel.SelectionPanel>
                                            <Views:EntitySelectionPanel />
                                        </Views:ButtonOpenSelectionPanel.SelectionPanel>
                                    </Views:ButtonOpenSelectionPanel>
                                </Views:PrefabSlotManager.SelectionPanel>

                                <Views:PrefabSlotManager.ItemTemplate>
                                    <DockPanel HorizontalAlignment="Stretch">
                                        <TextBlock HorizontalAlignment="Stretch" Text="{Binding Path=PrefabService.Name.Value}" />
                                        <Ellipse
                                            Width="5"
                                            Height="5"
                                            DockPanel.Dock="Right"
                                            Fill="Pink" />
                                    </DockPanel>
                                </Views:PrefabSlotManager.ItemTemplate>

                            </Views:PrefabSlotManager>

                            <ContentControl Content="{Binding}" DataContext="{Binding ModelEntityManager.SelectedItem}">
                                <ContentControl.Resources>
                                    <DataTemplate DataType="{x:Type Compositing:Entity}">
                                        <Views:ModelEntity DataContext="{Binding}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type Prefabs:EmptyPrefab}">
                                        <Border />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type Cameras:Camera}">
                                        <Views:Camera DataContext="{Binding}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type Lights:LightEntity}">
                                        <Views:LightEntity DataContext="{Binding}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type Compositing:TextEntity}">
                                        <Views:TextEntity DataContext="{Binding}" />
                                    </DataTemplate>
                                </ContentControl.Resources>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!--<TabItem>
                    <TabItem.Style>
                        <Style BasedOn="{StaticResource TabItemVerticalPanel}" TargetType="{x:Type TabItem}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModelEntityManager.SelectedItem, Converter={StaticResource DataToType}}" Value="{x:Type Compositing:Entity}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabItem.Style>
                    <TabItem.Header>
                        <Image Margin="8" Source="{StaticResource World}" />
                    </TabItem.Header>

                    <StackPanel>
                        <Views:Outliner
                            Margin="8"
                            DataContext="{Binding ModelEntityManager.SelectedItem.MaterialManager}"
                            ItemsSource="{Binding ControlRepository.Materials}">
                            <Views:Outliner.SelectionPanel>
                                <Button
                                    Command="{Binding AddItemCommand}"
                                    CommandParameter="{x:Type Materials:MaterialModel}"
                                    Content="New"
                                    Style="{DynamicResource ButtonRoundedRight}" />
                            </Views:Outliner.SelectionPanel>
                        </Views:Outliner>

                        <Border Visibility="{Binding ModelEntityManager.SelectedItem.MaterialManager.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                            <Views:Material DataContext="{Binding ModelEntityManager.SelectedItem.MaterialManager.SelectedItem}" />
                        </Border>

                    </StackPanel>

                </TabItem>

                <TabItem>
                    <TabItem.Style>
                        <Style BasedOn="{StaticResource TabItemVerticalPanel}" TargetType="{x:Type TabItem}">
                            <Setter Property="Visibility" Value="Hidden" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ModelEntityManager.SelectedItem, Converter={StaticResource DataToType}}" Value="{x:Type Compositing:Entity}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TabItem.Style>
                    <TabItem.Header>
                        <Image Margin="8" Source="{StaticResource Settings}" />
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <i:Interaction.Behaviors>
                            <Behaviors:ScrollViewerBehavior />
                        </i:Interaction.Behaviors>
                        <Border Background="{DynamicResource HighHighDarkerColor}">
                            <Views:ModifierManager DataContext="{Binding ModelEntityManager.SelectedItem.ModifierManager}">
                                <Views:ModifierManager.SelectionPanel>
                                    <Views:EntityModifierSelectionPanel DataContext="{Binding}" />
                                </Views:ModifierManager.SelectionPanel>
                            </Views:ModifierManager>
                        </Border>
                    </ScrollViewer>

                </TabItem>-->

                <TabItem>
                    <TabItem.Header>
                        <Image Margin="8" Source="{StaticResource PostFX}" />
                    </TabItem.Header>
                    <StackPanel>
                        <Panels:IndentedExpander Header="Texture Filters">
                            <Views:ModifierManager DataContext="{Binding TextureModifierManager}">
                                <Views:ModifierManager.SelectionPanel>
                                    <Views:TextureFilterSelectionPanel DataContext="{Binding}" />
                                </Views:ModifierManager.SelectionPanel>
                            </Views:ModifierManager>
                        </Panels:IndentedExpander>

                        <Panels:IndentedExpander Header="Modifiers">
                            <Views:ModifierManager DataContext="{Binding LayerModifierManager}">
                                <Views:ModifierManager.SelectionPanel>
                                    <Views:LayerModifierSelectionPanel DataContext="{Binding}" />
                                </Views:ModifierManager.SelectionPanel>
                            </Views:ModifierManager>
                        </Panels:IndentedExpander>

                        <Views:AmbientOcclusion DataContext="{Binding AmbientOcclusion}" />

                        <Views:LocalReflection DataContext="{Binding LocalReflection}" />
                    </StackPanel>
                </TabItem>
            </TabControl>

        </DockPanel>
    </Border>

</UserControl>
