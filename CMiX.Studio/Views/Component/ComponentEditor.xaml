<UserControl x:Class="CMiX.Studio.Views.ComponentEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ViewModelComponents="clr-namespace:CMiX.Core.Presentation.ViewModels.Components;assembly=CMiX.Core"
             xmlns:ViewComponents="clr-namespace:CMiX.Studio.Views.Component"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             mc:Ignorable="d" 
             d:DesignHeight="572.667" 
             d:DesignWidth="773.333">

    <UserControl.Resources>
        <DataTemplate x:Key="CompositionTemplate" DataType="{x:Type ViewModelComponents:Composition}">
            <ViewComponents:Composition DataContext="{Binding}"/>
        </DataTemplate>

        <DataTemplate x:Key="EntityTemplate" DataType="{x:Type ViewModelComponents:Entity}">
            <ViewComponents:Entity DataContext="{Binding}"/>
        </DataTemplate>

        <DataTemplate x:Key="LayerTemplate" DataType="{x:Type ViewModelComponents:Layer}">
            <ViewComponents:Layer DataContext="{Binding}"/>
        </DataTemplate>

        <ViewModelComponents:ComponentTemplateSelector 
            x:Key="ComponentTemplateSelector" 
            EntityTemplate="{StaticResource EntityTemplate}"
            LayerTemplate="{StaticResource LayerTemplate}" 
            CompositionTemplate="{StaticResource CompositionTemplate}"/>
    </UserControl.Resources>

    <ContentPresenter 
        DataContext="{Binding SelectedComponent}"
        Content="{Binding SelectedComponent}"
        ContentTemplateSelector="{StaticResource ComponentTemplateSelector}">
    </ContentPresenter>

</UserControl>
