<UserControl x:Class="CMiX.Studio.Views.LightSpot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core" 
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
             xmlns:Behaviors="clr-namespace:CMiX.Core.Presentation.Behaviors;assembly=CMiX.Core" 
             xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <BaseControl:VectorXYZ DataContext="{Binding Position}"/>
        <BaseControl:VectorXYZ Margin="0, 8" DataContext="{Binding Target}"/>
        
        <Grid Height="22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" BorderThickness="1, 0, 1, 1">
                <Controls:DistanceSlider 
                            Position="Top" 
                            Style="{StaticResource DistanceSliderStyle}" 
                            Value="{Binding Path=Range.Amount}">
                    <i:Interaction.Behaviors>
                        <Behaviors:ContextMenuMouseDownBehavior/>
                    </i:Interaction.Behaviors>
                </Controls:DistanceSlider>
            </Border>

            <TextBlock 
                Padding="8, 0" 
                DockPanel.Dock="Right"
                HorizontalAlignment="Right" 
                Text="Range" 
                Foreground="{DynamicResource TextBase}"/>

        </Grid>

        <Grid Height="22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" BorderThickness="1, 0, 1, 1">
                <Controls:DistanceSlider 
                            Position="Middle" 
                            Style="{StaticResource DistanceSliderStyle}" 
                            Value="{Binding Path=Angle.Amount}">
                    <i:Interaction.Behaviors>
                        <Behaviors:ContextMenuMouseDownBehavior/>
                    </i:Interaction.Behaviors>
                </Controls:DistanceSlider>
            </Border>

            <TextBlock 
                Padding="8, 0" 
                DockPanel.Dock="Right"
                HorizontalAlignment="Right" 
                Text="Angle" 
                Foreground="{DynamicResource TextBase}"/>

        </Grid>
        <Grid Height="22">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" BorderThickness="1, 0, 1, 2">
                <Controls:DistanceSlider 
                            Position="Bottom" 
                            Style="{StaticResource DistanceSliderStyle}" 
                            Value="{Binding Path=Softness.Amount}">
                    <i:Interaction.Behaviors>
                        <Behaviors:ContextMenuMouseDownBehavior/>
                    </i:Interaction.Behaviors>
                </Controls:DistanceSlider>
            </Border>

            <TextBlock 
                Padding="8, 0" 
                DockPanel.Dock="Right"
                HorizontalAlignment="Right" 
                Text="Softness" 
                Foreground="{DynamicResource TextBase}"/>

        </Grid>
    </StackPanel>
</UserControl>
