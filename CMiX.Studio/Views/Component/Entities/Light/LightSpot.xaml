<UserControl
    x:Class="CMiX.Studio.Views.LightSpot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="272.667"
    d:DesignWidth="221.333"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControl:VectorXYZ Caption="Position" DataContext="{Binding Position}" />

        <BaseControl:VectorXYZ
            Margin="0,8"
            Caption="Target"
            DataContext="{Binding Target}" />

        <BaseControl:DragValue
            Caption="Range"
            Position="Top"
            Value="{Binding Range.Value}" />

        <BaseControl:DragValue
            Margin="0,1"
            Caption="Angle"
            Position="Middle"
            Value="{Binding Angle.Value}" />

        <BaseControl:DragValue
            Caption="Softness"
            Position="Bottom"
            Value="{Binding Softness.Value}" />

    </StackPanel>

</UserControl>
