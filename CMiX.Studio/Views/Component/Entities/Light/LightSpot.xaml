<UserControl
    x:Class="CMiX.Studio.Views.LightSpot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.Controls.Panels"
    d:DesignHeight="272.667"
    d:DesignWidth="221.333"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControl:VectorXYZ Caption="Position" DataContext="{Binding Position}" />

        <BaseControl:VectorXYZ
            Margin="0,8"
            Caption="Target"
            DataContext="{Binding Target}" />

        <Panels:PositionedStackPanel>
            
            <BaseControl:DragValue
                Caption="Range"
                Value="{Binding Range.Value}" />
            
            <BaseControl:DragValue
                Margin="0,1"
                Caption="Angle"
                Value="{Binding Angle.Value}" />
            
            <BaseControl:DragValue
                Caption="Softness"
                Value="{Binding Softness.Value}" />
            
        </Panels:PositionedStackPanel>
        
    </StackPanel>

</UserControl>
