<UserControl x:Class="CMiX.Studio.Views.LightEntity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="193.179" d:DesignWidth="275.094">

    <UserControl.Resources>
        <ResourceDictionary>

            <DataTemplate x:Key="PointLightTemplate">
                <Views:LightPoint Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="SpotLightTemplate">
                <Views:LightSpot Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="AmbientLightTemplate">
                <Views:LightAmbient DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="DirectionalLightTemplate">
                <Views:LightDirectional Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>


    <StackPanel>

        <Panels:IndentedExpander Header="Modifiers">
            <Views:ModifierManager DataContext="{Binding ModifierManager}">
                <Views:ModifierManager.SelectionPanel>
                    <Views:LightModifierSelectionPanel DataContext="{Binding }"/>
                </Views:ModifierManager.SelectionPanel>
            </Views:ModifierManager>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Settings" Indentation="0">
            <StackPanel Margin="8">
                
                <BaseControls:ColorSelector 
                    Caption="Color"
                    SelectedColor="{Binding LightColor.SelectedColor}" 
                    ViewModel="{Binding LightColor}"/>

                <BaseControls:DragValue 
                    Margin="0, 8" 
                    Caption="Intensity" 
                    Value="{Binding Intensity.Value}"/>

                <BaseControls:ComboBox 
                    Caption="Type"                
                    SelectedItem="{Binding LightTypeSelector.Value}"              
                    ItemsSource="{Binding Source={StaticResource LightType}}"/>

                <ContentControl
                    Margin="0, 0, 0, 0"
                    DataContext="{Binding}"
                    Content="{Binding}">

                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Style.Triggers>

                                <DataTrigger Binding="{Binding LightTypeSelector.Value}" Value="{x:Static Lights:LightType.PointLight}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource PointLightTemplate}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding LightTypeSelector.Value}" Value="{x:Static Lights:LightType.SpotLight}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource SpotLightTemplate}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding LightTypeSelector.Value}" Value="{x:Static Lights:LightType.AmbientLight}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource AmbientLightTemplate}"/>
                                </DataTrigger>

                                <DataTrigger Binding="{Binding LightTypeSelector.Value}" Value="{x:Static Lights:LightType.DirectionalLight}">
                                    <Setter Property="ContentTemplate" Value="{StaticResource DirectionalLightTemplate}"/>
                                </DataTrigger>

                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>
            </StackPanel>
 
        </Panels:IndentedExpander>
    </StackPanel>
</UserControl>