<UserControl
    x:Class="CMiX.Studio.Views.LightEntity"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    d:DesignHeight="193.179"
    d:DesignWidth="275.094"
    mc:Ignorable="d">

    <StackPanel>
        <Panels:IndentedExpander Header="Transform" IsExpanded="{Binding TransformSRTIsExpanded}">
            <Views:TransformSRT DataContext="{Binding TransformSRT}" Margin="8"/>
        </Panels:IndentedExpander>
        
        <Panels:IndentedExpander Header="Modifiers" IsExpanded="{Binding ModifierManagerIsExpanded}">
            <Views:ModifierManager DataContext="{Binding ModifierManager}">
                <Views:ModifierManager.SelectionPanel>
                    <Views:AutoSelectionPanel PanelOwner="{x:Type Lights:LightEntity}" />
                </Views:ModifierManager.SelectionPanel>
            </Views:ModifierManager>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander
            Header="Settings"
            Indentation="0"
            IsExpanded="{Binding SettingsIsExpanded}">
            <Views:LightSettings DataContext="{Binding Settings}" />
        </Panels:IndentedExpander>

    </StackPanel>

</UserControl>