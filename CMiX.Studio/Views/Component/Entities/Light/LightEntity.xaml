<UserControl
    x:Class="CMiX.Studio.Views.LightEntity"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="193.179"
    d:DesignWidth="275.094"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel>

        <Panels:IndentedExpander
            Header="Settings"
            Indentation="0"
            IsExpanded="{Binding SettingsIsExpanded}">
            <Views:LightSettings DataContext="{Binding Settings}" />
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Modifiers" IsExpanded="{Binding ModifierIsExpanded}">
            <Views:ModifierManager DataContext="{Binding ModifierManager}">
                <Views:ModifierManager.SelectionPanel>
                    <Views:LightModifierSelectionPanel DataContext="{Binding}" />
                </Views:ModifierManager.SelectionPanel>
            </Views:ModifierManager>
        </Panels:IndentedExpander>

    </StackPanel>
</UserControl>