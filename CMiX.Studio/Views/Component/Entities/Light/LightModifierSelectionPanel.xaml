<UserControl
    x:Class="CMiX.Studio.Views.LightModifierSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ColorModifiers="clr-namespace:CMiX.Core.Colors.Modifiers;assembly=CMiX.Core"
    xmlns:Modifiers="clr-namespace:CMiX.Core.Transformation.Modifiers;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="130.856"
    d:DesignWidth="209.355"
    mc:Ignorable="d">

    <StackPanel>

        <Button
            Grid.Row="0"
            Grid.Column="0"
            Width="120"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Modifiers:RandomPositionModel}"
            Content="Random Position"
            Style="{StaticResource ButtonItemControl}" />

        <Button
            Grid.Row="0"
            Grid.Column="0"
            Width="120"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type ColorModifiers:RandomHSVModel}"
            Content="Random HSV"
            Style="{StaticResource ButtonItemControl}" />

    </StackPanel>

</UserControl>
