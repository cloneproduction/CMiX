<UserControl x:Class="CMiX.Studio.Views.MaskPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:ViewComponents="clr-namespace:CMiX.Studio.Views.Component"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="d"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True" 
             d:DesignHeight="516" d:DesignWidth="376.96">

    <Border VerticalAlignment="Stretch">
        <TabControl 
            TabStripPlacement="Left" 
            Background="{DynamicResource HighHighDarkerColor}" 
            Style="{StaticResource TabControlVerticalPanel}" >

            <TabItem x:Name="EntityTab" >
                <TabItem.Header>
                    <Image Margin="7" Source="{DynamicResource Cube}"/>
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <Grid Background="{DynamicResource DarkerColor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="13*"/>
                            <RowDefinition Height="160*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.RowSpan="2">
                            <Grid 
                                Height="100"                                         
                                DockPanel.Dock="Top"
                                Margin="8">
                                <ListBox 
                                    DataContext="{Binding MeshEntityManager}"
                                    AllowDrop="True"
                                    dd:DragDrop.IsDragSource="True"
                                    dd:DragDrop.IsDropTarget="True"
                                    dd:DragDrop.DragHandler="{Binding}"
                                    dd:DragDrop.DropHandler="{Binding}"
                                    Grid.Row="3" 
                                    SelectedItem="{Binding SelectedEntity}"
                                    ItemsSource="{Binding Layer.MeshEntities}">

                                    <ListBox.ItemTemplate>
                                        <ItemContainerTemplate>
                                            <Border Height="20">
                                                <TextBlock Padding="4" Text="{Binding Name}"/>
                                            </Border>
                                        </ItemContainerTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <Border Visibility="{Binding MeshEntityManager.SelectedEntity, Converter={StaticResource NullToVisibility}}">
                                <ViewComponents:Mesh DataContext="{Binding MeshEntityManager.SelectedEntity}"/>
                            </Border>

                        </DockPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Image Margin="6" Source="{DynamicResource MeshLight}"/>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <Grid Background="{DynamicResource DarkerColor}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="13*"/>
                            <RowDefinition Height="160*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.RowSpan="2">
                            <Grid 
                                Height="100"                                         
                                DockPanel.Dock="Top"
                                Margin="8">
                                <ListBox 
                                    DataContext="{Binding LightEntityManager}"
                                    AllowDrop="True"
                                    dd:DragDrop.IsDragSource="True"
                                    dd:DragDrop.IsDropTarget="True"
                                    dd:DragDrop.DragHandler="{Binding}"
                                    dd:DragDrop.DropHandler="{Binding}"
                                    Grid.Row="3" 
                                    SelectedItem="{Binding SelectedEntity}"
                                    ItemsSource="{Binding Layer.LightEntities}">

                                    <ListBox.ItemTemplate>
                                        <ItemContainerTemplate>
                                            <Border Height="20">
                                                <TextBlock Padding="4" Text="{Binding Name}"/>
                                            </Border>
                                        </ItemContainerTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>

                            <Border Visibility="{Binding LightEntityManager.SelectedEntity, Converter={StaticResource NullToVisibility}}">
                                <Views:LightEntity Margin="8" DataContext="{Binding LightEntityManager.SelectedEntity}"/>
                            </Border>

                        </DockPanel>
                    </Grid>
                </ScrollViewer>


            </TabItem>
            <TabItem Header="C">
                <Border Background="{DynamicResource DarkerColor}">
                    <Views:Camera DataContext="{Binding Camera}"/>
                </Border>

            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <Border Background="{DynamicResource DarkerColor}">
                        <Image Margin="8" Source="{DynamicResource World}"/>
                    </Border>

                </TabItem.Header>
                <StackPanel>
                    <Expander Header="Background">
                        <Grid Margin="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.9*"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button 
                                Height="22"
                                Grid.Column="1"
                                Margin="4"
                                Command="{Binding OpenColorSelectorCommand}"
                                Style="{StaticResource ButtonColorStyle}">
                                <Button.Background>
                                    <SolidColorBrush Color="{Binding BackgroundColor.SelectedColor}"/>
                                </Button.Background>
                            </Button>
                            <TextBlock 
                                Grid.Column="0" 
                                Padding="8, 0" 
                                HorizontalAlignment="Right" 
                                Text="Color" 
                                Foreground="{StaticResource TextBase}"/>
                        </Grid>
                    </Expander>
                </StackPanel>
            </TabItem>

            <TabItem Header="Fx">
                <StackPanel>
                    <Expander Header="Filters">
                        <Views:TextureFilterManager DataContext="{Binding ModifierManager}"/>
                    </Expander>
                    <ViewComponents:AmbientOcclusion DataContext="{Binding AmbientOcclusion}"/>
                </StackPanel>

            </TabItem>
        </TabControl>
    </Border>



