<UserControl x:Class="CMiX.Studio.Views.MeshSphere"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:Behaviors="clr-namespace:CMiX.Core.Presentation.Behaviors;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <BaseControl:VectorXYZ DataContext="{Binding Scale}"/>
        <BaseControl:VectorXYZ Margin="0, 8" DataContext="{Binding Offset}"/>

        <Grid Height="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" BorderThickness="1, 0, 1, 2">
                <Controls:DistanceSlider 
                            Position="Default" 
                            Style="{StaticResource DistanceSliderStyle}" 
                            Value="{Binding Path=Radius.Amount}">
                    <i:Interaction.Behaviors>
                        <Behaviors:ContextMenuMouseDownBehavior/>
                    </i:Interaction.Behaviors>
                </Controls:DistanceSlider>
            </Border>
            <DockPanel Grid.Column="0" >
                <TextBlock 
                    Padding="8, 0" 
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right" 
                    Text="Radius" 
                    Foreground="{DynamicResource TextBase}"/>

                <TextBlock
                    DockPanel.Dock="Right"
                    HorizontalAlignment="Right" 
                    Text="{Binding Name}"/>
            </DockPanel>
        </Grid>

        <Grid Margin="0, 8" Height="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Controls:Counter 
                Grid.Column="1"
                DataContext="{Binding Tessellation}"
                Style="{DynamicResource CMiXCounterStyle}"
                StepValue="1"
                HorizontalAlignment="Stretch"
                Value="{Binding Count, Mode=TwoWay}"/>

            <TextBlock 
                Padding="8, 0" 
                HorizontalAlignment="Right" 
                Text="Tessellation" 
                Foreground="{DynamicResource TextBase}"/>
        </Grid>
        
    </StackPanel>
</UserControl>
