<UserControl x:Class="CMiX.Studio.Views.Component.Mesh"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ViewModels="clr-namespace:CMiX.Core.Presentation.ViewModels;assembly=CMiX.Core"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="778" d:DesignWidth="330">

    <UserControl.Resources>
        <ResourceDictionary>

            <ObjectDataProvider x:Key="MeshType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="ViewModels:MeshType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <DataTemplate x:Key="MeshBoxTemplate">
                <Views:MeshBox DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="MeshSphereTemplate">
                <Views:MeshSphere DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="MeshTorusTemplate">
                <Views:MeshTorus DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="MeshConeTemplate">
                <Views:MeshCone DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="MeshCylinderTemplate">
                <Views:MeshCylinder DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="MeshPlaneTemplate">
                <Views:MeshPlane DataContext="{Binding}"/>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="8, 16">

            <Grid Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <ComboBox 
                        Grid.Column="1"
                        SelectedItem="{Binding MeshTypeSelector.Selection}"              
                        ItemsSource="{Binding Source={StaticResource MeshType}}"/>
                <TextBlock 
                        Grid.Column="0" 
                        Padding="8, 0" 
                        HorizontalAlignment="Right" 
                        Text="Type" 
                        Foreground="{StaticResource TextBase}"/>
            </Grid>

            <ContentControl
                        Margin="0, 8, 0, 0"
                        DataContext="{Binding}"
                        Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MeshTypeSelector.Selection}" Value="{x:Static ViewModels:MeshType.Box}">
                                <Setter Property="ContentTemplate" Value="{StaticResource MeshBoxTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MeshTypeSelector.Selection}" Value="{x:Static ViewModels:MeshType.Sphere}">
                                <Setter Property="ContentTemplate" Value="{StaticResource MeshSphereTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MeshTypeSelector.Selection}" Value="{x:Static ViewModels:MeshType.Torus}">
                                <Setter Property="ContentTemplate" Value="{StaticResource MeshTorusTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MeshTypeSelector.Selection}" Value="{x:Static ViewModels:MeshType.Cone}">
                                <Setter Property="ContentTemplate" Value="{StaticResource MeshConeTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MeshTypeSelector.Selection}" Value="{x:Static ViewModels:MeshType.Cylinder}">
                                <Setter Property="ContentTemplate" Value="{StaticResource MeshCylinderTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MeshTypeSelector.Selection}" Value="{x:Static ViewModels:MeshType.Plane}">
                                <Setter Property="ContentTemplate" Value="{StaticResource MeshPlaneTemplate}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>

        </StackPanel>

</UserControl>
