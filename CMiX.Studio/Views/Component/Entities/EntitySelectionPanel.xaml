<UserControl
    x:Class="CMiX.Studio.Views.EntitySelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="99.333"
    d:DesignWidth="217.333"
    mc:Ignorable="d">

    <StackPanel>
        <StackPanel.Resources>
            <Style BasedOn="{StaticResource ButtonItemControl}" TargetType="Button" />
        </StackPanel.Resources>

        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Compositing:Entity}"
            Style="{StaticResource ButtonItemControl}">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="12"
                        Height="12"
                        Margin="0,0,8,0"
                        Opacity="0.7"
                        Source="{DynamicResource Geometry}" />
                    <TextBlock Text="Entity" />
                </StackPanel>
            </Button.Content>
        </Button>

        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Compositing:TextEntity}"
            Style="{StaticResource ButtonItemControl}">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="12"
                        Height="12"
                        Margin="0,0,8,0"
                        Opacity="0.7"
                        Source="{DynamicResource TextIcon}" />
                    <TextBlock Text="Text" />
                </StackPanel>
            </Button.Content>
        </Button>

    </StackPanel>

</UserControl>
