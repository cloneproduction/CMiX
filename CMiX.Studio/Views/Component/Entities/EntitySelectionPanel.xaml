<UserControl x:Class="CMiX.Studio.Views.Component.Entities.EntitySelectionPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"

             xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
             xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="99.333" d:DesignWidth="217.333">

    <StackPanel Grid.Column="1">


        <Button 
            Style="{StaticResource ButtonItemControl}"
            Command="{Binding AddItemCommand}" 
            CommandParameter="{x:Type Compositing:Entity}" 
            Grid.Row="2"
            Grid.Column="1"
            VerticalAlignment="Center" 
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22" 
            Content="Entity"/>

        <Button 
            Style="{StaticResource ButtonItemControl}"
            Command="{Binding AddItemCommand}" 
            CommandParameter="{x:Type Cameras:Camera}" 
            Grid.Row="1"
            Grid.Column="1"
            VerticalAlignment="Center" 
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22" 
            Content="Camera"/>

        <Button 
            Style="{StaticResource ButtonItemControl}"
            Command="{Binding AddItemCommand}" 
            CommandParameter="{x:Type Lights:LightEntity}" 
            Grid.Row="1"
            Grid.Column="2"
            VerticalAlignment="Center" 
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22" 
            Content="Light"/>

    </StackPanel>
</UserControl>
