<UserControl
    x:Class="CMiX.Studio.Views.EntitySelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="99.333"
    d:DesignWidth="217.333"
    mc:Ignorable="d">

    <StackPanel>

        <Button
            Grid.Row="2"
            Grid.Column="1"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Compositing:EntityModel}"
            Style="{StaticResource ButtonItemControl}">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="12"
                        Height="12"
                        Margin="0,0,8,0"
                        Opacity="0.7"
                        Source="{DynamicResource Geometry}" />
                    <TextBlock Text="Entity" />
                </StackPanel>
            </Button.Content>
        </Button>

        <Button
            Grid.Row="1"
            Grid.Column="1"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Cameras:CameraModel}"
            Style="{StaticResource ButtonItemControl}">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="12"
                        Height="12"
                        Margin="0,0,8,0"
                        Opacity="0.7"
                        Source="{DynamicResource Camera}" />
                    <TextBlock Text="Camera" />
                </StackPanel>

            </Button.Content>
        </Button>

        <Button
            Grid.Row="1"
            Grid.Column="2"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Lights:LightEntityModel}"
            Style="{StaticResource ButtonItemControl}">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <Image
                        Width="12"
                        Height="12"
                        Margin="0,0,8,0"
                        Opacity="0.7"
                        Source="{DynamicResource MeshLight}" />
                    <TextBlock Text="Light" />
                </StackPanel>
            </Button.Content>
        </Button>

    </StackPanel>

</UserControl>
