<UserControl x:Class="CMiX.Studio.Views.LightEntity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:ViewModels="clr-namespace:CMiX.Core.Presentation.ViewModels;assembly=CMiX.Core"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs" 
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity" 
             xmlns:Behaviors="clr-namespace:CMiX.Core.Presentation.Behaviors;assembly=CMiX.Core"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="193.179" d:DesignWidth="275.094">

    <UserControl.Resources>
        <ResourceDictionary>

            <ObjectDataProvider x:Key="MeshType" MethodName="GetValues" ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="ViewModels:LightType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <DataTemplate x:Key="PointLightTemplate">
                <Views:LightPoint DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="SpotLightTemplate">
                <Views:LightSpot DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="AmbientLightTemplate">
                <Views:LightAmbient DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="DirectionalLightTemplate">
                <Views:LightDirectional DataContext="{Binding}"/>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>


    <StackPanel>

        <Grid Margin="0, 0, 0, 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock 
                    Text="Color" 
                    HorizontalAlignment="Right" Padding="4, 0"
                    VerticalAlignment="Center"/>

            <Border Grid.Column="1">
                <Button Height="25"
                        Command="{Binding OpenColorSelectorCommand}"
                        Style="{StaticResource ButtonColorStyle}">
                    <Button.Background>
                        <SolidColorBrush Color="{Binding LightColor.SelectedColor}"/>
                    </Button.Background>
                </Button>
            </Border>
        </Grid>

        <Grid Height="22" Margin="0, 0, 0, 0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" BorderThickness="1, 0, 1, 2">
                <Controls:DistanceSlider 
                            Position="Default" 
                            Style="{StaticResource DistanceSliderStyle}" 
                            Value="{Binding Path=Intensity.Amount}">
                    <i:Interaction.Behaviors>
                        <Behaviors:ContextMenuMouseDownBehavior/>
                    </i:Interaction.Behaviors>
                </Controls:DistanceSlider>
            </Border>

            <TextBlock 
                Padding="8, 0" 
                DockPanel.Dock="Right"
                HorizontalAlignment="Right" 
                Text="Intensity" 
                Foreground="{DynamicResource TextBase}"/>

        </Grid>

        <Grid Height="22" Margin="0, 8, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ComboBox 
                Grid.Column="1"
                SelectedItem="{Binding LightTypeSelector.Selection}"              
                ItemsSource="{Binding Source={StaticResource MeshType}}"/>
            <TextBlock 
                Grid.Column="0" 
                Padding="8, 0" 
                HorizontalAlignment="Right" 
                Text="Type" 
                Foreground="{StaticResource TextBase}"/>
        </Grid>



        <ContentControl
            Margin="0, 8, 0, 0"
            DataContext="{Binding}"
            Content="{Binding}">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Style.Triggers>

                        <DataTrigger Binding="{Binding LightTypeSelector.Selection}" Value="{x:Static ViewModels:LightType.PointLight}">
                            <Setter Property="ContentTemplate" Value="{StaticResource PointLightTemplate}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding LightTypeSelector.Selection}" Value="{x:Static ViewModels:LightType.SpotLight}">
                            <Setter Property="ContentTemplate" Value="{StaticResource SpotLightTemplate}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding LightTypeSelector.Selection}" Value="{x:Static ViewModels:LightType.AmbientLight}">
                            <Setter Property="ContentTemplate" Value="{StaticResource AmbientLightTemplate}"/>
                        </DataTrigger>

                        <DataTrigger Binding="{Binding LightTypeSelector.Selection}" Value="{x:Static ViewModels:LightType.DirectionalLight}">
                            <Setter Property="ContentTemplate" Value="{StaticResource DirectionalLightTemplate}"/>
                        </DataTrigger>

                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>

    </StackPanel>
</UserControl>
