<UserControl x:Class="CMiX.Studio.Views.ModelEntity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
             xmlns:Component="clr-namespace:CMiX.Studio.Views.Component"
             xmlns:Manager="clr-namespace:CMiX.Studio.Views.Managers"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="486" d:DesignWidth="322.667">

    <!--<UserControl.Resources>
        <CollectionViewSource x:Key="FilteredItems" 
                                Source="{Binding PrefabRepository.Prefabs}"
                                IsLiveFilteringRequested="True"
                                Filter="CollectionViewSource_Filter" />
    </UserControl.Resources>-->
    <StackPanel>

        <Panels:IndentedExpander Header="Modifiers" IsExpanded="{Binding ModifierManager.IsExpanded}">
            <Views:ModifierManager DataContext="{Binding ModifierManager}">
                <Views:ModifierManager.SelectionPanel>
                    <Views:EntityModifierSelectionPanel DataContext="{Binding }"/>
                </Views:ModifierManager.SelectionPanel>
            </Views:ModifierManager>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Material" IsExpanded="{Binding MaterialSelector.IsExpanded}">
            <StackPanel>

                <BaseControls:ColorSelector 
                    Margin="8, 8, 8, 0"
                    Caption="Base Color" 
                    SelectedColor="{Binding BaseColor.SelectedColor}"
                    ViewModel="{Binding BaseColor}"/>

                <Manager:PrefabManagerComboBox
                    DataContext="{Binding MaterialSelector}"
                    ItemsSource="{Binding Prefabs}"
                    AddItemCommand="{Binding AddItemCommand}"
                    SelectedItem="{Binding SelectedItem}"
                    SelectionChangedCommand="{Binding SelectedItemChangedCommand}"
                    SelectionChangedCommandParameter="{Binding SelectedItem}">
                    <!--<Manager:PrefabManagerComboBox.ItemsSource>
                        <Binding>
                            <Binding.Source>
                                <CollectionViewSource
                                    Source="{Binding PrefabRepository.Prefabs}"
                                    IsLiveFilteringRequested="True"
                                    Filter="CollectionViewSource_Filter" />
                            </Binding.Source>
                        </Binding>
                    </Manager:PrefabManagerComboBox.ItemsSource>-->

                </Manager:PrefabManagerComboBox>

                <Border Visibility="{Binding MaterialSelector.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                    <Views:Material DataContext="{Binding MaterialSelector.SelectedItem}"/>
                </Border>
                
            </StackPanel>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Mesh" IsExpanded="{Binding Mesh.IsExpanded}">
            <Component:Mesh DataContext="{Binding Mesh}" Margin="8"/>
        </Panels:IndentedExpander>

    </StackPanel>

</UserControl>