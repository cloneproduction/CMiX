<UserControl x:Class="CMiX.Studio.Views.ModelEntity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
             xmlns:Component="clr-namespace:CMiX.Studio.Views.Component"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="486" d:DesignWidth="322.667">

    <StackPanel>

        <Panels:IndentedExpander Header="Modifiers" IsExpanded="{Binding ModifierManager.IsExpanded}">
            
            <StackPanel>
                <Views:ModifierManager DataContext="{Binding ModifierManager}">
                    <Views:ModifierManager.SelectionPanel>
                        <Views:EntityModifierSelectionPanel DataContext="{Binding }"/>
                    </Views:ModifierManager.SelectionPanel>
                </Views:ModifierManager>
            </StackPanel>

        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Material" IsExpanded="{Binding Material.IsExpanded}">
            <Views:Material DataContext="{Binding Material}"/>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Mesh" IsExpanded="{Binding Mesh.IsExpanded}">
            <Component:Mesh DataContext="{Binding Mesh}" Margin="8"/>
        </Panels:IndentedExpander>

    </StackPanel>

</UserControl>