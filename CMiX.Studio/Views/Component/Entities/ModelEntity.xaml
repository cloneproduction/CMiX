<UserControl x:Class="CMiX.Studio.Views.ModelEntity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="486" d:DesignWidth="322.667">

    <StackPanel>

        <Grid Margin="8, 0, 8, 8" DockPanel.Dock="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Mesh" HorizontalAlignment="Right" Padding="4, 0"/>

            <ComboBox Grid.Column="1" DockPanel.Dock="Bottom" 
                SelectedValue="{Binding Mesh}"
                SelectedValuePath="Prefab"
                ItemsSource="{Binding CompositionService.MeshManager.Prefabs}">
                <ComboBox.ItemTemplate>
                    <ItemContainerTemplate>
                        <Border Height="20">
                            <TextBlock Padding="4" Text="{Binding Name}"/>
                        </Border>
                    </ItemContainerTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button 
                Grid.Column="2" 
                Margin="4, 0, 0, 0" 
                DockPanel.Dock="Right" 
                Width="20" 
                Style="{StaticResource ButtonRounded}" 
                Content="+"
                Command="{Binding CompositionService.MeshManager.AddItemCommand}"/>
        </Grid>

        <Grid Margin="8, 0, 8, 8" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Coloration" HorizontalAlignment="Right" Padding="4, 0"/>
            <ComboBox Grid.Column="1" DockPanel.Dock="Bottom" 
                  SelectedValue="{Binding Coloration}"
                  SelectedValuePath="Prefab"
                  ItemsSource="{Binding CompositionService.ColorationManager.Prefabs}">
                <ComboBox.ItemTemplate>
                    <ItemContainerTemplate>
                        <Border Height="20">
                            <TextBlock Padding="4" Text="{Binding Name}"/>
                        </Border>
                    </ItemContainerTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button 
                Grid.Column="2" 
                Margin="4, 0, 0, 0" 
                DockPanel.Dock="Right" 
                Width="20" 
                Style="{StaticResource ButtonRounded}" 
                Content="+"
                Command="{Binding CompositionService.ColorationManager.AddItemCommand}"/>
        </Grid>

        <Grid Margin="8, 0, 8, 8" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Material" HorizontalAlignment="Right" Padding="4, 0"/>
            <ComboBox DockPanel.Dock="Bottom" Grid.Column="1" 
                SelectedValue="{Binding Material}"
                SelectedValuePath="Prefab"
                ItemsSource="{Binding CompositionService.MaterialManager.Prefabs}">
                <ComboBox.ItemTemplate>
                    <ItemContainerTemplate>
                        <Border Height="20">
                            <TextBlock Padding="4" Text="{Binding Name}"/>
                        </Border>
                    </ItemContainerTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button 
                Grid.Column="2" 
                Margin="4, 0, 0, 0" 
                DockPanel.Dock="Right" 
                Width="20" 
                Style="{StaticResource ButtonRounded}" 
                Content="+"
                Command="{Binding CompositionService.MaterialManager.AddItemCommand}"/>
        </Grid>

        <Grid Margin="8, 0, 8, 8" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Transform" HorizontalAlignment="Right" Padding="4, 0"/>
            <ComboBox Grid.Column="1" 
                SelectedValue="{Binding Transform}"
                SelectedValuePath="Prefab"
                ItemsSource="{Binding CompositionService.TransformManager.Prefabs}">
                <ComboBox.ItemTemplate>
                    <ItemContainerTemplate>
                        <Border Height="20">
                            <TextBlock Padding="4" Text="{Binding Name}"/>
                        </Border>
                    </ItemContainerTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button 
                Grid.Column="2" 
                Margin="4, 0, 0, 0" 
                DockPanel.Dock="Right" 
                Width="20" 
                Style="{StaticResource ButtonRounded}" 
                Content="+"
                Command="{Binding CompositionService.TransformManager.AddItemCommand}"/>
        </Grid>
        
    </StackPanel>
</UserControl>
