<UserControl x:Class="CMiX.Studio.Views.ModelEntity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
             xmlns:Component="clr-namespace:CMiX.Studio.Views.Component"
             mc:Ignorable="d" 
             d:DesignHeight="486" d:DesignWidth="322.667">

    <StackPanel>
        <Panels:IndentedExpander Header="Transform">
            <Views:TransformSRT DataContext="{Binding TransformSRT}"/>
        </Panels:IndentedExpander>
        
        <Panels:IndentedExpander Header="Modifiers">
            <Views:ModifierManager DataContext="{Binding ModifierManager}">
                <Views:ModifierManager.SelectionPanel>
                    <Views:EntityModifierSelectionPanel DataContext="{Binding }"/>
                </Views:ModifierManager.SelectionPanel>
            </Views:ModifierManager>
        </Panels:IndentedExpander>
        
        <Panels:IndentedExpander Header="Material">
            <StackPanel>

                <Grid DockPanel.Dock="Left" Margin="8" Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Grid.Column="0"
                        DockPanel.Dock="Bottom" 
                        SelectedItem="{Binding MaterialManager.SelectedItem}"
                        ItemsSource="{Binding MaterialManager.Prefabs}"
                        Style="{StaticResource ComboBoxRoundedLeft}">
                        <ComboBox.ItemTemplate>
                            <ItemContainerTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </ItemContainerTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        Margin="1, 0, 0, 0"
                        Grid.Column="2" 
                        DockPanel.Dock="Right" 
                        Width="22" 
                        Content="+"
                        Command="{Binding MaterialManager.AddItemCommand}"
                        Style="{StaticResource ButtonRoundedRight}"/>
                </Grid>
                <Border>
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MaterialManager.SelectedItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding MaterialManager.SelectedItem.Prefab}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Views:Material DataContext="{Binding MaterialManager.SelectedItem.Prefab}"/>
                </Border>
            </StackPanel>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Mesh">
            <Component:Mesh DataContext="{Binding Mesh}" Margin="8"/>
        </Panels:IndentedExpander>

    </StackPanel>
</UserControl>
