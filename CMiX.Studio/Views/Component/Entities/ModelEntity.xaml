<UserControl x:Class="CMiX.Studio.Views.ModelEntity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
             xmlns:Component="clr-namespace:CMiX.Studio.Views.Component"
             xmlns:Manager="clr-namespace:CMiX.Studio.Views.Managers"
             mc:Ignorable="d" 
             d:DesignHeight="486" d:DesignWidth="322.667">

    <StackPanel>

        <Panels:IndentedExpander Header="Mesh">
            <Component:Mesh DataContext="{Binding Mesh}" Margin="8"/>
        </Panels:IndentedExpander>
        
        <Panels:IndentedExpander Header="Transform">
            <Views:TransformSRT DataContext="{Binding TransformSRT}"/>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Material">
            <StackPanel>

                <Manager:PrefabManagerComboBox
                    DataContext="{Binding MaterialSelector}"
                    ItemsSource="{Binding PrefabRepository.Prefabs}"
                    AddItemCommand="{Binding AddItemCommand}"
                    SelectedItem="{Binding SelectedItem}"
                    SelectionChangedCommand="{Binding SelectedItemChangedCommand}"
                    SelectionChangedCommandParameter="{Binding SelectedItem}"/>
                    <!--SelectionChangedCommand="{Binding SelectedItemChangedCommand}"
                    SelectionChangedCommandParameter="{Binding SelectedItem}"-->
                    
                <Border Visibility="{Binding Material, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                    <Views:Material DataContext="{Binding MaterialSelector.SelectedItem}"/>
                </Border>
            </StackPanel>
        </Panels:IndentedExpander>
        
        <Panels:IndentedExpander Header="Modifiers">
            <Views:ModifierManager DataContext="{Binding ModifierManager}">
                <Views:ModifierManager.SelectionPanel>
                    <Views:EntityModifierSelectionPanel DataContext="{Binding }"/>
                </Views:ModifierManager.SelectionPanel>
            </Views:ModifierManager>
        </Panels:IndentedExpander>

    </StackPanel>

</UserControl>