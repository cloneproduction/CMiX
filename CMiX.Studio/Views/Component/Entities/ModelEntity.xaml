<UserControl x:Class="CMiX.Studio.Views.ModelEntity"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
             xmlns:Component="clr-namespace:CMiX.Studio.Views.Component"
             mc:Ignorable="d" 
             d:DesignHeight="486" d:DesignWidth="322.667">

    <StackPanel>
        <Panels:IndentedExpander Header="Transform" Indentation="8">
            <Views:TransformSRT DataContext="{Binding TransformSRT}"/>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Material" Indentation="8">
            <StackPanel>

                <Grid DockPanel.Dock="Left" Margin="8" Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        Grid.Column="0"
                        DockPanel.Dock="Bottom" 
                        SelectedValue="{Binding Material}"
                        SelectedValuePath="Prefab"
                        ItemsSource="{Binding CompositionService.MaterialManager.Prefabs}">
                        <ComboBox.ItemTemplate>
                            <ItemContainerTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </ItemContainerTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        Grid.Column="2" 
                        DockPanel.Dock="Right" 
                        Width="22" 
                        Content="+"
                        Command="{Binding CompositionService.MaterialManager.AddItemCommand}"/>
                </Grid>
                <Views:Material DataContext="{Binding Material}"/>
            </StackPanel>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Mesh" Indentation="8">
            <Component:Mesh DataContext="{Binding Mesh}" Margin="8"/>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Modifiers" Indentation="8">
            <Views:TransformModifierManager DataContext="{Binding TransformModifier}"/>
        </Panels:IndentedExpander>

    </StackPanel>
</UserControl>
