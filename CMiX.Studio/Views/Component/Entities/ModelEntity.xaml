<UserControl
    x:Class="CMiX.Studio.Views.ModelEntity"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:Component="clr-namespace:CMiX.Studio.Views.Component"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    x:Name="uc"
    d:DesignHeight="605.19"
    d:DesignWidth="315.259"

    mc:Ignorable="d">
    <!--md:DialogServiceViews.IsRegistered="True"-->
    <StackPanel>
        
        <Panels:IndentedExpander Header="Transform" IsExpanded="{Binding TransformSRTIsExpanded}">
            <Views:TransformSRT DataContext="{Binding TransformSRT}" Margin="8"/>
        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Modifiers" IsExpanded="{Binding ModifierManagerIsExpanded}">
            <Views:ModifierManager DataContext="{Binding ModifierManager}">
                <Views:ModifierManager.SelectionPanel>
                    <Views:AutoSelectionPanel PanelOwner="{x:Type Compositing:Entity}" />
                </Views:ModifierManager.SelectionPanel>
            </Views:ModifierManager>
        </Panels:IndentedExpander>
        
        <Panels:IndentedExpander Header="Material" IsExpanded="{Binding MaterialManagerIsExpanded}">

            <StackPanel>

                <BaseControls:ColorSelector
                    Caption="Color"
                    DataContext="{Binding Color}" 
                    Margin="8, 8, 8, 0"/>

                <Views:Outliner
                    Margin="8"
                    DataContext="{Binding MaterialManager}"
                    ItemsSource="{Binding ControlRepository.Materials}">
                    <Views:Outliner.SelectionPanel>
                        <Button
                            Command="{Binding AddItemCommand}"
                            CommandParameter="{x:Type Materials:Material}"
                            Content="New"
                            Style="{DynamicResource ButtonRoundedRight}" />
                    </Views:Outliner.SelectionPanel>
                </Views:Outliner>

                <Border Visibility="{Binding MaterialManager.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                    <Views:Material DataContext="{Binding MaterialManager.SelectedItem}" />
                </Border>

            </StackPanel>

        </Panels:IndentedExpander>

        <Panels:IndentedExpander Header="Geometry" IsExpanded="{Binding MeshIsExpanded}">
            <Component:Mesh Margin="8" DataContext="{Binding Mesh}" />
        </Panels:IndentedExpander>

    </StackPanel>

</UserControl>