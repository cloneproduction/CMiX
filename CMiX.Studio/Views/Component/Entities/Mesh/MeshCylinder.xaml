<UserControl x:Class="CMiX.Studio.Views.MeshCylinder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.Controls"
             xmlns:Panels="clr-namespace:CMiX.Studio.Views.Controls.Panels"
             mc:Ignorable="d"
             d:DesignHeight="261.569" d:DesignWidth="246.503">

    <StackPanel>
        
        <BaseControl:VectorXYZ 
            Caption="Scale" 
            DataContext="{Binding Scale}"/>
        
        <BaseControl:VectorXYZ 
            Caption="Offset" 
            Margin="0, 8" 
            DataContext="{Binding Offset}"/>

        <Panels:PositionedStackPanel>
            
            <BaseControl:DragValue 
                Caption="Radius" 
                Value="{Binding Radius.Value}"/>

            <BaseControl:DragValue 
                Margin="0, 1, 0, 0" 
                Caption="Height" 
                Value="{Binding Height.Value}"/>
            
        </Panels:PositionedStackPanel>

        <BaseControl:IntegerValue 
            Margin="0, 8, 0, 0" 
            DataContext="{Binding Tessellation}" 
            Caption="Tessellation"/>
        
    </StackPanel>

</UserControl>
