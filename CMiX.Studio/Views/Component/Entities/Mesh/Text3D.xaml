<UserControl
    x:Class="CMiX.Studio.Views.Text3D"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.Controls.Panels"
    d:DesignHeight="250.666"
    d:DesignWidth="293.333"
    mc:Ignorable="d">

    <StackPanel>

        <TextBox
            Height="44"
            Style="{StaticResource TypeWriterStyle}"
            Text="{Binding Text.Value, UpdateSourceTrigger=PropertyChanged}" />

        <Panels:PositionedStackPanel>
            <BaseControls:ComboBox
                Margin="0,8,0,1"
                Caption="Font Family"
                ItemsSource="{x:Static Fonts.SystemFontFamilies}"
                SelectedItem="{Binding FontFamily.Value, Converter={StaticResource FontFamilyToString}}" />

            <BaseControls:IntegerValue
                Caption="Size"
                DataContext="{Binding FontSize}" />
        </Panels:PositionedStackPanel>

        <BaseControls:DragValue
            Margin="0,8"
            Caption="Extrude Amount"
            Value="{Binding ExtrudeAmount.Value}" />

        <Panels:PositionedStackPanel>
            <BaseControls:ComboBox
                Margin="0,0,0,1"
                Caption="Text Alignment"
                ItemsSource="{Binding Source={StaticResource HorizontalAlignment}}"
                SelectedItem="{Binding HorizontalAlignment.Value}" />

            <BaseControls:ComboBox
                Caption="Paragraph Alignment"
                ItemsSource="{Binding Source={StaticResource ParagraphAlignment}}"
                SelectedItem="{Binding ParagraphAlignment.Value}" />
        </Panels:PositionedStackPanel>

    </StackPanel>

</UserControl>
