<UserControl
    x:Class="CMiX.Studio.Views.CameraLFO"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.Controls.Panels"
    d:DesignHeight="312.32"
    d:DesignWidth="269.756"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControl:ComboBox
            Margin="0,0,0,8"
            Caption="Axis"
            ItemsSource="{Binding Source={StaticResource CameraAxis}}"
            SelectedItem="{Binding Axis.Value}" />

        <Panels:PositionedStackPanel>
            <BaseControl:DragValue
                Caption="From"
                Value="{Binding From.Value}" />
            <BaseControl:DragValue
                Margin="0,1,0,0"
                Caption="To"
                Value="{Binding To.Value}" />
        </Panels:PositionedStackPanel>
        
        <BaseControl:ToggleButton
            Margin="0,8"
            Caption="Ping Pong"
            IsChecked="{Binding PingPong.Value}" />

        <Views:BeatModifierManager DataContext="{Binding BeatModifierManager}" />

    </StackPanel>

</UserControl>
