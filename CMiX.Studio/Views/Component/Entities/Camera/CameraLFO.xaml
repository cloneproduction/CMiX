<UserControl
    x:Class="CMiX.Studio.Views.CameraLFO"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="432"
    d:DesignWidth="274"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControl:ComboBox
            Margin="0,0,0,8"
            Caption="Axis"
            ItemsSource="{Binding Source={StaticResource CameraAxis}}"
            SelectedItem="{Binding Axis.Value}" />

        <BaseControl:DragValue
            Caption="From"
            Position="Top"
            Value="{Binding From.Value}" />

        <BaseControl:DragValue
            Margin="0,1,0,0"
            Caption="To"
            Position="Bottom"
            Value="{Binding To.Value}" />

        <BaseControl:ToggleButton
            Margin="0,8"
            Caption="Ping Pong"
            IsChecked="{Binding PingPong.Value}" />

        <Views:BeatModifierManager Margin="0,8,0,0" DataContext="{Binding BeatModifierManager}" />

    </StackPanel>

</UserControl>
