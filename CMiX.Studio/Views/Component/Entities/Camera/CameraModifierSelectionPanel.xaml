<UserControl
    x:Class="CMiX.Studio.Views.CameraModifierSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CameraModifiers="clr-namespace:CMiX.Core.Rendering.Cameras.Modifiers;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="113.728"
    d:DesignWidth="287.657"
    mc:Ignorable="d">

    <StackPanel>

        <Button
            Grid.Row="0"
            Grid.Column="0"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type CameraModifiers:CameraLFOModel}"
            Content="LFO"
            Style="{StaticResource ButtonItemControl}" />

        <Button
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type CameraModifiers:CameraRandomModel}"
            Content="Random"
            Style="{StaticResource ButtonItemControl}" />

    </StackPanel>

</UserControl>
