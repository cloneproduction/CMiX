<UserControl
    x:Class="CMiX.Studio.Views.CameraSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    d:DesignHeight="327.532"
    d:DesignWidth="314.399"
    mc:Ignorable="d">

    <StackPanel Margin="8">

        <BaseControls:ToggleButton Caption="Orthographic" IsChecked="{Binding IsOrthographic.Value}" />

        <Border Margin="0,8">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOrthographic.Value}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Panels:PositionedStackPanel>
                <BaseControls:DragValue
                    Margin="0,0,0,1"
                    Caption="Distance"
                    Value="{Binding Distance.Value}" />

                <BaseControls:DragValue
                    Caption="FOV"
                    Value="{Binding FOV.Value}" />
            </Panels:PositionedStackPanel>
        </Border>

        <Border Margin="0,8">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsOrthographic.Value}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <BaseControls:DragValue Caption="Orthographic Size" Value="{Binding OrthographicSize.Value}" />
        </Border>

        <Panels:PositionedStackPanel>
            <BaseControls:DragValue
                Margin="0,0,0,1"
                Caption="Yaw"
                Value="{Binding Yaw.Value}" />
            <BaseControls:DragValue
                Caption="Pitch"
                Value="{Binding Pitch.Value}" />
        </Panels:PositionedStackPanel>
        
        <BaseControls:VectorXYZ Margin="0, 8" Caption="Target" DataContext="{Binding Target}" />

        <Panels:PositionedStackPanel>
            <BaseControls:DragValue
                Margin="0,0,0,1"
                Caption="Near"
                Value="{Binding NearClip.Value}" />
            <BaseControls:DragValue
                Caption="Far"
                Value="{Binding FarClip.Value}" />
        </Panels:PositionedStackPanel>
        
    </StackPanel>
</UserControl>
