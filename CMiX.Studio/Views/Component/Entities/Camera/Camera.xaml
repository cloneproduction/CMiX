<UserControl
    x:Class="CMiX.Studio.Views.Camera"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="CameraControl"
    d:DesignHeight="294.297"
    d:DesignWidth="260.578"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <i:Interaction.Behaviors>
            <Behaviors:ScrollViewerBehavior />
        </i:Interaction.Behaviors>
        <StackPanel>

            <Panels:IndentedExpander Header="Modifiers" IsExpanded="{Binding ModifierManagerIsExpanded}">
                <Views:ModifierManager DataContext="{Binding ModifierManager}">
                    <Views:ModifierManager.SelectionPanel>
                        <Views:CameraModifierSelectionPanel DataContext="{Binding}" />
                    </Views:ModifierManager.SelectionPanel>
                </Views:ModifierManager>
            </Panels:IndentedExpander>

            <Panels:IndentedExpander
                Header="Settings"
                Indentation="0"
                IsExpanded="{Binding SettingsIsExpanded}">
                <Views:CameraSettings DataContext="{Binding Settings}" />
            </Panels:IndentedExpander>

        </StackPanel>
    </ScrollViewer>
</UserControl>