<UserControl
    x:Class="CMiX.Studio.Views.CameraRandom"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="413.412"
    d:DesignWidth="271.192"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControl:ComboBox
            Caption="Axis"
            ItemsSource="{Binding Source={StaticResource CameraAxis}}"
            SelectedItem="{Binding Axis.Value}" />

        <BaseControl:DragValue
            Margin="0,8"
            Caption="Width"
            Value="{Binding Width.Value}" />

        <Views:Outliner DataContext="{Binding BeatModifierManager}" ItemsSource="{Binding ControlRepository.BeatModifiers}">
            <Views:Outliner.SelectionPanel>
                <Button
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{x:Type Animations:BeatModifierModel}"
                    Content="New"
                    Style="{DynamicResource ButtonRoundedRight}" />
            </Views:Outliner.SelectionPanel>
        </Views:Outliner>
    </StackPanel>

</UserControl>
