<UserControl x:Class="CMiX.Studio.Views.MeshPlane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:Behaviors="clr-namespace:CMiX.Core.Presentation.Behaviors;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel>
            <BaseControl:VectorXY DataContext="{Binding Scale}"/>
            <BaseControl:VectorXYZ Margin="0, 8" DataContext="{Binding Offset}"/>

            <Grid Margin="0, 0" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Controls:Counter 
                    Grid.Column="1"
                    DataContext="{Binding TessellationX}"
                    Style="{DynamicResource CMiXCounterStyle}"
                    StepValue="1"
                    HorizontalAlignment="Stretch"
                    Value="{Binding Count, Mode=TwoWay}"/>

                <TextBlock 
                    Grid.Column="0"
                    Padding="8, 0" 
                    HorizontalAlignment="Right" 
                    Text="Tessellation X" 
                    Foreground="{DynamicResource TextBase}"/>

            </Grid>

            <Grid Margin="0, 0" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Controls:Counter 
                    Grid.Column="1"
                    DataContext="{Binding TessellationX}"
                    Style="{DynamicResource CMiXCounterStyle}"
                    StepValue="1"
                    HorizontalAlignment="Stretch"
                    Value="{Binding Count, Mode=TwoWay}"/>

                <TextBlock 
                    Padding="8, 0" 
                    HorizontalAlignment="Right" 
                    Text="Y" 
                    Foreground="{DynamicResource TextBase}"/>
            </Grid>

            <Grid Margin="0, 8, 0, 0" Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Controls:CMiXToggleButton
                    Grid.Column="1"
                    Style="{DynamicResource CMiXToggleButtonStyle}"
                    Caption="Generate BackFace"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding GenerateBackFace.IsChecked}"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
