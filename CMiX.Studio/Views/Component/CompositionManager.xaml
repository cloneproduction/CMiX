<UserControl x:Class="CMiX.Studio.Views.Component.CompositionManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMiX.Studio.Views.Component"
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

        <StackPanel>
            <Border VerticalAlignment="Center"
                    Padding="8"
                    DockPanel.Dock="Top"
                    Height="40">
                <TextBlock DockPanel.Dock="Left" 
                        Text="COMPOSITIONS" 
                        FontWeight="SemiBold" 
                        VerticalAlignment="Center"/>
            </Border>

            <Border Margin="4, 0, 4, 8">
                <ListBox
                    MaxHeight="100"
                    Style="{StaticResource ListBoxWithButton}"
                    ItemsSource="{Binding Path=Project.Components}"
                    SelectedItem="{Binding SelectedComposition}">
                    <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Height="25">
                            <Controls:EditableTextBox 
                                        x:Name="editableTextBox"
                                        IsEditing="{Binding IsRenaming}"
                                        VerticalAlignment="Center" 
                                        Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="MouseDoubleClick">
                                        <i:InvokeCommandAction 
                                                    Command="{Binding RenameCommand}"
                                                    CommandParameter="{Binding}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Controls:EditableTextBox>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>

</UserControl>
