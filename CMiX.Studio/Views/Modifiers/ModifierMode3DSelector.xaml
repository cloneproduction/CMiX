<UserControl
    x:Class="CMiX.Studio.Views.Modifiers.ModifierMode3DSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Modifiers="clr-namespace:CMiX.Core.Modifiers;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="104.667"
    d:DesignWidth="252.667"
    mc:Ignorable="d">

    <StackPanel>
        <BaseControls:ComboBox
            Margin="0,0,0,1"
            Caption="Type"
            ItemsSource="{Binding Source={StaticResource ModifierMode}}"
            Position="Top"
            SelectedItem="{Binding Mode.Value}" />

        <Border>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="IsEnabled" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode.Value, Mode=TwoWay}" Value="{x:Static Modifiers:ModifierMode.ToSpread}">
                            <Setter Property="IsEnabled" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <BaseControls:Integer3Value Caption="Count" DataContext="{Binding Count}" />

        </Border>
    </StackPanel>
</UserControl>
