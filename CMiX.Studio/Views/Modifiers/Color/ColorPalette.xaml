<UserControl
    x:Class="CMiX.Studio.Views.ColorPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="308.861"
    d:DesignWidth="347.074"
    mc:Ignorable="d">

    <StackPanel>

        <Views:PrefabSlotManager Margin="0" DataContext="{Binding ColorManager}">
            <Views:PrefabSlotManager.SelectionPanel>
                <Button
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{x:Type Compositing:Color}"
                    Content="New Color" />
            </Views:PrefabSlotManager.SelectionPanel>
        </Views:PrefabSlotManager>

        <BaseControls:ComboBox
            Margin="0,8,0,0"
            Caption="Resample"
            ItemsSource="{Binding Source={StaticResource ResamplingMethod}}"
            Position="Default"
            SelectedItem="{Binding Resample.Value}" />
    </StackPanel>

</UserControl>
