<UserControl
    x:Class="CMiX.Studio.Views.Colorize"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Colorization="clr-namespace:CMiX.Studio.Views.Component.Colorization"
    xmlns:Modifiers="clr-namespace:CMiX.Studio.Views.Modifiers"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="392"
    d:DesignWidth="374"
    mc:Ignorable="d">

    <StackPanel Margin="-8">

        <Views:Outliner
            Margin="8"
            DataContext="{Binding ColorPaletteManager}"
            ItemsSource="{Binding ControlRepository.ColorPalettes}">
            <Views:Outliner.SelectionPanel>
                <Button
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{x:Type Colorization:ColorPalette}"
                    Content="New"
                    Style="{DynamicResource ButtonRoundedRight}" />
            </Views:Outliner.SelectionPanel>
        </Views:Outliner>

        <Border Visibility="{Binding ColorPaletteManager.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
            <Colorization:ColorPalette DataContext="{Binding ColorPaletteManager.SelectedItem}" />
        </Border>

    </StackPanel>
</UserControl>
