<UserControl
    x:Class="CMiX.Studio.Views.RandomHSV"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Modifiers="clr-namespace:CMiX.Studio.Views.Modifiers"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="392"
    d:DesignWidth="374"
    mc:Ignorable="d">

    <StackPanel>

        <Modifiers:ModifierModeSelector Margin="0,0,0,8" DataContext="{Binding ModifierModeSelector}" />

        <BaseControl:ComboBox
            Margin="0,0,0,8"
            Caption="Color Mode"
            ItemsSource="{Binding Source={StaticResource ColorMode}}"
            SelectedItem="{Binding ColorMode.Value}" />

        <BaseControl:DragValue
            Caption="Hue"
            Position="Top"
            Value="{Binding Hue.Value}" />

        <BaseControl:DragValue
            Margin="0,1"
            Caption="Saturation"
            Position="Middle"
            Value="{Binding Saturation.Value}" />

        <BaseControl:DragValue
            Margin="0"
            Caption="Value"
            Position="Middle"
            Value="{Binding Value.Value}" />

        <BaseControl:DragValue
            Margin="0,1,0,8"
            Caption="Alpha"
            Position="Bottom"
            Value="{Binding Alpha.Value}" />

        <Views:Outliner
            Margin="0,8,0,0"
            DataContext="{Binding BeatModifierManager}"
            ItemsSource="{Binding ControlRepository.BeatModifiers}">
            <Views:Outliner.SelectionPanel>
                <Button
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{x:Type Animations:BeatModifierModel}"
                    Content="New Beat"
                    Style="{DynamicResource ButtonRoundedRight}" />
            </Views:Outliner.SelectionPanel>
        </Views:Outliner>

        <Border Visibility="{Binding BeatModifierManager.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
            <Views:BeatModifier Margin="-8,0,-8,-8" DataContext="{Binding BeatModifierManager.SelectedItem}" />
        </Border>
    </StackPanel>
</UserControl>
