<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Filters="clr-namespace:CMiX.Core.Texturing.Filters;assembly=CMiX.Core"
                    xmlns:Views="clr-namespace:CMiX.Studio.Views">

    <DataTemplate DataType="{x:Type Filters:Kuwahara}">
        <Views:Kuwahara DataContext="{Binding}" />
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type Filters:ShiftRGB}">
        <Views:ShiftRGB DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Dither}">
        <Views:Dither DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Ascii}">
        <Views:Ascii DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Shadow}">
        <Views:Shadow DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Displace}">
        <Views:Displace DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:HSCB}">
        <Views:HSCB DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Invert}">
        <Views:Invert DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Blur}">
        <Views:Blur DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Edge}">
        <Views:Edge DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:TransformTexture}">
        <Views:TransformTexture DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Pixelate}">
        <Views:Pixelate DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Echo}">
        <Views:Echo DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Feedback}">
        <Views:Feedback DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:TriColor}">
        <Views:TriColor DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:RandomUV}">
        <Views:RandomUV DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:LFOUV}">
        <Views:LFOUV DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:SetAlpha}">
        <Views:SetAlpha DataContext="{Binding}" />
    </DataTemplate>
    
</ResourceDictionary>