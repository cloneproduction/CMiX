<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:CameraModifiers="clr-namespace:CMiX.Core.Rendering.Cameras.Modifiers;assembly=CMiX.Core"
    xmlns:ColorModifiers="clr-namespace:CMiX.Core.Colors.Modifiers;assembly=CMiX.Core"
    xmlns:Filters="clr-namespace:CMiX.Core.Texturing.Filters;assembly=CMiX.Core"
    xmlns:Layering="clr-namespace:CMiX.Core.Layering.Modifiers;assembly=CMiX.Core"
    xmlns:LightModifiers="clr-namespace:CMiX.Studio.Views.Modifiers.Light"
    xmlns:Modifiers="clr-namespace:CMiX.Core.Transformation.Modifiers;assembly=CMiX.Core"
    xmlns:Text="clr-namespace:CMiX.Core.Text.Modifiers;assembly=CMiX.Core"
    xmlns:TransformModifiers="clr-namespace:CMiX.Core.Transformation.Modifiers;assembly=CMiX.Core"
    xmlns:Transformation="clr-namespace:CMiX.Core.Transformation;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views">


    <!--  TEXT MODIFIERS  -->
    <DataTemplate DataType="{x:Type Text:Split}">
        <Views:Split DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Text:CharWriter}">
        <Views:CharWriter DataContext="{Binding}" />
    </DataTemplate>

    <!--  LAYER MODIFIERS  -->
    <DataTemplate DataType="{x:Type Layering:SelectRandomEntity}">
        <Views:SelectRandomEntity DataContext="{Binding}" />
    </DataTemplate>

    <!--  TEXTURE MODIFIERS  -->
    <DataTemplate DataType="{x:Type Filters:ShiftRGB}">
        <Views:ShiftRGB DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Dither}">
        <Views:Dither DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Ascii}">
        <Views:Ascii DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Shadow}">
        <Views:Shadow DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Displace}">
        <Views:Displace DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:HSCB}">
        <Views:HSCB DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Invert}">
        <Views:Invert DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Blur}">
        <Views:Blur DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Edge}">
        <Views:Edge DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:TransformTexture}">
        <Views:TransformTexture DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Pixelate}">
        <Views:Pixelate DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Echo}">
        <Views:Echo DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:Feedback}">
        <Views:Feedback DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:TriColor}">
        <Views:TriColor DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:RandomUV}">
        <Views:RandomUV DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:LFOUV}">
        <Views:LFOUV DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Filters:SetAlpha}">
        <Views:SetAlpha DataContext="{Binding}" />
    </DataTemplate>


    <!--  ENTITY MODIFIERS  -->

    <DataTemplate DataType="{x:Type Modifiers:TransformTexCoord}">
        <Views:TransformTexCoord DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Transformation:Billboard}">
        <Views:Billboard DataContext="{Binding}" />
    </DataTemplate>


    <DataTemplate DataType="{x:Type TransformModifiers:CircularSpread}">
        <Views:CircularSpread DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type TransformModifiers:Grid}">
        <Views:Grid DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type ColorModifiers:RandomHSV}">
        <Views:RandomHSV DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type TransformModifiers:LinearXYZ}">
        <Views:LinearXYZ DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type TransformModifiers:RandomXYZ}">
        <Views:RandomXYZ DataContext="{Binding}" />
    </DataTemplate>


    <DataTemplate DataType="{x:Type TransformModifiers:LFO}">
        <Views:LFO DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type TransformModifiers:RandomScale}">
        <Views:RandomScale DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type TransformModifiers:RandomRotation}">
        <Views:RandomRotation DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Transformation:TransformSRT}">
        <Views:TransformSRT DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Transformation:Translate}">
        <Views:Translate DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Transformation:Scale}">
        <Views:Scale DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Transformation:Rotation}">
        <Views:Rotation DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Modifiers:RandomTexCoord}">
        <Views:RandomUV DataContext="{Binding}" />
    </DataTemplate>

    <!--  CAMERA MODIFIERS  -->
    <DataTemplate DataType="{x:Type CameraModifiers:CameraLFO}">
        <Views:CameraLFO DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type CameraModifiers:CameraRandom}">
        <Views:CameraRandom DataContext="{Binding}" />
    </DataTemplate>


    <!--  LIGHT MODIFIERS  -->
    <DataTemplate DataType="{x:Type TransformModifiers:RandomPosition}">
        <LightModifiers:RandomPosition DataContext="{Binding}" />
    </DataTemplate>

</ResourceDictionary>