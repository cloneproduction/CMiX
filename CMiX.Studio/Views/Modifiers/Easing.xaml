<UserControl x:Class="CMiX.Studio.Views.Easing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="298.031" d:DesignWidth="269.095">

    <Expander>
        <Expander.Header>
            <DockPanel>
                <ToggleButton
                    Width="14"
                    Height="14"
                    Style="{DynamicResource ToggleButtonRounded}"
                    IsChecked="{Binding IsEnabled}"/>
                <TextBlock Text="Easing" Margin="8, 0" Foreground="{DynamicResource TextBase}"/>
            </DockPanel>
        </Expander.Header>

        <StackPanel 
            Margin="8" 
            IsEnabled="{Binding IsEnabled}">

            <BaseControls:ComboBox 
                Margin="0, 0, 0, 4"
                Caption="Function"
                SelectedItem="{Binding EasingFunction}"
                ItemsSource="{Binding Source={StaticResource EasingFunction}}"/>

            <BaseControls:ComboBox 
                Caption="Mode"
                SelectedItem="{Binding EasingMode}"
                ItemsSource="{Binding Source={StaticResource EasingMode}}"/>

        </StackPanel>

    </Expander>
</UserControl>
