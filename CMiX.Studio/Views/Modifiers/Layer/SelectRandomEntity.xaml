<UserControl
    x:Class="CMiX.Studio.Views.SelectRandomEntity"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="161.492"
    d:DesignWidth="247.919"
    mc:Ignorable="d">

    <StackPanel Margin="8">

        <BaseControls:ComboBox
            Margin="0,0,0,8"
            Caption="Entity Type"
            ItemsSource="{Binding Source={StaticResource EntityType}}"
            SelectedItem="{Binding EntityType.Value}" />

        <Views:Outliner DataContext="{Binding BeatModifierManager}" ItemsSource="{Binding ControlRepository.BeatModifiers}" />
    </StackPanel>


</UserControl>
