<UserControl
    x:Class="CMiX.Studio.Views.RenderRandomEntity"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="287.524"
    d:DesignWidth="274.84"
    mc:Ignorable="d">

    <StackPanel>
        <BaseControls:CMiXSlider
            Margin="0,0,0,8"
            Caption="Control"
            Maximum="1"
            Minimum="0"
            Value="{Binding Control.Value}" />
        <BaseControls:ComboBox
            Margin="0,0,0,8"
            Caption="Entity Type"
            ItemsSource="{Binding Source={StaticResource EntityType}}"
            SelectedItem="{Binding EntityType.Value}" />

        <Views:BeatModifierManager Margin="0,8,0,0" DataContext="{Binding BeatModifierManager}" />

    </StackPanel>


</UserControl>
