<UserControl
    x:Class="CMiX.Studio.Views.Modifiers.ModifierModeSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Modifiers="clr-namespace:CMiX.Core.Modifiers;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    d:DesignHeight="196"
    d:DesignWidth="256"
    mc:Ignorable="d">

    <Panels:PositionedStackPanel>

        <BaseControls:ComboBox
            Margin="0,0,0,1"
            Caption="Type"
            ItemsSource="{Binding Source={StaticResource ModifierMode}}"
            SelectedItem="{Binding Mode.Value}" />

        <Border>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="IsEnabled" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode.Value, Mode=TwoWay}" Value="{x:Static Modifiers:ModifierMode.ToSpread}">
                            <Setter Property="IsEnabled" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <BaseControls:DragValue
                Caption="Count"
                IsInteger="True"
                LargeChange="1.0"
                Minimum="1"
                SmallChange="1.0"
                Value="{Binding Count.Value}" />

        </Border>
    </Panels:PositionedStackPanel>
</UserControl>
