<UserControl
    x:Class="CMiX.Studio.Views.RandomRotation"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Modifiers="clr-namespace:CMiX.Studio.Views.Modifiers"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="386.132"
    d:DesignWidth="404.43"
    mc:Ignorable="d">

    <StackPanel Margin="8">

        <Modifiers:ModifierModeSelector DataContext="{Binding ModifierModeSelector}" />

        <BaseControls:VectorXYZ
            Margin="0,8"
            Caption="Rotation"
            DataContext="{Binding Rotation}"
            IsEnabled="{Binding RandomizeLocation.Value}" />

        <Views:BeatModifierManager DataContext="{Binding BeatModifierManager}" />

    </StackPanel>
</UserControl>
