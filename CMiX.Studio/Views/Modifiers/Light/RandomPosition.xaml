<UserControl
    x:Class="CMiX.Studio.Views.Modifiers.Light.RandomPosition"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Modifiers="clr-namespace:CMiX.Studio.Views.Modifiers"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="164.422"
    d:DesignWidth="328.211"
    mc:Ignorable="d">

    <StackPanel>

        <Modifiers:ModifierModeSelector DataContext="{Binding ModifierModeSelector}" />

        <BaseControls:VectorXYZ
            Margin="0,8"
            Caption="Location"
            DataContext="{Binding Location}"
            IsEnabled="{Binding RandomizeLocation.Value}" />

        <Views:BeatModifierManager DataContext="{Binding BeatModifierManager}" />

    </StackPanel>

</UserControl>
