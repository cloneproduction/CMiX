<UserControl x:Class="CMiX.Studio.Views.Modifiers.Light.RandomPosition"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:Modifiers="clr-namespace:CMiX.Studio.Views.Modifiers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <StackPanel>

        <StackPanel Margin="8">

            <Modifiers:ModifierModeSelector 
                Margin="0, 0, 0, 8"
                DataContext="{Binding ModifierModeSelector}"/>

            <Views:BeatModifier DataContext="{Binding BeatModifier}"/>

        </StackPanel>

        <BaseControls:VectorXYZ 
                IsEnabled="{Binding RandomizeLocation.Value}"
                Margin="8"
                Caption="Location" 
                DataContext="{Binding Location}"/>

        <Views:Easing DataContext="{Binding Easing}"/>

    </StackPanel>
</UserControl>
