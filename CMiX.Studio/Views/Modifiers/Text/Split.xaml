<UserControl
    x:Class="CMiX.Studio.Views.Split"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:Text="clr-namespace:CMiX.Core.Text.Modifiers;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="247.333"
    d:DesignWidth="278.667"
    mc:Ignorable="d">
    <StackPanel>

        <BaseControls:ComboBox
            Margin="0,0,0,8"
            Caption="Type"
            ItemsSource="{Binding Source={StaticResource SplitType}}"
            SelectedItem="{Binding Type.Value}" />

        <Border>
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="IsEnabled" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Type.Value}" Value="{x:Static Text:SplitType.Separator}">
                            <Setter Property="IsEnabled" Value="True" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Padding="0,0,8,0"
                    HorizontalAlignment="Right"
                    Text="Separator" />
                <TextBox
                    Grid.Column="1"
                    Style="{StaticResource TypeWriterStyle}"
                    Text="{Binding Separator.Value, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
