<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Layering="clr-namespace:CMiX.Core.Layering.Modifiers;assembly=CMiX.Core"
                    xmlns:Views="clr-namespace:CMiX.Studio.Views">

    <DataTemplate DataType="{x:Type Layering:SelectRandomEntity}">
        <Views:SelectRandomEntity DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Layering:SelectRandomCamera}">
        <Views:SelectRandomCamera DataContext="{Binding}" />
    </DataTemplate>
    
</ResourceDictionary>