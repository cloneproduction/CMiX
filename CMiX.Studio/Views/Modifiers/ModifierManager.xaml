<UserControl
    x:Class="CMiX.Studio.Views.ModifierManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="238.667"
    d:DesignWidth="277.667"
    mc:Ignorable="d">

    <StackPanel Margin="8">

        <ToggleButton
            x:Name="PopUpToggle"
            Background="{DynamicResource DarkerColor}"
            Content="Add Modifier"
            Margin="0, 0, 0, 4"
            Style="{StaticResource ToggleTransformModifierMenu}" />

        <Popup
            Width="{Binding ActualWidth, ElementName=PopUpToggle}"
            AllowsTransparency="True"
            HorizontalOffset="{Binding ActualWidth, ElementName=PopupToggle}"
            IsOpen="{Binding IsChecked, ElementName=PopUpToggle}"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=PopUpToggle}"
            StaysOpen="True">

            <i:Interaction.Behaviors>
                <Behaviors:ClosePopupBehavior />
                <Behaviors:ClosePopupOnButtonClickBehavior />
            </i:Interaction.Behaviors>

            <Border
                Padding="2,0,2,2"
                Background="{DynamicResource HighHighDarkerColor}"
                BorderBrush="{DynamicResource Shadow}"
                BorderThickness="1,0,1,2"
                CornerRadius="{DynamicResource CornerRadiusBottom}">
                <ContentControl Content="{Binding SelectionPanel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />
            </Border>

        </Popup>

        <ItemsControl
            dd:DragDrop.DragHandler="{Binding ManagerReorderService}"
            dd:DragDrop.DropHandler="{Binding ManagerReorderService}"
            dd:DragDrop.IsDragSource="True"
            dd:DragDrop.IsDropTarget="True"
            AllowDrop="True"
            ItemsSource="{Binding ManagerData.Items}">
            <ItemsControl.Resources>
                <ResourceDictionary Source="ModifierDataTemplates.xaml" />
            </ItemsControl.Resources>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Panels:ModifierPanel
                        Margin="0,4"
                        CloseModifierCommand="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CloseModifierCommandParameter="{Binding}"
                        Content="{Binding}"
                        DragHandlerIsPressed="{Binding DataContext.ManagerReorderService.DragHandlerIsPressed, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        ResetModifierCommand="{Binding DataContext.ResetItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        ResetModifierCommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </StackPanel>
</UserControl>