<UserControl
    x:Class="CMiX.Studio.Views.RandomUV"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="359.509"
    d:DesignWidth="349.649"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControls:DragValue
            Caption="Uniform"
            Position="Default"
            Value="{Binding Uniform.Value}" />

        <BaseControls:Vector2
            Margin="0,8"
            Caption="Scale"
            DataContext="{Binding Scale}" />

        <BaseControls:DragValue
            Caption="Rotation"
            Position="Default"
            Value="{Binding Rotation.Value}" />

        <BaseControls:Vector2
            Margin="0,8"
            Caption="Translate"
            DataContext="{Binding Location}" />

        <Views:SamplerState 
            Margin="0,0,0,8" 
            DataContext="{Binding SamplerState}" />

        <Views:BeatModifierManager 
            DataContext="{Binding BeatModifierManager}" />

    </StackPanel>
</UserControl>
