<UserControl
    x:Class="CMiX.Studio.Views.Scale"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Modifiers="clr-namespace:CMiX.Studio.Views.Modifiers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="210.627"
    d:DesignWidth="325.624"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControls:DragValue
            Margin="0,0,0,8"
            Caption="Uniform"
            Value="{Binding Uniform.Value}" />

        <BaseControls:VectorXYZ Caption="Scale" DataContext="{Binding XYZ}" />

    </StackPanel>
</UserControl>
