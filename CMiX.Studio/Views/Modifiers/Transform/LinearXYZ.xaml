<UserControl x:Class="CMiX.Studio.Views.LinearXYZ"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Modifiers="clr-namespace:CMiX.Studio.Views.Modifiers"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="314" d:DesignWidth="258.667">

    <StackPanel>

        <Modifiers:ModifierModeSelector
            DataContext="{Binding ModifierModeSelector}"/>

        <BaseControls:ComboBox  
            Margin="0, 8, 0, 1"
            Caption="Transform"
            Position="Top"
            SelectedItem="{Binding TransformTypeSelector.Value}"
            ItemsSource="{Binding Source={StaticResource TransformType}}"/>

        <BaseControls:AxisSelector3D 
            XIsChecked="{Binding DirectionXYZ.DirectionX.Value}"
            YIsChecked="{Binding DirectionXYZ.DirectionY.Value}"
            ZIsChecked="{Binding DirectionXYZ.DirectionZ.Value}"/>

        <BaseControls:DragValue 
            Caption="Width" 
            Position="Top"
            Margin="0, 8, 0, 1" 
            Value="{Binding Width.Value}"/>

        <BaseControls:DragValue 
            Caption="Phase" 
            Position="Bottom"
            Value="{Binding Phase.Value}"/>

    </StackPanel>

</UserControl>
