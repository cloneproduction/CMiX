<UserControl
    x:Class="CMiX.Studio.Views.Grid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="246.126"
    d:DesignWidth="298.03"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControls:Integer3Value Caption="Count" DataContext="{Binding Count}" />

        <BaseControls:VectorXYZ
            Margin="0,8"
            Caption="Width"
            DataContext="{Binding Width}" />

        <BaseControls:VectorXYZ Caption="Phase" DataContext="{Binding Phase}" />

    </StackPanel>

</UserControl>
