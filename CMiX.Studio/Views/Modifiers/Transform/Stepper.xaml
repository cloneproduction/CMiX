<UserControl x:Class="CMiX.Studio.Views.Stepper"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="344.111" d:DesignWidth="287.889">

    <StackPanel>

        <StackPanel Margin="8">

            <BaseControls:ComboBox   
                Margin="0, 0, 0, 8"
                Caption="Type"
                SelectedItem="{Binding Mode.Selection}"
                ItemsSource="{Binding Source={StaticResource ModifierMode}}"/>

            <Views:BeatModifier 
                DataContext="{Binding BeatModifier}"/>

            <BaseControls:IntegerValue 
                Caption="Step Count"
                Margin="0, 8, 0, 0" 
                Value="{Binding StepCount.Count}"/>

            <BaseControls:DragValue 
                Margin="0, 8, 0, 0" 
                Caption="From" 
                Position="Top" 
                Value="{Binding From.Amount}"/>

            <BaseControls:DragValue 
                Margin="0, 1, 0, 0" 
                Caption="To" 
                Position="Bottom" 
                Value="{Binding To.Amount}"/>

            <BaseControls:ToggleButton 
                Caption="PingPong" 
                Margin="0, 8" 
                IsChecked="{Binding PingPong.IsChecked}"/>

            <BaseControls:ComboBox 
                Caption="Transform" 
                SelectedItem="{Binding TransformType.Selection}" 
                ItemsSource="{Binding Source={StaticResource TransformType}}"/>

            <BaseControls:AxisSelector3D 
                Margin="0, 2, 0, 0"
                XIsChecked="{Binding XAxis.IsChecked}"
                YIsChecked="{Binding YAxis.IsChecked}"
                ZIsChecked="{Binding ZAxis.IsChecked}"/>

        </StackPanel>

        <Views:Easing  DataContext="{Binding Easing}"/>

    </StackPanel>

</UserControl>
