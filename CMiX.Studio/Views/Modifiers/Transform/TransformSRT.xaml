<UserControl x:Class="CMiX.Studio.Views.TransformSRT"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="291.592" d:DesignWidth="257.329">

    <StackPanel>

        <BaseControls:DragValue
            Margin="0"
            Caption="Uniform Scale" 
            Value="{Binding Uniform.Value}"/>

        <BaseControls:VectorXYZ
            Margin="0, 8, 0, 0"
            Caption="Scale"
            DataContext="{Binding Scale.XYZ}"/>

        <BaseControls:VectorXYZ
            Margin="0, 8"
            Caption="Rotation"
            DataContext="{Binding Rotation.XYZ}"/>

        <BaseControls:VectorXYZ
            Caption="Translate"
            DataContext="{Binding Translate.XYZ}"/>

    </StackPanel>
    
</UserControl>
