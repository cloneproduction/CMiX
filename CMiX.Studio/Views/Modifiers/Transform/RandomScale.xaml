<UserControl
    x:Class="CMiX.Studio.Views.RandomScale"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Modifiers="clr-namespace:CMiX.Studio.Views.Modifiers"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="358.875"
    d:DesignWidth="312.685"
    mc:Ignorable="d">

    <StackPanel>

        <Modifiers:ModifierModeSelector DataContext="{Binding ModifierModeSelector}" />

        <BaseControls:DragValue
            Margin="0,8"
            Caption="Uniform"
            Value="{Binding UniformXYZ.Value}" />

        <BaseControls:VectorXYZ
            Margin="0,8"
            Caption="Scale"
            DataContext="{Binding Scale}" />

        <Views:BeatModifierManager DataContext="{Binding BeatModifierManager}" />

    </StackPanel>

</UserControl>
