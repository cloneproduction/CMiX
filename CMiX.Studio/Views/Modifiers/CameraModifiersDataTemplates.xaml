<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:CameraModifiers="clr-namespace:CMiX.Core.Rendering.Cameras.Modifiers;assembly=CMiX.Core" 
                    xmlns:Views="clr-namespace:CMiX.Studio.Views">

    <DataTemplate DataType="{x:Type CameraModifiers:CameraLFO}">
        <Views:CameraLFO DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type CameraModifiers:CameraRandom}">
        <Views:CameraRandom DataContext="{Binding}" />
    </DataTemplate>
    
</ResourceDictionary>