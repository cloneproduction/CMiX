<UserControl x:Class="CMiX.Studio.Views.CameraRandom"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:ViewModels="clr-namespace:CMiX.Core.Presentation.ViewModels;assembly=CMiX.Core" 
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             mc:Ignorable="d" 
             d:DesignHeight="413.412" d:DesignWidth="271.192">

    <UserControl.Resources>

        <ObjectDataProvider x:Key="CameraAxis" MethodName="GetValues" ObjectType="{x:Type ViewModels:CameraAxis}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ViewModels:CameraAxis"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

    </UserControl.Resources>

    <Expander
        IsExpanded="{Binding IsExpanded}"
        Header="Random"
        Template="{StaticResource ModifierPanelTemplate}">
        <StackPanel>
            <StackPanel Margin="8, 16">
                <Grid Height="22" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Axis" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4" Foreground="{DynamicResource TextBase}"/>
                    <ComboBox 
                        Grid.Column="1" 
                        SelectedItem="{Binding Axis.Selection}"
                        ItemsSource="{Binding Source={StaticResource CameraAxis}}"/>
                </Grid>
                
                <Grid Height="20" Margin="0, 8, 0, 16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Controls:DistanceSlider 
                            Grid.Column="2" 
                            Position="Top" 
                            Style="{StaticResource DistanceSliderStyle}" 
                            Value="{Binding Width.Amount}"/>
                    <TextBlock 
                            Grid.Column="0" 
                            Padding="4" 
                            HorizontalAlignment="Right" 
                            Text="Width" 
                            Foreground="{StaticResource TextBase}"/>
                </Grid>
                
                <Views:BeatModifier DataContext="{Binding BeatModifier}"/>



                <!--<Grid Margin="0, 1, 0, 0" Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Controls:DistanceSlider 
                        Grid.Column="2" 
                        Position="Bottom" 
                        Style="{StaticResource DistanceSliderStyle}" 
                        Value="{Binding To.Amount}"/>

                    <TextBlock 
                        Grid.Column="0" 
                        Padding="4" 
                        HorizontalAlignment="Right" 
                        Text="To" 
                        Foreground="{StaticResource TextBase}"/>
                </Grid>-->

            </StackPanel>

            <Views:Easing  DataContext="{Binding Easing}"/>

        </StackPanel>
    </Expander>
</UserControl>
