<UserControl
    x:Class="CMiX.Studio.Views.AssetManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Assets="clr-namespace:CMiX.Core.ViewModels.Assets;assembly=CMiX.Core"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="urn:gong-wpf-dragdrop"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="551.333"
    d:DesignWidth="250.667"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>

            <!--<ObjectDataProvider
                x:Key="assetTypes"
                MethodName="GetValues"
                ObjectType="{x:Type System:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="Assets:AssetTypes" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>-->

            <Style x:Key="BaseBorderStyle" TargetType="{x:Type Border}">
                <Setter Property="Height" Value="30" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Margin" Value="0,1" />
                <Style.Triggers>

                    <DataTrigger Binding="{Binding FileExist}" Value="false">
                        <Setter Property="Background" Value="Maroon" />
                    </DataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="true" />
                            <Condition Binding="{Binding FileExist}" Value="false" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="Background" Value="Maroon" />
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>

                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsSelected}" Value="false" />
                            <Condition Binding="{Binding FileExist}" Value="false" />
                        </MultiDataTrigger.Conditions>
                        <MultiDataTrigger.Setters>
                            <Setter Property="Background" Value="Maroon" />
                        </MultiDataTrigger.Setters>
                    </MultiDataTrigger>

                </Style.Triggers>
            </Style>


            <HierarchicalDataTemplate
                x:Key="AssetDirectoryTemplate"
                DataType="{x:Type Assets:AssetDirectory}"
                ItemsSource="{Binding Assets}">
                <Border
                    x:Name="border"
                    Height="{DynamicResource ControlHeightXL}"
                    HorizontalAlignment="Stretch"
                    Visibility="Visible">
                    <DockPanel>
                        <Image
                            Margin="6"
                            DockPanel.Dock="Left"
                            Opacity="0.75">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Source" Value="{Binding Source={StaticResource Folder}, Mode=OneTime}" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=IsExpanded}" Value="True" />
                                                <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=TreeViewItem}, Path=HasItems}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Source" Value="{Binding Source={StaticResource Folder_Opened}, Mode=OneTime}" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Controls:EditableTextBox
                            HorizontalAlignment="Stretch"
                            IsEditing="{Binding IsRenaming, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </Border>
            </HierarchicalDataTemplate>


            <!--<DataTemplate x:Key="AssetTextureTemplate" DataType="{x:Type Assets:Asset}">
                <Border Style="{StaticResource BaseBorderStyle}">
                    <DockPanel Margin="0,1">
                        <Image
                            Margin="8"
                            DockPanel.Dock="Left"
                            Opacity="0.9"
                            Source="{StaticResource Texture}" />
                        <TextBlock Text="{Binding Path=Name}" ToolTip="{Binding Path=Path}" />
                    </DockPanel>
                </Border>
            </DataTemplate>-->

            <!--<DataTemplate x:Key="AssetVideoTemplate" DataType="{x:Type Assets:AssetVideo}">
                <Border Style="{StaticResource BaseBorderStyle}">
                    <DockPanel Margin="0, 1">
                        <Image Margin="8" Opacity="0.9" DockPanel.Dock="Left" Source="{StaticResource Texture}"/>
                        <TextBlock Text="{Binding Path=Name}" ToolTip="{Binding Path=Path}" />
                    </DockPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="AssetGeometryTemplate"  DataType="{x:Type Assets:AssetGeometry}">
                <Border Style="{StaticResource BaseBorderStyle}">
                    <DockPanel Margin="0, 1">
                        <Image Margin="8" Opacity="0.9" DockPanel.Dock="Left" Source="{StaticResource Geometry}"/>
                        <TextBlock Text="{Binding Path=Name}" ToolTip="{Binding Path=Path}" />
                    </DockPanel>
                </Border>
            </DataTemplate>-->

            <!--<Assets:AssetTemplateSelector
                x:Key="AssetTemplateSelector"
                AssetTextureTemplate="{StaticResource AssetTextureTemplate}"
                AssetGeometryTemplate="{StaticResource AssetGeometryTemplate}"
                AssetDirectoryTemplate="{StaticResource AssetDirectoryTemplate}"
                AssetVideoTemplate="{StaticResource AssetVideoTemplate}"/>-->

            <ContextMenu
                x:Key="ResourceContextMenu"
                Width="175"
                Style="{StaticResource ContextMenuDefault}">
                <MenuItem
                    Command="{Binding AddAssetCommand}"
                    Header="New Folder"
                    IsEnabled="{Binding CanAddAsset}">
                    <MenuItem.Icon>
                        <Image Source="{DynamicResource Add}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding RenameAssetCommand}"
                    Header="Rename"
                    IsEnabled="{Binding CanRenameAsset}">
                    <MenuItem.Icon>
                        <Image
                            Width="10"
                            Height="10"
                            Source="{DynamicResource Rename}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding DeleteAssetsCommand}"
                    Header="Delete"
                    IsEnabled="{Binding CanDeleteAsset}">
                    <MenuItem.Icon>
                        <Image
                            Width="10"
                            Height="10"
                            Source="{DynamicResource DeleteLayer}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem
                    Command="{Binding RelinkAssetsCommand}"
                    Header="Relink"
                    IsEnabled="{Binding CanRelinkAsset}">
                    <MenuItem.Icon>
                        <Image
                            Width="10"
                            Height="10"
                            Source="{StaticResource DeleteLayer}" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>

        </ResourceDictionary>
    </UserControl.Resources>

    <Border
        dd:DragDrop.DropHandler="{Binding}"
        dd:DragDrop.IsDropTarget="True"
        Background="{DynamicResource Grey300Brush}">
        <StackPanel>
            <Expander Header="Images" IsExpanded="True">
                <ListBox
                    dd:DragDrop.DropHandler="{Binding}"
                    dd:DragDrop.IsDropTarget="True"
                    AlternationCount="2"
                    Background="Transparent"
                    DockPanel.Dock="Top"
                    ItemsSource="{Binding AssetRepository.Images}"
                    SelectionMode="Extended">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="{DynamicResource ControlHeightSM}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListBoxItemAlternationStyle}" TargetType="{x:Type ListBoxItem}">
                            <Setter Property="IsSelected" Value="{Binding Mode=TwoWay, Path=IsSelected}" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                </ListBox>
            </Expander>
            <Expander Header="Videos" IsExpanded="True">
                <ListBox
                    dd:DragDrop.DropHandler="{Binding}"
                    dd:DragDrop.IsDropTarget="True"
                    AlternationCount="2"
                    Background="Transparent"
                    DockPanel.Dock="Top"
                    ItemsSource="{Binding AssetRepository.Videos}"
                    SelectionMode="Extended">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="{DynamicResource ControlHeightSM}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListBoxItemAlternationStyle}" TargetType="{x:Type ListBoxItem}">
                            <Setter Property="IsSelected" Value="{Binding Mode=TwoWay, Path=IsSelected}" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                </ListBox>
            </Expander>
            <Expander Header="Geometries" IsExpanded="True">
                <ListBox
                    dd:DragDrop.DropHandler="{Binding}"
                    dd:DragDrop.IsDropTarget="True"
                    AlternationCount="2"
                    Background="Transparent"
                    DockPanel.Dock="Top"
                    ItemsSource="{Binding AssetRepository.Geometries}"
                    SelectionMode="Extended">

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Height="{DynamicResource ControlHeightSM}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" />
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style BasedOn="{StaticResource ListBoxItemAlternationStyle}" TargetType="{x:Type ListBoxItem}">
                            <Setter Property="IsSelected" Value="{Binding Mode=TwoWay, Path=IsSelected}" />
                        </Style>
                    </ListBox.ItemContainerStyle>

                </ListBox>
            </Expander>
        </StackPanel>
    </Border>
</UserControl>