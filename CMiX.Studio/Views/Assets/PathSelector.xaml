<UserControl x:Class="CMiX.Studio.Views.PathSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="d" 
             x:Name="pathSelector"
             d:DesignHeight="40.286" d:DesignWidth="302.571"
             xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties">

    <Grid Height="22">

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock 
            Text="Filename"
            Margin="0, 0, 8, 0"
            HorizontalAlignment="Right"/>

        <Border
            x:Name="mask" 
            Grid.Column="1" 
            Background="{DynamicResource DarkColor}" 
            Style="{StaticResource BorderMask}"
            AttachedProperties:PositionedControl.Position="{Binding Path=Position, ElementName=pathSelector}"/>

        <Border 
            x:Name="mainBorder" 
            Grid.Column="1" 
            BorderBrush="Transparent" 
            Background="{DynamicResource DarkColor}">

            <Border.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=mask}"/>
            </Border.OpacityMask>

            <ComboBox 
                AttachedProperties:PositionedControl.Position="All"
                Grid.Column="1"
                AllowDrop="True"
                ItemsSource="{Binding ItemsSource, ElementName=pathSelector}"
                SelectedItem="{Binding SelectedItem, ElementName=pathSelector}"
                IsSynchronizedWithCurrentItem="False"
                dd:DragDrop.DropHandler="{Binding}"
                dd:DragDrop.IsDropTarget="True">

                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>

                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel RequestBringIntoView="OnRequestBringIntoView"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>

            </ComboBox>
        </Border>
    </Grid>
</UserControl>