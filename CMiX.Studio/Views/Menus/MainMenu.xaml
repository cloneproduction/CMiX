<UserControl
    x:Class="CMiX.Studio.Views.Menus.MainMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="36"
    d:DesignWidth="872"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">
    <Border
        Margin="0,0,0,2"
        Padding="2"
        Background="Transparent"
        BorderBrush="{DynamicResource SuperHighDarkerColor}"
        DockPanel.Dock="Top"
        WindowChrome.IsHitTestVisibleInChrome="True">
        <Menu
            Height="{DynamicResource ControlHeightMD}"
            Margin="0,0,0,0"
            HorizontalAlignment="Left"
            VerticalContentAlignment="Center"
            Style="{StaticResource MenuDefault}">

            <MenuItem
                Padding="8,0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="center"
                Header="File"
                Style="{DynamicResource TopMenuItem}">

                <MenuItem
                    Padding="0,0,64,0"
                    Command="{Binding NewProjectCommand}"
                    Header="New" />

                <MenuItem
                    Command="{Binding OpenProjectCommand}"
                    Header="Open"/>

                <MenuItem Command="{Binding SaveProjectCommand}" Header="Save" />

                <MenuItem Command="{Binding SaveAsProjectCommand}" Header="Save As" />

                <MenuItem
                    Command="{Binding CloseWindowCommand}"
                    Header="Quit" />

            </MenuItem>

            <MenuItem
                Padding="8,0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                Header="Edit"
                Style="{DynamicResource TopMenuItem}">

                <MenuItem Command="{Binding UndoCommand}" Header="Undo    Ctrl + Z" />

                <MenuItem Command="{Binding RedoCommand}" Header="Redo    Ctrl + Y" />

            </MenuItem>

            <MenuItem
                Padding="8,0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="center"
                Header="Compo"
                Style="{DynamicResource TopMenuItem}">

                <MenuItem Command="{Binding AddCompositionCommand}" Header="New Composition" />

                <MenuItem Header="Delete" />
                <MenuItem Header="Duplicate" />
                <Separator
                    Margin="0,8,8,8"
                    BorderBrush="{StaticResource DarkColor}"
                    BorderThickness="0.5" />
                <MenuItem Header="Import" />
                <MenuItem Header="Export" />

            </MenuItem>

            <MenuItem
                Padding="8,0"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="center"
                Header="Layer"
                Style="{DynamicResource TopMenuItem}">
                <MenuItem Command="{Binding AddLayerCommand}" Header="New Layer" />
                <MenuItem Header="Delete" />
                <MenuItem Header="Duplicate" />
            </MenuItem>

        </Menu>
    </Border>
</UserControl>
