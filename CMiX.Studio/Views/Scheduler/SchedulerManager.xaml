<UserControl x:Class="CMiX.Studio.Views.Scheduler.SchedulerManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMiX.Studio.Views.Scheduler"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs" 
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="510" d:DesignWidth="500">

    <StackPanel>
        <Border VerticalAlignment="Center"
                    Padding="8"
                    DockPanel.Dock="Top"
                    Height="40">
            <TextBlock DockPanel.Dock="Left" 
                        Text="SCHEDULER" 
                        FontWeight="SemiBold" 
                        VerticalAlignment="Center"/>
        </Border>

        <Border Margin="4, 0, 4, 8">
            <ListBox
                MaxHeight="100"
                Style="{StaticResource ListBoxWithButton}"
                ItemsSource="{Binding CompositionSchedulers}"
                SelectedItem="{Binding SelectedScheduler}"
                SelectedIndex="{Binding SelectedSchedulerIndex}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Height="25" >
                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
        <Expander Header="Tasks" IsExpanded="True" >
            <Border Padding="4">
                <StackPanel>
                    <Button Content="Add" 
                        Style="{StaticResource ButtonRounded}"
                        Margin="0, 0, 0, 4"
                        Height="20"
                        Command="{Binding AddJobCommand}"/>
                    <local:Overview Grid.Row="1"  DataContext="{Binding SelectedScheduler}"/>
                </StackPanel>
            </Border>
        </Expander>
        <!--<local:PlaylistEditor Grid.Row="1" Grid.ColumnSpan="2"  DataContext="{Binding PlaylistEditor}"/>-->

    </StackPanel>
</UserControl>
