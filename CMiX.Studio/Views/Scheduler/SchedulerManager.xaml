<UserControl x:Class="CMiX.Studio.Views.Scheduler.SchedulerManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMiX.Studio.Views.Scheduler"
             mc:Ignorable="d" 
             d:DesignHeight="510" d:DesignWidth="500">

    <StackPanel >
        <Border VerticalAlignment="Center"
                    Padding="8"
                    DockPanel.Dock="Top"
                    Height="40">
            <TextBlock DockPanel.Dock="Left" 
                           Text="SCHEDULER" 
                           FontWeight="SemiBold" 
                           VerticalAlignment="Center"/>
        </Border>

        <Border Margin="4, 0, 4, 4">
            <DockPanel HorizontalAlignment="Stretch">
                <StackPanel Margin="4, 0, 0, 0" DockPanel.Dock="Right" >
                    <Button 
                        Style="{StaticResource ButtonRoundedTop}"
                        Height="20" 
                        Width="20"
                        Margin="0, 0, 0, 1"
                        Content="+" 
                        Command="{Binding CreateSchedulerCommand}"/>
                    <Button 
                        Style="{StaticResource ButtonRoundedBottom}"
                        Height="20"
                        Width="20"
                        Margin="0, 1, 0, 0"
                        Content="-"
                        Command="{Binding DeleteSchedulerCommand}"/>
                </StackPanel>
                <Border >
                    <ListBox
                        BorderBrush="{DynamicResource DarkerColor}"
                        MaxHeight="100"
                        Background="{DynamicResource HighHighDarkerColor}"
                        ItemsSource="{Binding CompositionSchedulers}"
                        SelectedItem="{Binding SelectedScheduler}"
                        SelectedIndex="{Binding SelectedSchedulerIndex}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Height="25" >
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Name}"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </DockPanel>
        </Border>
        <local:JobEditor DataContext="{Binding JobEditor}" />
        <local:PlaylistEditor Grid.Row="1" Grid.ColumnSpan="2"  DataContext="{Binding PlaylistEditor}"/>
        <local:Overview Grid.Row="1"  DataContext="{Binding SelectedScheduler}"/>
    </StackPanel>
</UserControl>
