<UserControl x:Class="CMiX.Studio.Views.Scheduler.SchedulerManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMiX.Studio.Views.Scheduler"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs" 
             xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="510" d:DesignWidth="500">

    
    <Expander Header="Scheduler">
        <StackPanel>

            <ListBox
                Margin="8"
                MaxHeight="100"
                ItemsSource="{Binding CompositionSchedulers}"
                SelectedItem="{Binding SelectedScheduler}"
                SelectedIndex="{Binding SelectedSchedulerIndex}">
                <ListBox.ItemTemplate>

                    <DataTemplate>
                        <Controls:EditableTextBox 
                            x:Name="editableTextBox"
                            IsEditing="{Binding IsRenaming}"
                            VerticalAlignment="Center" 
                            Text="{Binding Name}">
                            
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="MouseDoubleClick">
                                    <i:InvokeCommandAction Command="{Binding RenameCommand}" CommandParameter="{Binding}"/>
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                            
                        </Controls:EditableTextBox>
                    </DataTemplate>
                    
                </ListBox.ItemTemplate>
            </ListBox>
            
            <Expander 
                Visibility="{Binding SelectedScheduler, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}"
                Header="Tasks"
                IsExpanded="True">

                <StackPanel Margin="8">
                    
                    <Button Content="Add"
                        Margin="0, 4, 0, 2"
                        Height="20"
                        Command="{Binding AddJobCommand}"/>
                    
                    <local:Overview  
                        Margin="0, 0" 
                        DataContext="{Binding SelectedScheduler}"/>
                    
                </StackPanel>

            </Expander>
            
        </StackPanel>
    </Expander>

</UserControl>