<UserControl x:Class="CMiX.Studio.Views.Scheduler.SchedulerManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CMiX.Studio.Views.Scheduler"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="510" d:DesignWidth="500">

    <Expander Header="Scheduler">
        <StackPanel>
            <Border Margin="8">
                <ListBox
                    MaxHeight="100"
                    Style="{StaticResource ListBoxWithButton}"
                    ItemsSource="{Binding CompositionSchedulers}"
                    SelectedItem="{Binding SelectedScheduler}"
                    SelectedIndex="{Binding SelectedSchedulerIndex}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border>
                                <Controls:EditableTextBox 
                                        x:Name="editableTextBox"
                                        IsEditing="{Binding IsRenaming}"
                                        VerticalAlignment="Center" 
                                        Text="{Binding Name}">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction 
                                                    Command="{Binding RenameCommand}"
                                                    CommandParameter="{Binding}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </Controls:EditableTextBox>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Expander 
                Visibility="{Binding SelectedScheduler, Converter={StaticResource NullToVisibility}}"
                Header="Tasks" 
                IsExpanded="True">
                <Border Padding="8">
                    <StackPanel>
                        <Button Content="Add"
                            Style="{StaticResource ButtonRounded}"
                            Margin="0, 4, 0, 2"
                            Height="20"
                            Command="{Binding AddJobCommand}"/>
                        <local:Overview  Margin="0, 0" DataContext="{Binding SelectedScheduler}"/>
                    </StackPanel>
                </Border>
            </Expander>
        </StackPanel>
    </Expander>

</UserControl>