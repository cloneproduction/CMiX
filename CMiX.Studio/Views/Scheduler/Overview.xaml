<UserControl x:Class="CMiX.Studio.Views.Scheduler.Overview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views.Scheduler"
             mc:Ignorable="d" 
             x:Name="overView"
             d:DesignHeight="450" d:DesignWidth="800">



    <ItemsControl ItemsSource="{Binding Schedules}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Expander Margin="0, 4" IsExpanded="True" Style="{StaticResource ItemControlExpander}">
                    <Expander.Header>
                        <DockPanel HorizontalAlignment="Stretch">
                            <Button Content="✕" 
                                    DockPanel.Dock="Right"
                                    Margin="0, 0, 4, 0"
                                    Style="{StaticResource ButtonItemControl}"
                                    Command="{Binding DataContext.RemoveJobCommand, ElementName=overView}"
                                    CommandParameter="{Binding}"/>
                            <TextBlock HorizontalAlignment="Stretch" Text="{Binding Name}" DockPanel.Dock="Left"/>
                        </DockPanel>
                    </Expander.Header>
                    <StackPanel Margin="0, 4">
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Right" Padding="4" Text="Playlist"/>
                            <Border Grid.Column="1" Height="25">
                                <TextBlock Padding="4" VerticalAlignment="Center" Text="{Binding Playlist.Name}"/>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Right" Padding="4" Text="Now Playing"/>
                            <Border Grid.Column="1" Height="25">
                                <TextBlock Padding="4" VerticalAlignment="Center" Text="{Binding CurrentComposition.Name}"/>
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" HorizontalAlignment="Right" Padding="4" Text="Up Next"/>
                            <Border Grid.Column="1" Height="25">
                                <TextBlock Padding="4" VerticalAlignment="Center" Text="{Binding NextRun}"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Expander>

            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>