<UserControl x:Class="CMiX.Studio.Views.Pixelate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="295.333" d:DesignWidth="282.667">
    
    <StackPanel Margin="8">

        <Controls:CMiXSlider 
            Caption="Factor X" 
            Margin="0, 0, 0, 1"
            Minimum="0" 
            Maximum="1" 
            Value="{Binding FactorX.Amount}" 
            Style="{StaticResource CMiXSliderStyle}" 
            Position="Top"/>

        <Controls:CMiXSlider 
            Caption="Factor Y" 
            Minimum="0" 
            Maximum="1" 
            Value="{Binding FactorY.Amount}" 
            Style="{StaticResource CMiXSliderStyle}" 
            Position="Bottom"/>

        <Controls:CMiXSlider 
            Margin="0, 8, 0, 0" 
            Caption="Control" 
            Minimum="0" 
            Maximum="1" 
            Value="{Binding Control.Amount}" 
            Style="{StaticResource CMiXSliderStyle}" 
            Position="Default"/>
        
    </StackPanel>
</UserControl>
