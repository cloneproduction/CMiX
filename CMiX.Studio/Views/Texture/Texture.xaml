<UserControl
    x:Class="CMiX.Studio.Views.Texture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    d:DesignHeight="454.667"
    d:DesignWidth="572.667"
    mc:Ignorable="d">

    <StackPanel>

        <TabControl Margin="8, 16" SelectedIndex="{Binding SelectedAssetType.Selection}" Style="{StaticResource InLineTabControlStyle}">

            <TabItem Header="Image">
                <StackPanel>
                    <Views:TexturePathSelector 
                        DockPanel.Dock="Top"
                        Margin="0, 8, 0, 0"
                        DataContext="{Binding ImageSelector}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Video">
                <StackPanel Margin="0, 8, 0, 0">
                    <Views:VideoPathSelector Grid.Column="1" DataContext="{Binding VideoSelector}"/>
                    <Views:VideoPlayer Margin="0, 8" DataContext="{Binding VideoPlayer}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Text">
                <StackPanel Margin="0, 8">
                    <Views:TypeWriter DataContext="{Binding TypeWriter}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Cam">
                <Views:VideoIn Margin="0, 16, 0, 8" DataContext="{Binding VideoIn}"/>
            </TabItem>

            <TabItem Header="Pro">

            </TabItem>

        </TabControl>

        <Expander Header="Filter" IsExpanded="True">
            <Views:TextureFilter DataContext="{Binding TextureModifierManager}"/>
        </Expander>

    </StackPanel>

</UserControl>