<UserControl
    x:Class="CMiX.Studio.Views.Texture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
    xmlns:MVVM.Views="clr-namespace:CMiX.Core.Presentation.Views;assembly=CMiX.Core"
    xmlns:Tools="clr-namespace:CMiX.Core.Presentation;assembly=CMiX.Core"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ViewModels="clr-namespace:CMiX.Core.Presentation.ViewModels"
    xmlns:Assets="clr-namespace:CMiX.Core.Presentation.ViewModels.Assets;assembly=CMiX.Core"
    d:DesignHeight="636.667"
    d:DesignWidth="316.667"
    mc:Ignorable="d">

    <Border Background="{DynamicResource DarkerColor}">
        <StackPanel>

            <Border
                Height="25"
                Margin="0, 0, 0, 2"
                Padding="4"
                DockPanel.Dock="Top">
                <DockPanel 
                VerticalAlignment="Center" 
                LastChildFill="False">
                    <TextBlock
                    Margin="4, 0, 0, 0"
                    Text="TEXTURE"
                    Foreground="{StaticResource TextBase}"/>
                </DockPanel>
            </Border>

            <Views:TexturePathSelector DataContext="{Binding ImageSelector}"/>
            <Expander 
                Visibility="{Binding ImageSelector.SelectedAsset, Converter={StaticResource TypeToVisibility}, ConverterParameter={x:Type Assets:AssetVideo}}"
                IsExpanded="True" 
                Header="Video Player">
                <Views:VideoPlayer DataContext="{Binding VideoPlayer}"/>
            </Expander>

            <Expander 
                IsExpanded="True" 
                Header="Filter">
                <Views:TextureFilterManager DataContext="{Binding ModifierManager}"/>
            </Expander>


        </StackPanel>
    </Border>


</UserControl>