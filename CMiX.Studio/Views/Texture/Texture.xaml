<UserControl
    x:Class="CMiX.Studio.Views.Texture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
    xmlns:MVVM.Views="clr-namespace:CMiX.Core.Presentation.Views;assembly=CMiX.Core"
    xmlns:Tools="clr-namespace:CMiX.Core.Presentation;assembly=CMiX.Core"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ViewModels="clr-namespace:CMiX.Core.Presentation.ViewModels"
    d:DesignHeight="636.667"
    d:DesignWidth="316.667"
    mc:Ignorable="d">

    <!--<UserControl.Resources>
        <Tools:BindingProxy x:Key="ProjectProxy" Data="{Binding}" />
        <ObjectDataProvider x:Key="InvertMode" MethodName="GetNames" ObjectType="{x:Type System:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="ViewModels:TextureInvertMode"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>-->


    <Border Background="{DynamicResource DarkerColor}">
        <StackPanel>

            <Border
                Height="25"
                Margin="0, 0, 0, 2"
                Padding="4"
                DockPanel.Dock="Top">
                <DockPanel 
                VerticalAlignment="Center" 
                LastChildFill="False">
                    <TextBlock
                    Margin="4, 0, 0, 0"
                    Text="TEXTURE"
                    Foreground="{StaticResource TextBase}"/>
                </DockPanel>
            </Border>

            <Views:TexturePathSelector DataContext="{Binding TextureSelector}"/>

            <Expander 
                IsExpanded="True" 
                Header="Transform">
                <StackPanel Margin="8">

                    <Grid Height="20" Margin="0, 4, 0 ,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" CornerRadius="2" BorderThickness="1, 0, 1, 1">
                            <Controls:DistanceSlider Position="Top" Style="{StaticResource DistanceSliderStyle}" Value="{Binding Path=Pan.Amount}" />
                        </Border>
                        <TextBlock 
                            Grid.Column="0" 
                            Padding="8, 0" 
                            HorizontalAlignment="Right" 
                            Text="Translate U" 
                            Foreground="{StaticResource TextBase}"/>
                    </Grid>

                    <Grid Height="20" Margin="0, 0, 0, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" CornerRadius="2" BorderThickness="1, 0, 1, 2">
                            <Controls:DistanceSlider Position="Bottom" Style="{StaticResource DistanceSliderStyle}" Value="{Binding Path=Tilt.Amount}" />
                        </Border>
                        <TextBlock 
                            Grid.Column="0" 
                            Padding="8, 0" 
                            HorizontalAlignment="Right" 
                            Text="V" 
                            Foreground="{StaticResource TextBase}"/>
                    </Grid>

                    <Grid Height="20" Margin="0, 4, 0 ,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" BorderThickness="1, 0, 1, 0">
                            <Controls:DistanceSlider Position="Top" Style="{StaticResource DistanceSliderStyle}" Value="{Binding Path=Scale.Amount}" />
                        </Border>
                       
                        <TextBlock 
                            Grid.Column="0" 
                            Padding="8, 0" 
                            HorizontalAlignment="Right" 
                            Text="Scale U" 
                            Foreground="{StaticResource TextBase}"/>
                    </Grid>

                    <Grid Height="20" Margin="0, 1, 0, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border  Grid.Column="1" Style="{DynamicResource BorderShadow}">
                            <Controls:DistanceSlider Grid.Column="1" Position="Bottom" Style="{StaticResource DistanceSliderStyle}" Value="{Binding Path=Scale.Amount}" />
                        </Border>
                        <TextBlock 
                            Grid.Column="0" 
                            Padding="8, 0" 
                            HorizontalAlignment="Right" 
                            Text="V" 
                            Foreground="{StaticResource TextBase}"/>
                    </Grid>

                    <Grid Height="20" Margin="0, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="1" Style="{DynamicResource BorderShadow}">
                            <Controls:DistanceSlider 
                                Grid.Column="1" 
                                Style="{StaticResource DistanceSliderStyle}" 
                                Value="{Binding Path=Rotate.Amount}" />
                        </Border>
                        <TextBlock 
                            Grid.Column="0" 
                            Padding="8, 0" 
                            HorizontalAlignment="Right" 
                            Text="Rotate" 
                            Foreground="{StaticResource TextBase}"/>
                    </Grid>

                    <Grid Height="20" Margin="0, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock 
                            Text="U" 
                            HorizontalAlignment="Right" 
                            Padding="4, 0" 
                            VerticalAlignment="Center"/>
                        <Border Grid.Column="1">
                            <ComboBox  Grid.Column="1"/>
                        </Border>
                    </Grid>

                    <Grid Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <TextBlock 
                            Text="V" 
                            HorizontalAlignment="Right" Padding="4, 0"
                            VerticalAlignment="Center"/>
                        <Border Grid.Column="1">
                            <ComboBox/>
                        </Border>
                    </Grid>

                </StackPanel>

            </Expander>

            <Expander 
                IsExpanded="True" 
                Padding="8" 
                Header="Color">
                <StackPanel Margin="8">

                    <Border Style="{DynamicResource BorderShadow}">
                        <StackPanel>
                            
                            <Controls:CMiXSlider
                                Style="{StaticResource CMiXSliderStyle}"
                                Position="Top"
                                Minimum="0"
                                Maximum="1"
                                Caption="Brightness"
                                Value="{Binding Brightness.Amount}"/>

                            <Controls:CMiXSlider
                                Style="{StaticResource CMiXSliderStyle}"
                                Position="Bottom"
                                Minimum="0"
                                Maximum="1"
                                Margin="0, 1, 0, 0"
                                Caption="Contrast"
                                DockPanel.Dock="Bottom"
                                Value="{Binding Contrast.Amount}"/>
                            
                        </StackPanel>
                    </Border>


                    <Views:Inverter Margin="0, 4" DataContext="{Binding Inverter}"/>

                    <Border Style="{DynamicResource BorderShadow}">
                        <StackPanel>

                            <Controls:CMiXSlider
                                Style="{StaticResource CMiXSliderStyle}"
                                Minimum="-1.0"
                                Maximum="1.0"
                                Caption="Hue"
                                Position="Top"
                                Value="{Binding Hue.Amount}"/>

                            <Controls:CMiXSlider
                                Style="{StaticResource CMiXSliderStyle}"
                                Minimum="-1.0"
                                Maximum="1.0"
                                Margin="0, 1"
                                Caption="Saturation"
                                Position="Middle"
                                Value="{Binding Saturation.Amount}"/>

                            <Controls:CMiXSlider
                                Style="{StaticResource CMiXSliderStyle}"
                                Minimum="-1.0"
                                Maximum="1.0"
                                Caption="Luminosity"
                                Position="Bottom"
                                Value="{Binding Luminosity.Amount}"/>

                        </StackPanel>
                    </Border>

                    <Border Margin="0, 8, 0, 0" Style="{DynamicResource BorderShadow}">
                        <Controls:CMiXSlider
                            Style="{StaticResource CMiXSliderStyle}"
                            Minimum="0"
                            Maximum="1.0"
                            Height="20"
                            Caption="Keying"
                            Value="{Binding Keying.Amount}"/>
                    </Border>
                </StackPanel>
            </Expander>
        </StackPanel>
    </Border>


</UserControl>