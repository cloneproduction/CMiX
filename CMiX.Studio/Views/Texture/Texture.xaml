<UserControl
    x:Class="CMiX.Studio.Views.Texture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    d:DesignHeight="636.667"
    d:DesignWidth="316.667"
    mc:Ignorable="d">

    <StackPanel>
        <Views:SamplerState DataContext="{Binding SamplerState}" Margin="8, 8, 8, 0"/>
        <TabControl Margin="8, 16" SelectedIndex="{Binding SelectedAssetType.Selection}" Style="{StaticResource InLineTabControlStyle}">

            <TabItem Header="Image">
                <StackPanel>
                    <Views:TexturePathSelector 
                        DockPanel.Dock="Top"
                        Margin="0, 8, 0, 0"
                        DataContext="{Binding ImageSelector}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Video">
                <StackPanel Margin="0, 8, 0, 0">
                    <Views:VideoPathSelector Grid.Column="1" DataContext="{Binding VideoSelector}"/>
                    <Views:VideoPlayer Margin="0, 8" DataContext="{Binding VideoPlayer}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Text">
                <StackPanel Margin="0, 8">
                    <Views:TypeWriter DataContext="{Binding TypeWriter}"/>
                </StackPanel>
            </TabItem>
                
            <TabItem Header="Cam">
                <StackPanel Margin="8">
                    <Views:VideoIn  Margin="0, 8, 0, 0" DataContext="{Binding VideoIn}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Pro">

            </TabItem>

            </TabControl>

        <Views:TextureFilterManager DataContext="{Binding ModifierManager}"/>
        <Views:TransformModifierManager DataContext="{Binding TextureTransformModifierManager}"/>
        </StackPanel>

</UserControl>