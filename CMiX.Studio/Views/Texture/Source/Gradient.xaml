<UserControl
    x:Class="CMiX.Studio.Views.Gradient"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="162.555"
    d:DesignWidth="270.31"
    mc:Ignorable="d">

    <StackPanel >

        <BaseControl:DragValue
            Margin="0,0,0,8"
            Caption="Gamma"
            Value="{Binding Gamma.Value}" />

        <BaseControl:ColorSelector
            Caption="From"
            Position="Top"
            SelectedColor="{Binding Path=From.SelectedColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            ViewModel="{Binding Path=From}" />

        <!--<BaseControl:ColorSelector
            Margin="0,1,0,0"
            Caption="To"
            Position="Bottom"
            SelectedColor="{Binding To.SelectedColor}"
            ViewModel="{Binding To}" />

        <BaseControl:ToggleButton
            Margin="0,8"
            Caption="Horizontal"
            IsChecked="{Binding Horizontal.Value}" />

        <BaseControl:Integer2Value Caption="Resolution" DataContext="{Binding Resolution}" />-->

    </StackPanel>

</UserControl>
