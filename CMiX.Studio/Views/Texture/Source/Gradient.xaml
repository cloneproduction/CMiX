<UserControl x:Class="CMiX.Studio.Views.Gradient"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="429.222" d:DesignWidth="287.643">

    <StackPanel>
        <StackPanel>
            <BaseControl:DragValue Caption="Gamma" Margin="0, 0, 0, 8" Value="{Binding Gamma.Amount}"/>

            <BaseControl:ColorSelector 
                Caption="From"
                Position="Top"
                ViewModel="{Binding From}"
                SelectedColor="{Binding From.SelectedColor}"/>
            
            <BaseControl:ColorSelector 
                Margin="0, 1, 0, 0"
                Caption="To"
                Position="Bottom"
                ViewModel="{Binding To}"
                SelectedColor="{Binding To.SelectedColor}"/>

            <BaseControl:ToggleButton 
                Margin="0, 8, 0, 0"
                IsChecked="{Binding Horizontal.IsChecked}"
                Caption="Horizontal"/>

            <StackPanel Margin="0, 8, 0, 0">

                
                <!--<Grid Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Padding="4" Text="Resolution X" HorizontalAlignment="Right"/>
                    <Border Grid.Column="1" BorderThickness="0, 0, 0, 1">
                        <Controls:Counter Position="Top" Style="{StaticResource CMiXCounterStyle}"  Value="{Binding ResolutionX.Count, Mode=TwoWay}"/>
                    </Border>
                </Grid>

                <Grid Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Padding="4" Text="Y" HorizontalAlignment="Right"/>
                    <Controls:Counter Grid.Column="1" Position="Bottom" Style="{StaticResource CMiXCounterStyle}" Value="{Binding ResolutionY.Count, Mode=TwoWay}"/>
                </Grid>-->

            </StackPanel>
        </StackPanel>

    </StackPanel>
</UserControl>
