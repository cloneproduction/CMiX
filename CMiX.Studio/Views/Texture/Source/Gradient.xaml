<UserControl x:Class="CMiX.Studio.Views.Gradient"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="429.222" d:DesignWidth="287.643">

    <StackPanel>
        <StackPanel>
            <Grid Height="22" Margin="0, 0, 0, 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                Text="Gamma" 
                HorizontalAlignment="Right" 
                Padding="4, 0" 
                VerticalAlignment="Center"/>
                <Controls:DistanceSlider 
                Grid.Column="1"  
                Value="{Binding Gamma.Amount}" 
                Style="{StaticResource DistanceSliderStyle}" 
                Position="Default"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                Text="From" 
                HorizontalAlignment="Right" Padding="4, 0"
                VerticalAlignment="Center"/>
                <Border Grid.Column="1">
                    <Button Height="22"
                        Margin="0"
                        Command="{Binding OpenColorSelectorCommand}"
                        CommandParameter="{Binding From}"
                        Style="{StaticResource ButtonColorStyle}">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding From.SelectedColor}"/>
                        </Button.Background>
                    </Button>
                </Border>
            </Grid>

            <Grid Margin="0, 4, 0, 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                    Text="To" 
                    HorizontalAlignment="Right" Padding="4, 0"
                    VerticalAlignment="Center"/>
                <Border Grid.Column="1">
                    <Button Height="22"
                        Margin="0"
                        Command="{Binding OpenColorSelectorCommand}"
                        CommandParameter="{Binding To}"
                        Style="{StaticResource ButtonColorStyle}">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding To.SelectedColor}"/>
                        </Button.Background>
                    </Button>
                </Border>
            </Grid>

            <Grid Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Padding="4" Text="Horizontal" HorizontalAlignment="Right"/>
                <ToggleButton Grid.Column="1" HorizontalAlignment="Left" IsChecked="{Binding Horizontal.IsChecked}"/>
            </Grid>

            <Views:TransformUV Margin="0, 8" DataContext="{Binding Transform2D}"/>
            
            <StackPanel Margin="0, 8, 0, 0">

                <Grid Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Padding="4" Text="Resolution X" HorizontalAlignment="Right"/>
                    <Border Grid.Column="1" BorderThickness="0, 0, 0, 1">
                        <Controls:Counter Position="Top" Style="{StaticResource CMiXCounterStyle}"  Value="{Binding ResolutionX.Count, Mode=TwoWay}"/>
                    </Border>
                </Grid>

                <Grid Height="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Padding="4" Text="Y" HorizontalAlignment="Right"/>
                    <Controls:Counter Grid.Column="1" Position="Bottom" Style="{StaticResource CMiXCounterStyle}" Value="{Binding ResolutionY.Count, Mode=TwoWay}"/>
                </Grid>

            </StackPanel>
        </StackPanel>

    </StackPanel>
</UserControl>
