<UserControl x:Class="CMiX.Studio.Views.Gradient"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="162.555" d:DesignWidth="270.31">

    <StackPanel>
        <StackPanel>
            <BaseControl:DragValue 
                Caption="Gamma" 
                Margin="0, 0, 0, 8"
                Value="{Binding Gamma.Value}"/>

            <BaseControl:ColorSelector 
                Caption="From"
                Position="Top"
                ViewModel="{Binding From}"
                SelectedColor="{Binding From.SelectedColor}"/>

            <BaseControl:ColorSelector 
                Margin="0, 1, 0, 0"
                Caption="To"
                Position="Bottom"
                ViewModel="{Binding To}"
                SelectedColor="{Binding To.SelectedColor}"/>

            <BaseControl:ToggleButton 
                Margin="0, 8"
                IsChecked="{Binding Horizontal.Value}"
                Caption="Horizontal"/>

            <BaseControl:Integer2Value 
                Caption="Resolution"
                DataContext="{Binding Resolution}"/>

        </StackPanel>

    </StackPanel>
</UserControl>
