<UserControl x:Class="CMiX.Studio.Views.BubbleNoise"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="429.222" d:DesignWidth="287.643">

    <StackPanel>
        <StackPanel>
            
            <BaseControls:DragValue 
                Caption="Speed" 
                Position="Top" 
                Value="{Binding Speed.Amount}"/>
            
            <BaseControls:DragValue 
                Margin="0, 1" 
                Caption="Frequency" 
                Position="Middle" 
                Value="{Binding Frequency.Amount}"/>
            
            <BaseControls:DragValue 
                Caption="Contrast" 
                Position="Bottom" 
                Value="{Binding Contrast.Amount}"/>
            
            <Grid Margin="0, 8, 0, 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                    Text="Background" 
                    HorizontalAlignment="Right" Padding="4, 0"
                    VerticalAlignment="Center"/>
                <Border Grid.Column="1">
                    <Button Height="22"
                        Margin="0"
                        Command="{Binding OpenColorSelectorCommand}"
                        CommandParameter="{Binding BackgroundColor}"
                        Style="{StaticResource ButtonColorStyle}">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding BackgroundColor.SelectedColor}"/>
                        </Button.Background>
                    </Button>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock 
                    Text="Bubble" 
                    HorizontalAlignment="Right" Padding="4, 0"
                    VerticalAlignment="Center"/>
                <Border Grid.Column="1">
                    <Button Height="22"
                        Margin="0"
                        Command="{Binding OpenColorSelectorCommand}"
                        CommandParameter="{Binding BubbleColor}"
                        Style="{StaticResource ButtonColorStyle}">
                        <Button.Background>
                            <SolidColorBrush Color="{Binding BubbleColor.SelectedColor}"/>
                        </Button.Background>
                    </Button>
                </Border>
            </Grid>

            <BaseControls:Counter 
                Position="Top" 
                Margin="0, 8, 0, 0" 
                Caption="Resolution X" 
                Count="{Binding ResolutionX.Count}"/>
            
            <BaseControls:Counter 
                Position="Bottom" 
                Caption="Y" 
                Count="{Binding ResolutionY.Count}"/>
            
        </StackPanel>

    </StackPanel>
</UserControl>
