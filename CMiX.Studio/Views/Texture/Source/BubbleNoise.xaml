<UserControl x:Class="CMiX.Studio.Views.BubbleNoise"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="429.222" d:DesignWidth="287.643">

    <StackPanel>

        <BaseControls:DragValue 
            Caption="Speed" 
            Position="Top" 
            Value="{Binding Speed.Value}"/>
            
        <BaseControls:DragValue 
            Margin="0, 1" 
            Caption="Frequency" 
            Position="Middle" 
            Value="{Binding Frequency.Value}"/>

        <BaseControls:DragValue 
            Caption="Contrast" 
            Position="Bottom" 
            Value="{Binding Contrast.Value}"/>

        <BaseControls:ColorSelector 
            Caption="Background" 
            Margin="0, 8, 0, 1"
            ViewModel="{Binding BackgroundColor}"
            SelectedColor="{Binding BackgroundColor.SelectedColor}" 
            Position="Top"/>
            
        <BaseControls:ColorSelector 
            Caption="Bubble" 
            ViewModel="{Binding BubbleColor}"
            SelectedColor="{Binding BubbleColor.SelectedColor}" 
            Position="Bottom"/>

        <BaseControls:Integer2Value 
            Margin="0, 8, 0, 0"
            DataContext="{Binding Resolution}" 
            Caption="Resolution"/>

    </StackPanel>
    
</UserControl>
