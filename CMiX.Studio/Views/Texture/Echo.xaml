<UserControl x:Class="CMiX.Studio.Views.Echo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="295.333" d:DesignWidth="282.667">
    <Expander
        Header="Echo" 
        Template="{StaticResource ModifierPanelTemplate}"
        IsExpanded="{Binding IsExpanded}">
        
        <StackPanel Margin="8">
            
            <Controls:CMiXSlider Caption="Factor" 
                                 Margin="0, 8"
                                 Minimum="0" 
                                 Maximum="1" 
                                 Value="{Binding Factor.Amount}" 
                                 Style="{StaticResource CMiXSliderStyle}" 
                                 Position="Top"/>
            
        </StackPanel>
        
    </Expander>
</UserControl>
