<UserControl
    x:Class="CMiX.Studio.Views.SamplerState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignWidth="386"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControls:ComboBox
            Caption="Address U"
            ItemsSource="{Binding Source={StaticResource TextureAddressMode}}"
            Position="Top"
            SelectedItem="{Binding AddressU.Value, Converter={StaticResource EnumToString}}" />

        <BaseControls:ComboBox
            Margin="0,1,0,0"
            Caption="V"
            ItemsSource="{Binding Source={StaticResource TextureAddressMode}}"
            Position="Bottom"
            SelectedItem="{Binding AddressV.Value, Converter={StaticResource EnumToString}}" />

        <BaseControls:ColorSelector
            Margin="0,8,0,0"
            Caption="Border Color"
            Position="Default"
            SelectedColor="{Binding BorderColor.Value}"
            ViewModel="{Binding BorderColor}" />

    </StackPanel>

</UserControl>
