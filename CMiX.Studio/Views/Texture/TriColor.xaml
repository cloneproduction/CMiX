<UserControl x:Class="CMiX.Studio.Views.TriColor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="246.889" d:DesignWidth="291.555">

    <StackPanel Margin="8">

        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock 
                    Text="Color A" 
                    HorizontalAlignment="Right" Padding="4, 0"
                    VerticalAlignment="Center"/>
            <Border Margin="0, 4, 0, 0" Grid.Column="1">
                <Button Height="21"
                        Margin="0"
                        Background="{Binding ColorA.SelectedColor, Converter={StaticResource ColorToBrush}, ConverterParameter=all}"
                        Command="{Binding OpenColorASelectorCommand}"
                        Style="{StaticResource ButtonColorStyle}"/>
            </Border>
        </Grid>

        <Grid >
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock 
                    Text="Color B" 
                    HorizontalAlignment="Right" Padding="4, 0"
                    VerticalAlignment="Center"/>
            <Border Margin="0, 4, 0, 0" Grid.Column="1">
                <Button Height="21"
                        Margin="0"
                        Background="{Binding ColorB.SelectedColor, Converter={StaticResource ColorToBrush}, ConverterParameter=all}"
                        Command="{Binding OpenColorBSelectorCommand}"
                        Style="{StaticResource ButtonColorStyle}"/>
            </Border>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock 
                    Text="Color C" 
                    HorizontalAlignment="Right" Padding="4, 0"
                    VerticalAlignment="Center"/>
            <Border Margin="0, 4, 0, 0" Grid.Column="1">
                <Button 
                        Height="21"
                        Margin="0"
                        Background="{Binding ColorC.SelectedColor, Converter={StaticResource ColorToBrush}, ConverterParameter=all}"
                        Command="{Binding OpenColorCSelectorCommand}"
                        Style="{StaticResource ButtonColorStyle}"/>
            </Border>
        </Grid>

        <Grid Margin="0, 8, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock 
                    Text="Single Channel" 
                    HorizontalAlignment="Right" Padding="4, 0"
                    VerticalAlignment="Center"/>
            <Border Margin="0, 4, 0, 0" Grid.Column="1">
                <ToggleButton 
                        Height="21"
                        HorizontalAlignment="Left"
                        IsChecked="{Binding SingleChannel.IsChecked}"/>
            </Border>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock 
                    Text="Clamp Color" 
                    HorizontalAlignment="Right" Padding="4, 0"
                    VerticalAlignment="Center"/>
            <Border Margin="0, 4, 0, 0" Grid.Column="1">
                <ToggleButton 
                        Height="21"
                        HorizontalAlignment="Left"
                        IsChecked="{Binding ClampColor.IsChecked}"/>
            </Border>
        </Grid>

        <Controls:CMiXSlider Margin="0, 8, 0, 1" Caption="Smooth" Minimum="0.0" Maximum="1.0" Value="{Binding Smooth.Amount}" Style="{StaticResource CMiXSliderStyle}" Position="Top"/>
        <Controls:CMiXSlider Margin="0, 0, 0, 8" Caption="Center" Minimum="0.0" Maximum="1.0" Value="{Binding Center.Amount}" Style="{StaticResource CMiXSliderStyle}" Position="Bottom"/>

        <Controls:CMiXSlider Margin="0, 8" Caption="Control" Minimum="0.0" Maximum="1.0" Value="{Binding Control.Amount}" Style="{StaticResource CMiXSliderStyle}" Position="Default"/>
    </StackPanel>
</UserControl>
