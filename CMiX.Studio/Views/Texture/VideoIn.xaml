<UserControl x:Class="CMiX.Studio.Views.VideoIn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="67.333" d:DesignWidth="332">
    
    <StackPanel>
        
        <Grid Height="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Resolution X" HorizontalAlignment="Right" Padding="4"/>
            <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" CornerRadius="2, 2, 0, 0" BorderThickness="1, 0, 1, 1">
                <Controls:Counter
                    Style="{DynamicResource CMiXCounterStyle}"
                    Position="Top"
                    StepValue="1"
                    Height="21"
                    HorizontalAlignment="Stretch"
                    Value="{Binding SizeX.Count, Mode=TwoWay}"/>
            </Border>
        </Grid>

        <Grid Height="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Y" HorizontalAlignment="Right" Padding="4"/>
            <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" CornerRadius="0, 0, 4, 4" BorderThickness="1, 0, 1, 2">
                <Controls:Counter
                    Style="{DynamicResource CMiXCounterStyle}"
                    StepValue="1"
                    Grid.Column="1"
                    Position="Bottom"
                    Height="20"
                    HorizontalAlignment="Stretch"
                    Value="{Binding SizeY.Count, Mode=TwoWay}"/>
            </Border>
        </Grid>

    </StackPanel>
    
</UserControl>
