<UserControl x:Class="CMiX.Studio.Views.RandomUV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:basecontrol="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="548" d:DesignWidth="461.333">

    <StackPanel>
        <StackPanel Margin="8" >
            
            <Views:BeatModifier DataContext="{Binding BeatModifier}"/>
            
            <basecontrol:DragValue 
                Margin="0, 16, 0, 0" 
                Position="Top" 
                Value="{Binding ScaleX.Amount}" 
                Caption="Scale X"/>
            
            <basecontrol:DragValue 
                Position="Bottom" 
                Margin="0, 1, 0, 0" 
                Value="{Binding ScaleY.Amount}" 
                Caption="Y"/>
            
            <basecontrol:DragValue 
                Margin="0, 2, 0, 8" 
                Position="Default" 
                Value="{Binding Uniform.Amount}" 
                Caption="Uniform"/>
            
            <basecontrol:DragValue 
                Margin="0, 0, 0, 1" 
                Position="Top" 
                Value="{Binding LocationX.Amount}" 
                Caption="Translate X"/>
            
            <basecontrol:DragValue 
                Margin="0, 0, 0, 8" 
                Position="Bottom" 
                Value="{Binding LocationY.Amount}" 
                Caption="Y"/>
            
            <basecontrol:DragValue 
                Margin="0, 0, 0, 1" 
                Position="Default" 
                Value="{Binding Rotation.Amount}" 
                Caption="Rotation"/>
            
            <Views:SamplerState 
                Margin="0, 16, 0, 0" 
                DataContext="{Binding SamplerState}"/>
            
        </StackPanel>

        <Views:Easing DataContext="{Binding Easing}"/>
        
    </StackPanel>

</UserControl>
