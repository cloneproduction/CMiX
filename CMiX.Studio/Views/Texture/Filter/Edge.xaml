<UserControl x:Class="CMiX.Studio.Views.Edge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="240.813" d:DesignWidth="236.721">
    
    <StackPanel Margin="8">
        
        <Controls:CMiXSlider 
            Caption="Radius" 
            Minimum="0" 
            Maximum="10" 
            Value="{Binding Radius.Value}" 
            Style="{StaticResource SliderRoundedTop}" 
            Position="Top"/>
        
        <Controls:CMiXSlider 
            Margin="0, 1, 0, 0" 
            Caption="Brightness" 
            Minimum="0" 
            Maximum="10" 
            Value="{Binding Brightness.Value}" 
            Style="{StaticResource SliderRoundedBottom}" 
            Position="Bottom"/>
        
        <Controls:CMiXSlider 
            Margin="0, 8, 0, 0" 
            Caption="Control" 
            Minimum="0" 
            Maximum="1" 
            Value="{Binding Control.Value}" 
            Style="{StaticResource SliderRounded}" Position="Default"/>
        
    </StackPanel>
</UserControl>
