<UserControl x:Class="CMiX.Studio.Views.Echo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="295.333" d:DesignWidth="282.667">
    
    <BaseControl:CMiXSlider 
        Caption="Factor" 
        Margin="8"
        Minimum="0" 
        Maximum="1" 
        Value="{Binding Factor.Amount}" 
        Style="{StaticResource SliderRounded}" 
        Position="Default"/>
    
</UserControl>
