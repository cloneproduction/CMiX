<UserControl x:Class="CMiX.Studio.Views.TransformUV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="160.58" d:DesignWidth="211.028">

    <StackPanel>
        
        <BaseControls:DragValue           
            Caption="Uniform Scale"
            Value="{Binding Uniform.Amount}" 
            Position="Default"/>

        <BaseControls:VectorXY
            Margin="0, 8, 0, 0"
            Caption="Scale"
            X="{Binding Scale.XYZ.X.Amount}"
            Y="{Binding Scale.XYZ.Y.Amount}"/>

        <BaseControls:DragValue  
            Margin="0, 8"
            Caption="Rotate"
            Value="{Binding Rotation.XYZ.Z.Amount}" 
            Position="Default"/>

        <BaseControls:VectorXY
            Caption="Translate"
            X="{Binding Translate.XYZ.X.Amount}"
            Y="{Binding Translate.XYZ.Y.Amount}"/>

    </StackPanel>
    
</UserControl>
