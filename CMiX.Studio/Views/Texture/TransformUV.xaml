<UserControl x:Class="CMiX.Studio.Views.TransformUV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
             mc:Ignorable="d" 
             d:DesignHeight="160.58" d:DesignWidth="211.028">

    <StackPanel>
        
        <BaseControls:DragValue           
            Caption="Uniform Scale"
            Value="{Binding Uniform.Amount}" 
            Position="Default"/>

        <BaseControls:DragValue  
            Margin="0, 8, 0, 1"
            Caption="Scale X"
            Value="{Binding Scale.XYZ.X.Amount}" 
            Position="Top"/>

        <BaseControls:DragValue  
            Caption="Y"
            Value="{Binding Scale.XYZ.Y.Amount}" 
            Position="Bottom"/>

        <BaseControls:DragValue  
            Margin="0, 8"
            Caption="Rotate"
            Value="{Binding Rotation.XYZ.Z.Amount}" 
            Position="Default"/>

        <BaseControls:DragValue  
            Margin="0, 0, 0, 1"
            Caption="Translate X"
            Value="{Binding Translate.XYZ.X.Amount}" 
            Position="Top"/>

        <BaseControls:DragValue  
            Caption="Y"
            Value="{Binding Translate.XYZ.Y.Amount}" 
            Position="Bottom"/>

    </StackPanel>
</UserControl>
