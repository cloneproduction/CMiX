<UserControl x:Class="CMiX.Studio.Views.TextureFilter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Behaviors="clr-namespace:CMiX.Core.Presentation.Behaviors;assembly=CMiX.Core"
             xmlns:Converters="clr-namespace:CMiX.Core.Presentation.ValueConverters;assembly=CMiX.Core"
             xmlns:ViewModels="clr-namespace:CMiX.Core.Presentation.ViewModels;assembly=CMiX.Core"
             xmlns:Tools="clr-namespace:CMiX.Core.Presentation;assembly=CMiX.Core"
             xmlns:Filters="clr-namespace:CMiX.Studio.Views"
             xmlns:dd="urn:gong-wpf-dragdrop"
             x:Name="textureFilterManager"
             mc:Ignorable="d" 
             d:DesignHeight="259.434" d:DesignWidth="313.836">

    <UserControl.Resources>
        <ResourceDictionary>
            <Tools:BindingProxy x:Key="ProjectProxy" Data="{Binding}" />
            <Converters:BoolInverterConverter x:Key="BoolInverter" />
            <Converters:EnumToStringConverter x:Key="EnumToString" />

            <DataTemplate x:Key="HSCBTemplate" DataType="{x:Type ViewModels:HSCB}">
                <Filters:HSCB Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="InvertTemplate" DataType="{x:Type ViewModels:HSCB}">
                <Filters:Invert Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="BlurTemplate" DataType="{x:Type ViewModels:HSCB}">
                <Filters:Blur Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="EdgeTemplate" DataType="{x:Type ViewModels:Edge}">
                <Filters:Edge Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="TransformTextureTemplate" DataType="{x:Type ViewModels:TransformTexture}">
                <Filters:TransformTexture Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="PixelateTemplate" DataType="{x:Type ViewModels:Pixelate}">
                <Filters:Pixelate Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="EchoTemplate" DataType="{x:Type ViewModels:Echo}">
                <Filters:Echo Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="FeedbackTemplate" DataType="{x:Type ViewModels:Feedback}">
                <Filters:Feedback Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="TriColorTemplate" DataType="{x:Type ViewModels:TriColor}">
                <Filters:TriColor Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="RandomUVTemplate" DataType="{x:Type ViewModels:RandomUV}">
                <Filters:RandomUV Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>

            <DataTemplate x:Key="LFOUVTemplate" DataType="{x:Type ViewModels:LFOUV}">
                <Filters:LFOUV Margin="0, 8, 0, 0" DataContext="{Binding}"/>
            </DataTemplate>
            
            <ViewModels:TextureFilterTemplateSelector 
                x:Key="TemplateSelector" 
                BlurTemplate="{StaticResource BlurTemplate}"
                InvertTemplate="{StaticResource InvertTemplate}"
                HSCBTemplate="{StaticResource HSCBTemplate}"
                EdgeTemplate="{StaticResource EdgeTemplate}"
                TransformTextureTemplate="{StaticResource TransformTextureTemplate}"
                PixelateTemplate="{StaticResource PixelateTemplate}"
                EchoTemplate="{StaticResource EchoTemplate}"
                FeedbackTemplate="{StaticResource FeedbackTemplate}"
                TriColorTemplate="{StaticResource TriColorTemplate}"
                RandomUVTemplate="{StaticResource RandomUVTemplate}"
                LFOUVTemplate="{StaticResource LFOUVTemplate}"/>

        </ResourceDictionary>

    </UserControl.Resources>

    <StackPanel Margin="8, 16">

        <ToggleButton 
            x:Name="PopUpToggle" 
            Content="Add Filter"
            Height="22" 
            Margin="0, 0, 0, 8"
            Background="{DynamicResource DarkerColor}" 
            Style="{StaticResource ToggleTransformModifierMenu}"/>

        <Popup
            AllowsTransparency="True"
            Behaviors:ClosePopupBehavior.PopupContainer="{Binding ElementName=textureFilterManager}"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=PopUpToggle}"
            FlowDirection="LeftToRight"
            IsOpen="{Binding IsChecked, ElementName=PopUpToggle}">

            <Border 
                BorderThickness="1, 0, 1, 2"
                BorderBrush="{DynamicResource Shadow}"
                CornerRadius="{DynamicResource CornerRadiusBottom}" 
                Padding="2, 0, 2, 2"
                Background="{DynamicResource HighHighDarkerColor}">

                <Grid Margin="4, 8">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:HSCB}" 
                            Grid.Column="0"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="HSCB"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Invert}" 
                            Grid.Column="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Invert"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:TriColor}" 
                            Grid.Column="1"
                            Grid.Row="2"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="TriColor"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Edge}" 
                            Grid.Column="0"
                            Grid.Row="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Edge"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:TransformTexture}" 
                            Grid.Column="1"
                            Grid.Row="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Transform"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:RandomUV}" 
                            Grid.Column="1"
                            Grid.Row="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Random UV"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:LFOUV}" 
                            Grid.Column="1"
                            Grid.Row="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="LFO UV"/>
                        
                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Pixelate}" 
                            Grid.Column="2"
                            Grid.Row="1"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Pixelate"/>

                    </StackPanel>

                    <StackPanel Grid.Column="2">

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Blur}" 
                            Grid.Column="2"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Blur"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Echo}" 
                            Grid.Column="2"
                            Grid.Row="2"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Echo"/>

                        <Button 
                            Style="{StaticResource ButtonItemControl}"
                            Command="{Binding CreateCommand}" 
                            CommandParameter="{x:Type ViewModels:Feedback}" 
                            Grid.Column="2"
                            Grid.Row="3"
                            VerticalAlignment="Center" 
                            Width="120" 
                            Height="22" 
                            Content="Feedback"/>
                        
                    </StackPanel>
                </Grid>
            </Border>
        </Popup>

        <ItemsControl 
            AllowDrop="True"
            dd:DragDrop.IsDragSource="True"
            dd:DragDrop.IsDropTarget="True"
            dd:DragDrop.DragHandler="{Binding}"
            dd:DragDrop.DropHandler="{Binding}"
            ItemTemplateSelector="{StaticResource TemplateSelector }" 
            ItemsSource="{Binding Modifiers}">
        </ItemsControl>

    </StackPanel>
</UserControl>
