<UserControl x:Class="CMiX.Studio.Views.TypeWriter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             mc:Ignorable="d"
             d:DesignHeight="450.779" d:DesignWidth="280.26"
             md:DialogServiceViews.IsRegistered="True">

    <StackPanel>

        <TextBox Height="44" 
                 Text="{Binding StringControl.Text, UpdateSourceTrigger=PropertyChanged}" 
                 Style="{StaticResource TypeWriterStyle}">
            <i:Interaction.Triggers>
                <i:EventTrigger  EventName="LostFocus">
                    <i:InvokeCommandAction Command="{Binding TextInputLostFocusCommand}" 
                                   CommandParameter="{Binding ., ElementName=textBox1}" />
                </i:EventTrigger>
                <i:EventTrigger  EventName="GotFocus">
                    <i:InvokeCommandAction Command="{Binding TextInputGotFocusCommand}" 
                                   CommandParameter="{Binding ., ElementName=textBox1}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </TextBox>
        <Grid Height="22" Margin="0, 16, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Padding="4" Text="Font Family" HorizontalAlignment="Right"/>
            <ComboBox Grid.Column="1" SelectedItem="{Binding FontFamily.Selection, Converter={StaticResource FontFamilyToString}}" ItemsSource="{Binding Source={StaticResource SortedFontsCollection}}" />
        </Grid>

        <Grid Height="22" Margin="0, 4, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Padding="4" Text="Style" HorizontalAlignment="Right"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Source={StaticResource FontStyle}}" SelectedItem="{Binding Style.Selection}"/>
        </Grid>

        <Grid Height="22" Margin="0, 16, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" BorderThickness="1, 0, 1, 0">
                <Controls:DistanceSlider 
                    Grid.Column="1" 
                    Position="Default" 
                    Style="{StaticResource DistanceSliderStyle}" 
                    Value="{Binding FontSize.Amount}"/>
            </Border>
            <TextBlock 
                Grid.Column="0" 
                Padding="8, 0" 
                HorizontalAlignment="Right" 
                Text="Size" 
                Foreground="{StaticResource TextBase}"/>
        </Grid>

        <Grid Margin="0, 16, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock 
                        Text="Font Color" 
                        HorizontalAlignment="Right" Padding="4, 0"
                        VerticalAlignment="Center"/>
            <Border Grid.Column="1">
                <Button Height="22"
                        Margin="0"
                        Command="{Binding OpenFontColorCommand}"
                        Style="{StaticResource ButtonColorStyle}">
                    <Button.Background>
                        <SolidColorBrush Color="{Binding FontColor.SelectedColor}"/>
                    </Button.Background>
                </Button>
            </Border>
        </Grid>

        <Grid Margin="0, 4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock 
                Text="Background Color" 
                HorizontalAlignment="Right" Padding="4, 0"
                VerticalAlignment="Center"/>

            <Border Grid.Column="1">
                <Button Height="22"
                        Margin="0"
                        Command="{Binding OpenFontBackgroundCommand}"
                        Style="{StaticResource ButtonColorStyle}">
                    <Button.Background>
                        <SolidColorBrush Color="{Binding BackgroundColor.SelectedColor}"/>
                    </Button.Background>
                </Button>
            </Border>

        </Grid>

        <Grid Height="22" Margin="0, 8, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" BorderThickness="1, 0, 1, 0">
                <Controls:DistanceSlider 
                    Grid.Column="1" 
                    Position="Top" 
                    Style="{StaticResource DistanceSliderStyle}" 
                    Value="{Binding Path=PositionX.Amount}"/>
            </Border>
            <TextBlock 
                Grid.Column="0" 
                Padding="8, 0" 
                HorizontalAlignment="Right" 
                Text="Position X" 
                Foreground="{StaticResource TextBase}"/>
        </Grid>

        <Grid Height="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="1" BorderBrush="{DynamicResource Shadow}" BorderThickness="1, 0, 1, 0">
                <Controls:DistanceSlider 
                    Grid.Column="1" 
                    Position="Bottom" 
                    Style="{StaticResource DistanceSliderStyle}" 
                    Value="{Binding Path=PositionY.Amount}"/>
            </Border>
            <TextBlock 
                Grid.Column="0" 
                Padding="8, 0" 
                HorizontalAlignment="Right" 
                Text="Y" 
                Foreground="{StaticResource TextBase}"/>
        </Grid>

        <Grid Height="22" Margin="0, 16, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Padding="4" Text="Resolution X" HorizontalAlignment="Right"/>
            <Border Grid.Column="1" BorderThickness="1, 0, 1, 1">
                <Controls:Counter Position="Top" Style="{StaticResource CMiXCounterStyle}"  Value="{Binding ResolutionX.Count, Mode=TwoWay}"/>
            </Border>

        </Grid>

        <Grid Height="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Padding="4" Text="Y" HorizontalAlignment="Right"/>
            <Border Grid.Column="1" BorderThickness="1, 0, 1, 2" BorderBrush="{DynamicResource SuperHighDarkerColor}">
                <Controls:Counter Position="Bottom" Style="{StaticResource CMiXCounterStyle}" Value="{Binding ResolutionY.Count, Mode=TwoWay}"/>
            </Border>
        </Grid>


    </StackPanel>

</UserControl>
