<UserControl x:Class="CMiX.Studio.Views.Edge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Expander
        Header="Edge" 
        Template="{StaticResource ModifierPanelTemplate}"
        IsExpanded="{Binding IsExpanded}">
        <StackPanel Margin="8">
            <Controls:CMiXSlider Caption="Radius" Minimum="0" Maximum="10" Value="{Binding Radius.Amount}" Style="{StaticResource CMiXSliderStyle}" Position="Top"/>
            <Controls:CMiXSlider Margin="0, 1, 0, 0" Caption="Brightness" Minimum="0" Maximum="10" Value="{Binding Brightness.Amount}" Style="{StaticResource CMiXSliderStyle}" Position="Bottom"/>
        </StackPanel>
    </Expander>
</UserControl>
