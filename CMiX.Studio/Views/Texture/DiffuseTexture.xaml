<UserControl
    x:Class="CMiX.Studio.Views.DiffuseTexture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:TextureSource="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Texturing="clr-namespace:CMiX.Core.Texturing;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:Manager="clr-namespace:CMiX.Studio.Views.Managers"
    d:DesignHeight="197.334"
    d:DesignWidth="314"
    mc:Ignorable="d">

    <StackPanel>
        <Manager:PrefabManagerComboBox
            DataContext="{Binding TextureManager}"
            ItemsSource="{Binding Prefabs}"
            AddItemCommand="{Binding AddItemCommand}"
            AddItemCommandParameter="{x:Type Texturing:Texture}"
            SelectedItem="{Binding SelectedItem}"
            SelectionChangedCommand="{Binding SelectedItemChangedCommand}"
            SelectionChangedCommandParameter="{Binding SelectedItem}"/>

        <BaseControls:ComboBox
            Margin="8, 0, 8, 0"
            Caption="Type"
            SelectedItem="{Binding Path=TextureManager.SelectedItem.TextureSourceSelector.ProceduralName.Value, Converter={StaticResource EnumToString}}"
            ItemsSource="{Binding Source={StaticResource TextureSourceName}}"/>

        <Grid Margin="8">

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TextureManager.SelectedItem.TextureSourceSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Image}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Views:PathSelector 
                    ItemsSource="{Binding Path=DataContext.AssetManager.ImageAssets, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                    SelectedItem="{Binding Path=TextureManager.SelectedItem.TextureSourceSelector.Image.Asset.Value}"/>

            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TextureManager.SelectedItem.TextureSourceSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Video}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <Views:PathSelector 
                            SelectedItem="{Binding Path=TextureManager.SelectedItem.VideoPlayer.Asset.Value}"
                            ItemsSource="{Binding Path=DataContext.AssetManager.VideoAssets, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                            Grid.Column="1"
                            Height="22"/>

                    <Views:VideoPlayer Margin="0, 8, 0, 0" DataContext="{Binding Path=TextureManager.SelectedItem.VideoPlayer}"/>

                </StackPanel>
            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TextureManager.SelectedItem.TextureSourceSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Text}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Views:TypeWriter DataContext="{Binding Path=TextureManager.SelectedItem.TypeWriter}"/>

            </Border>


            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TextureManager.SelectedItem.TextureSourceSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Input}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Views:VideoIn DataContext="{Binding Path=TextureManager.SelectedItem.VideoIn}"/>

            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TextureManager.SelectedItem.TextureSourceSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Gradient}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Views:Gradient DataContext="{Binding Path=TextureManager.SelectedItem.TextureSourceSelector.Gradient}"/>

            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TextureManager.SelectedItem.TextureSourceSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.BubbleNoise}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Views:BubbleNoise DataContext="{Binding Path=TextureManager.SelectedItem.TextureSourceSelector.BubbleNoise}"/>

            </Border>
        </Grid>

        <Panels:IndentedExpander Indentation="24" Header="Filter" IsExpanded="{Binding Path=TextureManager.IsExpanded, Mode=OneWay}">
            <Views:TextureFilter DataContext="{Binding Path=TextureManager.SelectedItem.ModifierManager}"/>
        </Panels:IndentedExpander>

    </StackPanel>

</UserControl>