<UserControl x:Class="CMiX.Studio.Views.ColorSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True"
             d:DesignHeight="450" d:DesignWidth="800">
    <Border>
        <Button Height="21"
                    Margin="4"
                    Background="{Binding SelectedColor, Converter={StaticResource ColorToBrush}, ConverterParameter=all}"
                    Command="{Binding OpenColorSelectorCommand}"
                    Style="{StaticResource ButtonColorStyle}"/>
    </Border>
</UserControl>
