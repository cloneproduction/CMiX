<UserControl
    x:Class="CMiX.Studio.Views.Coloration.Coloration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Colorization="clr-namespace:CMiX.Studio.Views.Component.Colorization"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="402.666"
    d:DesignWidth="357.666"
    mc:Ignorable="d">

    <StackPanel>
        <Views:PrefabSlotManager
            Margin="8,8,8,0"
            DataContext="{Binding ColorPaletteManager}"
            ItemsSource="{Binding ControlRepository.ColorPalettes}">
            <Views:PrefabSlotManager.SelectionPanel>
                <Button
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{x:Type Compositing:ColorPalette}"
                    Content="New Color Palette" />
            </Views:PrefabSlotManager.SelectionPanel>
        </Views:PrefabSlotManager>

        <Colorization:ColorPalette DataContext="{Binding}" />

        <Views:ModifierManager DataContext="{Binding ModifierManager}">
            <Views:ModifierManager.SelectionPanel>
                <Views:EntityModifierSelectionPanel DataContext="{Binding}" />
            </Views:ModifierManager.SelectionPanel>
        </Views:ModifierManager>

    </StackPanel>

</UserControl>
