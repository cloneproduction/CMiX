<UserControl
    x:Class="CMiX.Studio.Views.LightSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Light="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="28.139"
    d:DesignWidth="100.648"
    mc:Ignorable="d">

    <Button
        Grid.Column="0"
        Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
        Height="22"
        VerticalAlignment="Center"
        Command="{Binding AddItemCommand}"
        CommandParameter="{x:Type Light:LightEntityModel}"
        Content="Light"
        Style="{StaticResource ButtonItemControl}" />

</UserControl>
