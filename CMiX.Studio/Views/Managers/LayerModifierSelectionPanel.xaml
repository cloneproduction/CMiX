<UserControl
    x:Class="CMiX.Studio.Views.LayerModifierSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Layering="clr-namespace:CMiX.Core.Layering.Modifiers;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <StackPanel>

        <StackPanel.Resources>
            <Style BasedOn="{StaticResource ButtonItemControl}" TargetType="Button" />
        </StackPanel.Resources>

        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Layering:SelectRandomEntity}"
            Content="Select Random Entity" />

        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Layering:SelectRandomCamera}"
            Content="Select Random Camera" />

    </StackPanel>

</UserControl>
