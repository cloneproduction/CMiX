<UserControl
    x:Class="CMiX.Studio.Views.LayerModifierSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Layering="clr-namespace:CMiX.Core.Layering.Modifiers;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="4,8">

        <StackPanel Grid.Column="0">

            <Button
                Grid.Row="2"
                Grid.Column="1"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Layering:SelectRandomEntityModel}"
                Content="Select Random Entity"
                Style="{StaticResource ButtonItemControl}" />

        </StackPanel>

    </Grid>
</UserControl>
