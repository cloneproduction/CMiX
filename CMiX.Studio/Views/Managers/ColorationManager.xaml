<UserControl x:Class="CMiX.Studio.Views.Managers.ColorationManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:Behaviors="clr-namespace:CMiX.Core.Presentation.Behaviors;assembly=CMiX.Core"
             mc:Ignorable="d"
             md:DialogServiceViews.IsRegistered="True" 
             d:DesignHeight="645.333" d:DesignWidth="349.293">

    <!--<i:Interaction.Behaviors>
        <Behaviors:ScrollViewerBehavior/>
    </i:Interaction.Behaviors>-->
    <StackPanel>
        <Grid 
            Height="100"                                         
            DockPanel.Dock="Top"
            Margin="8">
            <ListBox 
                DataContext="{Binding}"
                SelectedItem="{Binding SelectedItem}"
                ItemsSource="{Binding Prefabs}">

                <ListBox.ItemTemplate>
                    <ItemContainerTemplate>
                        <Border Height="20">
                            <TextBlock Padding="4" Text="{Binding Name}"/>
                        </Border>
                    </ItemContainerTemplate>
                </ListBox.ItemTemplate>

            </ListBox>
        </Grid>

        <Border Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">

        </Border>
    </StackPanel>
</UserControl>
