<UserControl
    x:Class="CMiX.Studio.Views.EntityModifierSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ColorModifiers="clr-namespace:CMiX.Core.Colors.Modifiers;assembly=CMiX.Core"
    xmlns:TransformModifiers="clr-namespace:CMiX.Core.Transformation.Modifiers;assembly=CMiX.Core"
    xmlns:Transformation="clr-namespace:CMiX.Core.Transformation;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="4,8">

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">

            <TextBlock
                Margin="8,8"
                Foreground="{DynamicResource LightColor}"
                Text="Coloration" />
            <Border
                Margin="0"
                BorderBrush="{DynamicResource DarkerColor}"
                BorderThickness="0,0,0,1" />
            <Button
                Grid.Row="2"
                Grid.Column="1"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type ColorModifiers:RandomHSVModel}"
                Content="Random HSV"
                Style="{StaticResource ButtonItemControl}" />

        </StackPanel>

        <StackPanel Grid.Column="1">

            <TextBlock
                Margin="8,8"
                Foreground="{DynamicResource LightColor}"
                Text="Transforms" />
            <Border
                Margin="0"
                BorderBrush="{DynamicResource DarkerColor}"
                BorderThickness="0,0,0,1" />


            <Button
                Grid.Row="2"
                Grid.Column="1"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:TransformSRTModel}"
                Content="Transform XYZ"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Grid.Row="1"
                Grid.Column="1"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:TranslateModel}"
                Content="Translate XYZ"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Grid.Row="1"
                Grid.Column="2"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:ScaleModel}"
                Content="Scale XYZ"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Grid.Row="2"
                Grid.Column="0"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:RotationModel}"
                Content="Rotate XYZ"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Grid.Column="1"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomXYZModel}"
                Content="RandomXYZ"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Grid.Row="1"
                Grid.Column="0"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomScaleModel}"
                Content="Random Scale"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Grid.Row="1"
                Grid.Column="0"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomPositionModel}"
                Content="Random Translate"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Grid.Row="1"
                Grid.Column="0"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomRotationModel}"
                Content="Random Rotation"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Grid.Row="1"
                Grid.Column="0"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:GaussianXYZModel}"
                Content="Gaussian XYZ"
                Style="{StaticResource ButtonItemControl}" />

        </StackPanel>

        <StackPanel Grid.Column="2">
            <TextBlock
                Margin="8,8"
                Foreground="{DynamicResource LightColor}"
                Text="" />
            <Border
                Margin="0"
                BorderBrush="{DynamicResource DarkerColor}"
                BorderThickness="0,0,0,1" />

            <Button
                Grid.Column="2"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:GridModel}"
                Content="Grid"
                Style="{StaticResource ButtonItemControl}" />
            
            <Button
                Grid.Column="0"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:LinearXYZModel}"
                Content="LinearXYZ"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Grid.Column="2"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:LFOModel}"
                Content="LFO"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Grid.Column="2"
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:StepperModel}"
                Content="Stepper"
                Style="{StaticResource ButtonItemControl}" />

        </StackPanel>
    </Grid>
</UserControl>
