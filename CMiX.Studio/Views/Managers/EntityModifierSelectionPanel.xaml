<UserControl
    x:Class="CMiX.Studio.Views.EntityModifierSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ColorModifiers="clr-namespace:CMiX.Core.Colors.Modifiers;assembly=CMiX.Core"
    xmlns:TransformModifiers="clr-namespace:CMiX.Core.Transformation.Modifiers;assembly=CMiX.Core"
    xmlns:Transformation="clr-namespace:CMiX.Core.Transformation;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="362.671"
    d:DesignWidth="281.37"
    mc:Ignorable="d">

    <Border>
        <StackPanel>
            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:Billboard}"
                Content="Billboard"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:CircularSpread}"
                Content="Circular Spread"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:Grid}"
                Content="Grid"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type ColorModifiers:RandomHSV}"
                Content="Random HSV"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:LinearXYZ}"
                Content="Linear XYZ"
                Style="{StaticResource ButtonItemControl}" />


            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:LFO}"
                Content="LFO"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomXYZ}"
                Content="Random XYZ"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomPosition}"
                Content="Random Position"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomScale}"
                Content="Random Scale"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomRotation}"
                Content="Random Rotation"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:TransformSRT}"
                Content="Transform SRT"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:Translate}"
                Content="Translate"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:Scale}"
                Content="Scale"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:Rotation}"
                Content="Rotation"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomTexCoord}"
                Content="Random TexCoord"
                Style="{StaticResource ButtonItemControl}" />

        </StackPanel>

    </Border>
</UserControl>
