<UserControl
    x:Class="CMiX.Studio.Views.EntityModifierSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ColorModifiers="clr-namespace:CMiX.Core.Colors.Modifiers;assembly=CMiX.Core"
    xmlns:TransformModifiers="clr-namespace:CMiX.Core.Transformation.Modifiers;assembly=CMiX.Core"
    xmlns:Transformation="clr-namespace:CMiX.Core.Transformation;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="362.671"
    d:DesignWidth="281.37"
    mc:Ignorable="d">

    <Border Margin="4,8">
        <StackPanel Grid.Column="2">

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:CircularSpreadModel}"
                Content="Circular Spread"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:GridModel}"
                Content="Grid"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type ColorModifiers:RandomHSVModel}"
                Content="Random HSV"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:LinearXYZModel}"
                Content="Linear XYZ"
                Style="{StaticResource ButtonItemControl}" />


            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:LFOModel}"
                Content="LFO"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomXYZModel}"
                Content="Random XYZ"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomPositionModel}"
                Content="Random Position"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomScaleModel}"
                Content="Random Scale"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomRotationModel}"
                Content="Random Rotation"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:TransformSRTModel}"
                Content="Transform SRT"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:TranslateModel}"
                Content="Translate"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:ScaleModel}"
                Content="Scale"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Transformation:RotationModel}"
                Content="Rotation"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type TransformModifiers:RandomUVModel}"
                Content="Random UV"
                Style="{StaticResource ButtonItemControl}" />

        </StackPanel>

    </Border>
</UserControl>
