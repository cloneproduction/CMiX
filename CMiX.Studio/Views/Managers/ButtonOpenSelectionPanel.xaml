<UserControl
    x:Class="CMiX.Studio.Views.ButtonOpenSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="buttonOpenSelectionPanel"
    d:DesignHeight="40"
    d:DesignWidth="144"
    mc:Ignorable="d">

    <Grid>

        <ToggleButton x:Name="PopUpToggle" Content="{Binding Caption, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" />

        <Popup
            Width="{Binding ActualWidth, ElementName=PopUpToggle}"
            Behaviors:ClosePopupBehavior.PopupContainer="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            AllowsTransparency="True"
            FlowDirection="LeftToRight"
            IsOpen="{Binding IsChecked, ElementName=PopUpToggle}"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=PopUpToggle}">

            <Border
                Padding="2,4,2,2"
                Background="{DynamicResource HighHighDarkerColor}"
                BorderBrush="{DynamicResource Shadow}"
                BorderThickness="1,0,1,2"
                CornerRadius="{DynamicResource CornerRadiusBottom}">

                <ContentControl Content="{Binding SelectionPanel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" DataContext="{Binding}" />

            </Border>

        </Popup>
    </Grid>

</UserControl>
