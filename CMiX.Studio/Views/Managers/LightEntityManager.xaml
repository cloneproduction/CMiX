             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             mc:Ignorable="d" 
             d:DesignHeight="878" d:DesignWidth="356">

    <DockPanel>
        <Views:PrefabSlotManager Margin="8" DockPanel.Dock="Top" DataContext="{Binding}"/>
