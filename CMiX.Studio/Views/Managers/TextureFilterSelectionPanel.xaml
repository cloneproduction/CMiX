<UserControl
    x:Class="CMiX.Studio.Views.TextureFilterSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Filters="clr-namespace:CMiX.Core.Texturing.Filters;assembly=CMiX.Core"
    xmlns:Modifiers="clr-namespace:CMiX.Core.Transformation.Modifiers;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="4">

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:HSCB}"
                Content="HSCB"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Invert}"
                Content="Invert"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:TriColor}"
                Content="TriColor"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Displace}"
                Content="Displace"
                Style="{StaticResource ButtonItemControl}" />

        </StackPanel>

        <StackPanel Grid.Column="1">
            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Edge}"
                Content="Edge"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:TransformTexture}"
                Content="Transform"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:RandomUV}"
                Content="Random UV"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:LFOUV}"
                Content="LFO UV"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Pixelate}"
                Content="Pixelate"
                Style="{StaticResource ButtonItemControl}" />

        </StackPanel>

        <StackPanel Grid.Column="2">

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Blur}"
                Content="Blur"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Echo}"
                Content="Echo"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Feedback}"
                Content="Feedback"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:SetAlpha}"
                Content="SetAlpha"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Shadow}"
                Content="Shadow"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Ascii}"
                Content="Ascii"
                Style="{StaticResource ButtonItemControl}" />

            <Button
                Width="120"
                Height="22"
                VerticalAlignment="Center"
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Dither}"
                Content="Dither"
                Style="{StaticResource ButtonItemControl}" />
        </StackPanel>
    </Grid>
</UserControl>
