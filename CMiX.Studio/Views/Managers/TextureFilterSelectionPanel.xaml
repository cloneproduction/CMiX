<UserControl
    x:Class="CMiX.Studio.Views.TextureFilterSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Filters="clr-namespace:CMiX.Core.Texturing.Filters;assembly=CMiX.Core"
    xmlns:Modifiers="clr-namespace:CMiX.Core.Transformation.Modifiers;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <Grid Margin="4">
        <Grid.Resources>
            <Style BasedOn="{StaticResource ButtonItemControl}" TargetType="Button" />
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:HSCB}"
                Content="HSCB" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Invert}"
                Content="Invert" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:TriColor}"
                Content="TriColor" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Displace}"
                Content="Displace" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:ShiftRGB}"
                Content="ShiftRGB" />

        </StackPanel>

        <StackPanel Grid.Column="1">
            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Edge}"
                Content="Edge" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:TransformTexture}"
                Content="Transform" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:RandomUV}"
                Content="Random UV" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:LFOUV}"
                Content="LFO UV" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Pixelate}"
                Content="Pixelate" />

        </StackPanel>

        <StackPanel Grid.Column="2">

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Blur}"
                Content="Blur" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Echo}"
                Content="Echo" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Feedback}"
                Content="Feedback" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:SetAlpha}"
                Content="SetAlpha" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Shadow}"
                Content="Shadow" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Ascii}"
                Content="Ascii" />

            <Button
                Command="{Binding AddItemCommand}"
                CommandParameter="{x:Type Filters:Dither}"
                Content="Dither" />

        </StackPanel>
    </Grid>
</UserControl>
