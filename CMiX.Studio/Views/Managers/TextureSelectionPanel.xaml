<UserControl
    x:Class="CMiX.Studio.Views.TextureSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Sources="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Texturing="clr-namespace:CMiX.Core.Texturing;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="193.025"
    d:DesignWidth="348.952"
    mc:Ignorable="d">

    <StackPanel Grid.Column="0">

        <Button
            Grid.Column="0"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:Image}"
            Content="Image"
            Style="{StaticResource ButtonItemControl}" />

        <Button
            Grid.Column="0"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:BubbleNoise}"
            Content="BubbleNoise"
            Style="{StaticResource ButtonItemControl}" />

        <Button
            Grid.Column="0"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:CheckerBoard}"
            Content="CheckerBoard"
            Style="{StaticResource ButtonItemControl}" />

        <Button
            Grid.Column="0"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:VideoPlayer}"
            Content="Video"
            Style="{StaticResource ButtonItemControl}" />

        <Button
            Grid.Column="0"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:Gradient}"
            Content="Gradient"
            Style="{StaticResource ButtonItemControl}" />

        <Button
            Grid.Column="0"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:TypeWriter}"
            Content="Text"
            Style="{StaticResource ButtonItemControl}" />

        <Button
            Grid.Column="0"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:VideoIn}"
            Content="Video In"
            Style="{StaticResource ButtonItemControl}" />

        <Button
            Grid.Column="0"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:TouchBlob}"
            Content="Touch Blob"
            Style="{StaticResource ButtonItemControl}" />
    </StackPanel>

</UserControl>
