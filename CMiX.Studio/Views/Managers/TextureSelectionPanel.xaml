<UserControl
    x:Class="CMiX.Studio.Views.TextureSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Sources="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Texturing="clr-namespace:CMiX.Core.Texturing;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="193.025"
    d:DesignWidth="348.952"
    mc:Ignorable="d">

    <StackPanel>
        <StackPanel.Resources>
            <Style BasedOn="{StaticResource ButtonItemControl}" TargetType="Button" />
        </StackPanel.Resources>

        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:Image}"
            Content="Image" />

        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:BubbleNoise}"
            Content="BubbleNoise" />

        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:CheckerBoard}"
            Content="CheckerBoard" />

        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:VideoPlayer}"
            Content="Video" />

        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:Gradient}"
            Content="Gradient" />

        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:TypeWriter}"
            Content="Text" />

        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:VideoIn}"
            Content="Video In" />

        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Sources:TouchBlob}"
            Content="Touch Blob" />

    </StackPanel>

</UserControl>
