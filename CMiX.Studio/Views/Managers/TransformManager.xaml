<UserControl x:Class="CMiX.Studio.Views.Managers.TransformManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:basecontrol="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:Behaviors="clr-namespace:CMiX.Core.Presentation.Behaviors;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="668.082" d:DesignWidth="312.071">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <i:Interaction.Behaviors>
            <Behaviors:ScrollViewerBehavior/>
        </i:Interaction.Behaviors>
        <DockPanel>
            <Border 
            Height="100"                                         
            DockPanel.Dock="Top"
            Margin="8">
                <ListBox 
                Style="{StaticResource ListBoxWithButton}"
                DataContext="{Binding}"
                SelectedItem="{Binding SelectedItem}"
                ItemsSource="{Binding Prefabs}">

                    <ListBox.ItemTemplate>
                        <ItemContainerTemplate>
                            <Border Height="20">
                                <TextBlock Padding="4" Text="{Binding Name}"/>
                            </Border>
                        </ItemContainerTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <StackPanel Margin="8, 16">
                        <basecontrol:VectorXYZ DataContext="{Binding SelectedItem.Prefab.Translate}"/>
                        <Grid Height="20" Margin="0, 8, 0, 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Controls:DistanceSlider 
                                Grid.Column="2" 
                                Position="Top" 
                                Style="{StaticResource DistanceSliderStyle}" 
                                Value="{Binding SelectedItem.Prefab.Uniform.Amount}"/>
                            <TextBlock 
                                Grid.Column="0" 
                                Padding="4" 
                                HorizontalAlignment="Right" 
                                Text="Uniform XYZ" 
                                Foreground="{StaticResource TextBase}"/>
                        </Grid>
                        <basecontrol:VectorXYZ  Margin="0, 8" DataContext="{Binding SelectedItem.Prefab.Scale}"/>
                        <basecontrol:VectorXYZ  DataContext="{Binding SelectedItem.Prefab.Rotate}"/>
                    </StackPanel>

                    <Expander>
                        <Expander.Header>
                            <DockPanel>
                                <ToggleButton
                                    x:Name="ModifierEnabled"
                                    Height="16"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsChecked="{Binding SelectedItem.Prefab.TransformModifier.Visibility.IsChecked}"/>
                                <TextBlock Text="Modifiers" Margin="8, 0" Foreground="{DynamicResource TextBase}"/>
                            </DockPanel>
                        </Expander.Header>
                        <Views:TransformModifierManager DataContext="{Binding SelectedItem.Prefab.TransformModifier}"/>
                    </Expander>

                </StackPanel>

            </Border>
        </DockPanel>
    </ScrollViewer>

</UserControl>
