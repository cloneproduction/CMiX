<UserControl x:Class="CMiX.Studio.Views.Managers.TransformManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:Views="clr-namespace:CMiX.Studio.Views"
             xmlns:basecontrol="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:Behaviors="clr-namespace:CMiX.Core.Presentation.Behaviors;assembly=CMiX.Core"
             mc:Ignorable="d" 
             d:DesignHeight="668.082" d:DesignWidth="312.071">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <i:Interaction.Behaviors>
            <Behaviors:ScrollViewerBehavior/>
        </i:Interaction.Behaviors>
        
        <DockPanel>
            
            <ListBox 
                Height="100"                                         
                DockPanel.Dock="Top"
                Margin="8"
                Style="{StaticResource ListBoxWithButton}"
                DataContext="{Binding}"
                SelectedItem="{Binding SelectedItem}"
                ItemsSource="{Binding Prefabs}">
            </ListBox>

            <Border Visibility="{Binding SelectedItem, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    
                    <Expander Header="Transform SRT">
                        <StackPanel Margin="8">
                            
                            <basecontrol:DragValue 
                                Caption="Uniform" 
                                Value="{Binding SelectedItem.Prefab.Uniform.Amount}"/>
                            
                            <basecontrol:VectorXYZ 
                                Caption="Scale"  
                                Margin="0, 8" 
                                DataContext="{Binding SelectedItem.Prefab.Scale}"
                                X="{Binding X.Amount}"
                                Y="{Binding Y.Amount}"
                                Z="{Binding Z.Amount}"/>
                            
                            <basecontrol:VectorXYZ 
                                Caption="Rotation"  
                                DataContext="{Binding SelectedItem.Prefab.Rotate}"
                                X="{Binding X.Amount}"
                                Y="{Binding Y.Amount}"
                                Z="{Binding Z.Amount}"/>
                            
                            <basecontrol:VectorXYZ 
                                Caption="Translate" 
                                Margin="0, 8, 0, 0" 
                                DataContext="{Binding SelectedItem.Prefab.Translate}"
                                X="{Binding X.Amount}"
                                Y="{Binding Y.Amount}"
                                Z="{Binding Z.Amount}"/>
                            
                        </StackPanel>
                    </Expander>

                    <Expander>
                        <Expander.Header>
                            <DockPanel>
                                <ToggleButton
                                    x:Name="ModifierEnabled"
                                    IsChecked="{Binding SelectedItem.Prefab.TransformModifier.Visibility.IsChecked}"/>
                                <TextBlock Text="Modifiers" Margin="8, 0" Foreground="{DynamicResource TextBase}"/>
                            </DockPanel>
                        </Expander.Header>
                        <Views:TransformModifierManager DataContext="{Binding SelectedItem.Prefab.TransformModifier}"/>
                    </Expander>

                </StackPanel>

            </Border>
        </DockPanel>
    </ScrollViewer>

</UserControl>
