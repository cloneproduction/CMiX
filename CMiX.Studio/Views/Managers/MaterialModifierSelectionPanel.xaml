<UserControl
    x:Class="CMiX.Studio.Views.MaterialModifierSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:MaterialModifiers="clr-namespace:CMiX.Core.Materials.Modifiers;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CMiX.Studio.Views.Managers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <StackPanel>
        <StackPanel.Resources>
            <Style BasedOn="{StaticResource ButtonItemControl}" TargetType="Button" />
        </StackPanel.Resources>
        <Button
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type MaterialModifiers:SelectRandomTexture}"
            Content="Select Random Texture" />
    </StackPanel>
</UserControl>
