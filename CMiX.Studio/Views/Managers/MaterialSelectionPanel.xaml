<UserControl
    x:Class="CMiX.Studio.Views.MaterialSelectionPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="27.143"
    d:DesignWidth="193.333"
    mc:Ignorable="d">

    <StackPanel Grid.Column="0">

        <Button
            Grid.Column="0"
            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
            Height="22"
            VerticalAlignment="Center"
            Command="{Binding AddItemCommand}"
            CommandParameter="{x:Type Materials:Material}"
            Content="Material"
            Style="{StaticResource ButtonItemControl}" />

    </StackPanel>

</UserControl>
