<UserControl
    x:Class="CMiX.Studio.Views.PrefabManagerComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="prefabManagerComboBox"
    d:DesignHeight="58"
    d:DesignWidth="236"
    mc:Ignorable="d">

    <Grid
        Height="{DynamicResource ControlHeightMD}"
        Margin="8"
        DockPanel.Dock="Left">

        <Border
            x:Name="mask"
            Grid.Column="1"
            AttachedProperties:PositionedControl.Position="{Binding Path=Position, ElementName=prefabManagerComboBox}"
            Background="{DynamicResource Grey200Brush}"
            Style="{StaticResource BorderMask}" />

        <Border>
            <Border.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=mask}" />
            </Border.OpacityMask>

            <DockPanel>

                <Button
                    Grid.Column="2"
                    Margin="1,0,0,0"
                    Command="{Binding RemoveSelectedItemCommand}"
                    CommandParameter="{Binding SelectedItem}"
                    DockPanel.Dock="Right"
                    Style="{StaticResource ButtonStraight}">
                    <Button.Content>
                        <Image
                            Margin="42"
                            Opacity="0.5"
                            Source="{DynamicResource Add}" />
                    </Button.Content>
                </Button>

                <ComboBox
                    Grid.Column="0"
                    DockPanel.Dock="Left"
                    ItemsSource="{Binding ItemsSource, ElementName=prefabManagerComboBox}"
                    SelectedItem="{Binding SelectedItem, ElementName=prefabManagerComboBox}">
                    <ComboBox.ItemTemplate>
                        <ItemContainerTemplate>
                            <TextBlock Text="{Binding Name.Value}" />
                        </ItemContainerTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

            </DockPanel>
        </Border>

    </Grid>

</UserControl>
