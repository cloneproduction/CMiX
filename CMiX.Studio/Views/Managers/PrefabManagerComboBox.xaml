<UserControl x:Class="CMiX.Studio.Views.Managers.PrefabManagerComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
             x:Name="prefabManagerComboBox"
             mc:Ignorable="d" 
             d:DesignHeight="58" d:DesignWidth="236">

    
    <Grid 
        DockPanel.Dock="Left" 
        Margin="8" 
        Height="22">
            
        <Border
            x:Name="mask" 
            Grid.Column="1" 
            Background="{DynamicResource HighHighDarkerColor}" 
            Style="{StaticResource BorderMask}"
            AttachedProperties:PositionedControl.Position="{Binding Path=Position, ElementName=prefabManagerComboBox}"/>
            
        <Border>
            <Border.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=mask}"/>
            </Border.OpacityMask>

            <DockPanel>

                <Button
                    Margin="1, 0, 0, 0"
                    Grid.Column="2" 
                    DockPanel.Dock="Right" 
                    Command="{Binding AddItemCommand, ElementName=prefabManagerComboBox}"
                    Style="{StaticResource ButtonStraight}">
                    <Button.Content>
                        <Image Margin="42" Source="{DynamicResource Add}" Opacity="0.5"/>
                    </Button.Content>
                </Button>

                <ComboBox
                    Grid.Column="0"
                    DockPanel.Dock="Left" 
                    SelectedItem="{Binding SelectedItem, ElementName=prefabManagerComboBox}"
                    ItemsSource="{Binding ItemsSource, ElementName=prefabManagerComboBox}">
                    <ComboBox.ItemTemplate>
                        <ItemContainerTemplate>
                            <TextBlock Text="{Binding Name}"/>
                        </ItemContainerTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

            </DockPanel>
        </Border>
            
    </Grid>

</UserControl>
