<UserControl
    x:Class="CMiX.Studio.Views.PrefabSlotManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:Prefabs="clr-namespace:CMiX.Core.Prefabs;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="prefabSlotManager"
    d:DesignHeight="215.334"
    d:DesignWidth="255.001"
    mc:Ignorable="d">

    <Border Background="{DynamicResource HighDarkerColor}">
        <StackPanel>
            <DockPanel HorizontalAlignment="Stretch">

                <DockPanel
                    Margin="4,0,0,0"
                    DockPanel.Dock="Right"
                    LastChildFill="False">

                    <Button
                        Height="20"
                        Command="{Binding AddItemCommand}"
                        CommandParameter="{x:Type Prefabs:EmptyPrefabModel}"
                        Content="+"
                        DockPanel.Dock="Top"
                        Style="{StaticResource ButtonRoundedTop}" />

                    <Button
                        x:Name="deleteItemButton"
                        Height="20"
                        Margin="0,1,0,0"
                        Command="{Binding DeleteItemCommand}"
                        CommandParameter="{Binding ManagerData.SelectedItem}"
                        Content="-"
                        DockPanel.Dock="Top"
                        Style="{StaticResource ButtonRoundedBottom}" />

                    <Button
                        x:Name="moveItemDownButton"
                        Width="21"
                        Height="20"
                        Padding="8"
                        Command="{Binding ItemDownCommand}"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource ButtonRoundedBottom}">

                        <Button.Content>
                            <Image
                                Margin="20"
                                Opacity="0.7"
                                Source="{DynamicResource ArrowDown}" />
                        </Button.Content>
                    </Button>

                    <Button
                        x:Name="moveItemUpButton"
                        Height="20"
                        Margin="0,0,0,1"
                        Command="{Binding ItemUpCommand}"
                        DockPanel.Dock="Bottom"
                        Style="{StaticResource ButtonRoundedTop}">

                        <Button.Content>
                            <Image
                                Margin="20"
                                Opacity="0.7"
                                Source="{DynamicResource ArrowUp}" />
                        </Button.Content>
                    </Button>

                </DockPanel>

                <ListBox
                    x:Name="prefabListBox"
                    Grid.Row="3"
                    Height="100"
                    DataContext="{Binding}"
                    ItemsSource="{Binding ManagerData.Items}"
                    SelectedIndex="{Binding ManagerData.SelectedIndex}"
                    SelectedItem="{Binding ManagerData.SelectedItem}" />

            </DockPanel>


            <DockPanel Margin="0,8,0,0">
                <ToggleButton
                    x:Name="ToggleItemSelection"
                    Height="22"
                    Margin="0,4"
                    Background="{DynamicResource DarkerColor}"
                    IsEnabled="{Binding IsChecked, ElementName=ModifierEnabled}"
                    Style="{StaticResource ToggleTransformModifierMenu}" />

                <Popup
                    Behaviors:ClosePopupBehavior.PopupContainer="{Binding ElementName=prefabSlotManager}"
                    AllowsTransparency="True"
                    FlowDirection="LeftToRight"
                    IsOpen="{Binding IsChecked, ElementName=ToggleItemSelection}"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=ToggleItemSelection}">

                    <ItemsControl ItemsSource="{Binding Path=DataContext.PrefabRepositories.Entities, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Height="22"
                                    Command="{Binding DataContext.ReplaceSelectedItemCommand, ElementName=prefabSlotManager}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding PrefabService.Name.Value}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Popup>

                <Grid DockPanel.Dock="Right">

                    <Border Background="{DynamicResource HighHighDarkerColor}" CornerRadius="0, 2, 2, 0">
                        <TextBox
                            Padding="4,0"
                            Background="Transparent"
                            Text="{Binding DataContext.ManagerData.SelectedItem.PrefabService.Name.Value, ElementName=prefabSlotManager, UpdateSourceTrigger=PropertyChanged}" />
                    </Border>

                    <ToggleButton
                        x:Name="PopUpToggle"
                        Height="22"
                        Content="New">
                        <ToggleButton.Style>
                            <Style BasedOn="{StaticResource ToggleButtonRoundedRight}" TargetType="{x:Type ToggleButton}">
                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding ManagerData.SelectedItem}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>

                                    <DataTrigger Binding="{Binding ManagerData.SelectedItem, Converter={StaticResource DataToType}}" Value="{x:Type Prefabs:EmptyPrefab}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>

                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>

                    <Popup
                        Width="{Binding ActualWidth, ElementName=PopUpToggle}"
                        Behaviors:ClosePopupBehavior.PopupContainer="{Binding ElementName=prefabSlotManager}"
                        AllowsTransparency="True"
                        FlowDirection="LeftToRight"
                        IsOpen="{Binding IsChecked, ElementName=PopUpToggle}"
                        Placement="Bottom"
                        PlacementTarget="{Binding ElementName=PopUpToggle}">

                        <Border
                            Padding="2,4,2,2"
                            Background="{DynamicResource HighHighDarkerColor}"
                            BorderBrush="{DynamicResource Shadow}"
                            BorderThickness="1,0,1,2"
                            CornerRadius="{DynamicResource CornerRadiusBottom}">

                            <ContentControl Content="{Binding SelectionPanel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" DataContext="{Binding}" />

                        </Border>

                    </Popup>

                </Grid>
            </DockPanel>

        </StackPanel>
    </Border>

</UserControl>
