<UserControl
    x:Class="CMiX.Studio.Views.PrefabSlotManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:Prefabs="clr-namespace:CMiX.Core.Prefabs;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    x:Name="prefabSlotManager"
    d:DesignHeight="164.196"
    d:DesignWidth="252.008"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel>

        <DockPanel HorizontalAlignment="Stretch">

            <DockPanel
                Width="{DynamicResource ControlHeightSM}"
                Margin="4,0,0,0"
                DockPanel.Dock="Right"
                LastChildFill="False">

                <Button
                    Height="{DynamicResource ControlHeightSM}"
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{x:Type Prefabs:EmptyPrefab}"
                    Content="+"
                    DockPanel.Dock="Top"
                    Style="{StaticResource ButtonRoundedTop}" />

                <Button
                    x:Name="deleteItemButton"
                    Height="{DynamicResource ControlHeightSM}"
                    Margin="0,1,0,0"
                    Command="{Binding DeleteItemCommand}"
                    CommandParameter="{Binding SelectedItem}"
                    Content="-"
                    DockPanel.Dock="Top"
                    Style="{StaticResource ButtonRoundedBottom}" />

                <Border
                    Margin="0,16,0,0"
                    DockPanel.Dock="Top"
                    Visibility="{Binding Path=ManagerData.Items.Count, Converter={StaticResource CountToVisibility}}">
                    <DockPanel>
                        <Button
                            x:Name="moveItemDownButton"
                            Width="{DynamicResource ControlHeightSM}"
                            Height="{DynamicResource ControlHeightSM}"
                            Padding="8"
                            Command="{Binding ManagerReorderService.ItemDownCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding SelectedItem}"
                            DockPanel.Dock="Bottom"
                            Style="{StaticResource ButtonRoundedBottom}">

                            <Button.Content>
                                <Image
                                    Margin="20"
                                    Opacity="0.7"
                                    Source="{DynamicResource ArrowDown}" />
                            </Button.Content>
                        </Button>

                        <Button
                            x:Name="moveItemUpButton"
                            Height="{DynamicResource ControlHeightSM}"
                            Margin="0,0,0,1"
                            Command="{Binding ManagerReorderService.ItemUpCommand, FallbackValue={x:Null}}"
                            CommandParameter="{Binding SelectedItem}"
                            DockPanel.Dock="Bottom"
                            Style="{StaticResource ButtonRoundedTop}">

                            <Button.Content>
                                <Image
                                    Margin="20"
                                    Opacity="0.7"
                                    Source="{DynamicResource ArrowUp}" />
                            </Button.Content>
                        </Button>
                    </DockPanel>
                </Border>

            </DockPanel>

            <BaseControls:CMiXListBox
                x:Name="prefabListBox"
                MinHeight="105"
                DataContext="{Binding}"
                DockPanel.Dock="top"
                IsEnabled="True"
                ItemsSource="{Binding ManagerData.Items}"
                SelectedIndex="{Binding ManagerData.SelectedIndex, Mode=TwoWay}"
                SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
                <ListBox.Resources>
                    <ResourceDictionary Source="ListBoxItemDataTemplate.xaml" />
                </ListBox.Resources>
            </BaseControls:CMiXListBox>
        </DockPanel>

        <DockPanel Margin="0,4,0,0">
            <ToggleButton
                x:Name="PopUpToggle"
                Width="22"
                Height="{DynamicResource ControlHeightMD}"
                Margin="0,4"
                HorizontalContentAlignment="Center"
                Background="{DynamicResource DarkerColor}"
                Style="{StaticResource ToggleTransformModifierMenu}" />

            <Popup
                AllowsTransparency="True"
                FlowDirection="LeftToRight"
                IsOpen="{Binding IsChecked, ElementName=PopUpToggle}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=PopUpToggle}"
                VerticalOffset="2">
                <i:Interaction.Behaviors>
                    <Behaviors:ClosePopupBehavior />
                </i:Interaction.Behaviors>
                <Border
                    Width="250"
                    Padding="4"
                    Background="{DynamicResource HighHighDarkerColor}"
                    CornerRadius="{DynamicResource CornerRadiusLargeAll}">
                    <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=prefabSlotManager}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}"
                                    Margin="0,2"
                                    Command="{Binding DataContext.ReplaceSelectedItemCommand, ElementName=prefabSlotManager}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding PrefabService.Name.Value}"
                                    Style="{DynamicResource ButtonItemControl}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

            </Popup>

            <Grid DockPanel.Dock="Right">

                <Border
                    Height="{DynamicResource ControlHeightMD}"
                    Margin="1,0,0,0"
                    Background="{DynamicResource HighHighDarkerColor}"
                    CornerRadius="{DynamicResource CornerRadiusRight}">
                    <TextBox
                        Padding="4,0"
                        Background="Transparent"
                        Text="{Binding DataContext.SelectedItem.PrefabService.Name.Value, ElementName=prefabSlotManager, UpdateSourceTrigger=PropertyChanged}" />
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=SelectedItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=SelectedItem, Converter={StaticResource DataToType}}" Value="{x:Type Prefabs:EmptyPrefab}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <ContentControl
                        Height="{DynamicResource ControlHeightMD}"
                        Content="{Binding SelectionPanel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                        DataContext="{Binding}" />

                </Border>

            </Grid>
        </DockPanel>

    </StackPanel>

</UserControl>
