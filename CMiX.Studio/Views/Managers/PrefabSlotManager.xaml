<UserControl
    x:Class="CMiX.Studio.Views.PrefabSlotManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:Prefabs="clr-namespace:CMiX.Core.Prefabs;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    x:Name="prefabSlotManager"
    d:DesignHeight="215.334"
    d:DesignWidth="255.001"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel>

        <DockPanel HorizontalAlignment="Stretch">

            <DockPanel
                Margin="4,0,0,0"
                DockPanel.Dock="Right"
                LastChildFill="False">

                <Button
                    Height="20"
                    Command="{Binding AddItemCommand}"
                    CommandParameter="{x:Type Prefabs:EmptyPrefabModel}"
                    Content="+"
                    DockPanel.Dock="Top"
                    Style="{StaticResource ButtonRoundedTop}" />

                <Button
                    x:Name="deleteItemButton"
                    Height="20"
                    Margin="0,1,0,0"
                    Command="{Binding DeleteItemCommand}"
                    CommandParameter="{Binding SelectedItem}"
                    Content="-"
                    DockPanel.Dock="Top"
                    Style="{StaticResource ButtonRoundedBottom}" />

                <Button
                    x:Name="moveItemDownButton"
                    Width="21"
                    Height="20"
                    Padding="8"
                    Command="{Binding ItemDownCommand}"
                    DockPanel.Dock="Bottom"
                    Style="{StaticResource ButtonRoundedBottom}">

                    <Button.Content>
                        <Image
                            Margin="20"
                            Opacity="0.7"
                            Source="{DynamicResource ArrowDown}" />
                    </Button.Content>
                </Button>

                <Button
                    x:Name="moveItemUpButton"
                    Height="20"
                    Margin="0,0,0,1"
                    Command="{Binding ItemUpCommand}"
                    DockPanel.Dock="Bottom"
                    Style="{StaticResource ButtonRoundedTop}">

                    <Button.Content>
                        <Image
                            Margin="20"
                            Opacity="0.7"
                            Source="{DynamicResource ArrowUp}" />
                    </Button.Content>
                </Button>

            </DockPanel>

            <ListBox
                x:Name="prefabListBox"
                Grid.Row="3"
                Height="100"
                DataContext="{Binding}"
                ItemsSource="{Binding ManagerData.Items}"
                SelectedIndex="{Binding ManagerData.SelectedIndex}"
                SelectedItem="{Binding SelectedItem}" />

        </DockPanel>

        <DockPanel Margin="0,8,0,0">
            <ToggleButton
                x:Name="ToggleItemSelection"
                Width="24"
                Height="22"
                Margin="0,4"
                HorizontalContentAlignment="Center"
                Background="{DynamicResource DarkerColor}"
                IsEnabled="{Binding IsChecked, ElementName=ModifierEnabled}"
                Style="{StaticResource ToggleTransformModifierMenu}" />

            <Popup
                Behaviors:ClosePopupBehavior.PopupContainer="{Binding ElementName=prefabSlotManager}"
                AllowsTransparency="True"
                FlowDirection="LeftToRight"
                IsOpen="{Binding IsChecked, ElementName=ToggleItemSelection}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=ToggleItemSelection}">

                <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=prefabSlotManager}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Height="22"
                                Command="{Binding DataContext.ReplaceSelectedItemCommand, ElementName=prefabSlotManager}"
                                CommandParameter="{Binding}"
                                Content="{Binding PrefabService.Name.Value}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </Popup>

            <Grid DockPanel.Dock="Right">

                <Border
                    Height="22"
                    Margin="1,0,0,0"
                    Background="{DynamicResource HighHighDarkerColor}"
                    CornerRadius="0, 2, 2, 0">
                    <TextBox
                        Padding="4,0"
                        Background="Transparent"
                        Text="{Binding DataContext.SelectedItem.PrefabService.Name.Value, ElementName=prefabSlotManager, UpdateSourceTrigger=PropertyChanged}" />
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Path=SelectedItem}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Path=SelectedItem, Converter={StaticResource DataToType}}" Value="{x:Type Prefabs:EmptyPrefab}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <ContentControl Content="{Binding SelectionPanel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}" DataContext="{Binding}" />

                </Border>

            </Grid>
        </DockPanel>

    </StackPanel>

</UserControl>
