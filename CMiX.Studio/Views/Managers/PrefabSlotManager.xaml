<UserControl
    x:Class="CMiX.Studio.Views.PrefabSlotManager"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:Prefabs="clr-namespace:CMiX.Core.Prefabs;assembly=CMiX.Core"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    x:Name="prefabSlotManager"
    d:DesignHeight="164.196"
    d:DesignWidth="252.008"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel>

        <!--  LIST  -->
        <BaseControls:CMiXListBox
            x:Name="prefabListBox"
            MinHeight="105"
            DataContext="{Binding}"
            ItemsSource="{Binding ManagerData.Items}"
            SelectedIndex="{Binding ManagerData.SelectedIndex, Mode=TwoWay}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListBox.Resources>
                <ResourceDictionary Source="ListBoxItemDataTemplate.xaml" />
            </ListBox.Resources>
        </BaseControls:CMiXListBox>

        <!--  TOOLBAR  -->
        <DockPanel Margin="0,4,0,0">

            <!--  DELETE  -->
            <Button
                Style="{StaticResource ButtonRoundedRight}"
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Command="{Binding DeleteItemCommand}"
                CommandParameter="{Binding SelectedItem}"
                Content="-"
                DockPanel.Dock="Right" />

            <!--  MOVE UP  -->
            <Button
                Margin="1, 0"
                Style="{StaticResource ButtonStraight}"
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Command="{Binding ManagerReorderService.ItemUpCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding SelectedItem}"
                DockPanel.Dock="Right">
                <Image Margin="16" Opacity="0.7" Source="{DynamicResource ArrowUp}" />
            </Button>

            <!--  MOVE DOWN  -->
            <Button
                Style="{StaticResource ButtonStraight}"
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Command="{Binding ManagerReorderService.ItemDownCommand, FallbackValue={x:Null}}"
                CommandParameter="{Binding SelectedItem}"
                DockPanel.Dock="Right">
                <Image Margin="16" Opacity="0.7" Source="{DynamicResource ArrowDown}" />
            </Button>

            <!--  SWAP  -->
            <ToggleButton
                Style="{StaticResource ToggleButtonRoundedLeft}"
                x:Name="SwapToggle"
                Width="{DynamicResource ControlHeightMD}"
                Height="{DynamicResource ControlHeightMD}"
                Content="⇄"
                DockPanel.Dock="Left" />

            <Popup
                AllowsTransparency="True"
                IsOpen="{Binding IsChecked, ElementName=SwapToggle}"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=SwapToggle}"
                VerticalOffset="-1">
                <i:Interaction.Behaviors>
                    <Behaviors:ClosePopupBehavior />
                </i:Interaction.Behaviors>
                <Border
                    Width="250"
                    Padding="2"
                    Background="{DynamicResource Grey100Brush}"
                    CornerRadius="{DynamicResource CornerRadiusLargeAll}">
                    <ItemsControl ItemsSource="{Binding ItemsSource, ElementName=prefabSlotManager}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Border}}"
                                    Margin="2"
                                    Command="{Binding DataContext.AddExistingItemCommand, ElementName=prefabSlotManager}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding PrefabService.Name.Value}"
                                    Style="{DynamicResource ButtonItemControl}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Popup>

            <!--  SELECTION PANEL (type picker)  -->
            <ContentControl
                Margin="1, 0"
                Height="{DynamicResource ControlHeightMD}"
                Content="{Binding SelectionPanel, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                DataContext="{Binding}"
                DockPanel.Dock="Left" />

        </DockPanel>

    </StackPanel>

</UserControl>
