<UserControl x:Class="CMiX.Studio.Views.PrefabSlotManager"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             x:Name="prefabSlotManager"
             d:DesignHeight="215.334" d:DesignWidth="255.001">

    <Border Background="{DynamicResource HighDarkerColor}">
        <StackPanel>
            <DockPanel HorizontalAlignment="Stretch">

                <DockPanel 
                    LastChildFill="False"
                        Margin="4, 0, 0, 0" 
                        DockPanel.Dock="Right">

                    <Button 
                        DockPanel.Dock="Top"
                            Height="20"
                            Content="+" 
                            Style="{StaticResource ButtonRoundedTop}"
                            Command="{Binding AddEmptyItemCommand}"/>

                    <Button 
                        DockPanel.Dock="Top"
                            x:Name="deleteItemButton"
                            Height="20"
                            Content="-"
                            Margin="0, 1, 0, 0"
                            Style="{StaticResource ButtonRoundedBottom}"
                            Command="{Binding DeleteItemCommand}"
                            CommandParameter="{Binding SelectedItem}"/>

                    <Button 
                            x:Name="moveItemDownButton"
                        DockPanel.Dock="Bottom"
                            Height="20"
                            Width="21"
                            Style="{StaticResource ButtonRoundedBottom}"
                            Padding="8"
                            Command="{Binding ItemDownCommand}">
                        <Button.Content>
                            <Image Source="{DynamicResource ArrowDown}" Margin="20" Opacity="0.7"/>
                        </Button.Content>
                    </Button>
                    
                    <Button 
                            x:Name="moveItemUpButton"
                            DockPanel.Dock="Bottom"
                            Height="20"
                            Margin="0, 0, 0, 1"
                            Style="{StaticResource ButtonRoundedTop}"
                            Command="{Binding ItemUpCommand}">
                        <Button.Content>
                            <Image Source="{DynamicResource ArrowUp}" Margin="20" Opacity="0.7"/>
                        </Button.Content>
                    </Button>

                </DockPanel>

                <ListBox 
                    x:Name="prefabListBox"
                    Height="100" 
                    DataContext="{Binding }"
                    Grid.Row="3" 
                    ItemsSource="{Binding Prefabs}"
                    SelectedItem="{Binding SelectedItem}"/>

            </DockPanel>


            <Grid Margin="0, 8, 0, 0" >
                <ComboBox 
                    x:Name="prefabCombobox"
                    Height="22"
                    DockPanel.Dock="Bottom"
                    ItemsSource="{Binding Prefabs}"
                    SelectedItem="{Binding SelectedItem.Prefab}">

                    <ComboBox.Style>
                        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ElementName=prefabCombobox, Path=HasItems}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="False" />
                                </MultiDataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ElementName=prefabListBox, Path=HasItems}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="IsEnabled" Value="False" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>

                    <ComboBox.ItemTemplate>
                        <ItemContainerTemplate>
                            <Border>
                                <TextBlock Text="{Binding Name}"/>
                            </Border>
                        </ItemContainerTemplate>
                    </ComboBox.ItemTemplate>

                </ComboBox>
                <Button Height="22" Command="{Binding AddItemCommand}" Content="New">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ElementName=prefabListBox, Path=HasItems}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

        </StackPanel>
    </Border>

</UserControl>
