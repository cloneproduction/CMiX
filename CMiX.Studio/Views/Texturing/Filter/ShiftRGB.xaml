<UserControl
    x:Class="CMiX.Studio.Views.ShiftRGB"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="142.111"
    d:DesignWidth="240"
    mc:Ignorable="d">

    <Views:FilterPanel>
        <Views:FilterPanel.Content>
            <StackPanel>

                <BaseControls:CMiXSlider
                    Caption="Factor"
                    Maximum="1.0"
                    Minimum="0.0"
                    Position="Default"
                    Value="{Binding Factor.Value}" />

                <BaseControls:DragValue
                    Margin="0,8,0,0"
                    Caption="Direction"
                    Position="Top"
                    Value="{Binding Direction.Value}" />

                <BaseControls:DragValue
                    Margin="0,1"
                    Caption="Shift"
                    Position="Middle"
                    Value="{Binding Shift.Value}" />

                <BaseControls:DragValue
                    Caption="Hue"
                    Position="Bottom"
                    Value="{Binding Hue.Value}" />

            </StackPanel>
        </Views:FilterPanel.Content>
    </Views:FilterPanel>

</UserControl>
