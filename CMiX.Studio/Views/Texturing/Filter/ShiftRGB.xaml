<UserControl
    x:Class="CMiX.Studio.Views.ShiftRGB"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    d:DesignHeight="142.111"
    d:DesignWidth="240"
    mc:Ignorable="d">

    <Views:FilterPanel>
        <Views:FilterPanel.Content>
            <Panels:PositionedStackPanel>

                <BaseControls:DragValue
                    Caption="Direction"
                    Value="{Binding Direction.Value}" />

                <BaseControls:DragValue
                    Margin="0,1"
                    Caption="Shift"
                    Value="{Binding Shift.Value}" />

                <BaseControls:DragValue
                    Caption="Hue"
                    Value="{Binding Hue.Value}" />

            </Panels:PositionedStackPanel>
        </Views:FilterPanel.Content>
    </Views:FilterPanel>

</UserControl>
