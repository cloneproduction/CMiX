<UserControl
    x:Class="CMiX.Studio.Views.ShiftRGB"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="126.111"
    d:DesignWidth="234.667"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControls:DragValue
            Caption="Direction"
            Position="Top"
            Value="{Binding Direction.Value}" />

        <BaseControls:DragValue
            Margin="0,1"
            Caption="Shift"
            Position="Middle"
            Value="{Binding Shift.Value}" />

        <BaseControls:DragValue
            Caption="Hue"
            Position="Bottom"
            Value="{Binding Hue.Value}" />

        <BaseControls:CMiXSlider
            Margin="0,8,0,0"
            Caption="Factor"
            Maximum="1.0"
            Minimum="0.0"
            Position="Default"
            Style="{StaticResource SliderRounded}"
            Value="{Binding Factor.Value}" />

    </StackPanel>

</UserControl>
