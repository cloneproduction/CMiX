<UserControl
    x:Class="CMiX.Studio.Views.Pixelate"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="295.333"
    d:DesignWidth="282.667"
    mc:Ignorable="d">

    <Views:FilterPanel>
        <Views:FilterPanel.Content>
            <StackPanel>

                <Controls:CMiXSlider
                    Margin="0,0,0,1"
                    Caption="Factor X"
                    Maximum="1"
                    Minimum="0"
                    Position="Top"
                    Value="{Binding Factor.X.Value}" />

                <Controls:CMiXSlider
                    Caption="Factor Y"
                    Maximum="1"
                    Minimum="0"
                    Position="Bottom"
                    Value="{Binding Factor.Y.Value}" />

            </StackPanel>
        </Views:FilterPanel.Content>
    </Views:FilterPanel>

</UserControl>
