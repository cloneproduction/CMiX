<UserControl
    x:Class="CMiX.Studio.Views.Echo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="295.333"
    d:DesignWidth="282.667"
    mc:Ignorable="d">

    <BaseControl:CMiXSlider
        Caption="Factor"
        Maximum="1"
        Minimum="0"
        Value="{Binding Factor.Value}" />

</UserControl>
