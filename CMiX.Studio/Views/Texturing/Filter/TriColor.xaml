<UserControl
    x:Class="CMiX.Studio.Views.TriColor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="246.889"
    d:DesignWidth="291.555"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel Margin="8">

        <BaseControl:ColorSelector
            Caption="Color A"
            Position="Top"
            SelectedColor="{Binding ColorA.Value}"
            ViewModel="{Binding Path=ColorA}" />

        <BaseControl:ColorSelector
            Margin="0,1"
            Caption="Color B"
            Position="Middle"
            SelectedColor="{Binding ColorB.Value}"
            ViewModel="{Binding Path=ColorB}" />

        <BaseControl:ColorSelector
            Caption="Color C"
            Position="Bottom"
            SelectedColor="{Binding ColorC.Value}"
            ViewModel="{Binding Path=ColorC}" />

        <BaseControl:ToggleButton
            Margin="0,8,0,0"
            Caption="Single Channel"
            IsChecked="{Binding SingleChannel.Value}" />

        <BaseControl:ToggleButton
            Margin="0,8,0,0"
            Caption="Clamp Color"
            IsChecked="{Binding ClampColor.Value}" />

        <BaseControl:CMiXSlider
            Margin="0,8,0,1"
            Caption="Smooth"
            Maximum="1.0"
            Minimum="0.0"
            Position="Top"
            Style="{StaticResource SliderRoundedTop}"
            Value="{Binding Smooth.Value}" />

        <BaseControl:CMiXSlider
            Margin="0,0,0,8"
            Caption="Center"
            Maximum="1.0"
            Minimum="0.0"
            Position="Bottom"
            Style="{StaticResource SliderRoundedBottom}"
            Value="{Binding Center.Value}" />

        <BaseControl:CMiXSlider
            Margin="0,8,0,0"
            Caption="Control"
            Maximum="1.0"
            Minimum="0.0"
            Position="Default"
            Value="{Binding Control.Value}" />

    </StackPanel>
</UserControl>
