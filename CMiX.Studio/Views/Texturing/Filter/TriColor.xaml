<UserControl x:Class="CMiX.Studio.Views.TriColor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
             xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
             md:DialogServiceViews.IsRegistered="True"
             mc:Ignorable="d" 
             d:DesignHeight="246.889" d:DesignWidth="291.555">

    <StackPanel Margin="8">

        <BaseControl:ColorSelector 
            Position="Top"
            SelectedColor="{Binding ColorA.SelectedColor, Converter={StaticResource EnumToString}}"
            Caption="Color A"/>

        <BaseControl:ColorSelector 
            Position="Middle"
            Margin="0, 1"
            SelectedColor="{Binding ColorB.SelectedColor, Converter={StaticResource EnumToString}}"
            Caption="Color B"/>

        <BaseControl:ColorSelector 
            Position="Bottom"
            SelectedColor="{Binding ColorC.SelectedColor, Converter={StaticResource EnumToString}}"
            Caption="Color C"/>
        
        <BaseControl:ToggleButton 
            IsChecked="{Binding SingleChannel.Value}" 
            Caption="Single Channel"
            Margin="0, 8, 0, 0"/>

        <BaseControl:ToggleButton 
            IsChecked="{Binding ClampColor.Value}" 
            Caption="Clamp Color"
            Margin="0, 8, 0, 0"/>
        
        <BaseControl:CMiXSlider 
            Margin="0, 8, 0, 1" 
            Caption="Smooth" 
            Minimum="0.0" 
            Maximum="1.0" 
            Value="{Binding Smooth.Value}" 
            Style="{StaticResource SliderRoundedTop}" 
            Position="Top"/>
        
        <BaseControl:CMiXSlider 
            Margin="0, 0, 0, 8" 
            Caption="Center" 
            Minimum="0.0" 
            Maximum="1.0" 
            Value="{Binding Center.Value}" 
            Style="{StaticResource SliderRoundedBottom}" 
            Position="Bottom"/>

        <BaseControl:CMiXSlider 
            Margin="0, 8, 0, 0" 
            Caption="Control" 
            Minimum="0.0" 
            Maximum="1.0" 
            Value="{Binding Control.Value}" 
            Position="Default"/>
        
    </StackPanel>
</UserControl>
