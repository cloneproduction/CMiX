<UserControl
    x:Class="CMiX.Studio.Views.TriColor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.Controls.Panels"
    d:DesignHeight="246.889"
    d:DesignWidth="291.555"
    mc:Ignorable="d">

    <Views:FilterPanel>
        <StackPanel>

            <Panels:PositionedStackPanel>

                <BaseControl:ColorSelector
                        Caption="Color A"
                        DataContext="{Binding ColorA}"/>

                <BaseControl:ColorSelector
                        Margin="0,1"
                        Caption="Color B"
                        DataContext="{Binding ColorB}"/>

                <BaseControl:ColorSelector
                        Caption="Color C"
                        DataContext="{Binding ColorC}"/>

            </Panels:PositionedStackPanel>

            <BaseControl:ToggleButton
                    Margin="0,8,0,0"
                    Caption="Single Channel"
                    IsChecked="{Binding SingleChannel.Value}" />

            <BaseControl:ToggleButton
                    Margin="0,1,0,0"
                    Caption="Clamp Color"
                    IsChecked="{Binding ClampColor.Value}" />

            <Panels:PositionedStackPanel Margin="0,8,0,0">
                <BaseControl:CMiXSlider
                        Margin="0,0,0,1"
                        Caption="Smooth"
                        Maximum="1.0"
                        Minimum="0.0"
                        Value="{Binding Smooth.Value}" />
                <BaseControl:CMiXSlider
                        Caption="Center"
                        Maximum="1.0"
                        Minimum="0.0"
                        Value="{Binding Center.Value}" />
            </Panels:PositionedStackPanel>

        </StackPanel>
    </Views:FilterPanel>
</UserControl>
