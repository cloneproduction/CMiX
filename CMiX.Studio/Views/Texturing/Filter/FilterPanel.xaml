<UserControl
    x:Class="CMiX.Studio.Views.FilterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="130.056"
    d:DesignWidth="250.366"
    mc:Ignorable="d">

    <UserControl.ContentTemplate>
        <DataTemplate>
            <StackPanel>

                <Controls:CMiXSlider
                    Margin="0,0,0,8"
                    Caption="Control"
                    Maximum="1"
                    Minimum="0"
                    Position="Default"
                    Value="{Binding Path=DataContext.Control.Value}" />
                <ContentPresenter Content="{TemplateBinding Content}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.ContentTemplate>

</UserControl>
