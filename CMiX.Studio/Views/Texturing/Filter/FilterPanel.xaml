<UserControl
    x:Class="CMiX.Studio.Views.FilterPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
    d:DesignHeight="130.056"
    d:DesignWidth="250.366"
    mc:Ignorable="d">

    <UserControl.ContentTemplate>
        <DataTemplate>
            <StackPanel>
                
                <ContentPresenter 
                    Content="{TemplateBinding Content}" />

                <Expander Margin="-8,8,-8,-8" IsExpanded="{Binding Path=DataContext.Blend.IsExpanded}">

                    <Expander.Header>
                        <DockPanel>
                            <ToggleButton
                                Width="14"
                                Height="14"
                                IsChecked="{Binding Path=DataContext.Blend.IsEnabled.Value}"
                                Style="{DynamicResource ToggleButtonRounded}" />
                            <TextBlock
                                Margin="8,0"
                                Foreground="{DynamicResource ForegroundBrush}"
                                Text="Blend" />
                        </DockPanel>
                    </Expander.Header>

                    <StackPanel Margin="8, 0" IsEnabled="{Binding Path=DataContext.Blend.IsEnabled.Value}">
                        <Controls:CMiXSlider
                            Margin="0, 8"
                            AttachedProperties:PositionedControl.Position="All"
                            Caption="Opacity"
                            Maximum="1"
                            Minimum="0"
                            Value="{Binding Path=DataContext.Blend.Opacity.Value}" />
                        <BaseControls:ComboBox
                            Margin="0, 0, 0, 8"
                            Caption="Blend Mode"
                            ItemsSource="{Binding Source={StaticResource BlendMode}}"
                            SelectedItem="{Binding Path=DataContext.Blend.BlendMode.Value}" />
                    </StackPanel>
                    
                </Expander>
            </StackPanel>
        </DataTemplate>
    </UserControl.ContentTemplate>

</UserControl>
