<UserControl
    x:Class="CMiX.Studio.Views.Displace"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="240.813"
    d:DesignWidth="236.721"
    mc:Ignorable="d">

    <StackPanel Margin="8">

        <Controls:Vector2 Caption="Offset" DataContext="{Binding Offset}" />

        <Controls:Vector2
            Margin="0,8"
            Caption="OffsetScale"
            DataContext="{Binding OffsetScale}" />

        <Controls:ComboBox
            Caption="Displacement Tex"
            DataContext="{Binding TextureSelector}"
            ItemsSource="{Binding ControlRepository.Textures}"
            SelectedItem="{Binding SelectedItem}" />

        <Controls:CMiXSlider
            Margin="0,8,0,0"
            Caption="Control"
            Maximum="1"
            Minimum="0"
            Position="Default"
            Style="{StaticResource SliderRounded}"
            Value="{Binding Control.Value}" />


    </StackPanel>
</UserControl>
