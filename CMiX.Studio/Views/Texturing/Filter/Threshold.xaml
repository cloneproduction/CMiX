<UserControl
    x:Class="CMiX.Studio.Views.Threshold"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.Controls.Panels"
    d:DesignHeight="240.813"
    d:DesignWidth="236.721"
    mc:Ignorable="d">

    <Views:FilterPanel>
        <StackPanel>
            <Panels:PositionedStackPanel>
                <Controls:DragValue
                    Caption="Threshold"
                    Minimum="0"
                    Value="{Binding ThresholdValue.Value}" />
                <Controls:DragValue
                    Margin="0, 1, 0, 0"
                    Caption="Smooth"
                    Value="{Binding Smooth.Value}" />
            </Panels:PositionedStackPanel>
            
            <Panels:PositionedStackPanel Margin="0, 8">

                <Controls:ColorSelector
                        Margin="0,0, 0, 1"
                        Caption="Foreground"
                        DataContext="{Binding Foreground}"/>

                <Controls:ColorSelector
                        Caption="Background"
                        DataContext="{Binding Background}"/>

            </Panels:PositionedStackPanel>
            
            <Controls:ToggleButton 
                    Caption="Invert" 
                    IsChecked="{Binding Invert.Value}" />
            <Controls:ToggleButton 
                    Caption="Antialiasing" 
                    IsChecked="{Binding Antialiasing.Value}" />
        </StackPanel>
    </Views:FilterPanel>
    
</UserControl>
