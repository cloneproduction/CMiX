<UserControl
    x:Class="CMiX.Studio.Views.SetAlpha"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="208.777"
    d:DesignWidth="266.087"
    mc:Ignorable="d">

    <StackPanel Margin="8">

        <BaseControls:ComboBox
            Margin="0,8"
            Caption="Channel"
            ItemsSource="{Binding Source={StaticResource AlphaChannel}}"
            Position="Default"
            SelectedItem="{Binding AlphaChannel.Value}" />

        <BaseControls:ToggleButton Caption="Invert" IsChecked="{Binding Invert.Value}" />

        <BaseControls:ToggleButton
            Margin="0,8"
            Caption="Keep Original Alpha"
            IsChecked="{Binding KeepOriginalAlpha.Value}" />

        <BaseControls:CMiXSlider
            Caption="Control"
            Maximum="1"
            Minimum="0"
            Value="{Binding Control.Value}" />

    </StackPanel>


</UserControl>
