<UserControl
    x:Class="CMiX.Studio.Views.SetAlpha"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    d:DesignHeight="208.777"
    d:DesignWidth="266.087"
    mc:Ignorable="d">

    <Views:FilterPanel>
        <StackPanel>

            <BaseControls:ComboBox
                    Caption="Channel"
                    ItemsSource="{Binding Source={StaticResource AlphaChannel}}"
                    SelectedItem="{Binding AlphaChannel.Value}" />

            <BaseControls:ToggleButton 
                    Margin="0,8"
                    Caption="Invert" 
                    IsChecked="{Binding Invert.Value}" />

            <BaseControls:ToggleButton
                    Caption="Keep Original Alpha"
                    IsChecked="{Binding KeepOriginalAlpha.Value}" />

        </StackPanel>
    </Views:FilterPanel>

</UserControl>
