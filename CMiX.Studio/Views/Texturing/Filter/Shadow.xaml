<UserControl
    x:Class="CMiX.Studio.Views.Shadow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="342.777"
    d:DesignWidth="268.087"
    mc:Ignorable="d">

    <StackPanel Margin="8">

        <BaseControls:VectorXYZ
            Margin="0,0,0,8"
            Caption="Light Position"
            DataContext="{Binding LightDirection}" />

        <BaseControls:DragValue
            Caption="Height"
            Position="Top"
            Value="{Binding Height.Value}" />

        <BaseControls:DragValue
            Margin="0,1,0,0"
            Caption="Dot Tolerance"
            Position="Middle"
            Value="{Binding DotTolerance.Value}" />

        <BaseControls:DragValue
            Margin="0,1,0,0"
            Caption="Ray Jitter"
            Position="Middle"
            Value="{Binding RayJitter.Value}" />

        <BaseControls:DragValue
            Margin="0,1,0,0"
            Caption="Ray Length"
            Position="Middle"
            Value="{Binding RayLength.Value}" />

        <BaseControls:DragValue
            Margin="0,1,0,0"
            Caption="Shadow Fade"
            Position="Middle"
            Value="{Binding ShadowFade.Value}" />

        <BaseControls:DragValue
            Margin="0,1,0,0"
            Caption="Shadow FallOff Pow"
            Position="Middle"
            Value="{Binding ShadowFallOffPow.Value}" />

        <BaseControls:DragValue
            Margin="0,1,0,0"
            Caption="Shadow Blur"
            Position="Middle"
            Value="{Binding ShadowBlur.Value}" />

        <BaseControls:DragValue
            Margin="0,1,0,0"
            Caption="Shadow Blur Pow"
            Position="Middle"
            Value="{Binding ShadowBlurPow.Value}" />

        <BaseControls:DragValue
            Margin="0,1,0,0"
            Caption="Sharp Offset"
            Position="Bottom"
            Value="{Binding SharpOffset.Value}" />

        <BaseControls:CMiXSlider
            Margin="0,8,0,0"
            Caption="Control"
            Maximum="1"
            Minimum="0"
            Value="{Binding Control.Value}" />

    </StackPanel>


</UserControl>
