<UserControl
    x:Class="CMiX.Studio.Views.Ascii"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="240.813"
    d:DesignWidth="236.721"
    mc:Ignorable="d">

    <Views:FilterPanel>
        <Views:FilterPanel.Content>
            
            <StackPanel>

                <Controls:DragValue
                    Caption="Grid Size"
                    Value="{Binding GridSize.Value}" />

                <Controls:Vector2
                    Margin="0,8"
                    Caption="Character Size"
                    DataContext="{Binding CharacterSize}" />

                <Controls:ToggleButton 
                    Caption="Grayscale" 
                    IsChecked="{Binding Grayscale.Value}" />

            </StackPanel>
            
        </Views:FilterPanel.Content>
    </Views:FilterPanel>
    
</UserControl>
