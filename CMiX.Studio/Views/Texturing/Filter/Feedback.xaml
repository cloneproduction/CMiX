<UserControl
    x:Class="CMiX.Studio.Views.Feedback"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="65.571"
    d:DesignWidth="283.816"
    mc:Ignorable="d">

    <Views:FilterPanel>
        <BaseControls:CMiXSlider
            Caption="Factor"
            Maximum="1"
            Minimum="0"
            Value="{Binding Factor.Value}" />
    </Views:FilterPanel>
</UserControl>
