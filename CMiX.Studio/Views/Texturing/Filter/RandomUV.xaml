<UserControl
    x:Class="CMiX.Studio.Views.RandomUV"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:basecontrol="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="309.682"
    d:DesignWidth="327.942"
    mc:Ignorable="d">

    <StackPanel Margin="8">

        <basecontrol:DragValue
            Caption="Uniform"
            Position="Default"
            Value="{Binding Uniform.Value}" />

        <basecontrol:Vector2
            Margin="0,8"
            Caption="Scale"
            DataContext="{Binding Scale}" />

        <basecontrol:DragValue
            Caption="Rotation"
            Position="Default"
            Value="{Binding Rotation.Value}" />

        <basecontrol:Vector2
            Margin="0,8"
            Caption="Translate"
            DataContext="{Binding Location}" />

        <Views:SamplerState DataContext="{Binding SamplerState}" />

        <Views:Outliner
            Margin="0,8,0,0"
            DataContext="{Binding BeatModifierManager}"
            ItemsSource="{Binding ControlRepository.BeatModifiers}"
            TypeParameter="{x:Type Animations:BeatModifierModel}" />

    </StackPanel>

</UserControl>
