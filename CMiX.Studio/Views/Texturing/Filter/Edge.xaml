<UserControl
    x:Class="CMiX.Studio.Views.Edge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.Controls.Panels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="240.813"
    d:DesignWidth="236.721"
    mc:Ignorable="d">

    <Views:FilterPanel>
        <Panels:PositionedStackPanel>

            <Controls:CMiXSlider
                    Caption="Radius"
                    Maximum="10"
                    Minimum="0"
                    Value="{Binding Radius.Value}" />

            <Controls:CMiXSlider
                    Margin="0,1,0,0"
                    Caption="Brightness"
                    Maximum="10"
                    Minimum="0"
                    Value="{Binding Brightness.Value}" />

        </Panels:PositionedStackPanel>
    </Views:FilterPanel>

</UserControl>
