<UserControl
    x:Class="CMiX.Studio.Views.HSCB"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    d:DesignHeight="190"
    d:DesignWidth="293.333"
    mc:Ignorable="d">

    <Views:FilterPanel>
        <Views:FilterPanel.Content>
            <Panels:PositionedStackPanel>

                <Controls:CMiXSlider
                    Margin="0,0,0,1"
                    Caption="Hue"
                    Maximum="1.0"
                    Minimum="0.0"
                    Value="{Binding Hue.Value}" />

                <Controls:CMiXSlider
                    Margin="0,0,0,0"
                    Caption="Saturation"
                    Maximum="1.0"
                    Minimum="0.0"
                    Value="{Binding Saturation.Value}" />

                <Controls:CMiXSlider
                    Margin="0,1,0,0"
                    Caption="Contrast"
                    Maximum="10.0"
                    Minimum="0.0"
                    Value="{Binding Contrast.Value}" />

                <Controls:CMiXSlider
                    Height="{DynamicResource ControlHeightMD}"
                    Margin="0,1,0,0"
                    Caption="Brightness"
                    Maximum="10.0"
                    Minimum="0.0"
                    Value="{Binding Brightness.Value}" />

            </Panels:PositionedStackPanel>
        </Views:FilterPanel.Content>
    </Views:FilterPanel>

</UserControl>
