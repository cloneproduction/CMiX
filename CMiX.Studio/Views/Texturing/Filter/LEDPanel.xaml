<UserControl
    x:Class="CMiX.Studio.Views.LEDPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.Controls.Panels"
    d:DesignHeight="240.813"
    d:DesignWidth="236.721"
    mc:Ignorable="d">

    <Views:FilterPanel>
        <Panels:PositionedStackPanel>
                <Controls:DragValue
                    Caption="Pixel Size"
                    Minimum="0"
                    Value="{Binding PixelSize.Value}" />
                <Controls:DragValue
                    Margin="0, 1, 0, 0"
                    Minimum="0"
                    Caption="Mask Stagger"
                    Value="{Binding MaskStagger.Value}" />
            <Controls:DragValue
                    Margin="0, 1, 0, 0"
                    Minimum="0"
                    Caption="Mask Border"
                    Value="{Binding MaskBorder.Value}" />
            <Controls:DragValue
                    Margin="0, 1, 0, 0"
                    Caption="Mask Intensity"
                    Minimum="0"
                    Value="{Binding MaskIntensity.Value}" />
        </Panels:PositionedStackPanel>

    </Views:FilterPanel>
    
</UserControl>
