<UserControl
    x:Class="CMiX.Studio.Views.Kuwahara"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="240.813"
    d:DesignWidth="236.721"
    mc:Ignorable="d">

    <Views:FilterPanel>
        <StackPanel>

            <Controls:ComboBox
                    Caption="Type"
                    ItemsSource="{Binding Source={StaticResource KuwaharaType}}"
                    SelectedItem="{Binding Type.Value}" />

            <Controls:DragValue
                    Margin="0,8,0,0"
                    Caption="Radius"
                    Maximum="10"
                    Minimum="0"
                    Value="{Binding Radius.Value}" />

        </StackPanel>
    </Views:FilterPanel>

</UserControl>
