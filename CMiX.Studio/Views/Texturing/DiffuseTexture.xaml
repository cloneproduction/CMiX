<UserControl
    x:Class="CMiX.Studio.Views.DiffuseTexture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Prefabs="clr-namespace:CMiX.Core.Prefabs;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="349.334"
    d:DesignWidth="335.333"
    mc:Ignorable="d">

    <StackPanel>
        <Views:PrefabSlotManager
            Margin="8"
            DataContext="{Binding TextureManager}"
            ItemsSource="{Binding Path=DataContext.PrefabRepositories.Textures, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}">
            <Views:PrefabSlotManager.SelectionPanel>
                <Views:ButtonOpenSelectionPanel Caption="Add Texture">
                    <Views:ButtonOpenSelectionPanel.SelectionPanel>
                        <Views:TextureSelectionPanel />
                    </Views:ButtonOpenSelectionPanel.SelectionPanel>
                </Views:ButtonOpenSelectionPanel>
            </Views:PrefabSlotManager.SelectionPanel>
        </Views:PrefabSlotManager>

        <Border>
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=TextureManager.SelectedItem}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=TextureManager.SelectedItem, Converter={StaticResource DataToType}}" Value="{x:Type Prefabs:EmptyPrefab}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Views:Texture DataContext="{Binding TextureManager.SelectedItem}" />

        </Border>

    </StackPanel>

</UserControl>