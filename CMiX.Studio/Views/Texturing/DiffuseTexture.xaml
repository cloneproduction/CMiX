<UserControl
    x:Class="CMiX.Studio.Views.DiffuseTexture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="349.334"
    d:DesignWidth="335.333"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel>
        <Views:PrefabSlotManager
            Margin="8"
            DataContext="{Binding TextureManager}"
            ItemsSource="{Binding Path=DataContext.PrefabRepositories.Textures, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}">
            <Views:PrefabSlotManager.SelectionPanel>
                <Views:TextureSelectionPanel />
            </Views:PrefabSlotManager.SelectionPanel>
        </Views:PrefabSlotManager>

        <Views:Texture DataContext="{Binding TextureManager.SelectedItem}" />
    </StackPanel>

</UserControl>