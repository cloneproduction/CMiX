<UserControl
    x:Class="CMiX.Studio.Views.Texturing.Texture"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:TextureSource="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <StackPanel>
        <Border>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding }" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <BaseControls:ComboBox
                Margin="8,0,8,8"
                Caption="Type"
                ItemsSource="{Binding Source={StaticResource TextureSourceName}}"
                SelectedItem="{Binding Path=TextureSourceSelector.ProceduralName.Value, Mode=TwoWay, Converter={StaticResource EnumToString}}" />
        </Border>

        <Grid Margin="8,0,8,8">

            <Border Margin="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TextureSourceSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Image}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Views:PathSelector ItemsSource="{Binding Path=DataContext.AssetManager.ImageAssets, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}" SelectedItem="{Binding Path=Image.Asset.Value}" />

            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TextureSourceSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Video}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <Views:PathSelector
                        Grid.Column="1"
                        Height="22"
                        ItemsSource="{Binding Path=DataContext.AssetManager.VideoAssets, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
                        SelectedItem="{Binding Path=VideoPlayer.Asset.Value}" />

                    <Views:VideoPlayer Margin="0,8,0,0" DataContext="{Binding Path=VideoPlayer}" />

                </StackPanel>
            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TextureSourceSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Text}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <!--<Views:TypeWriter DataContext="{Binding Path=TextureManager.ManagerData.SelectedItem.TypeWriter}" />-->

                <StackPanel>

                    <TextBox
                        Height="44"
                        Style="{StaticResource TypeWriterStyle}"
                        Text="{Binding TypeWriter.StringControl.Value, UpdateSourceTrigger=PropertyChanged}" />

                    <BaseControls:ComboBox
                        Margin="0,8,0,1"
                        Caption="Font Family"
                        ItemsSource="{Binding Source={StaticResource SortedFontsCollection}}"
                        Position="Top"
                        SelectedItem="{Binding TypeWriter.FontFamily.Value, Converter={StaticResource FontFamilyToString}}" />

                    <BaseControls:ComboBox
                        Caption="Style"
                        ItemsSource="{Binding Source={StaticResource FontStyle}}"
                        Position="Bottom"
                        SelectedItem="{Binding TypeWriter.Style.Value}" />

                    <BaseControls:DragValue
                        Margin="0,8"
                        Caption="Size"
                        Value="{Binding TypeWriter.FontSize.Value}" />

                    <BaseControls:ColorSelector
                        Caption="Font Color"
                        Position="Top"
                        SelectedColor="{Binding TypeWriter.FontColor.Value}"
                        ViewModel="{Binding TypeWriter.FontColor}" />

                    <BaseControls:ColorSelector
                        Margin="0,1,0,0"
                        Caption="Background Color"
                        Position="Bottom"
                        SelectedColor="{Binding TypeWriter.BackgroundColor.Value}"
                        ViewModel="{Binding TypeWriter.BackgroundColor}" />

                    <BaseControls:Vector2
                        Margin="0,8"
                        Caption="Position"
                        DataContext="{Binding TypeWriter.Position}" />

                    <BaseControls:Integer2Value Caption="Resolution" DataContext="{Binding TypeWriter.Resolution}" />

                </StackPanel>

            </Border>

            <Border>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TextureSourceSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Input}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Views:VideoIn DataContext="{Binding Path=VideoIn}" />

            </Border>

            <Border>

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TextureSourceSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.Gradient}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <BaseControls:DragValue
                        Margin="0,0,0,8"
                        Caption="Gamma"
                        Value="{Binding Path=Gradient.Gamma.Value}" />

                    <BaseControls:ColorSelector
                        Caption="From"
                        Position="Top"
                        SelectedColor="{Binding Path=Gradient.From.Value, Converter={StaticResource ColorToHex}}"
                        ViewModel="{Binding Path=Gradient.From}" />

                    <BaseControls:ColorSelector
                        Margin="0,1,0,0"
                        Caption="To"
                        Position="Bottom"
                        SelectedColor="{Binding Path=Gradient.To.Value, Converter={StaticResource ColorToHex}}"
                        ViewModel="{Binding Path=Gradient.To}" />

                    <BaseControls:ToggleButton
                        Margin="0,8"
                        Caption="Horizontal"
                        IsChecked="{Binding Path=Gradient.Horizontal.Value}" />

                    <BaseControls:Integer2Value Caption="Resolution" DataContext="{Binding Path=Gradient.Resolution}" />

                </StackPanel>

            </Border>

            <Border>

                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Path=TextureSourceSelector.ProceduralName.Value}" Value="{x:Static TextureSource:TextureSourceName.BubbleNoise}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>

                    <BaseControls:DragValue
                        Caption="Speed"
                        Position="Top"
                        Value="{Binding Path=BubbleNoise.Speed.Value}" />

                    <BaseControls:DragValue
                        Margin="0,1"
                        Caption="Frequency"
                        Position="Middle"
                        Value="{Binding Path=BubbleNoise.Frequency.Value}" />

                    <BaseControls:DragValue
                        Caption="Contrast"
                        Position="Bottom"
                        Value="{Binding Path=BubbleNoise.Contrast.Value}" />

                    <BaseControls:ColorSelector
                        Margin="0,8,0,1"
                        Caption="Background"
                        Position="Top"
                        SelectedColor="{Binding Path=BubbleNoise.BackgroundColor.Value, Converter={StaticResource ColorToHex}}"
                        ViewModel="{Binding Path=BubbleNoise.BackgroundColor}" />

                    <BaseControls:ColorSelector
                        Caption="Bubble"
                        Position="Bottom"
                        SelectedColor="{Binding Path=BubbleNoise.BubbleColor.Value, Converter={StaticResource ColorToHex}}"
                        ViewModel="{Binding Path=BubbleNoise.BubbleColor}" />

                    <BaseControls:Integer2Value
                        Margin="0,8,0,0"
                        Caption="Resolution"
                        DataContext="{Binding Path=BubbleNoise.Resolution}" />

                </StackPanel>

            </Border>

        </Grid>

        <Panels:IndentedExpander
            Header="Filter"
            Indentation="24"
            IsExpanded="{Binding Path=TextureManager.IsExpanded}">
            <Views:ModifierManager DataContext="{Binding Path=ModifierManager}">
                <Views:ModifierManager.SelectionPanel>
                    <Views:TextureFilterSelectionPanel DataContext="{Binding}" />
                </Views:ModifierManager.SelectionPanel>
            </Views:ModifierManager>
        </Panels:IndentedExpander>
    </StackPanel>


</UserControl>
