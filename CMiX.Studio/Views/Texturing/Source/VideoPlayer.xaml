<UserControl
    x:Class="CMiX.Studio.Views.VideoPlayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="177.256"
    d:DesignWidth="317.024"
    mc:Ignorable="d">

    <StackPanel>

        <Views:PathSelector
            Margin="0,0,0,8"
            ItemsSource="{Binding Path=DataContext.AssetManager.VideoAssets, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"
            SelectedItem="{Binding Asset.Value}" />

        <BaseControls:IntegerValue Caption="Seek Frame" Value="{Binding SeekFrame.Value}" />

        <BaseControls:Button
            Margin="0,8"
            Caption="Do Seek"
            Command="{Binding DoSeek.ClickCommand}" />

        <BaseControls:ToggleButton Caption="Play" IsChecked="{Binding Play.Value}" />

    </StackPanel>

</UserControl>
