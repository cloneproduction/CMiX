<UserControl
    x:Class="CMiX.Studio.Views.CheckerBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="341.222"
    d:DesignWidth="286.976"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel Margin="8">

        <BaseControls:Vector2 Caption="Cell Count" DataContext="{Binding CellCount}" />

        <BaseControls:ColorSelector
            Margin="0,8,0,1"
            Caption="Color A"
            Position="Top"
            SelectedColor="{Binding ColorA.Value, Converter={StaticResource ColorToHex}}"
            ViewModel="{Binding ColorA}" />

        <BaseControls:ColorSelector
            Caption="Color B"
            Position="Bottom"
            SelectedColor="{Binding ColorB.Value, Converter={StaticResource ColorToHex}}"
            ViewModel="{Binding ColorB}" />

        <Views:Transform2D Margin="0,8" DataContext="{Binding Transform2D}" />

        <BaseControls:Integer2Value Caption="Resolution" DataContext="{Binding Resolution}" />

    </StackPanel>

</UserControl>
