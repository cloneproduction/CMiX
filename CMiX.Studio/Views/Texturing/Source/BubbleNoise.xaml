<UserControl
    x:Class="CMiX.Studio.Views.BubbleNoise"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.Controls.Panels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="429.222"
    d:DesignWidth="287.643"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">
    
    <StackPanel>
        <Panels:PositionedStackPanel>

            <BaseControls:DragValue
                Caption="Speed"
                Value="{Binding Speed.Value}" />

            <BaseControls:DragValue
                Margin="0,1"
                Caption="Frequency"
                Value="{Binding Frequency.Value}" />

            <BaseControls:DragValue
                Caption="Contrast"
                Value="{Binding Contrast.Value}" />
        </Panels:PositionedStackPanel>

        <Panels:PositionedStackPanel>
            <BaseControls:ColorSelector
                Margin="0,8,0,1"
                Caption="Background"
                DataContext="{Binding BackgroundColor}"/>

            <BaseControls:ColorSelector
                Caption="Bubble"
                DataContext="{Binding BubbleColor}"/>
        </Panels:PositionedStackPanel>

        <BaseControls:Integer2Value
            Margin="0,8,0,0"
            Caption="Resolution"
            DataContext="{Binding Resolution}" />
    </StackPanel>

</UserControl>
