<UserControl
    x:Class="CMiX.Studio.Views.Gradient"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.Controls"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.Controls.Panels"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="162.555"
    d:DesignWidth="270.31"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel>
        
        <BaseControl:DragValue
            Margin="0,0,0,8"
            Caption="Gamma"
            Value="{Binding Gamma.Value}" />
        
        <Panels:PositionedStackPanel>
            
            <BaseControl:ColorSelector
                Caption="From"
                DataContext="{Binding From}"/>
            
            <BaseControl:ColorSelector
                Margin="0,1,0,0"
                Caption="To"
                DataContext="{Binding To}"/>
            
        </Panels:PositionedStackPanel>

        <BaseControl:ToggleButton
            Margin="0,8"
            Caption="Horizontal"
            IsChecked="{Binding Horizontal.Value}" />

        <BaseControl:Integer2Value 
            Caption="Resolution" 
            DataContext="{Binding Resolution}" />

    </StackPanel>

</UserControl>
