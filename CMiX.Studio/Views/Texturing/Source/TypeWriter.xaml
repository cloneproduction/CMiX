<UserControl
    x:Class="CMiX.Studio.Views.TypeWriter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControl="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="450.779"
    d:DesignWidth="280.26"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel>

        <TextBox
            Height="44"
            Style="{StaticResource TypeWriterStyle}"
            Text="{Binding StringControl.Value, UpdateSourceTrigger=PropertyChanged}" />

        <BaseControl:ComboBox
            Margin="0,8,0,1"
            Caption="Font Family"
            ItemsSource="{x:Static Fonts.SystemFontFamilies}"
            Position="Top"
            SelectedItem="{Binding FontFamily.Value, Converter={StaticResource FontFamilyToString}}" />

        <BaseControl:ComboBox
            Caption="Style"
            ItemsSource="{Binding Source={StaticResource FontStyle}}"
            Position="Bottom"
            SelectedItem="{Binding Style.Value}" />

        <BaseControl:DragValue
            Margin="0,8"
            Caption="Size"
            Value="{Binding FontSize.Value}" />

        <BaseControl:ColorSelector
            Caption="Font Color"
            DataContext="{Binding FontColor}"
            Position="Top" />

        <BaseControl:ColorSelector
            Margin="0,1,0,0"
            Caption="Background Color"
            DataContext="{Binding BackgroundColor}"
            Position="Bottom" />

        <BaseControl:Vector2
            Margin="0,8"
            Caption="Position"
            DataContext="{Binding Position}" />

        <BaseControl:Integer2Value Caption="Resolution" DataContext="{Binding Resolution}" />

    </StackPanel>

</UserControl>
