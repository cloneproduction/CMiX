<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Sources="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views">


    <!--  TEXTURE SOURCES  -->
    <DataTemplate DataType="{x:Type Sources:BubbleNoise}">
        <Views:BubbleNoise DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Sources:VideoPlayer}">
        <Views:VideoPlayer DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Sources:Image}">
        <Views:Image DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Sources:Gradient}">
        <Views:Gradient DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Sources:VideoIn}">
        <Views:VideoIn DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Sources:TypeWriter}">
        <Views:TypeWriter DataContext="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type Sources:TouchBlob}">
        <Views:TouchBlob DataContext="{Binding}" />
    </DataTemplate>
</ResourceDictionary>