<UserControl
    x:Class="CMiX.Studio.Views.TouchBlob"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignHeight="429.222"
    d:DesignWidth="287.643"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel>

        <BaseControls:DragValue
            Margin="0,0,0,8"
            Caption="Size"
            Position="Middle"
            Value="{Binding Size.Value}" />

        <BaseControls:ColorSelector
            Caption="Color"
            Position="Top"
            SelectedColor="{Binding Path=Color.Value}"
            ViewModel="{Binding Path=Color}" />

        <BaseControls:ColorSelector
            Margin="0,1,0,0"
            Caption="Background"
            Position="Bottom"
            SelectedColor="{Binding Background.Value}"
            ViewModel="{Binding Background}" />

        <BaseControls:Integer2Value
            Margin="0,8,0,0"
            Caption="Resolution"
            DataContext="{Binding Resolution}" />

    </StackPanel>

</UserControl>
