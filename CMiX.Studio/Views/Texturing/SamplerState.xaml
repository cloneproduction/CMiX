<UserControl
    x:Class="CMiX.Studio.Views.SamplerState"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:md="https://github.com/fantasticfiasco/mvvm-dialogs"
    d:DesignWidth="386"
    md:DialogServiceViews.IsRegistered="True"
    mc:Ignorable="d">

    <StackPanel>
        
        <Panels:PositionedStackPanel>

            <BaseControls:ComboBox
                Caption="Address U"
                ItemsSource="{Binding Source={StaticResource TextureAddressMode}}"
                SelectedItem="{Binding AddressU.Value}" />

            <BaseControls:ComboBox
                Margin="0,1,0,0"
                Caption="V"
                ItemsSource="{Binding Source={StaticResource TextureAddressMode}}"
                SelectedItem="{Binding AddressV.Value}" />

        </Panels:PositionedStackPanel>

        <BaseControls:ColorSelector
            Margin="0,8,0,0"
            Caption="Border Color"
            DataContext="{Binding BorderColor}"/>

    </StackPanel>

</UserControl>
