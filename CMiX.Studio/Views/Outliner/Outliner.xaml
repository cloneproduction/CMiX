<UserControl x:Class="CMiX.Studio.Views.Outliner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ViewModels="clr-namespace:CMiX.Core.Presentation.ViewModels;assembly=CMiX.Core"
             xmlns:Components="clr-namespace:CMiX.Core.Presentation.ViewModels.Components;assembly=CMiX.Core"
             xmlns:Converters="clr-namespace:CMiX.Core.Presentation.ValueConverters;assembly=CMiX.Core"
             xmlns:Tools="clr-namespace:CMiX.Core.Presentation;assembly=CMiX.Core"
             xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:dd="urn:gong-wpf-dragdrop"
             xmlns:Behaviors="clr-namespace:CMiX.Core.Presentation.Behaviors;assembly=CMiX.Core"
             mc:Ignorable="d" 
             x:Name="outliner"
             d:DesignHeight="450.191" d:DesignWidth="300.596">

    <UserControl.Resources>
        <ResourceDictionary>

            <Tools:BindingProxy x:Key="ComponentManagerProxy" Data="{Binding Path=DataContext.ComponentManager, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"/>
            <Tools:BindingProxy x:Key="RootProxy" Data="{Binding Path=DataContext, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Window}}}"/>
            <Tools:BindingProxy x:Key="OutlinerProxy" Data="{Binding Path=DataContext}"/>
            
            <DataTemplate x:Key="projectComponent" DataType="{x:Type Components:Project}">
                <DockPanel>
                    
                    <Border 
                        DockPanel.Dock="Left" 
                        Height="30" 
                        Width="30" 
                        BorderBrush="{DynamicResource SuperHighDarkerColor}" 
                        BorderThickness="0, 0, 1, 0">
                    </Border>
                    
                    <Grid Grid.Column="1" Margin="{Binding Converter={StaticResource LeftMarginMultiplier}, RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="19" />
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="toggleBorder">
                            <ToggleButton x:Name="Expander"
                                Style="{DynamicResource ExpandCollapseToggleStyle}"
                                IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                ClickMode="Press"/>
                        </Border>
                    </Grid>
                    
                </DockPanel>
            </DataTemplate>
            <DataTemplate x:Key="componentTemplate" DataType="{x:Type Components:Component}">

            </DataTemplate>
            <Components:ComponentTemplateSelector
                x:Key="componentTemplateSelector"
                ProjectTemplate="{StaticResource projectComponent}"
                CompositionTemplate="{StaticResource componentTemplate}"
                LayerTemplate="{StaticResource componentTemplate}"
                SceneTemplate="{StaticResource componentTemplate}"
                EntityTemplate="{StaticResource componentTemplate}"/>
            
            <ContextMenu x:Key="OutlinerContextMenu"
                     Style="{StaticResource ContextMenuDefault}"
                     Visibility="{Binding Data.ComponentManager.SelectedComponent, Converter={StaticResource NullToVisibility}, Source={StaticResource RootProxy}}"
                     Width="175">

                <MenuItem
>
                    <MenuItem.Style>
                        <Style TargetType="{x:Type MenuItem}" 
                               BasedOn="{StaticResource ContextMenuSubItem}">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Setter Property="Header" Value="Add"/>
                            <Setter Property="Command" Value="{Binding Data.CreateComponentCommand, Source={StaticResource ComponentManagerProxy}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Data.SelectedComponent, Source={StaticResource ComponentManagerProxy},  Converter={StaticResource DataTypeConverter}}" Value="{x:Type Components:Composition}">
                                    <Setter Property="Header" Value="Add Layer"/>
                                    <Setter Property="CommandParameter" Value="{x:Static Components:ComponentType.Layer}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Data.SelectedComponent, Source={StaticResource ComponentManagerProxy},  Converter={StaticResource DataTypeConverter}}" Value="{x:Type Components:Layer}">
                                    <Setter Property="Header" Value="Add Scene"/>
                                    <Setter Property="CommandParameter" Value="{x:Static Components:ComponentType.Scene}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Data.SelectedComponent, Source={StaticResource ComponentManagerProxy},  Converter={StaticResource DataTypeConverter}}" Value="{x:Type Components:Scene}">
                                    <Setter Property="Header" Value="Add Entity"/>
                                    <Setter Property="CommandParameter" Value="{x:Static Components:ComponentType.Entity}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Data.SelectedComponent, Source={StaticResource ComponentManagerProxy},  Converter={StaticResource DataTypeConverter}}" Value="{x:Type Components:Entity}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                    <MenuItem.Icon>
                        <Image Source="{StaticResource Add}"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem
                    Command="{Binding Data.RenameComponentCommand, Source={StaticResource ComponentManagerProxy}}"
                    CommandParameter="{Binding Data.SelectedComponent, Source={StaticResource ComponentManagerProxy}}"
                    Header="Rename">
                    <MenuItem.Icon>
                        <Image Source="{StaticResource Rename}"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem
                    Command="{Binding Data.DuplicateComponentCommand, Source={StaticResource ComponentManagerProxy}}"
                    CommandParameter="{Binding Data.SelectedComponent, Source={StaticResource ComponentManagerProxy}}"
                    Header="Duplicate">
                    <MenuItem.Style>
                        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource ContextMenuSubItem}">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Data.SelectedComponent, Source={StaticResource ComponentManagerProxy},  Converter={StaticResource DataTypeConverter}}" Value="{x:Type Components:Project}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                    <MenuItem.Icon>
                        <Image Source="{StaticResource Copy}"/>
                    </MenuItem.Icon>
                </MenuItem>

                <MenuItem
                    Command="{Binding Data.DeleteComponentCommand, Source={StaticResource ComponentManagerProxy}}"
                    CommandParameter="{Binding Data.SelectedComponent, Source={StaticResource ComponentManagerProxy}}"
                    Header="Delete">
                    <MenuItem.Style>
                        <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource ContextMenuSubItem}">
                            <Setter Property="IsEnabled" Value="True"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Data.SelectedComponent, Source={StaticResource ComponentManagerProxy}, Converter={StaticResource DataTypeConverter}}" Value="{x:Type Components:Project}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                    <MenuItem.Icon>
                        <Image Source="{StaticResource DeleteLayer}"/>
                    </MenuItem.Icon>
                </MenuItem>

            </ContextMenu>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Background="{StaticResource HighDarkerColor}">
        <Border 
            VerticalAlignment="Center"
            Padding="4"
            DockPanel.Dock="Top"
            BorderBrush="{StaticResource SuperHighDarkerColor}"
            BorderThickness="0, 0, 0, 1">
            <DockPanel Height="25">
                <TextBlock Text="OUTLINER" Margin="8" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <Button 
                    x:Name="deleteItemButton"
                    DockPanel.Dock="Right" 
                    Width="25" 
                    Command="{Binding DeleteCompositionCommand}"
                    Style="{StaticResource ButtonRoundedRight}"
                    Content="-">
                </Button>
                
                <Border DockPanel.Dock="Right" BorderBrush="{DynamicResource SuperHighDarkerColor}" BorderThickness="0, 0, 0, 1">
                    <Button 
                        Width="25" 
                        Margin="1, 0"
                        Command="{Binding CreateCompositionCommand}"
                        Content="+">
                    </Button>
                </Border>
                
                <ToggleButton x:Name="PopUpToggle" 
                              Content="Add Modifier"
                              Width="25" 
                              Background="{DynamicResource DarkerColor}" 
                              Style="{StaticResource ToggleTransformModifierMenu}">
                </ToggleButton>

                <Controls:CMiXPopup 
                        AllowsTransparency="True"
                        Behaviors:ClosePopupBehavior.PopupContainer="{Binding ElementName=outliner}"
                        Placement="Bottom"
                        Width="250"
                        PlacementTarget="{Binding ElementName=PopUpToggle}"
                        FlowDirection="RightToLeft"
                        IsOpen="{Binding IsChecked, ElementName=PopUpToggle}">
                    
                    <Border Background="Transparent" 
                            CornerRadius="{DynamicResource CornerRadiusBottom}" 
                            Padding="2, 0, 2, 2">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" Opacity="0.8"  ShadowDepth="2" Direction="-90" RenderingBias="Performance" />
                        </Border.Effect>
                        <Border CornerRadius="{DynamicResource CornerRadiusBottomLarge}" 
                                Opacity="0.75" 
                                Background="{DynamicResource HighDarkerColor}">
                            <ItemsControl ItemsSource="{Binding Project.Components}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border>
                                            <Button 

                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding DataContext.SelectCompositionCommand, ElementName=outliner}"
                                                CommandParameter="{Binding}"
                                                Height="25"
                                                Content="{Binding Name}" 
                                                Style="{StaticResource ButtonListBoxItem}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Border>
                </Controls:CMiXPopup>

                <Border Background="{DynamicResource DarkerColor}" BorderBrush="{DynamicResource SuperHighDarkerColor}" BorderThickness="0, 0, 0, 1" >
                    <Controls:EditableTextBox Padding="4, 0, 0, 0" Text="{Binding SelectedComposition.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </Border>
                
            </DockPanel>
        </Border>

        <Controls:TreeViewSelect 
            Style="{StaticResource TreeViewDefault}"
            AllowDrop="True"
            dd:DragDrop.IsDragSource="True"
            dd:DragDrop.IsDropTarget="True"
            dd:DragDrop.DragHandler="{Binding OutlinerDragDropManager}"
            dd:DragDrop.DropHandler="{Binding OutlinerDragDropManager}"
            ContextMenu="{DynamicResource OutlinerContextMenu}"
            ItemsSource="{Binding SelectedComposition.Components}">
            <Controls:TreeViewSelect.Resources>
                <HierarchicalDataTemplate DataType="{x:Type Components:Scene}" ItemsSource="{Binding Components}">
                    <DockPanel>
                        <Image Margin="8" Opacity="0.75">
                            <Image.Style>
                                <Style TargetType="{x:Type Image}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Mask.IsMask}" Value="False">
                                            <Setter Property="Source" Value="{DynamicResource Scene}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Mask.IsMask}" Value="True">
                                            <Setter Property="Source" Value="{DynamicResource Mask}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <Controls:EditableTextBox 
                                DockPanel.Dock="Left"
                                Padding="0, 4" 
                                VerticalAlignment="Center" 
                                IsEditing="{Binding IsRenaming, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </HierarchicalDataTemplate>

                <HierarchicalDataTemplate DataType="{x:Type Components:Layer}" ItemsSource="{Binding Components}">
                    <DockPanel DockPanel.Dock="Top">
                        <Image Margin="8" Opacity="0.75" Source="{StaticResource Copy}"/>
                        <Controls:EditableTextBox 
                                    DockPanel.Dock="Left"
                                    Padding="0, 4" 
                                    VerticalAlignment="Center" 
                                    IsEditing="{Binding IsRenaming, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                    Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type Components:Entity}">
                    <DockPanel>
                        <Image Margin="8" DockPanel.Dock="Left" Opacity="0.75" Source="{StaticResource Entity}"/>
                        <Controls:EditableTextBox 
                                Padding="4" 
                                VerticalAlignment="Center" 
                                IsEditing="{Binding IsRenaming, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>
                </DataTemplate>

            </Controls:TreeViewSelect.Resources>
            
            <i:Interaction.Behaviors>
                <Behaviors:BindableSelectedItemBehavior 
                    SelectedItem="{Binding Data.ComponentManager.SelectedComponent, Source={StaticResource RootProxy}, Mode=TwoWay}"/>
            </i:Interaction.Behaviors>

            <TreeView.ItemContainerStyle>
                <Style TargetType="{x:Type TreeViewItem}" BasedOn="{StaticResource TreeViewItemDefault}">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded}"/>
                </Style>
            </TreeView.ItemContainerStyle>
            
        </Controls:TreeViewSelect>
        
    </DockPanel>

</UserControl>
