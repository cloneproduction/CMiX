    <Border 
            VerticalAlignment="Center"
            Padding="4"
            DockPanel.Dock="Top"
        Background="{DynamicResource DarkerColor}"
            BorderBrush="{DynamicResource Shadow}">
        <DockPanel Height="25">
            <ComboBox 
                    Style="{StaticResource ComboBoxWithButton}"
                    SelectedItem="{Binding SelectedComposition}"
                    ItemsSource="{Binding Project.Components}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>
    </Border>

</UserControl>
