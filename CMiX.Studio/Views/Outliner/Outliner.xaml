<UserControl x:Class="CMiX.Studio.Views.Outliner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="222.346" d:DesignWidth="306.881">

    <Border 
        VerticalAlignment="Center"
        Padding="4"
        DockPanel.Dock="Top"
        Background="{DynamicResource DarkerColor}"
        BorderBrush="{DynamicResource Shadow}">
        <DockPanel Height="25">
            <ComboBox 
                Style="{StaticResource ComboBoxWithButton}"
                SelectedItem="{Binding SelectedItem}"
                ItemsSource="{Binding Prefabs}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DockPanel>
    </Border>

</UserControl>
