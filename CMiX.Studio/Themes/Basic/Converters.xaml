<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Converters="clr-namespace:CMiX.Studio.Converters">

    <Converters:LeftMarginMultiplierConverter x:Key="LeftMarginMultiplier" />
    
    <Converters:ColorToBrushConverter x:Key="ColorToBrush" />
    <Converters:ColorToHexConverter x:Key="ColorToHex" />
    <Converters:ColorToStringConverter x:Key="ColorToString" />
    <Converters:ColorToNoAlphaConverter x:Key="ColorToNoAlpha" />
    
    <Converters:DoubleToStringConverter x:Key="DoubleToString" />

    <Converters:BoolToVisibilityConverter x:Key="BoolToCollapsed" FalseValue="Collapsed" />
    <Converters:BoolToVisibilityConverter x:Key="BoolToVisibility" FalseValue="Hidden"/>
    <Converters:NullToVisibilityConverter x:Key="NullToVisibility" />
    <Converters:CountToVisibilityConverter x:Key="CountToVisibility" />
    
    <Converters:MultiPeriodToBeatAnimationConverter x:Key="MultiPeriodToBeatAnimation" />
    <Converters:DataTypeConverter x:Key="DataToType" />

    <Converters:FontFamilyToStringConverter x:Key="FontFamilyToString" />
    <Converters:RemapDoubleConverter x:Key="RemapDouble"/>

</ResourceDictionary>