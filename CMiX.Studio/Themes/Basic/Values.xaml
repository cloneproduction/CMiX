<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:Double x:Key="DefaultFontSize">10</system:Double>
    <system:Double x:Key="CR">2</system:Double>
    <system:Double x:Key="LargeRadius">4</system:Double>

    <CornerRadius
        x:Key="CornerRadiusDefault"
        BottomLeft="{StaticResource CR}"
        BottomRight="{StaticResource CR}"
        TopLeft="{StaticResource CR}"
        TopRight="{StaticResource CR}" />

    <CornerRadius
        x:Key="CornerRadiusTop"
        BottomLeft="0"
        BottomRight="0"
        TopLeft="{StaticResource CR}"
        TopRight="{StaticResource CR}" />

    <CornerRadius
        x:Key="CornerRadiusBottom"
        BottomLeft="{StaticResource CR}"
        BottomRight="{StaticResource CR}"
        TopLeft="0"
        TopRight="0" />


    <CornerRadius
        x:Key="CornerRadiusDefaultLarge"
        BottomLeft="{StaticResource LargeRadius}"
        BottomRight="{StaticResource LargeRadius}"
        TopLeft="{StaticResource LargeRadius}"
        TopRight="{StaticResource LargeRadius}" />

    <CornerRadius
        x:Key="CornerRadiusTopLarge"
        BottomLeft="0"
        BottomRight="0"
        TopLeft="{StaticResource LargeRadius}"
        TopRight="{StaticResource LargeRadius}" />

    <CornerRadius
        x:Key="CornerRadiusRightLarge"
        BottomLeft="0"
        BottomRight="{StaticResource LargeRadius}"
        TopLeft="0"
        TopRight="{StaticResource LargeRadius}" />

    <CornerRadius
        x:Key="CornerRadiusLeftLarge"
        BottomLeft="{StaticResource LargeRadius}"
        BottomRight="0"
        TopLeft="{StaticResource LargeRadius}"
        TopRight="0" />

    <CornerRadius
        x:Key="CornerRadiusBottomLarge"
        BottomLeft="{StaticResource LargeRadius}"
        BottomRight="{StaticResource LargeRadius}"
        TopLeft="0"
        TopRight="0" />
</ResourceDictionary>