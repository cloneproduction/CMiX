<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl">

    <Style TargetType="{x:Type Controls:EditableTextBox}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:EditableTextBox}">
                    <Border Background="{DynamicResource SuperHighDarkerColor}" 
                            BorderBrush="{DynamicResource DarkerColor}"
                            BorderThickness="0.5">
                        <TextBox
                            x:Name="PART_TextBox"
                            Height="{TemplateBinding ActualHeight}"
                            VerticalAlignment="Center"
                            Padding="8,0"
                            Foreground="{DynamicResource TextBase}"
                            SelectionBrush="{DynamicResource SuperHighLightColor}"
                            CaretBrush="{DynamicResource TextBase}"
                            Background="Transparent"
                            BorderThickness="0">
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="Text" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:N3}'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInteger, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Text" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat='{}{0:N0}'}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>

                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource Self}}" Value="False">
                            <Setter Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>