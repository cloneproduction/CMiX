<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Markup="clr-namespace:CMiX.Studio.Markup"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Studio;component/Themes/Basic/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>
    
    <Style TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="All" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="border"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        SnapsToDevicePixels="True">

                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="All">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusAll}" />
                        </Trigger>
                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Middle">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusNone}" />
                        </Trigger>
                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Right">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusRight}" />
                        </Trigger>
                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Left">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusLeft}" />
                        </Trigger>
                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="None">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusNone}" />
                        </Trigger>
                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Top">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusTop}" />
                        </Trigger>
                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Bottom">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusBottom}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey700Brush}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource HighGrey700Brush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonStraight"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="{x:Type Button}">
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="None" />
    </Style>

    <Style x:Key="ButtonRounded"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="{x:Type Button}">
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="All" />
    </Style>

    <Style x:Key="ButtonRoundedRight"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="{x:Type Button}">
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="Right" />
    </Style>

    <Style x:Key="ButtonRoundedLeft"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="{x:Type Button}">
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="Left" />
    </Style>

    <Style x:Key="ButtonRoundedTop"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="{x:Type Button}">
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="Top" />
    </Style>

    <Style x:Key="ButtonRoundedBottom"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="{x:Type Button}">
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="Bottom" />
    </Style>


    <!--  This one is use for ColorSelector  -->
    <Style x:Key="ButtonColorStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">

                        <Border
                            x:Name="mask"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"
                            AttachedProperties:PositionedControl.Position="{Binding Path=(AttachedProperties:PositionedControl.Position), RelativeSource={RelativeSource TemplatedParent}}"
                            Background="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}"
                            Style="{DynamicResource BorderMask}" />

                        <Grid SnapsToDevicePixels="True">
                            <Grid.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=mask}" />
                            </Grid.OpacityMask>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="1" 
                                    CornerRadius="{DynamicResource CornerRadiusRight}">
                                <Border.Background>
                                    <ImageBrush
                                    ImageSource="{DynamicResource CheckBoard}"
                                    Stretch="Uniform"
                                    TileMode="Tile"
                                    Viewport="0, 0, 128, 128"
                                    ViewportUnits="Absolute" />
                                </Border.Background>
                            </Border>

                            <Border
                            x:Name="borderAlpha"
                            Grid.Column="1"
                            CornerRadius="{DynamicResource CornerRadiusRight}">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding Path=Background.Color, RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border.Background>
                            </Border>

                            <Border
                            x:Name="border"
                            Grid.Column="0"
                            Background="{Binding Path=Background.Color, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorToNoAlpha}}"
                            CornerRadius="{DynamicResource CornerRadiusLeft}" />

                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                            <Setter TargetName="borderAlpha" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonListBoxItem" TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="border"
                        Margin="0"
                        Padding="0,0,8,0"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Right" ContentTemplate="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="1.0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="1.0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonItemControl" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="border"
                        Margin="0"
                        Padding="8,0,0,0"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Left" ContentTemplate="{TemplateBinding Content}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey500Brush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonValidation" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="IsEnabled" Value="True" />
        <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="border"
                        Margin="0"
                        Background="{DynamicResource AccentInactiveBrush}"
                        BorderBrush="{DynamicResource Shadow}"
                        BorderThickness="0,0,0,2"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        SnapsToDevicePixels="True"
                        TextOptions.TextFormattingMode="Display"
                        UseLayoutRounding="True">

                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <TextBlock
                                x:Name="textBlock"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource ForegroundBrush}"
                                Text="{TemplateBinding Content}" />
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonWindowControlStyle" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="{DynamicResource ControlHeightXL}" />
        <Setter Property="Width" Value="{DynamicResource ControlHeightXL}" />
        <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="ButtonCloseWindowStyle" BasedOn="{StaticResource ButtonWindowControlStyle}" TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" Padding="8" Background="Transparent" SnapsToDevicePixels="True">
                        <Image x:Name="image" Opacity="0.75" Source="{DynamicResource CloseTab}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey600Brush}" />
                            <Setter TargetName="image" Property="Opacity" Value="1.0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey700Brush}" />
                            <Setter TargetName="image" Property="Opacity" Value="1.0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonMaximizeWindowStyle" BasedOn="{StaticResource ButtonWindowControlStyle}" TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" Padding="10" Background="Transparent" SnapsToDevicePixels="True">
                        <Image x:Name="image" Opacity="0.75" Source="{DynamicResource Maximize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey600Brush}" />
                            <Setter TargetName="image" Property="Opacity" Value="1.0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey700Brush}" />
                            <Setter TargetName="image" Property="Opacity" Value="1.0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ButtonMinimizeWindowStyle" BasedOn="{StaticResource ButtonWindowControlStyle}" TargetType="{x:Type Button}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" Padding="8" Background="Transparent" SnapsToDevicePixels="True">
                        <Image x:Name="image" Opacity="0.75" Source="{DynamicResource Minimize}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey600Brush}" />
                            <Setter TargetName="image" Property="Opacity" Value="1.0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey700Brush}" />
                            <Setter TargetName="image" Property="Opacity" Value="1.0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
</ResourceDictionary>