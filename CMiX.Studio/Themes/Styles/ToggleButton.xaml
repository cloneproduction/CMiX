<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
    xmlns:Prefabs="clr-namespace:CMiX.Core.Prefabs;assembly=CMiX.Core">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Studio;component/Themes/Basic/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="All" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">

                    <Border
                        x:Name="border"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        SnapsToDevicePixels="True">

                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Viewbox>
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="All">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusAll}" />
                        </Trigger>

                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Middle">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusNone}" />
                        </Trigger>
                        
                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Right">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusRight}" />
                        </Trigger>

                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Left">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusLeft}" />
                        </Trigger>

                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="None">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusNone}" />
                        </Trigger>

                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Top">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusTop}" />
                        </Trigger>

                        <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Bottom">
                            <Setter TargetName="border" Property="CornerRadius" Value="{DynamicResource CornerRadiusBottom}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey700Brush}" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey700Brush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey700Brush}" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey600Brush}" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>




    <Style
        x:Key="ToggleButtonRounded"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="{x:Type ToggleButton}">
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="All" />
    </Style>



    <Style
        x:Key="ToggleButtonRoundedLeft"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="{x:Type ToggleButton}">
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="Left" />
    </Style>







    <Style x:Key="ToggleCheckBox" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="{DynamicResource Grey600Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource ForegroundBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="All" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">

                    <Border
                        x:Name="border"
                        Padding="4"
                        HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        SnapsToDevicePixels="True">
                        <Image x:Name="icon" Source="{DynamicResource IsChecked}" />
                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey700Brush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="border" Property="Opacity" Value="0.5" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
                                <Setter TargetName="icon" Property="Visibility" Value="Visible" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="icon" Property="Visibility" Value="Visible" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey600Brush}" />
                                <Setter TargetName="icon" Property="Visibility" Value="Hidden" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="False" />
                                <Condition Property="IsMouseOver" Value="False" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey500Brush}" />
                                <Setter TargetName="icon" Property="Visibility" Value="Hidden" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ToggleButtonIcon"
        BasedOn="{StaticResource {x:Type ToggleButton}}"
        TargetType="{x:Type ToggleButton}">
        <Setter Property="Border.CornerRadius" Value="{DynamicResource CornerRadiusAll}" />
        <Setter Property="Content">
            <Setter.Value>
                <Run />
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Content">
                    <Setter.Value>
                        <Image
                            Margin="2"
                            Opacity="0.75"
                            Source="{DynamicResource IsChecked}" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ToggleVisibility" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightXS}"/>
        <Setter Property="Width" Value="{DynamicResource ControlHeightXS}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="border"
                        Margin="0"
                        Padding="1"
                        Background="Transparent"
                        Opacity="0.6"
                        SnapsToDevicePixels="True">
                        <Image x:Name="image" Source="{DynamicResource Visible}" />
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="image" Property="Source" Value="{DynamicResource NotVisible}" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Opacity" Value="1.0" />
                        </Trigger>
                        
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TogglePlayPause" TargetType="{x:Type ToggleButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="border"
                        Margin="0"
                        Padding="1"
                        Background="Transparent"
                        Opacity="0.6"
                        SnapsToDevicePixels="True">
                        <Image x:Name="image" Source="{DynamicResource Play}" />
                    </Border>
                    <ControlTemplate.Triggers>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="image" Property="Source" Value="{DynamicResource Stop}" />
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ToggleTransformModifierMenu" TargetType="{x:Type ToggleButton}">
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="border"
                        Background="{DynamicResource Grey400Brush}"
                        CornerRadius="{DynamicResource CornerRadiusLeft}"
                        SnapsToDevicePixels="True">
                        <DockPanel>
                            <Path
                                x:Name="arrow"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 1,1.5 L 4.5,5 L 8,1.5"
                                DockPanel.Dock="Right"
                                Opacity="0.5"
                                SnapsToDevicePixels="false"
                                Stroke="{DynamicResource ForegroundBrush}"
                                StrokeThickness="2" />
                            <TextBlock Padding="8,4,4,4" Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="true" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.Setters>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Grey500Brush}" />
                            </MultiTrigger.Setters>
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="true" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="arrow" Property="Opacity" Value="1.0" />
                        </MultiTrigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="InlineToggleButtonLeft"
            BasedOn="{StaticResource {x:Type ToggleButton}}"
            TargetType="{x:Type ToggleButton}">
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="Left" />
    </Style>

    <Style x:Key="InlineToggleButtonCenter"
            BasedOn="{StaticResource {x:Type ToggleButton}}"
            TargetType="{x:Type ToggleButton}">
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="None" />
    </Style>

    <Style x:Key="InlineToggleButtonRight"
            BasedOn="{StaticResource {x:Type ToggleButton}}"
            TargetType="{x:Type ToggleButton}">
        <Setter Property="AttachedProperties:PositionedControl.Position" Value="Right" />
    </Style>

</ResourceDictionary>