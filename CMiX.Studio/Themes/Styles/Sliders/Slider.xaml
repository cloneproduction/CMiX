<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Studio;component/Themes/Basic/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="RepeatButtonDecrease" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="border" Background="{DynamicResource AccentInactive}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="RepeatButtonDecreaseOver"
        BasedOn="{StaticResource RepeatButtonDecrease}"
        TargetType="{x:Type RepeatButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{DynamicResource Accent}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="RepeatButtonIncrease" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="false" />
        <Setter Property="IsTabStop" Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{DynamicResource DarkColor}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="RepeatButtonIncreaseOver"
        BasedOn="{StaticResource RepeatButtonIncrease}"
        TargetType="{x:Type RepeatButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{DynamicResource Color}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="RepeatButtonIncreaseDown"
        BasedOn="{StaticResource RepeatButtonIncrease}"
        TargetType="{x:Type RepeatButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="{DynamicResource HighHighDarkerColor}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Controls:CMiXSlider}">
        <Setter Property="Height" Value="22" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="AttachedProperties:MouseDownHelper.IsEnabled" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Right" />
        <Setter Property="AttachedProperties:PositionedCornerRadius.RoundedPosition" Value="All" />
        <Setter Property="Caption" Value="" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:CMiXSlider}">

                    <Border x:Name="mainBorder" SnapsToDevicePixels="True">
                        <Grid>

                            <Border x:Name="borderMask">
                                <Border.Style>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="Background" Value="{DynamicResource DarkerColor}" />
                                        <Setter Property="CornerRadius" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource TemplatedParent}}" Value="Default">
                                                <Setter Property="CornerRadius" Value="2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource TemplatedParent}}" Value="Bottom">
                                                <Setter Property="CornerRadius" Value="0, 0, 2, 2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource TemplatedParent}}" Value="Top">
                                                <Setter Property="CornerRadius" Value="2, 2, 0, 0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource TemplatedParent}}" Value="Left">
                                                <Setter Property="CornerRadius" Value="2, 0, 0, 2" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Position, RelativeSource={RelativeSource TemplatedParent}}" Value="Right">
                                                <Setter Property="CornerRadius" Value="0, 2, 2, 0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>

                            <Border x:Name="sliderBorder" Background="Transparent">
                                <Border.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=borderMask}" />
                                </Border.OpacityMask>

                                <Track>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
                                            x:Name="RBD"
                                            Command="{x:Static Slider.DecreaseLarge}"
                                            Style="{StaticResource RepeatButtonDecrease}" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton
                                            x:Name="RBI"
                                            Command="{x:Static Slider.IncreaseLarge}"
                                            Style="{StaticResource RepeatButtonIncrease}" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>

                            <TextBlock
                                x:Name="sliderName"
                                Padding="8,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Text="{TemplateBinding Caption}" />

                            <Label
                                x:Name="textDisplay"
                                Padding="0,0,8,0"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Value, Converter={StaticResource DoubleToString}}"
                                ContentStringFormat="{}{0:0.000}" />

                            <Controls:NumericInput
                                x:Name="textInput"
                                Height="{TemplateBinding ActualHeight}"
                                IsEditing="{Binding IsEditing, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                Minimum="{Binding Minimum, RelativeSource={RelativeSource TemplatedParent}}"
                                Maximum="{Binding Maximum, RelativeSource={RelativeSource TemplatedParent}}" />

                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>

                        <DataTrigger Binding="{Binding Path=IsEditing, RelativeSource={RelativeSource Self}}" Value="False">
                            <Setter TargetName="sliderName" Property="Visibility" Value="Visible" />
                            <Setter TargetName="textDisplay" Property="Visibility" Value="Visible" />
                            <Setter TargetName="sliderBorder" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <DataTrigger Binding="{Binding Path=IsEditing, RelativeSource={RelativeSource Self}}" Value="True">
                            <Setter TargetName="sliderName" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="textDisplay" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="sliderBorder" Property="Visibility" Value="Hidden" />
                        </DataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RBD" Property="Style" Value="{DynamicResource RepeatButtonDecreaseOver}" />
                            <Setter TargetName="RBI" Property="Style" Value="{DynamicResource RepeatButtonIncreaseOver}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="mainBorder" Property="Opacity" Value="0.5" />
                        </Trigger>

                        <Trigger Property="IsMouseCaptured" Value="True">
                            <Setter TargetName="RBI" Property="Style" Value="{DynamicResource RepeatButtonIncreaseDown}" />
                        </Trigger>

                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>