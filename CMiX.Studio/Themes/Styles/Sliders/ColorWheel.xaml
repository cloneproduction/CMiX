<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl"
    xmlns:Converters="clr-namespace:CMiX.Studio.Converters"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Studio;component/Themes/Basic/Converters.xaml" />
        <ResourceDictionary Source="pack://application:,,,/CMiX.Studio;component/Themes/Basic/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ColorWheelStyle" TargetType="{x:Type Controls:ColorWheel}">
        <Setter Property="AttachedProperties:MouseDownHelper.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:ColorWheel}">

                    <Grid Margin="5">

                        <Ellipse
                            x:Name="PART_BlackEllipse"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Fill="Black"
                            Stretch="Uniform"
                            StrokeThickness="0" />

                        <Ellipse
                            Name="PART_SpectrumEllipse"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Stretch="Uniform"
                            StrokeThickness="0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{StaticResource ColorWheel}" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <Canvas>
                            <Ellipse
                                Name="PART_CursorEllipse"
                                Width="12"
                                Height="12"
                                Fill="Transparent"
                                Stroke="White"
                                StrokeThickness="1">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="-5" Y="-4" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="AttachedProperties:MouseDownHelper.IsMouseLeftButtonDown" Value="True">
                            <Setter Property="Cursor" Value="None" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>


    <Style x:Key="ValueSliderVertical" TargetType="{x:Type Controls:ColorPickerSlider}">
        <Setter Property="Maximum" Value="255" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="AttachedProperties:MouseDownHelper.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:ColorPickerSlider}">
                    <Border
                        x:Name="sliderBorder"
                        BorderBrush="Black"
                        BorderThickness="1"
                        CornerRadius="2">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="White" />
                                <GradientStop Offset="1" Color="Black" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Track
                            x:Name="PART_Track"
                            Grid.Row="1"
                            Margin="0">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Style="{DynamicResource SliderRepeatButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Style="{DynamicResource SliderRepeatButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Part_Thumb" Style="{DynamicResource ValueSliderVerticalThumbStyle}" />
                            </Track.Thumb>
                        </Track>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="AttachedProperties:MouseDownHelper.IsMouseLeftButtonDown" Value="True">
                            <Setter Property="Cursor" Value="None" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ValueSliderVerticalThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Rectangle
                            Height="8"
                            Fill="Transparent"
                            Stroke="Black"
                            StrokeThickness="1" />
                        <Rectangle
                            Height="10"
                            Fill="Transparent"
                            Stroke="White"
                            StrokeThickness="1" />
                    </Grid>

                    <!--<Ellipse
                        Name="PART_CursorEllipse"
                        Width="6"
                        Height="6"
                        Fill="White"
                        Stroke="Black"
                        StrokeThickness="1" />-->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>




</ResourceDictionary>