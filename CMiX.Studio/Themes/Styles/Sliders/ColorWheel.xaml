<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Studio;component/Themes/Basic/Converters.xaml" />
        <ResourceDictionary Source="pack://application:,,,/CMiX.Studio;component/Themes/Basic/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ColorWheelStyle" TargetType="{x:Type Controls:ColorWheel}">
        <Setter Property="AttachedProperties:MouseDownHelper.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:ColorWheel}">

                    <Grid Margin="5">

                        <Ellipse
                            x:Name="PART_BlackEllipse"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Fill="Black"
                            Stretch="Uniform"
                            StrokeThickness="0" />

                        <Ellipse
                            Name="PART_SpectrumEllipse"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Opacity="{Binding Path=ColorState.HSV_V, RelativeSource={RelativeSource TemplatedParent}}"
                            Stretch="Uniform"
                            StrokeThickness="0">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{StaticResource ColorWheel}" />
                            </Ellipse.Fill>
                        </Ellipse>

                        <Canvas>
                            <Ellipse
                                Name="PART_CursorEllipse"
                                Width="12"
                                Height="12"
                                Fill="{Binding Path=SelectedColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorToBrush}, ConverterParameter='all'}"
                                Stroke="Black"
                                StrokeThickness="0.2">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="-5" Y="-4" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Canvas>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="AttachedProperties:MouseDownHelper.IsMouseLeftButtonDown" Value="True">
                            <Setter Property="Cursor" Value="None" />
                            <Setter TargetName="PART_CursorEllipse" Property="RenderTransform">
                                <Setter.Value>
                                    <TransformGroup>
                                        <TranslateTransform X="-6" Y="-6" />
                                        <ScaleTransform ScaleX="1.5" ScaleY="1.5" />
                                    </TransformGroup>

                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>


    <Style x:Key="ValueSliderVertical" TargetType="{x:Type Controls:CMiXSlider}">
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="AttachedProperties:MouseDownHelper.IsEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:CMiXSlider}">
                    <Grid>
                        <Border
                            x:Name="sliderBorder"
                            BorderBrush="Black"
                            BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="White" />
                                    <GradientStop Offset="1" Color="Black" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Track x:Name="PART_Track" Margin="-1,-5">
                                <Track.Thumb>
                                    <Thumb x:Name="Part_Thumb" Style="{DynamicResource ValueSliderVerticalThumbStyle}" />
                                </Track.Thumb>
                            </Track>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="AttachedProperties:MouseDownHelper.IsMouseLeftButtonDown" Value="True">
                            <Setter Property="Cursor" Value="None" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>



    <Style x:Key="ValueSliderVerticalThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Rectangle
                            Height="9"
                            Fill="Black"
                            Stroke="White"
                            StrokeThickness="0.5" />
                        <Rectangle
                            Height="10"
                            Fill="White"
                            Opacity="{Binding Path=ColorState.HSV_V, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Controls:StandardColorPicker}}}"
                            Stroke="Black"
                            StrokeThickness="0.5" />

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>