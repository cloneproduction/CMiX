<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Prefabs="clr-namespace:CMiX.Core.Prefabs;assembly=CMiX.Core"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Studio;component/Themes/Basic/Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="NoFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListBoxResizeBorderStyle" TargetType="{x:Type Border}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Cursor" Value="SizeNS" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ServerConnectionIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="Red" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=ClientIsConnected}" Value="True">
                <Setter Property="Fill" Value="Green" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ServerEditableTextBoxStyle" TargetType="{x:Type Controls:EditableTextBox}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Converter={StaticResource DataToType}}" Value="{x:Type Prefabs:EmptyPrefab}">
                <Setter Property="IsEnabled" Value="False" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LayerListBoxItemBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="BorderThickness" Value="1,0,1,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shadow}" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Grey500Brush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type Controls:CMiXListBox}">
        <Setter Property="ItemContainerStyle" Value="{DynamicResource ListBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:CMiXListBox}">
                    <Border
                        x:Name="outerBorder"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        BorderThickness="0.5"
                        BorderBrush="{DynamicResource Grey400Brush}">
                        <DockPanel>

                            <Border
                                x:Name="resizeBorder"
                                Height="12"
                                Background="{DynamicResource ListBoxBackground}"
                                DockPanel.Dock="Bottom"
                                Style="{StaticResource ListBoxResizeBorderStyle}">
                                <Image
                                    Margin="1"
                                    IsHitTestVisible="False"
                                    Opacity="0.25"
                                    Source="{DynamicResource DragHandler}" />
                            </Border>

                            <Border
                                x:Name="Bd"
                                MinHeight="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MinHeight}"
                                Background="{DynamicResource ListBoxBackground}"
                                CornerRadius="{DynamicResource CornerRadiusAll}"
                                SnapsToDevicePixels="True">
                                <ScrollViewer
                                    Margin="2"
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                            </Border>

                        </DockPanel>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="outerBorder" Property="BorderBrush" Value="{DynamicResource Grey600Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ListBox}">
        <Setter Property="ItemContainerStyle" Value="{DynamicResource ListBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border
                        x:Name="Bd"
                        Background="{DynamicResource ListBoxBackground}"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer
                            Margin="2"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="{DynamicResource ControlHeightMD}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border
                        x:Name="Bd"
                        Margin="1"
                        Padding="2,0,0,0"
                        Background="Transparent"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        SnapsToDevicePixels="True"
                        TextBlock.Foreground="{DynamicResource ForegroundBrush}">
                        <ContentPresenter Margin="0,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Grey400Brush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ServerListBoxItemStyle"
           BasedOn="{StaticResource ListBoxItemStyle}"
           TargetType="{x:Type ListBoxItem}">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border
                        x:Name="Bd"
                        Margin="1"
                        Padding="2,0,0,0"
                        Background="Transparent"
                        CornerRadius="{DynamicResource CornerRadiusAll}"
                        SnapsToDevicePixels="True"
                        TextBlock.Foreground="{DynamicResource ForegroundBrush}">
                        <DockPanel>
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="4,0"
                                Style="{StaticResource ServerConnectionIndicatorStyle}" />
                            <ToggleButton
                                Height="{DynamicResource ControlHeightXS}"
                                Margin="4"
                                Padding="4"
                                DockPanel.Dock="Right"
                                IsChecked="{Binding ServerIsRunning}"
                                Style="{DynamicResource TogglePlayPause}" />
                            <Controls:EditableTextBox
                                x:Name="editableTextBox"
                                Height="{DynamicResource ControlHeightSM}"
                                Foreground="{DynamicResource ForegroundBrush}"
                                Style="{StaticResource ServerEditableTextBoxStyle}"
                                Text="{Binding Path=PrefabService.Name.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Grey500Brush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListBoxItemAlternationStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="MainContainer" Padding="2">
                        <Border
                            x:Name="Bd"
                            Padding="4,0,0,0"
                            Background="Transparent"
                            SnapsToDevicePixels="True"
                            TextBlock.Foreground="{DynamicResource ForegroundBrush}">
                            <ContentPresenter />
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                            <Setter TargetName="MainContainer" Property="Background" Value="{DynamicResource ListBoxBackground}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainContainer" Property="Background" Value="{DynamicResource Grey500Brush}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="TextBlock.Foreground" Value="{DynamicResource ActiveForegroundBrush}" />
                            <Setter TargetName="MainContainer" Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LayerListBoxItemStyle"
           BasedOn="{StaticResource ListBoxItemStyle}"
           TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="1,0,0,0" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border Name="Bd" Style="{StaticResource LayerListBoxItemBorderStyle}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentInactiveBrush}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="False" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Grey400Brush}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LayerListBoxStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="{DynamicResource ListBoxBackground}" />
        <Setter Property="ItemContainerStyle" Value="{DynamicResource LayerListBoxItemStyle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <ScrollViewer
                            Focusable="False"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>