<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Studio.Views.BaseControl">

    <Style TargetType="{x:Type Controls:NumericInput}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Visibility" Value="Hidden" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Controls:NumericInput}">
                    <Border Background="{DynamicResource Grey100Brush}">
                        <TextBox
                        x:Name="PART_TextBox"
                        Height="{TemplateBinding ActualHeight}"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Left"
                        VerticalContentAlignment="Center"
                        Padding="8,0"
                        Foreground="{DynamicResource ForegroundBrush}"
                        SelectionBrush="{DynamicResource SuperHighGrey700Brush}"
                        CaretBrush="{DynamicResource ForegroundBrush}"
                        Background="Transparent"
                        BorderThickness="0">
                            <TextBox.Style>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="Text" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat='{}{0:N3}'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInteger, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                            <Setter Property="Text" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, StringFormat='{}{0:N0}'}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>