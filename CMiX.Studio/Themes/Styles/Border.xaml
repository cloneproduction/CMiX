<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:AttachedProperties="clr-namespace:CMiX.Studio.AttachedProperties">

    <Style x:Key="BorderMask" TargetType="{x:Type Border}">
        <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusAll}" />

        <Style.Triggers>
            <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Top">
                <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusTop}" />
            </Trigger>
            <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Bottom">
                <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusBottom}" />
            </Trigger>
            <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Middle">
                <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusNone}" />
            </Trigger>
            <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Left">
                <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusLeft}" />
            </Trigger>
            <Trigger Property="AttachedProperties:PositionedControl.Position" Value="Right">
                <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusRight}" />
            </Trigger>
            <Trigger Property="AttachedProperties:PositionedControl.Position" Value="None">
                <Setter Property="CornerRadius" Value="{DynamicResource CornerRadiusNone}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>