<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Controls="clr-namespace:CMiX.Core.Controls"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CMiX.Studio;component/Themes/Styles/ToggleButton.xaml" />
        <ResourceDictionary Source="pack://application:,,,/CMiX.Studio;component/Themes/Styles/Button.xaml" />
        <ResourceDictionary Source="pack://application:,,,/CMiX.Studio;component/Themes/Basic/Icons.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="ModifierExpanderToggleStyle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border
                        x:Name="mainBorder"
                        Height="20"
                        Background="Transparent">
                        <Grid SnapsToDevicePixels="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="19" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path
                                x:Name="arrow"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 1,1.5 L 4.5,5 L 8,1.5"
                                SnapsToDevicePixels="false"
                                Stroke="{DynamicResource HighLightColor}"
                                StrokeThickness="2" />
                            <ContentPresenter
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                SnapsToDevicePixels="True" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter TargetName="arrow" Property="Data" Value="M 1,4.5  L 4.5,1  L 8,4.5" />
                            <Setter TargetName="mainBorder" Property="CornerRadius" Value="{DynamicResource CornerRadiusTop}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModifierCloseButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource DarkColor}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBase}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Template">
            <Setter.Value>

                <ControlTemplate TargetType="{x:Type Button}">

                    <Border
                        x:Name="border"
                        Padding="4"
                        Background="Transparent"
                        CornerRadius="0, 4, 0, 0"
                        SnapsToDevicePixels="True">
                        <Image
                            x:Name="image"
                            Opacity="0.6"
                            Source="{DynamicResource CloseTab}" />
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="image" Property="Opacity" Value="1.0" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="image" Property="Opacity" Value="1.0" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>

            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="DragHandlerButton"
        BasedOn="{StaticResource {x:Type Button}}"
        TargetType="{x:Type Button}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="border"
                        Width="22"
                        Margin="0"
                        Padding="4"
                        Background="Transparent"
                        Opacity="0.6"
                        SnapsToDevicePixels="True">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <ContentPresenter ContentTemplate="{TemplateBinding Content}" />
                        </Viewbox>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="ModifierExpanderTemplate" TargetType="{x:Type Expander}">
        <Border
            Background="{DynamicResource HighDarkerColor}"
            BorderBrush="{DynamicResource HighHighDarkerColor}"
            BorderThickness="0,1,0,0"
            CornerRadius="4"
            SnapsToDevicePixels="true">
            <DockPanel>

                <DockPanel DockPanel.Dock="Top">


                    <ToggleButton
                        x:Name="HeaderSite"
                        MinWidth="0"
                        MinHeight="0"
                        HorizontalContentAlignment="Left"
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                        DockPanel.Dock="Left"
                        Foreground="{DynamicResource TextBase}"
                        IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{DynamicResource ModifierExpanderToggleStyle}" />

                </DockPanel>

                <Border
                    x:Name="PresenterBorder"
                    BorderBrush="{DynamicResource DarkerColor}"
                    BorderThickness="0,1,0,0"
                    DockPanel.Dock="Top">
                    <Border BorderBrush="{DynamicResource HighHighDarkerColor}" BorderThickness="0,1,0,0">
                        <ContentPresenter
                            x:Name="ExpandSite"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            DockPanel.Dock="Bottom"
                            Focusable="false"
                            Visibility="Collapsed" />
                    </Border>

                </Border>
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="true">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                <Setter TargetName="PresenterBorder" Property="BorderThickness" Value="0,1,0,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="ModifierPanelTemplate" TargetType="{x:Type Expander}">
        <Border
            x:Name="border"
            Background="{DynamicResource HighDarkerColor}"
            BorderBrush="{DynamicResource Shadow}"
            BorderThickness="1,0,1,2"
            CornerRadius="4"
            SnapsToDevicePixels="true">
            <DockPanel>

                <DockPanel DockPanel.Dock="Top">

                    <Border
                        Width="25"
                        Height="22"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Right">

                        <Button
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource DragHandlerButton}">
                            <Button.Content>
                                <Image Opacity="0.25" Source="{DynamicResource DragHandler}" />
                            </Button.Content>
                            <i:Interaction.Triggers>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.DragHandlerDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </i:EventTrigger>
                                <i:EventTrigger EventName="PreviewMouseLeftButtonUp">
                                    <i:InvokeCommandAction Command="{Binding Path=DataContext.DragHandlerUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </i:EventTrigger>
                            </i:Interaction.Triggers>
                        </Button>
                    </Border>

                    <Button
                        Width="25"
                        Height="22"
                        Command="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=DataContext.RemoveCommand}"
                        CommandParameter="{Binding}"
                        DockPanel.Dock="Right"
                        Style="{DynamicResource ModifierCloseButtonStyle}" />

                    <ToggleButton
                        Width="25"
                        Height="22"
                        DockPanel.Dock="Right"
                        IsChecked="{Binding DataContext.Visible.IsChecked, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{StaticResource ToggleModifierVisibility}" />

                    <ToggleButton
                        x:Name="HeaderSite"
                        MinWidth="0"
                        MinHeight="0"
                        HorizontalContentAlignment="Left"
                        Content="{TemplateBinding Header}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                        DockPanel.Dock="Left"
                        Foreground="{DynamicResource TextBase}"
                        IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                        Style="{DynamicResource ModifierExpanderToggleStyle}" />

                </DockPanel>



                <Border
                    x:Name="PresenterBorder"
                    BorderBrush="{DynamicResource DarkColor}"
                    BorderThickness="0,1,0,0"
                    DockPanel.Dock="Top">
                    <Border BorderBrush="{DynamicResource HighHighDarkerColor}" BorderThickness="0,1,0,0">
                        <ContentPresenter
                            x:Name="ExpandSite"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            DockPanel.Dock="Bottom"
                            Focusable="false"
                            Visibility="Collapsed" />
                    </Border>

                </Border>
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="true">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                <Setter TargetName="PresenterBorder" Property="BorderThickness" Value="0,1,0,0" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </Trigger>
            <!--<Trigger Property="IsMouseOver" Value="true">
                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource Accent}"/>
            </Trigger>-->
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>