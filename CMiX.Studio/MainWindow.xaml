<Window
    x:Class="CMiX.Studio.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Controls="clr-namespace:CMiX.Core.Presentation.Controls;assembly=CMiX.Core"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:Beat="clr-namespace:CMiX.Studio.Views.Beat"
    xmlns:ComponentViews="clr-namespace:CMiX.Studio.Views.Component"
    xmlns:Menus="clr-namespace:CMiX.Studio.Views.Menus"
    xmlns:Scheduling="clr-namespace:CMiX.Studio.Views.Scheduler"
    xmlns:Windows="clr-namespace:CMiX.Studio.Views.Windows" xmlns:BaseControls="clr-namespace:CMiX.Studio.Views.BaseControl" xmlns:managers="clr-namespace:CMiX.Studio.Views.Managers"
    Focusable="True"
    Title="C-MiX Studio"
    Width="400"
    Height="1000"
    Style="{StaticResource MainWindowStyle}"
    mc:Ignorable="d">

    <Window.Resources>
        <Controls:AnimatedDouble x:Key="AnimatedDouble0"/>


            <ObjectDataProvider x:Key="ControlPanelNames" MethodName="GetValues" ObjectType="{x:Type BaseControls:ControlPanelNames}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="BaseControls:ControlPanelNames"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

    </Window.Resources>
    <Window.InputBindings>

        <KeyBinding 
            Modifiers="Ctrl"
            Key="O" 
            Command="{Binding OpenProjectCommand}" />
        <KeyBinding 
            Modifiers="Ctrl"
            Key="S" 
            Command="{Binding SaveProjectCommand}" />
        <KeyBinding 
            Modifiers="Ctrl+Shift"
            Key="S" 
            Command="{Binding SaveAsProjectCommand}" />
        <KeyBinding 
            Key="D1"
            Command="{Binding KeyPressedCommand}" CommandParameter="{x:Static Key.D1}"/>
        <KeyBinding 
            Key="D2"
            Command="{Binding KeyPressedCommand}" CommandParameter="{x:Static Key.D2}"/>
        <KeyBinding 
            Key="D3"
            Command="{Binding KeyPressedCommand}" CommandParameter="{x:Static Key.D3}"/>
        <KeyBinding 
            Key="D4"
            Command="{Binding KeyPressedCommand}" CommandParameter="{x:Static Key.D4}"/>
        <KeyBinding 
            Key="D5"
            Command="{Binding KeyPressedCommand}" CommandParameter="{x:Static Key.D5}"/>

    </Window.InputBindings>


    <Border Background="{DynamicResource HighHighDarkerColor}">
        <DockPanel>

            <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource HighHighDarkerColor}" Background="{DynamicResource DarkerColor}">
                <DockPanel LastChildFill="False">
                    
                    <Windows:MainWindowController 
                        DataContext="{Binding MainWindowController}"
                        DockPanel.Dock="Right"/>
                    
                    <Menus:MainMenu 
                        DataContext="{Binding MainMenu}"
                        DockPanel.Dock="Left"/>
                    
                </DockPanel>
            </Border>

            <Border BorderBrush="{DynamicResource SuperHighDarkerColor}" BorderThickness="2" DockPanel.Dock="Bottom" Background="{DynamicResource HighDarkerColor}">
                <StackPanel>

                    <Grid Margin="8" Height="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            Style="{StaticResource ComboBoxRounded}"
                            Margin="0, 0, 2, 0"
                            SelectedValue="{Binding Project.CompositionManager.SelectedItem.Prefab.MasterBeat}"
                            SelectedValuePath="Prefab"
                            ItemsSource="{Binding Project.CompositionService.MasterBeatManager.Prefabs}">
                            <ComboBox.ItemTemplate>
                                <ItemContainerTemplate>
                                    <TextBlock Text="{Binding Name}"/>
                                </ItemContainerTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <DockPanel Grid.Column="1">

                            <Button
                                Margin="2, 0, 0, 0"
                                Background="Transparent"
                                Style="{StaticResource ButtonRounded}"
                                Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                Command="{Binding Project.CompositionManager.SelectedItem.Prefab.MasterBeat.Resync.ResyncCommand}"
                                DockPanel.Dock="Right">
                                <Button.Content>
                                    <Image Margin="16" Source="{StaticResource Reset}"/>
                                </Button.Content>
                            </Button>

                            <ToggleButton
                                Background="Transparent"
                                Style="{StaticResource ToggleButtonRounded}"
                                Margin="2, 0"
                                Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                IsChecked="{Binding  Project.CompositionManager.SelectedItem.Prefab.MasterBeat.Pause.IsChecked}"
                                Content="P"
                                DockPanel.Dock="Right"/>

                            <Button
                                Background="Transparent"
                                Margin="2, 0"
                                Style="{StaticResource ButtonRounded}"
                                Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                Command="{Binding  Project.CompositionManager.SelectedItem.Prefab.MasterBeat.DivideCommand}"
                                Content="-"
                                DockPanel.Dock="Right"/>

                            <Button
                                Margin="2, 0"
                                Background="Transparent"
                                Style="{StaticResource ButtonRounded}"
                                Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}"
                                Command="{Binding  Project.CompositionManager.SelectedItem.Prefab.MasterBeat.MultiplyCommand}"
                                Content="+"
                                DockPanel.Dock="Right"/>

                            <Button
                                Margin="2, 0"
                                DockPanel.Dock="Right"
                                Width="50"
                                Background="Transparent"
                                Style="{StaticResource ButtonRounded}"
                                Command="{Binding  Project.CompositionManager.SelectedItem.Prefab.MasterBeat.TapCommand}"
                                Content="TAP"/>

                            <Grid Margin="2, 0">
                                <Border 
                                    CornerRadius="2"
                                    Background="{DynamicResource Color}"
                                    Opacity="{Binding Project.CompositionManager.SelectedItem.Prefab.MasterBeat.AnimatedDouble.AnimationPosition}"/>
                                <TextBlock 
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextBase}" 
                                    Text="{Binding  Project.CompositionManager.SelectedItem.Prefab.MasterBeat.Period, Converter={StaticResource PeriodToBPM}, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat=F0}" />
                            </Grid>
                        </DockPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource SuperHighDarkerColor}" BorderThickness="2, 2, 2, 0">
                <TabControl DockPanel.Dock="Top" VerticalAlignment="Stretch" Style="{StaticResource TabControlLayerPanel}">

                    <TabItem Style="{StaticResource TabItemVerticalPanel}">
                        <TabItem.Header>
                            <Image Margin="8" ToolTip="Assets" Source="{StaticResource LayerScene}" />
                        </TabItem.Header>
                        <DockPanel>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.4*"/>
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="1"
                                    Background="{DynamicResource HighDarkerColor}"
                                    BorderBrush="{DynamicResource SuperHighDarkerColor}"
                                    BorderThickness="0, 2, 0, 0"
                                    Visibility="{Binding Project.CompositionManager.SelectedItem.Prefab.LayerManager.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                                    <ComponentViews:Layer Margin="0, 8, 0, 0" DataContext="{Binding Project.CompositionManager.SelectedItem.Prefab.LayerManager.SelectedItem.Prefab}"/>
                                </Border>

                                <Views:LayerManager 
                                    Grid.Row="0"  
                                    DataContext="{Binding Project.CompositionManager.SelectedItem.Prefab.LayerManager}"/>

                                <GridSplitter 
                                    Grid.Row="0" 
                                    VerticalAlignment="Bottom" 
                                    Margin="0, -4" 
                                    Height="8" 
                                    Style="{StaticResource GridSplitter}"/>
                            </Grid>

                        </DockPanel>
                    </TabItem>

                    <TabItem>
                        
                        <TabItem.Header>
                            <Image Margin="8" ToolTip="Assets" Source="{StaticResource Beat}" />
                        </TabItem.Header>

                        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden">
                            <Border Background="{DynamicResource HighDarkerColor}">
                                <StackPanel>
                                    <Beat:BeatManager Margin="8" DataContext="{Binding Project.CompositionService.MasterBeatManager}"/>
                                    <Expander Header="Modifiers">
                                        <Views:TextureFilter  DataContext="{Binding Project.CompositionService.CompositionManager.SelectedItem.Prefab.ModifierManager}"/>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                        
                    </TabItem>



                    <TabItem>
                        <TabItem.Header>
                            <Image Margin="8" ToolTip="Assets" Source="{StaticResource Resources}" />
                        </TabItem.Header>
                        <Views:AssetManager DataContext="{Binding AssetManager}"/>
                    </TabItem>

                    <TabItem>
                        
                        <TabItem.Header>
                            <Image Margin="8" ToolTip="Assets" Source="{StaticResource Composition}" />
                        </TabItem.Header>
                        
                        <Border VerticalAlignment="Stretch" Background="{DynamicResource HighDarkerColor}">
                            <DockPanel>
                                <Views:Outliner VerticalAlignment="Top" DockPanel.Dock="Top" Margin="8" Grid.Column="1"  DataContext="{Binding Project.CompositionManager}"/>
                                <Panels:IndentedExpander DockPanel.Dock="Top" Header="Filter">
                                    <Views:TextureFilter  DataContext="{Binding Project.CompositionManager.SelectedItem.Prefab.TextureModifierManager}"/>
                                </Panels:IndentedExpander>
                                <Panels:IndentedExpander Header="Render Settings" DockPanel.Dock="Top">
                                    <ComponentViews:CompositionSettings DataContext="{Binding Project.CompositionManager.SelectedItem.Prefab.OutputSettings}"/>
                                </Panels:IndentedExpander>
                            </DockPanel>
                        </Border>

                    </TabItem>

                    <TabItem Style="{StaticResource TabItemVerticalPanel}">
                        
                        <TabItem.Header>
                            <Image Margin="8" ToolTip="Assets" Source="{StaticResource Network}" />
                        </TabItem.Header>
                        
                        <Border Background="{DynamicResource HighDarkerColor}">
                            <StackPanel>
                                <Views:ServerManager DataContext="{Binding ServerManager}"/>
                                <Scheduling:PlaylistEditor DataContext="{Binding PlaylistEditor}"/>
                                <Scheduling:SchedulerManager DataContext="{Binding SchedulerManager}"/>
                            </StackPanel>
                        </Border>

                    </TabItem>
                    
                </TabControl>
            </Border>

        </DockPanel>
    </Border>

</Window>