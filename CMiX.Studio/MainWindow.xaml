<Window
    x:Class="CMiX.Studio.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Beat="clr-namespace:CMiX.Studio.Views.Beat"
    xmlns:ComponentViews="clr-namespace:CMiX.Studio.Views.Component"
    xmlns:Menus="clr-namespace:CMiX.Studio.Views.Menus"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:Scheduling="clr-namespace:CMiX.Studio.Views.Scheduler"
    xmlns:Texture="clr-namespace:CMiX.Studio.Views.Texture"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:Windows="clr-namespace:CMiX.Studio.Views.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="400"
    Height="1000"
    Focusable="True"
    Style="{StaticResource MainWindowStyle}"
    mc:Ignorable="d">

    <Window.InputBindings>

        <KeyBinding
            Key="O"
            Command="{Binding OpenProjectCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="S"
            Command="{Binding SaveProjectCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="S"
            Command="{Binding SaveAsProjectCommand}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="D1"
            Command="{Binding KeyPressedCommand}"
            CommandParameter="{x:Static Key.D1}" />
        <KeyBinding
            Key="D2"
            Command="{Binding KeyPressedCommand}"
            CommandParameter="{x:Static Key.D2}" />
        <KeyBinding
            Key="D3"
            Command="{Binding KeyPressedCommand}"
            CommandParameter="{x:Static Key.D3}" />
        <KeyBinding
            Key="D4"
            Command="{Binding KeyPressedCommand}"
            CommandParameter="{x:Static Key.D4}" />
        <KeyBinding
            Key="D5"
            Command="{Binding KeyPressedCommand}"
            CommandParameter="{x:Static Key.D5}" />

    </Window.InputBindings>


    <Border Background="{DynamicResource HighHighDarkerColor}">
        <DockPanel>

            <Border Background="{DynamicResource SuperHighDarkerColor}" DockPanel.Dock="Top">

                <DockPanel LastChildFill="False">

                    <Windows:MainWindowController DataContext="{Binding MainWindowController}" DockPanel.Dock="Right" />

                    <Menus:MainMenu DataContext="{Binding MainMenu}" DockPanel.Dock="Left" />

                </DockPanel>
            </Border>

            <Border
                Height="30"
                Background="{DynamicResource SuperHighDarkerColor}"
                BorderBrush="{DynamicResource SuperHighDarkerColor}"
                BorderThickness="2,0,2,2"
                DockPanel.Dock="Bottom">

                <DockPanel LastChildFill="False" Opacity="0.5">

                    <TextBlock
                        Padding="8"
                        DockPanel.Dock="Right"
                        Text="CMiX" />

                    <TextBlock
                        Padding="8"
                        DockPanel.Dock="Left"
                        Text="CloneProduction" />

                </DockPanel>

            </Border>

            <Border
                Padding="8"
                Background="{DynamicResource HighDarkerColor}"
                BorderBrush="{DynamicResource SuperHighDarkerColor}"
                BorderThickness="2,0"
                DockPanel.Dock="Bottom">

                <Beat:MasterBeatControl DataContext="{Binding Project.CompositionManager.ManagerData.SelectedItem.MasterBeat}" />

            </Border>

            <Border BorderBrush="{DynamicResource SuperHighDarkerColor}" BorderThickness="2,2,2,0">

                <TabControl
                    VerticalAlignment="Stretch"
                    DockPanel.Dock="Top"
                    Style="{StaticResource TabControlLayerPanel}">

                    <TabItem>

                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource Composition}"
                                ToolTip="Assets" />
                        </TabItem.Header>

                        <Border
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource HighDarkerColor}"
                            BorderBrush="{DynamicResource SuperHighDarkerColor}"
                            BorderThickness="0,1,0,0">

                            <DockPanel>

                                <Views:Outliner
                                    Grid.Column="1"
                                    Margin="8"
                                    VerticalAlignment="Top"
                                    DataContext="{Binding Project.CompositionManager}"
                                    DockPanel.Dock="Top" />

                                <Border Visibility="{Binding Project.CompositionManager.ManagerData.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                                    <StackPanel>

                                        <Panels:IndentedExpander DockPanel.Dock="Top" Header="Filters">
                                            <Views:ModifierManager DataContext="{Binding Project.CompositionManager.ManagerData.SelectedItem.ModifierManager}">
                                                <Views:ModifierManager.SelectionPanel>
                                                    <Texture:TextureFilterSelectionPanel DataContext="{Binding}" />
                                                </Views:ModifierManager.SelectionPanel>
                                            </Views:ModifierManager>
                                        </Panels:IndentedExpander>

                                        <Panels:IndentedExpander DockPanel.Dock="Top" Header="Settings">
                                            <ComponentViews:CompositionSettings Margin="8" DataContext="{Binding Project.CompositionManager.ManagerData.SelectedItem.OutputSettings}" />
                                        </Panels:IndentedExpander>

                                    </StackPanel>
                                </Border>
                            </DockPanel>
                        </Border>

                    </TabItem>

                    <TabItem Style="{StaticResource TabItemVerticalPanel}">

                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource LayerScene}"
                                ToolTip="Assets" />
                        </TabItem.Header>

                        <Border Visibility="{Binding Project.CompositionManager.ManagerData.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.4*" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="1"
                                    Background="{DynamicResource HighDarkerColor}"
                                    BorderBrush="{DynamicResource SuperHighDarkerColor}"
                                    BorderThickness="0,2"
                                    Visibility="{Binding Project.CompositionManager.ManagerData.SelectedItem.LayerManager.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                                    <ComponentViews:Layer Margin="0,0,0,0" DataContext="{Binding Project.CompositionManager.ManagerData.SelectedItem.LayerManager.ManagerData.SelectedItem}" />
                                </Border>

                                <Views:LayerManager
                                    Grid.Row="0"
                                    BorderBrush="{DynamicResource SuperHighDarkerColor}"
                                    BorderThickness="0,2,0,0"
                                    DataContext="{Binding Project.CompositionManager.ManagerData.SelectedItem.LayerManager}" />

                                <GridSplitter
                                    Grid.Row="0"
                                    Height="8"
                                    Margin="0,-4"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource GridSplitter}" />
                            </Grid>
                        </Border>

                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource Resources}"
                                ToolTip="Assets" />
                        </TabItem.Header>
                        <Views:AssetManager DataContext="{Binding AssetManager}" />
                    </TabItem>

                    <TabItem Style="{StaticResource TabItemVerticalPanel}">

                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource Network}"
                                ToolTip="Assets" />
                        </TabItem.Header>

                        <Border Background="{DynamicResource HighDarkerColor}">
                            <StackPanel>
                                <Views:ServerManager DataContext="{Binding ServerManager}" />
                                <Scheduling:PlaylistEditor DataContext="{Binding PlaylistEditor}" />
                                <Scheduling:SchedulerManager DataContext="{Binding SchedulerManager}" />
                            </StackPanel>
                        </Border>

                    </TabItem>

                </TabControl>
            </Border>

        </DockPanel>
    </Border>

</Window>