<Window
    x:Class="CMiX.Studio.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:Animations="clr-namespace:CMiX.Core.Animations;assembly=CMiX.Core"
    xmlns:Modifiers="clr-namespace:CMiX.Core.Colors.Modifiers;assembly=CMiX.Core"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Materials="clr-namespace:CMiX.Core.Materials;assembly=CMiX.Core"
    xmlns:Prefabs="clr-namespace:CMiX.Core.Prefabs;assembly=CMiX.Core"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Texturing="clr-namespace:CMiX.Core.Texturing.Sources;assembly=CMiX.Core"
    xmlns:Behaviors="clr-namespace:CMiX.Studio.Behaviors"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:Beat="clr-namespace:CMiX.Studio.Views.Beat"
    xmlns:Menus="clr-namespace:CMiX.Studio.Views.Menus"
    xmlns:Windows="clr-namespace:CMiX.Studio.Views.Windows"
    Width="400"
    Height="1000"
    Focusable="True"
    Style="{StaticResource MainWindowStyle}"
    mc:Ignorable="d">

    <DockPanel Background="{DynamicResource Grey200Brush}" LastChildFill="True">

        <Border Background="{DynamicResource Grey100Brush}" DockPanel.Dock="Top">

            <DockPanel LastChildFill="False">

                <Windows:MainWindowController DataContext="{Binding MainWindowController}" DockPanel.Dock="Right" />

                <Menus:MainMenu DataContext="{Binding MainMenu}" DockPanel.Dock="Left" />

            </DockPanel>
        </Border>

        <Border
            Height="{DynamicResource ControlHeightXL}"
            Background="{DynamicResource Grey100Brush}"
            BorderBrush="{DynamicResource Grey100Brush}"
            BorderThickness="2,0,2,2"
            DockPanel.Dock="Bottom">

            <DockPanel LastChildFill="False" Opacity="0.5">

                <TextBlock
                    Padding="8"
                    DockPanel.Dock="Left"
                    Text="CMiX Studio" />

                <TextBlock
                    Padding="8"
                    DockPanel.Dock="Right"
                    Text="CloneProduction" />

            </DockPanel>

        </Border>

        <Border
            Padding="8"
            Background="{DynamicResource Grey300Brush}"
            BorderBrush="{DynamicResource Grey100Brush}"
            BorderThickness="2,0"
            DockPanel.Dock="Bottom">

            <Beat:MasterBeatControl DataContext="{Binding Project.MasterBeat}" />

        </Border>

        <TabControl
            Grid.Column="1"
            VerticalAlignment="Stretch"
            DockPanel.Dock="Top"
            Style="{StaticResource TabControlLayerPanel}">

            <TabItem Style="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{StaticResource Composition}"
                        ToolTip="Assets" />
                </TabItem.Header>
                <ScrollViewer>
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>
                    <DockPanel>

                        <Views:Outliner
                            Margin="8"
                            VerticalAlignment="Top"
                            DataContext="{Binding Project.CompositionManager}"
                            DockPanel.Dock="Top"
                            ItemsSource="{Binding ControlRepository.Compositions}">

                            <Views:Outliner.SelectionPanel>
                                <Button
                                    Command="{Binding AddItemCommand}"
                                    CommandParameter="{x:Type Compositing:Composition}"
                                    Content="New Composition"
                                    Style="{DynamicResource ButtonRoundedRight}" />
                            </Views:Outliner.SelectionPanel>

                        </Views:Outliner>

                        <Views:Composition DataContext="{Binding Project.CompositionManager.SelectedItem}" Visibility="{Binding Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}" />

                    </DockPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Style="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{StaticResource LayerScene}"
                        ToolTip="Assets" />
                </TabItem.Header>

                <Border Visibility="{Binding Project.CompositionManager.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.4*" />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <Border
                            Grid.Row="1"
                            Background="{DynamicResource Grey300Brush}"
                            BorderBrush="{DynamicResource Grey100Brush}"
                            BorderThickness="0,2"
                            Visibility="{Binding Project.CompositionManager.SelectedItem.LayerManager.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                            <Views:Layer Margin="0,0,0,0" DataContext="{Binding Project.CompositionManager.SelectedItem.LayerManager.SelectedItem}" />
                        </Border>

                        <Views:LayerManager
                            Grid.Row="0"
                            BorderBrush="{DynamicResource Grey100Brush}"
                            BorderThickness="0,2,0,0"
                            DataContext="{Binding Project.CompositionManager.SelectedItem.LayerManager}" />

                        <GridSplitter
                            Grid.Row="0"
                            Height="8"
                            Margin="0,-4"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource GridSplitter}" />
                    </Grid>
                </Border>

            </TabItem>

            <TabItem Style="{StaticResource TabItemHorizontal}">
                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{StaticResource Geometry}"
                        ToolTip="Assets" />
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>

                    <Border Background="{DynamicResource Grey300Brush}">
                        <StackPanel>

                            <Views:RepositoryManager
                                x:Name="EntitiesRepository"
                                DataContext="{Binding EntityManager}"
                                DockPanel.Dock="Top"
                                ItemsSource="{Binding DataContext.PrefabRepositories.Entities, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}">
                                <Views:RepositoryManager.SelectionPanel>
                                    <Button
                                        Command="{Binding AddItemCommand}"
                                        CommandParameter="{x:Type Compositing:Entity}"
                                        Content="New Entity" />
                                </Views:RepositoryManager.SelectionPanel>
                            </Views:RepositoryManager>

                            <ContentControl Content="{Binding}" DataContext="{Binding EntityManager.SelectedItem}">
                                <ContentControl.Resources>

                                    <DataTemplate DataType="{x:Type Compositing:Entity}">
                                        <Views:ModelEntity DataContext="{Binding}" />
                                    </DataTemplate>

                                    <!--<DataTemplate DataType="{x:Type Prefabs:EmptyPrefab}">
                                        <Border />
                                    </DataTemplate>-->

                                    <DataTemplate DataType="{x:Type Cameras:Camera}">
                                        <Views:Camera DataContext="{Binding}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type Lights:LightEntity}">
                                        <Views:LightEntity DataContext="{Binding}" />
                                    </DataTemplate>

                                </ContentControl.Resources>
                            </ContentControl>

                        </StackPanel>
                    </Border>

                </ScrollViewer>

            </TabItem>

            <TabItem Style="{StaticResource TabItemHorizontal}">
                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{StaticResource World}"
                        ToolTip="Material" />
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>

                    <Border Background="{DynamicResource Grey300Brush}">
                        <Views:RepositoryManager DataContext="{Binding MaterialManager}" ItemsSource="{Binding ControlRepository.Materials}">
                            <Views:RepositoryManager.SelectionPanel>
                                <Button
                                    Command="{Binding AddItemCommand}"
                                    CommandParameter="{x:Type Materials:Material}"
                                    Content="New Material" />
                            </Views:RepositoryManager.SelectionPanel>
                            <Views:RepositoryManager.EditingPanel>
                                <Views:Material DataContext="{Binding}" />
                            </Views:RepositoryManager.EditingPanel>
                        </Views:RepositoryManager>
                    </Border>

                </ScrollViewer>

            </TabItem>

            <TabItem Style="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{StaticResource Texture}"
                        ToolTip="Assets" />
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>
                    <Views:RepositoryManager
                        x:Name="repositoryManager"
                        Background="{DynamicResource Grey300Brush}"
                        DataContext="{Binding TextureManager}"
                        DockPanel.Dock="Top"
                        ItemsSource="{Binding ControlRepository.Textures}">
                        <Views:RepositoryManager.SelectionPanel>
                            <Views:ButtonOpenSelectionPanel Caption="New Texture">
                                <Views:ButtonOpenSelectionPanel.SelectionPanel>
                                    <Views:AutoSelectionPanel Interface="{x:Type Texturing:ITextureSource}" />
                                </Views:ButtonOpenSelectionPanel.SelectionPanel>
                            </Views:ButtonOpenSelectionPanel>
                        </Views:RepositoryManager.SelectionPanel>
                        <Views:RepositoryManager.EditingPanel>
                            <Views:Texture DataContext="{Binding}" />
                        </Views:RepositoryManager.EditingPanel>
                    </Views:RepositoryManager>
                </ScrollViewer>
            </TabItem>

            <TabItem Style="{StaticResource TabItemHorizontal}">
                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{StaticResource Camera}"
                        ToolTip="Assets" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>
                    <Border Background="{DynamicResource Grey300Brush}">
                        <Views:RepositoryManager
                            DataContext="{Binding CameraManager}"
                            DockPanel.Dock="Top"
                            ItemsSource="{Binding ControlRepository.Cameras}">
                            <Views:RepositoryManager.SelectionPanel>
                                <Button
                                    Command="{Binding AddItemCommand}"
                                    CommandParameter="{x:Type Cameras:Camera}"
                                    Content="New Camera" />
                            </Views:RepositoryManager.SelectionPanel>
                            <Views:RepositoryManager.EditingPanel>
                                <Views:Camera DataContext="{Binding}" />
                            </Views:RepositoryManager.EditingPanel>
                        </Views:RepositoryManager>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Style="{StaticResource TabItemHorizontal}">
                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{StaticResource MeshLight}"
                        ToolTip="Assets" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>
                    <Border Background="{DynamicResource Grey300Brush}">
                        <Views:RepositoryManager DataContext="{Binding LightManager}" ItemsSource="{Binding ControlRepository.Lights}">
                            <Views:RepositoryManager.SelectionPanel>
                                <Button
                                    Command="{Binding AddItemCommand}"
                                    CommandParameter="{x:Type Lights:LightEntity}"
                                    Content="New Light" />
                            </Views:RepositoryManager.SelectionPanel>
                            <Views:RepositoryManager.EditingPanel>
                                <Views:LightEntity DataContext="{Binding}" />
                            </Views:RepositoryManager.EditingPanel>
                        </Views:RepositoryManager>
                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Style="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{StaticResource Beat}"
                        ToolTip="BeatModifiers" />

                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>
                    <Border Background="{DynamicResource Grey300Brush}">
                        <Views:RepositoryManager DataContext="{Binding BeatManager}" ItemsSource="{Binding ControlRepository.BeatModifiers}">
                            <Views:RepositoryManager.SelectionPanel>
                                <Button
                                    Command="{Binding AddItemCommand}"
                                    CommandParameter="{x:Type Animations:BeatModifier}"
                                    Content="New Beat" />
                            </Views:RepositoryManager.SelectionPanel>
                            <Views:RepositoryManager.EditingPanel>
                                <Views:BeatModifier DataContext="{Binding}" />
                            </Views:RepositoryManager.EditingPanel>
                        </Views:RepositoryManager>
                    </Border>
                </ScrollViewer>

            </TabItem>

            <TabItem Style="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{StaticResource Coloration}"
                        ToolTip="Color Palette" />

                </TabItem.Header>


                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>
                    <Border Background="{DynamicResource Grey300Brush}">
                        <Views:RepositoryManager DataContext="{Binding ColorPaletteManager}" ItemsSource="{Binding ControlRepository.ColorPalettes}">
                            <Views:RepositoryManager.SelectionPanel>
                                <Button
                                    Command="{Binding AddItemCommand}"
                                    CommandParameter="{x:Type Modifiers:ColorPalette}"
                                    Content="New Palette" />
                            </Views:RepositoryManager.SelectionPanel>

                        </Views:RepositoryManager>
                    </Border>
                </ScrollViewer>

            </TabItem>

            <TabItem Style="{StaticResource TabItemHorizontal}">
                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{StaticResource Resources}"
                        ToolTip="Assets" />
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>
                    <Views:AssetManager DataContext="{Binding AssetManager}" />
                </ScrollViewer>
            </TabItem>

            <TabItem Style="{StaticResource TabItemHorizontal}">

                <TabItem.Header>
                    <Image
                        Margin="8"
                        Source="{StaticResource Network}"
                        ToolTip="Assets" />
                </TabItem.Header>

                <ScrollViewer VerticalScrollBarVisibility="Hidden">
                    <i:Interaction.Behaviors>
                        <Behaviors:ScrollViewerBehavior />
                    </i:Interaction.Behaviors>
                    <Views:ServerManagementPanel DataContext="{Binding ServerManager}" />
                </ScrollViewer>

            </TabItem>

        </TabControl>

    </DockPanel>

</Window>