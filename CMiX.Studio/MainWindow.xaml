<Window
    x:Class="CMiX.Studio.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Beat="clr-namespace:CMiX.Studio.Views.Beat"
    xmlns:Cameras="clr-namespace:CMiX.Core.Rendering.Cameras;assembly=CMiX.Core"
    xmlns:Compositing="clr-namespace:CMiX.Core.Compositing;assembly=CMiX.Core"
    xmlns:Entities="clr-namespace:CMiX.Studio.Views.Component.Entities"
    xmlns:Lights="clr-namespace:CMiX.Core.Rendering.Lights;assembly=CMiX.Core"
    xmlns:Menus="clr-namespace:CMiX.Studio.Views.Menus"
    xmlns:Panels="clr-namespace:CMiX.Studio.Views.BaseControl.Panels"
    xmlns:Prefabs="clr-namespace:CMiX.Core.Prefabs;assembly=CMiX.Core"
    xmlns:Scheduling="clr-namespace:CMiX.Studio.Views.Scheduler"
    xmlns:Views="clr-namespace:CMiX.Studio.Views"
    xmlns:Windows="clr-namespace:CMiX.Studio.Views.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="400"
    Height="1000"
    Focusable="True"
    Style="{StaticResource MainWindowStyle}"
    mc:Ignorable="d">

    <Window.InputBindings>

        <KeyBinding
            Key="O"
            Command="{Binding OpenProjectCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="S"
            Command="{Binding SaveProjectCommand}"
            Modifiers="Ctrl" />
        <KeyBinding
            Key="S"
            Command="{Binding SaveAsProjectCommand}"
            Modifiers="Ctrl+Shift" />
        <KeyBinding
            Key="D1"
            Command="{Binding KeyPressedCommand}"
            CommandParameter="{x:Static Key.D1}" />
        <KeyBinding
            Key="D2"
            Command="{Binding KeyPressedCommand}"
            CommandParameter="{x:Static Key.D2}" />
        <KeyBinding
            Key="D3"
            Command="{Binding KeyPressedCommand}"
            CommandParameter="{x:Static Key.D3}" />
        <KeyBinding
            Key="D4"
            Command="{Binding KeyPressedCommand}"
            CommandParameter="{x:Static Key.D4}" />
        <KeyBinding
            Key="D5"
            Command="{Binding KeyPressedCommand}"
            CommandParameter="{x:Static Key.D5}" />

    </Window.InputBindings>


    <Border Background="{DynamicResource HighHighDarkerColor}">
        <DockPanel>

            <Border Background="{DynamicResource SuperHighDarkerColor}" DockPanel.Dock="Top">

                <DockPanel LastChildFill="False">

                    <Windows:MainWindowController DataContext="{Binding MainWindowController}" DockPanel.Dock="Right" />

                    <Menus:MainMenu DataContext="{Binding MainMenu}" DockPanel.Dock="Left" />

                </DockPanel>
            </Border>

            <Border
                Height="30"
                Background="{DynamicResource SuperHighDarkerColor}"
                BorderBrush="{DynamicResource SuperHighDarkerColor}"
                BorderThickness="2,0,2,2"
                DockPanel.Dock="Bottom">

                <DockPanel LastChildFill="False" Opacity="0.5">

                    <TextBlock
                        Padding="8"
                        DockPanel.Dock="Right"
                        Text="CMiX" />

                    <TextBlock
                        Padding="8"
                        DockPanel.Dock="Left"
                        Text="CloneProduction" />

                </DockPanel>

            </Border>

            <Border
                Padding="8"
                Background="{DynamicResource HighDarkerColor}"
                BorderBrush="{DynamicResource SuperHighDarkerColor}"
                BorderThickness="2,0"
                DockPanel.Dock="Bottom">

                <Beat:MasterBeatControl DataContext="{Binding Project.CompositionManager.SelectedItem.MasterBeat}" />

            </Border>

            <Border BorderBrush="{DynamicResource SuperHighDarkerColor}" BorderThickness="2,2,2,0">

                <TabControl
                    Grid.Column="1"
                    VerticalAlignment="Stretch"
                    DockPanel.Dock="Top"
                    Style="{StaticResource TabControlLayerPanel}">

                    <TabItem>

                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource Composition}"
                                ToolTip="Assets" />
                        </TabItem.Header>

                        <Border
                            VerticalAlignment="Stretch"
                            Background="{DynamicResource HighDarkerColor}"
                            BorderBrush="{DynamicResource SuperHighDarkerColor}"
                            BorderThickness="0,1,0,0">

                            <DockPanel>

                                <Views:Outliner
                                    Grid.Column="1"
                                    Margin="8"
                                    VerticalAlignment="Top"
                                    DataContext="{Binding Project.CompositionManager}"
                                    DockPanel.Dock="Top"
                                    TypeParameter="{x:Type Compositing:CompositionModel}" />

                                <Views:Composition DataContext="{Binding Project.CompositionManager.SelectedItem}" Visibility="{Binding Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}" />

                            </DockPanel>
                        </Border>

                    </TabItem>

                    <TabItem Style="{StaticResource TabItemVerticalPanel}">

                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource LayerScene}"
                                ToolTip="Assets" />
                        </TabItem.Header>

                        <Border Visibility="{Binding Project.CompositionManager.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="0.4*" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>

                                <Border
                                    Grid.Row="1"
                                    Background="{DynamicResource HighDarkerColor}"
                                    BorderBrush="{DynamicResource SuperHighDarkerColor}"
                                    BorderThickness="0,2"
                                    Visibility="{Binding Project.CompositionManager.SelectedItem.LayerManager.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                                    <Views:Layer Margin="0,0,0,0" DataContext="{Binding Project.CompositionManager.SelectedItem.LayerManager.SelectedItem}" />
                                </Border>

                                <Views:LayerManager
                                    Grid.Row="0"
                                    BorderBrush="{DynamicResource SuperHighDarkerColor}"
                                    BorderThickness="0,2,0,0"
                                    DataContext="{Binding Project.CompositionManager.SelectedItem.LayerManager}" />

                                <GridSplitter
                                    Grid.Row="0"
                                    Height="8"
                                    Margin="0,-4"
                                    VerticalAlignment="Bottom"
                                    Style="{StaticResource GridSplitter}" />
                            </Grid>
                        </Border>

                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource Entity}"
                                ToolTip="Assets" />
                        </TabItem.Header>
                        <StackPanel>

                            <Views:RepositoryManager
                                x:Name="EntitiesRepository"
                                Margin="8"
                                DataContext="{Binding EntityManager}"
                                DockPanel.Dock="Top">

                                <Views:RepositoryManager.Resources>
                                    <CollectionViewSource x:Key="CamerasCollection" Source="{Binding Path=DataContext.PrefabRepositories.Cameras, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
                                    <CollectionViewSource x:Key="EntitiesCollection" Source="{Binding Path=DataContext.PrefabRepositories.Entities, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
                                    <CollectionViewSource x:Key="LightsCollection" Source="{Binding Path=DataContext.PrefabRepositories.Lights, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Window}}}" />
                                </Views:RepositoryManager.Resources>
                                <Views:RepositoryManager.ItemsSource>
                                    <CompositeCollection>
                                        <CollectionContainer Collection="{Binding Source={StaticResource CamerasCollection}}" />
                                        <CollectionContainer Collection="{Binding Source={StaticResource EntitiesCollection}}" />
                                        <CollectionContainer Collection="{Binding Source={StaticResource LightsCollection}}" />
                                    </CompositeCollection>
                                </Views:RepositoryManager.ItemsSource>

                                <Views:RepositoryManager.SelectionPanel>
                                    <StackPanel>

                                        <Button
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                            Height="22"
                                            VerticalAlignment="Center"
                                            Command="{Binding AddItemCommand}"
                                            CommandParameter="{x:Type Compositing:EntityModel}"
                                            Style="{StaticResource ButtonItemControl}">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image
                                                        Width="12"
                                                        Height="12"
                                                        Margin="0,0,8,0"
                                                        Opacity="0.7"
                                                        Source="{DynamicResource Geometry}" />
                                                    <TextBlock Text="Entity" />
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>

                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                            Height="22"
                                            VerticalAlignment="Center"
                                            Command="{Binding AddItemCommand}"
                                            CommandParameter="{x:Type Cameras:CameraModel}"
                                            Style="{StaticResource ButtonItemControl}">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image
                                                        Width="12"
                                                        Height="12"
                                                        Margin="0,0,8,0"
                                                        Opacity="0.7"
                                                        Source="{DynamicResource Camera}" />
                                                    <TextBlock Text="Camera" />
                                                </StackPanel>

                                            </Button.Content>
                                        </Button>

                                        <Button
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Width="{Binding ActualWidth, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=UserControl}}"
                                            Height="22"
                                            VerticalAlignment="Center"
                                            Command="{Binding AddItemCommand}"
                                            CommandParameter="{x:Type Lights:LightEntityModel}"
                                            Style="{StaticResource ButtonItemControl}">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal">
                                                    <Image
                                                        Width="12"
                                                        Height="12"
                                                        Margin="0,0,8,0"
                                                        Opacity="0.7"
                                                        Source="{DynamicResource MeshLight}" />
                                                    <TextBlock Text="Light" />
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>
                                    </StackPanel>
                                    <!--<Entities:EntitySelectionPanel />-->
                                </Views:RepositoryManager.SelectionPanel>

                            </Views:RepositoryManager>

                            <ContentControl Content="{Binding}" DataContext="{Binding EntityManager.SelectedItem}">
                                <ContentControl.Resources>

                                    <DataTemplate DataType="{x:Type Compositing:Entity}">
                                        <Views:ModelEntity DataContext="{Binding}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type Prefabs:EmptyPrefab}">
                                        <Border />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type Cameras:Camera}">
                                        <Views:Camera DataContext="{Binding}" />
                                    </DataTemplate>

                                    <DataTemplate DataType="{x:Type Lights:LightEntity}">
                                        <Views:LightEntity DataContext="{Binding}" />
                                    </DataTemplate>

                                </ContentControl.Resources>
                            </ContentControl>
                        </StackPanel>

                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource World}"
                                ToolTip="Material" />
                        </TabItem.Header>

                        <StackPanel>
                            <Views:RepositoryManager
                                x:Name="materialManager"
                                Margin="8"
                                DataContext="{Binding MaterialManager}"
                                DockPanel.Dock="Top"
                                ItemsSource="{Binding ControlRepository.Materials}">
                                <Views:RepositoryManager.SelectionPanel>
                                    <Views:MaterialSelectionPanel />
                                </Views:RepositoryManager.SelectionPanel>
                            </Views:RepositoryManager>

                            <Border Visibility="{Binding MaterialManager.SelectedItem, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}">
                                <Views:Material DataContext="{Binding MaterialManager.SelectedItem}" />
                            </Border>

                        </StackPanel>


                    </TabItem>

                    <TabItem>

                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource Texture}"
                                ToolTip="Assets" />
                        </TabItem.Header>

                        <StackPanel>

                            <Views:RepositoryManager
                                x:Name="repositoryManager"
                                Margin="8"
                                DataContext="{Binding TextureManager}"
                                DockPanel.Dock="Top"
                                ItemsSource="{Binding ControlRepository.Textures}">
                                <Views:RepositoryManager.SelectionPanel>
                                    <Views:TextureSelectionPanel />
                                </Views:RepositoryManager.SelectionPanel>
                            </Views:RepositoryManager>

                            <Panels:IndentedExpander
                                Header="Settings"
                                Indentation="0"
                                IsExpanded="false">
                                <ContentControl
                                    Margin="8"
                                    Content="{Binding}"
                                    DataContext="{Binding TextureManager.SelectedItem}">
                                    <ContentControl.Resources>
                                        <ResourceDictionary Source="pack://application:,,,/CMiX.Studio;component/Views/Texturing/Source/TextureSourceDataTemplates.xaml" />
                                    </ContentControl.Resources>
                                </ContentControl>
                            </Panels:IndentedExpander>

                            <Panels:IndentedExpander
                                Header="Filter"
                                Indentation="0"
                                IsExpanded="{Binding Path=TextureManager.SelectedItem.FilterManager.IsExpanded}">
                                <Views:ModifierManager DataContext="{Binding Path=TextureManager.SelectedItem.FilterManager}">
                                    <Views:ModifierManager.SelectionPanel>
                                        <Views:TextureFilterSelectionPanel DataContext="{Binding}" />
                                    </Views:ModifierManager.SelectionPanel>
                                </Views:ModifierManager>
                            </Panels:IndentedExpander>

                        </StackPanel>

                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource Camera}"
                                ToolTip="Assets" />
                        </TabItem.Header>
                        <StackPanel>
                            <ListBox
                                x:Name="CameraListBox"
                                Height="120"
                                DockPanel.Dock="Top"
                                ItemsSource="{Binding PrefabRepositories.Cameras}" />

                            <Views:Camera
                                Margin="0,8,0,0"
                                DataContext="{Binding SelectedItem, ElementName=CameraListBox}"
                                Visibility="{Binding Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}" />
                        </StackPanel>

                    </TabItem>

                    <TabItem>
                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource MeshLight}"
                                ToolTip="Assets" />
                        </TabItem.Header>
                        <StackPanel>
                            <ListBox
                                x:Name="LightListBox"
                                Height="120"
                                DockPanel.Dock="Top"
                                ItemsSource="{Binding PrefabRepositories.Lights}" />

                            <Views:Camera
                                Margin="0,8,0,0"
                                DataContext="{Binding SelectedItem, ElementName=LightListBox}"
                                Visibility="{Binding Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static Visibility.Collapsed}}" />
                        </StackPanel>

                    </TabItem>



                    <TabItem>
                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource Resources}"
                                ToolTip="Assets" />
                        </TabItem.Header>
                        <Views:AssetManager DataContext="{Binding AssetManager}" />
                    </TabItem>

                    <TabItem Style="{StaticResource TabItemVerticalPanel}">

                        <TabItem.Header>
                            <Image
                                Margin="8"
                                Source="{StaticResource Network}"
                                ToolTip="Assets" />
                        </TabItem.Header>

                        <Border Background="{DynamicResource HighDarkerColor}">
                            <StackPanel>
                                <Views:ServerManager DataContext="{Binding ServerManager}" />
                                <Scheduling:PlaylistEditor DataContext="{Binding PlaylistEditor}" />
                                <Scheduling:SchedulerManager DataContext="{Binding SchedulerManager}" />
                            </StackPanel>
                        </Border>

                    </TabItem>

                </TabControl>

            </Border>

        </DockPanel>
    </Border>

</Window>